/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
BMPCMP_ICON             ICON    DISCARDABLE     "bmpcmp.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

BMPCMP_MENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Load Images",                CM_LOAD
        MENUITEM "E&xit",                       CM_EXIT
    END
    POPUP "&Display"
    BEGIN
        MENUITEM "Test/Reference",              CM_DISPTESTREF, CHECKED
        MENUITEM "Test/Difference",             CM_DISPTESTDIFF
        MENUITEM "Reference/Difference",        CM_DISPREFDIFF
        MENUITEM "Test/Overlay Diff (only for 24bit on blackl)", 
                                                CM_DISPTESTOVERLAY24DIFF
        MENUITEM "Reference/Overlay Diff (only for 24bit on blackl)", 
                                                CM_DISPREFOVERLAY24DIFF
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Left Mouse - Zoom in 2x",     ID_MENUITEM40006
        MENUITEM "Right Mouse - Zoom out 2x",   ID_MENUITEM40007
        MENUITEM "CTRL + Left Mouse - Shift Cursor", ID_MENUITEM40008
        MENUITEM "SHFT + Left Mouse - Print Value", ID_MENUITEM40009
        MENUITEM SEPARATOR
        MENUITEM "For Overlay diffs: ",         ID_HELP_FOROVERLAYDIFFSBLUEPIXELSAREINTHETESTIMAGEONLY

        MENUITEM "  blue: test image only",     ID_HELP_BLUETESTIMAGEONLY
        MENUITEM "  green: reference image only", 
                                                ID_HELP_GREENREFERENCEIMAGEONLY

        MENUITEM "  white: both images have non-black and non-equal pixels", 
                                                ID_HELP_WHITEBOTHIMAGESHAVENONBLACKANDNONEQUALPIXELS

        MENUITEM "  gray: both images have the same, non-black pixel", 
                                                ID_HELP_GRAYBOTHIMAGESHAVETHESAMENONBLACKPIXEL

    END
END


