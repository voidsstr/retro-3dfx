; 106  :             SETDW(ghwIO->vidSerialParallelPort, dwReg); 

  000fd	8b 45 08	 mov	 eax, DWORD PTR _ppdev$[ebp]
  00100	8b 88 78 1a 00
	00		 mov	 ecx, DWORD PTR [eax+6776]
  00106	8b 55 f8	 mov	 edx, DWORD PTR _dwReg$[ebp]
  00109	89 51 78	 mov	 DWORD PTR [ecx+120], edx

; 107  : 
; 108  :             //Wait until the new data state latched on the bus
; 109  :             for ( i=0 ;; )

  0010c	c7 45 fc 00 00
	00 00		 mov	 DWORD PTR _i$[ebp], 0
$L36675:

; 111  :                dwReg = GET(ghwIO->vidSerialParallelPort);

  00113	8b 45 08	 mov	 eax, DWORD PTR _ppdev$[ebp]
  00116	8b 88 78 1a 00
	00		 mov	 ecx, DWORD PTR [eax+6776]
  0011c	8b 51 78	 mov	 edx, DWORD PTR [ecx+120]
  0011f	89 55 f8	 mov	 DWORD PTR _dwReg$[ebp], edx

; 112  :                if (data & 1)

  00122	8b 45 10	 mov	 eax, DWORD PTR _data$[ebp]
  00125	25 ff 00 00 00	 and	 eax, 255		; 000000ffH
  0012a	83 e0 01	 and	 eax, 1
  0012d	85 c0		 test	 eax, eax
  0012f	74 27		 je	 SHORT $L36678

; 114  :                    if ( dwReg & H3_VMI_I2C_DATA_STATE_MASK )

  00131	8b 4d f8	 mov	 ecx, DWORD PTR _dwReg$[ebp]
  00134	81 e1 00 00 00
	08		 and	 ecx, 134217728		; 08000000H
  0013a	85 c9		 test	 ecx, ecx
  0013c	74 02		 je	 SHORT $L36679

; 115  :                        break;

  0013e	eb 28		 jmp	 SHORT $L36676
$L36679:

; 116  :                    else if ( ++i > 50 )

  00140	8b 55 fc	 mov	 edx, DWORD PTR _i$[ebp]
  00143	83 c2 01	 add	 edx, 1
  00146	89 55 fc	 mov	 DWORD PTR _i$[ebp], edx
  00149	83 7d fc 32	 cmp	 DWORD PTR _i$[ebp], 50	; 00000032H
  0014d	7e 07		 jle	 SHORT $L36681

; 117  :                        return(1);  //Someone is holding bus low

  0014f	b8 01 00 00 00	 mov	 eax, 1
  00154	eb 14		 jmp	 SHORT $L36649
$L36681:

; 119  :                else

  00156	eb 0e		 jmp	 SHORT $L36683
$L36678:

; 121  :                    if ( !(dwReg & H3_VMI_I2C_DATA_STATE_MASK) )

  00158	8b 45 f8	 mov	 eax, DWORD PTR _dwReg$[ebp]
  0015b	25 00 00 00 08	 and	 eax, 134217728		; 08000000H
  00160	85 c0		 test	 eax, eax
  00162	75 02		 jne	 SHORT $L36683

; 122  :                        break;

  00164	eb 02		 jmp	 SHORT $L36676
$L36683:

; 124  :             }

  00166	eb ab		 jmp	 SHORT $L36675
$L36676:
$L36653:

; 127  :      return(0);

  00168	33 c0		 xor	 eax, eax
$L36649:

; 128  : }// I2C_Out

  0016a	8b e5		 mov	 esp, ebp
  0016c	5d		 pop	 ebp
  0016d	c3		 ret	 0
_I2C_OUT ENDP
