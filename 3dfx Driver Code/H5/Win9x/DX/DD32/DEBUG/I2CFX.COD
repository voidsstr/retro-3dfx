  0008f	85 d2		 test	 edx, edx
  00091	74 10		 je	 SHORT $L36665

; 86   :                    if ( dwReg & H3_VMI_I2C_CLOCK_STATE_MASK )

  00093	8b 45 f8	 mov	 eax, DWORD PTR _dwReg$[ebp]
  00096	25 00 00 00 04	 and	 eax, 67108864		; 04000000H
  0009b	85 c0		 test	 eax, eax
