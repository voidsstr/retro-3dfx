PUBLIC	_DdDestroyDriver@4
EXTRN	_DoKMTV:NEAR
_TEXT	SEGMENT
_pcsd$ = 8
_ppdev$ = -4
_DdDestroyDriver@4 PROC NEAR

; 96   : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp
  00003	51		 push	 ecx

; 97   :   DD_ENTRY_SETUP(pcsd->lpDD);

  00004	8b 45 08	 mov	 eax, DWORD PTR _pcsd$[ebp]
  00007	8b 08		 mov	 ecx, DWORD PTR [eax]
  00009	8b 91 30 04 00
	00		 mov	 edx, DWORD PTR [ecx+1072]
  0000f	89 55 fc	 mov	 DWORD PTR _ppdev$[ebp], edx
  00012	8b 45 fc	 mov	 eax, DWORD PTR _ppdev$[ebp]
  00015	8b 48 08	 mov	 ecx, DWORD PTR [eax+8]
  00018	83 c9 02	 or	 ecx, 2
  0001b	8b 55 fc	 mov	 edx, DWORD PTR _ppdev$[ebp]
  0001e	89 4a 08	 mov	 DWORD PTR [edx+8], ecx
  00021	8b 45 fc	 mov	 eax, DWORD PTR _ppdev$[ebp]
  00024	8b 48 08	 mov	 ecx, DWORD PTR [eax+8]
  00027	81 e1 00 10 00
	00		 and	 ecx, 4096		; 00001000H
  0002d	85 c9		 test	 ecx, ecx
  0002f	74 0c		 je	 SHORT $L36857
  00031	8b 55 fc	 mov	 edx, DWORD PTR _ppdev$[ebp]
  00034	52		 push	 edx
  00035	e8 00 00 00 00	 call	 _DoKMTV
  0003a	83 c4 04	 add	 esp, 4
$L36857:

; 98   : 
; 99   :   return DDHAL_DRIVER_HANDLED;

  0003d	b8 01 00 00 00	 mov	 eax, 1

; 100  : 
; 101  : } // DdDestroyDriver

  00042	8b e5		 mov	 esp, ebp
  00044	5d		 pop	 ebp
  00045	c2 04 00	 ret	 4
_DdDestroyDriver@4 ENDP
_TEXT	ENDS
PUBLIC	_DdSetExclusiveMode@4
PUBLIC	_Exit_3DApplication
EXTRN	_Msg:NEAR
_DATA	SEGMENT
	ORG $+3
$SG36865 DB	'SetExclusiveMode32 (entering)', 00H
	ORG $+2
$SG36867 DB	'SetExclusiveMode32 (leaving)', 00H
_DATA	ENDS
_TEXT	SEGMENT
_psemd$ = 8
_ppdev$ = -4
_DdSetExclusiveMode@4 PROC NEAR

; 112  : {

  00048	55		 push	 ebp
  00049	8b ec		 mov	 ebp, esp
  0004b	51		 push	 ecx

; 113  :     DD_ENTRY_SETUP(psemd->lpDD);

  0004c	8b 45 08	 mov	 eax, DWORD PTR _psemd$[ebp]
  0004f	8b 08		 mov	 ecx, DWORD PTR [eax]
  00051	8b 91 30 04 00
	00		 mov	 edx, DWORD PTR [ecx+1072]
  00057	89 55 fc	 mov	 DWORD PTR _ppdev$[ebp], edx
  0005a	8b 45 fc	 mov	 eax, DWORD PTR _ppdev$[ebp]
  0005d	8b 48 08	 mov	 ecx, DWORD PTR [eax+8]
  00060	83 c9 02	 or	 ecx, 2
  00063	8b 55 fc	 mov	 edx, DWORD PTR _ppdev$[ebp]
  00066	89 4a 08	 mov	 DWORD PTR [edx+8], ecx
  00069	8b 45 fc	 mov	 eax, DWORD PTR _ppdev$[ebp]
  0006c	8b 48 08	 mov	 ecx, DWORD PTR [eax+8]
  0006f	81 e1 00 10 00
	00		 and	 ecx, 4096		; 00001000H
  00075	85 c9		 test	 ecx, ecx
  00077	74 0c		 je	 SHORT $L36863
  00079	8b 55 fc	 mov	 edx, DWORD PTR _ppdev$[ebp]
  0007c	52		 push	 edx
  0007d	e8 00 00 00 00	 call	 _DoKMTV
  00082	83 c4 04	 add	 esp, 4
$L36863:

; 114  : 
; 115  :     if( psemd->dwEnterExcl )

  00085	8b 45 08	 mov	 eax, DWORD PTR _psemd$[ebp]
  00088	83 78 04 00	 cmp	 DWORD PTR [eax+4], 0
  0008c	74 22		 je	 SHORT $L36864

; 117  :       #ifdef FXTRACE
; 118  :       Msg(ppdev, DEBUG_APIENTRY, "SetExclusiveMode32 (entering)" );

  0008e	68 00 00 00 00	 push	 OFFSET FLAT:$SG36865
  00093	6a 01		 push	 1
  00095	8b 4d fc	 mov	 ecx, DWORD PTR _ppdev$[ebp]
  00098	51		 push	 ecx
  00099	e8 00 00 00 00	 call	 _Msg
  0009e	83 c4 0c	 add	 esp, 12			; 0000000cH

; 119  :       #endif
; 120  :       _DS(ddExclusiveMode) = TRUE;

  000a1	8b 55 fc	 mov	 edx, DWORD PTR _ppdev$[ebp]
  000a4	c7 82 48 05 00
	00 01 00 00 00	 mov	 DWORD PTR [edx+1352], 1

; 122  :     else

  000ae	eb 3b		 jmp	 SHORT $L36866
$L36864:

; 124  :       #ifdef FXTRACE
; 125  :       Msg(ppdev, DEBUG_APIENTRY, "SetExclusiveMode32 (leaving)" );

  000b0	68 00 00 00 00	 push	 OFFSET FLAT:$SG36867
  000b5	6a 01		 push	 1
  000b7	8b 45 fc	 mov	 eax, DWORD PTR _ppdev$[ebp]
  000ba	50		 push	 eax
  000bb	e8 00 00 00 00	 call	 _Msg
  000c0	83 c4 0c	 add	 esp, 12			; 0000000cH

; 126  :       #endif
; 127  : 
; 128  : 	  /* In case we reached this point and the primary surface has not been demoted from */
; 129  : 	  /* overlay, we need to call Exit_3DApplication() in order to the neccessary demotions. */
; 130  : 
; 131  : 	  if (_DD(dd3DInOverlay))

  000c3	8b 4d fc	 mov	 ecx, DWORD PTR _ppdev$[ebp]
  000c6	8b 91 14 18 00
	00		 mov	 edx, DWORD PTR [ecx+6164]
  000cc	83 7a 48 00	 cmp	 DWORD PTR [edx+72], 0
  000d0	74 0c		 je	 SHORT $L36869

; 132  : 	      Exit_3DApplication(ppdev);

  000d2	8b 45 fc	 mov	 eax, DWORD PTR _ppdev$[ebp]
  000d5	50		 push	 eax
  000d6	e8 00 00 00 00	 call	 _Exit_3DApplication
  000db	83 c4 04	 add	 esp, 4
$L36869:

; 133  : 
; 134  :       _DS(ddExclusiveMode) = FALSE;

  000de	8b 4d fc	 mov	 ecx, DWORD PTR _ppdev$[ebp]
  000e1	c7 81 48 05 00
	00 00 00 00 00	 mov	 DWORD PTR [ecx+1352], 0
$L36866:

; 136  : 
; 137  :     psemd->ddRVal = DD_OK;

  000eb	8b 55 08	 mov	 edx, DWORD PTR _psemd$[ebp]
  000ee	c7 42 0c 00 00
	00 00		 mov	 DWORD PTR [edx+12], 0

; 138  :     return DDHAL_DRIVER_HANDLED;

  000f5	b8 01 00 00 00	 mov	 eax, 1

; 139  : 
; 140  : } // DdSetExclusiveMode

  000fa	8b e5		 mov	 esp, ebp
  000fc	5d		 pop	 ebp
  000fd	c2 04 00	 ret	 4
_DdSetExclusiveMode@4 ENDP
