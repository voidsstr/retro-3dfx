  00131	89 4a 08	 mov	 DWORD PTR [edx+8], ecx
  00134	8b 45 fc	 mov	 eax, DWORD PTR _ppdev$[ebp]
  00137	8b 48 08	 mov	 ecx, DWORD PTR [eax+8]
  0013a	81 e1 00 10 00
	00		 and	 ecx, 4096		; 00001000H
