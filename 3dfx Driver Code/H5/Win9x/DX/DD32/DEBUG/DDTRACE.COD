PUBLIC	_ddDebugPrint
EXTRN	__imp__wvsprintfA@12:NEAR
EXTRN	__imp__OutputDebugStringA@4:NEAR
_TEXT	SEGMENT
_szFormat$ = 8
_buffer$ = -256
_ddDebugPrint PROC NEAR

; 90   : {                     

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp
  00003	81 ec 00 01 00
	00		 sub	 esp, 256		; 00000100H

; 91   :      char buffer[256];
; 92   : 
; 93   :      wvsprintf(buffer, szFormat, (LPVOID)(&szFormat+1));

  00009	8d 45 0c	 lea	 eax, DWORD PTR _szFormat$[ebp+4]
  0000c	50		 push	 eax
  0000d	8b 4d 08	 mov	 ecx, DWORD PTR _szFormat$[ebp]
  00010	51		 push	 ecx
  00011	8d 95 00 ff ff
	ff		 lea	 edx, DWORD PTR _buffer$[ebp]
  00017	52		 push	 edx
  00018	ff 15 00 00 00
	00		 call	 DWORD PTR __imp__wvsprintfA@12

; 94   :      OutputDebugString(buffer);

  0001e	8d 85 00 ff ff
	ff		 lea	 eax, DWORD PTR _buffer$[ebp]
  00024	50		 push	 eax
  00025	ff 15 00 00 00
	00		 call	 DWORD PTR __imp__OutputDebugStringA@4

; 95   : }// ddDebugPrint

  0002b	8b e5		 mov	 esp, ebp
  0002d	5d		 pop	 ebp
  0002e	c3		 ret	 0
_ddDebugPrint ENDP
_TEXT	ENDS
