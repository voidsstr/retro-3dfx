_TEXT	SEGMENT
_ppdev$ = 8
_debugPrintLevel$ = 12
_szFormat$ = 16
_str$ = -256
_Msg	PROC NEAR

; 118  : {

  0002f	55		 push	 ebp
  00030	8b ec		 mov	 ebp, esp
  00032	81 ec 00 01 00
	00		 sub	 esp, 256		; 00000100H

; 119  :     char        str[256];
; 120  : 
; 121  :     if (debugPrintLevel <= _DD(DD_DebugLevel)) 

  00038	8b 45 08	 mov	 eax, DWORD PTR _ppdev$[ebp]
  0003b	8b 88 14 18 00
	00		 mov	 ecx, DWORD PTR [eax+6164]
  00041	8b 55 0c	 mov	 edx, DWORD PTR _debugPrintLevel$[ebp]
  00044	3b 51 04	 cmp	 edx, DWORD PTR [ecx+4]
  00047	7f 57		 jg	 SHORT $L36601

; 123  :       wsprintf( (LPSTR) str, START_STR );

  00049	68 00 00 00 00	 push	 OFFSET FLAT:$SG36603
  0004e	8d 85 00 ff ff
	ff		 lea	 eax, DWORD PTR _str$[ebp]
  00054	50		 push	 eax
  00055	ff 15 00 00 00
	00		 call	 DWORD PTR __imp__wsprintfA
  0005b	83 c4 08	 add	 esp, 8

; 124  :       wvsprintf( str+lstrlen( str ), szFormat, (LPVOID)(&szFormat+1) );

  0005e	8d 4d 14	 lea	 ecx, DWORD PTR _szFormat$[ebp+4]
  00061	51		 push	 ecx
  00062	8b 55 10	 mov	 edx, DWORD PTR _szFormat$[ebp]
  00065	52		 push	 edx
  00066	8d 85 00 ff ff
	ff		 lea	 eax, DWORD PTR _str$[ebp]
  0006c	50		 push	 eax
  0006d	ff 15 00 00 00
	00		 call	 DWORD PTR __imp__lstrlenA@4
  00073	8d 8c 05 00 ff
	ff ff		 lea	 ecx, DWORD PTR _str$[ebp+eax]
  0007a	51		 push	 ecx
  0007b	ff 15 00 00 00
	00		 call	 DWORD PTR __imp__wvsprintfA@12

; 125  :       lstrcat( (LPSTR) str, END_STR );

  00081	68 00 00 00 00	 push	 OFFSET FLAT:$SG36606
  00086	8d 95 00 ff ff
	ff		 lea	 edx, DWORD PTR _str$[ebp]
  0008c	52		 push	 edx
  0008d	ff 15 00 00 00
	00		 call	 DWORD PTR __imp__lstrcatA@8

; 126  :       OutputDebugString( str );

  00093	8d 85 00 ff ff
	ff		 lea	 eax, DWORD PTR _str$[ebp]
  00099	50		 push	 eax
  0009a	ff 15 00 00 00
	00		 call	 DWORD PTR __imp__OutputDebugStringA@4
$L36601:

; 128  : 
; 129  : } /* Msg */

  000a0	8b e5		 mov	 esp, ebp
  000a2	5d		 pop	 ebp
  000a3	c3		 ret	 0
