; 567  :     // Check for calls to GetDriverInfo2
; 568  :     else if (IsEqualIID(&lpInput->guidInfo, &GUID_GetDriverInfo2) )
; 569  :     {
; 570  :         // Make sure this is actually a call to GetDriverInfo2 
; 571  :         // ( and not a call to DDStereoMode!)
; 572  :         if (D3DGDI_IS_GDI2(lpInput))
; 573  :         {
; 574  :             // Yes, its a call to GetDriverInfo2, fetch the
; 575  :             // DD_GETDRIVERINFO2DATA data structure.
; 576  :             DD_GETDRIVERINFO2DATA* pGDI2 = D3DGDI_GET_GDI2_DATA(lpInput);
; 577  :             DD_DXVERSION *pDXVer;
; 578  :             DD_GETFORMATCOUNTDATA *pGFCD;
; 579  :             DD_GETFORMATDATA *pGFD;
; 580  :             size_t copySize;
; 581  :             D3DCAPS8 D3DCaps8;
; 582  : 
; 583  :             // What type of request is this?
; 584  :             switch (pGDI2->dwType)
; 585  :             {
; 586  :                 case D3DGDI2_TYPE_DXVERSION:
; 587  : 
; 588  :                     // This is a way for a driver on NT to find out the DX-Runtime 
; 589  :                     // version. (This functionality exists on 9x but not on NT). 
; 590  :                     // This information is provided to a new driver (i.e. one that 
; 591  :                     // exposes GETDRIVERINFO2) for DX7 applications and DX8 
; 592  :                     // applications. And you should get x0000800 for dwDXVersion; 
; 593  :                     // or more accurately, you should DD_RUNTIME_VERSION which is 
; 594  :                     // defined in ddrawi.h.
; 595  : 
; 596  :                     pDXVer = (DD_DXVERSION *) pGDI2;
; 597  :                     _FF(ddRunTimeVersion) = pDXVer->dwDXVersion;
; 598  : 
; 599  :                     lpInput->dwActualSize = sizeof(DD_DXVERSION);
; 600  :                     lpInput->ddRVal       = DD_OK;                
; 601  : 
; 602  :                     break;
; 603  : 
; 604  :                 case D3DGDI2_TYPE_GETFORMATCOUNT:
; 605  : 
; 606  :                     // Its a request for the number of texture formats
; 607  :                     // we support. Get the extended data structure so
; 608  :                     // we can fill in the format count field.
; 609  : 
; 610  :                     pGFCD = (DD_GETFORMATCOUNTDATA *) pGDI2;
; 611  :                     pGFCD->dwFormatCount = g_nDX8TextureFormats;
; 612  : 
; 613  :                     lpInput->dwActualSize = sizeof(DD_GETFORMATCOUNTDATA);
; 614  :                     lpInput->ddRVal       = DD_OK;
; 615  : 
; 616  :                     break;
; 617  : 
; 618  :                 case D3DGDI2_TYPE_GETFORMAT:
; 619  : 
; 620  :                     // Its a request for a particular format we support.
; 621  :                     // Get the extended data structure so we can fill in
; 622  :                     // the format field.
; 623  : 
; 624  :                     pGFD = (DD_GETFORMATDATA *) pGDI2;
; 625  :                 
; 626  :                     // Initialize the surface description and copy over
; 627  :                     // the pixel format from out pixel format table.
; 628  : 
; 629  :                     memcpy(&pGFD->format, &g_DX8TextureFormats[pGFD->dwFormatIndex].ddpfPixelFormat,
; 630  :                            sizeof(pGFD->format));
; 631  : 
; 632  :                     lpInput->dwActualSize = sizeof(DD_GETFORMATDATA);
; 633  :                     lpInput->ddRVal       = DD_OK;
; 634  : 
; 635  :                     break;
; 636  : 
; 637  :                case D3DGDI2_TYPE_GETD3DCAPS8:
; 638  : 
; 639  :                     // The runtime is requesting the DX8 D3D caps build them
; 640  :                 
; 641  :                     BuildD3DCaps8(ppdev, &D3DCaps8);
; 642  : 
; 643  :                     // It should be noted that the dwExpectedSize field
; 644  :                     // of DD_GETDRIVERINFODATA is not used for
; 645  :                     // GetDriverInfo2 calls and should be ignored.
; 646  : 
; 647  :                     copySize = min(sizeof(D3DCAPS8), pGDI2->dwExpectedSize);
; 648  :                     memcpy(lpInput->lpvData, &D3DCaps8, copySize);
; 649  : 
; 650  :                     lpInput->dwActualSize = copySize;
; 651  :                     lpInput->ddRVal       = DD_OK;
; 652  : 
; 653  :                     break;
; 654  : 
; 655  :                 default:
; 656  : 
; 657  :                     // Default behavior for any other type.
; 658  : 
; 659  :                     break;
; 660  :             }
; 661  :         }
; 662  :     }
