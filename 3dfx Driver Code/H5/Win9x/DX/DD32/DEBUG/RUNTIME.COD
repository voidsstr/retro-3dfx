; 136  : 
; 137  :    // shift by the exponent to get rid of the exponent. Need to use
; 138  :    // 23 - expnt because expnt is number of posistions to the left of
; 139  :    // decimal and we want to get rid of the posistions to the right of
; 140  :    // the decimal.
; 141  :    
; 142  : //   mantissa >>= (23 - expnt);
; 143  : //PingZ 8/5/99  The above line is wrong.  It only works if expnt is less than 23. If expnt is 
; 144  : //greater than 23 it will convert matissa to zero!
; 145  : //Here is the correct way to do it.
; 146  : 
; 147  :    expnt = 23 - expnt;

  00162	ba 17 00 00 00	 mov	 edx, 23			; 00000017H
  00167	2b 55 f8	 sub	 edx, DWORD PTR _expnt$[ebp]
