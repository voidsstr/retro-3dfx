  000f9	c7 45 fc 00 00
	00 00		 mov	 DWORD PTR _neg$[ebp], 0

; 118  : 
; 119  :    mantissa = expnt = *( long *) &f;

  00100	8b 45 08	 mov	 eax, DWORD PTR _f$[ebp]
  00103	89 45 f8	 mov	 DWORD PTR _expnt$[ebp], eax
  00106	8b 4d f8	 mov	 ecx, DWORD PTR _expnt$[ebp]
  00109	89 4d f4	 mov	 DWORD PTR _mantissa$[ebp], ecx

; 120  : 
; 121  :    // Special Case
