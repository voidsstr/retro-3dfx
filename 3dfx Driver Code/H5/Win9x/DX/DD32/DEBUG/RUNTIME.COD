  0010c	83 7d f4 00	 cmp	 DWORD PTR _mantissa$[ebp], 0
  00110	75 07		 jne	 SHORT $L48895

; 123  :      return 0;

  00112	33 c0		 xor	 eax, eax
  00114	e9 85 00 00 00	 jmp	 $L48890
$L48895:

; 124  : 
; 125  :    if( expnt & 0x80000000 )

  00119	8b 55 f8	 mov	 edx, DWORD PTR _expnt$[ebp]
  0011c	81 e2 00 00 00
	80		 and	 edx, -2147483648	; 80000000H
