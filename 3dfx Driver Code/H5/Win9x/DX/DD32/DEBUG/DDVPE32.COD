  000c7	89 50 08	 mov	 DWORD PTR [eax+8], edx
  000ca	8b 4d a4	 mov	 ecx, DWORD PTR _ppdev$[ebp]
  000cd	8b 51 08	 mov	 edx, DWORD PTR [ecx+8]
  000d0	81 e2 00 10 00
	00		 and	 edx, 4096		; 00001000H
  000d6	85 d2		 test	 edx, edx
  000d8	74 0c		 je	 SHORT $L36873
  000da	8b 45 a4	 mov	 eax, DWORD PTR _ppdev$[ebp]
  000dd	50		 push	 eax
