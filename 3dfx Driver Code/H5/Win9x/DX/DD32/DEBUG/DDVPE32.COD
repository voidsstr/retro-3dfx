  00058	50		 push	 eax
  00059	8b 4d f8	 mov	 ecx, DWORD PTR _hDevice$[ebp]
  0005c	51		 push	 ecx
  0005d	ff 15 00 00 00
	00		 call	 DWORD PTR __imp__DeviceIoControl@32
  00063	85 c0		 test	 eax, eax
  00065	75 07		 jne	 SHORT $L36860

