  00090	6a 01		 push	 1
  00092	8b 45 08	 mov	 eax, DWORD PTR _ppdev$[ebp]
  00095	50		 push	 eax
  00096	e8 00 00 00 00	 call	 _IOControl
  0009b	83 c4 10	 add	 esp, 16			; 00000010H

; 332  : #endif
