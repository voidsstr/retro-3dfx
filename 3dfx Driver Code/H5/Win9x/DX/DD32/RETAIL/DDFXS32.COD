; 137  :     psemd->ddRVal = DD_OK;

  0008b	c7 47 0c 00 00
	00 00		 mov	 DWORD PTR [edi+12], 0
  00092	5f		 pop	 edi
  00093	c7 86 48 05 00
	00 00 00 00 00	 mov	 DWORD PTR [esi+1352], 0

; 138  :     return DDHAL_DRIVER_HANDLED;

  0009d	b8 01 00 00 00	 mov	 eax, 1
  000a2	5e		 pop	 esi

