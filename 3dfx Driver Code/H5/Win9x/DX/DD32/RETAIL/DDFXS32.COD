; 122  :     else
; 123  :     {
; 124  :       #ifdef FXTRACE
; 125  :       Msg(ppdev, DEBUG_APIENTRY, "SetExclusiveMode32 (leaving)" );
; 126  :       #endif
; 127  : 
; 128  : 	  /* In case we reached this point and the primary surface has not been demoted from */
