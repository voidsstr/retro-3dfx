; 97   :   DD_ENTRY_SETUP(pcsd->lpDD);

  00000	8b 44 24 04	 mov	 eax, DWORD PTR _pcsd$[esp-4]
  00004	8b 08		 mov	 ecx, DWORD PTR [eax]
  00006	8b 81 30 04 00
	00		 mov	 eax, DWORD PTR [ecx+1072]
  0000c	8b 50 08	 mov	 edx, DWORD PTR [eax+8]
  0000f	83 ca 02	 or	 edx, 2
  00012	8b ca		 mov	 ecx, edx
  00014	f6 c5 10	 test	 ch, 16			; 00000010H
  00017	89 50 08	 mov	 DWORD PTR [eax+8], edx
  0001a	74 09		 je	 SHORT $L37506
  0001c	50		 push	 eax
  0001d	e8 00 00 00 00	 call	 _DoKMTV
  00022	83 c4 04	 add	 esp, 4
$L37506:

; 98   : 
; 99   :   return DDHAL_DRIVER_HANDLED;

  00025	b8 01 00 00 00	 mov	 eax, 1

; 100  : 
; 101  : } // DdDestroyDriver

  0002a	c2 04 00	 ret	 4
_DdDestroyDriver@4 ENDP
