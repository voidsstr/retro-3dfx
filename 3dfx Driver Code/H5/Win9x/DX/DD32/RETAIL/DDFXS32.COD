  01e4e	81 c5 00 02 00
	00		 add	 ebp, 512		; 00000200H

; 2104 :       and   eax,0ffffh       ; mask off high word

  01e54	25 ff ff 00 00	 and	 eax, 65535		; 0000ffffH

; 2105 :       mov   dwReturn, eax

  01e59	89 45 fc	 mov	 DWORD PTR _dwReturn$[ebp], eax

; 2106 :       }
; 2107 : 
; 2108 :     return dwReturn;                  // return code in eax

  01e5c	8b 45 fc	 mov	 eax, DWORD PTR _dwReturn$[ebp]

; 2109 : }

  01e5f	8b e5		 mov	 esp, ebp
  01e61	5d		 pop	 ebp
  01e62	c3		 ret	 0
