; 2086 :    // NOTE that QT_Thunk will die without fixing up EBP.  I
; 2087 :    //   don't know exactly how big the stack should be but
; 2088 :    //   it appears the more the 16:16 uses, the larger it must be!
; 2089 : 
; 2090 :    DWORD Addr1616;
; 2091 :    DWORD dwReturn;
; 2092 : 
; 2093 :    // Get 16:16 function address from shared data
; 2094 :    Addr1616 = _FF(dwSwitchCursor);

