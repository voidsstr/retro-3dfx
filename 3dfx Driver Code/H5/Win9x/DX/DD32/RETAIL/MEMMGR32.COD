_DATA	ENDS
PUBLIC	_mmEvict32
EXTRN	_QT_Thunk:NEAR
_TEXT	SEGMENT
_ppdev$ = 8
_fpVidMemStart32$ = 12
_fpVidMemEnd32$ = 16
_dwBlockSize$ = 20
_Addr1616$ = 8
_mmEvict32 PROC NEAR

; 62   : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp

; 63   :    // QT_Thunk is documented in Windows 95 System Programming
; 64   :    //   Secrets, Pietrek.  pp. 191-195, 208-211.
; 65   :    // NOTE that QT_Thunk will die without fixing up EBP.  I
; 66   :    //   don't know exactly how big the stack should be but
; 67   :    //   it appears the more the 16:16 uses, the larger it must be!
; 68   : 
; 69   :    DWORD Addr1616;
; 70   : 
; 71   :    // Get 16:16 function address from shared data
; 72   :    Addr1616 = _FF(mmEvictAddr);

  00003	8b 45 08	 mov	 eax, DWORD PTR _ppdev$[ebp]
  00006	8b 88 24 18 00
	00		 mov	 ecx, DWORD PTR [eax+6180]
  0000c	89 4d 08	 mov	 DWORD PTR _Addr1616$[ebp], ecx

; 73   : 
; 74   :    // QT_Thunk will do all the fixups and pass control to
; 75   :    //   the 16:16 in edx.
; 76   :    _asm
; 77   :       {
; 78   :       push  DWORD PTR fpVidMemStart32

  0000f	ff 75 0c	 push	 DWORD PTR _fpVidMemStart32$[ebp]

; 79   :       push  DWORD PTR fpVidMemEnd32

  00012	ff 75 10	 push	 DWORD PTR _fpVidMemEnd32$[ebp]

; 80   :       push  DWORD PTR dwBlockSize

  00015	ff 75 14	 push	 DWORD PTR _dwBlockSize$[ebp]

; 81   :       mov   edx,Addr1616     ; QT_Thunk expects 16:16 proc addr in EDX

  00018	8b 55 08	 mov	 edx, DWORD PTR _Addr1616$[ebp]

; 82   :       sub   ebp,200h         ; QT_Thunk builds convoluted 16:16 stack frame

  0001b	81 ed 00 02 00
	00		 sub	 ebp, 512		; 00000200H

; 83   :       call  QT_Thunk

  00021	e8 00 00 00 00	 call	 _QT_Thunk

; 84   :       add   ebp,200h         ; QT_Thunk stack stuff

  00026	81 c5 00 02 00
	00		 add	 ebp, 512		; 00000200H

; 85   :       and   eax,0ffffh       ; mask off high word

  0002c	25 ff ff 00 00	 and	 eax, 65535		; 0000ffffH

; 86   :       }
; 87   : 
; 88   :     return;                  // return code in eax
; 89   : }

  00031	5d		 pop	 ebp
  00032	c3		 ret	 0
_mmEvict32 ENDP
_TEXT	ENDS
PUBLIC	_mmReclaim32
_TEXT	SEGMENT
_ppdev$ = 8
_fpVidMemAddr32$ = 12
_Addr1616$ = 8
_mmReclaim32 PROC NEAR

; 102  : {

  00040	55		 push	 ebp
  00041	8b ec		 mov	 ebp, esp

; 103  :    DWORD Addr1616;
; 104  : 
; 105  :    // Get 16:16 function address from shared data
; 106  :    Addr1616 = _FF(mmReclaimAddr);

  00043	8b 45 08	 mov	 eax, DWORD PTR _ppdev$[ebp]
  00046	8b 88 28 18 00
	00		 mov	 ecx, DWORD PTR [eax+6184]
  0004c	89 4d 08	 mov	 DWORD PTR _Addr1616$[ebp], ecx

; 107  : 
; 108  :    // QT_Thunk will do all the fixups and pass control to
; 109  :    //   the 16:16 in edx.
; 110  :    _asm
; 111  :       {
; 112  :       push  DWORD PTR fpVidMemAddr32   ; pass our parms

  0004f	ff 75 0c	 push	 DWORD PTR _fpVidMemAddr32$[ebp]

; 113  :       mov   edx,Addr1616     ; QT_Thunk expects 16:16 proc addr in EDX

  00052	8b 55 08	 mov	 edx, DWORD PTR _Addr1616$[ebp]

; 114  :       sub   ebp,200h         ; QT_Thunk builds convoluted 16:16 stack frame

  00055	81 ed 00 02 00
	00		 sub	 ebp, 512		; 00000200H

; 115  :       call  QT_Thunk

  0005b	e8 00 00 00 00	 call	 _QT_Thunk

; 116  :       add   ebp,200h         ; QT_Thunk stack stuff

  00060	81 c5 00 02 00
	00		 add	 ebp, 512		; 00000200H

; 117  :       and   eax,0ffffh       ; mask off high word

  00066	25 ff ff 00 00	 and	 eax, 65535		; 0000ffffH

; 118  :       }
; 119  : 
; 120  :     return;                  // return code in eax
; 121  : }

  0006b	5d		 pop	 ebp
  0006c	c3		 ret	 0
_mmReclaim32 ENDP
_TEXT	ENDS
END
