; 798  :                                         &(surfaceData->lfbPtr),
; 799  :                                         &(surfaceData->hwPtr),
; 800  :                                         &(surfaceData->lPitch),
; 801  :                                         &tileFlag,
; 802  :                                         &(surfaceData->heapID),
