; 743  : 
; 744  : #ifdef WINNT
; 745  : // For nt let MS manage memory
; 746  : // the nt ddraw.dll does export the DDHAL32_VidMemAlloc & DDHAL32_VidMemFree
; 747  : // functions but since under nt we aren't currently supporting 3D or a tiled
; 748  : // heap, there's really no point in using them
; 749  : // Actually we can't use the DDHAL32_??? functions directly because they are
; 750  : // in a ring 3 dll and we're at ring 0, in fact using them directly causes
; 751  : // our driver not to even load.
; 752  : 
; 753  : // We choose a 16 byte alignment to prevent problems on Banshee, at a small
; 754  : // cost in memory use. We used to align on DWORD boundaries, but this won't
; 755  : // work for clients like OpenGL
; 756  : 
; 757  : // BYTEALIGNMENT must be a power of 2 or the code won't work right!
; 758  : #define BYTEALIGNMENT   16  // 16 byte alignment
; 759  : 
; 760  : #define XALIGN(width)   (((width) + (BYTEALIGNMENT - 1)) & ~(BYTEALIGNMENT - 1))
; 761  : 
; 762  : #if USE_NT5_DDMEMMGR
