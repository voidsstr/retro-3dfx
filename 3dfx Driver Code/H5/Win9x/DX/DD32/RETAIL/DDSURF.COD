; 767  :       {
; 768  :         psurf_gbl->lPitch   = _DS(ddTilePitch);
; 769  :         surfaceData->lPitch = _DS(ddTilePitch);
; 770  :         surfaceData->hwPtr  = ppdev->ulScreenOffset | SSTG_IS_TILED;
; 771  :         DISPDBG((2, "Allocated primary ddraw surface (%lXh x %lXh) at fpVidMem = %8lXh, pitch = %8lXh, hwPtr = %8lXh",
; 772  :                     psurf_gbl->wWidth, psurf_gbl->wHeight, psurf_gbl->fpVidMem, psurf_gbl->lPitch, surfaceData->hwPtr));
; 773  :       }
; 774  :       else
; 775  : #endif // ENABLE_TILED_HEAP
; 776  :       {
; 777  :         //psurf_gbl->lPitch   = ppdev->lDelta;
; 778  :         surfaceData->lPitch = ppdev->lDelta;
; 779  :         surfaceData->hwPtr  = ppdev->ulScreenOffset;
; 780  :         DISPDBG((2, "Allocated primary ddraw surface (%lXh x %lXh) at fpVidMem = %08lXh, pitch = %08lXh",
; 781  :                     psurf_gbl->wWidth, psurf_gbl->wHeight, psurf_gbl->fpVidMem, psurf_gbl->lPitch));
; 782  :       }
; 783  :     }
; 784  :     else
; 785  :     {
; 786  :       // round pitch and blockSizeX up to at least a BYTEALIGNMENT boundary
; 787  :       // otherwise NT won't allocate it in video memory
; 788  :       psurf_gbl->lPitch = XALIGN(bWidth);
; 789  :       psurf_gbl->dwBlockSizeX = XALIGN(bWidth);
