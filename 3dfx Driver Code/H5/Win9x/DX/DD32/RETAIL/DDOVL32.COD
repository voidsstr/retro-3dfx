	00		 mov	 DWORD PTR [eax+250], edx

; 107  :   rOvlDst.top   = wOvlScrY;

  0008f	89 88 fe 00 00
	00		 mov	 DWORD PTR [eax+254], ecx

; 108  : 
; 109  :   // Fix for PRS 12592, we dec the overlay height by 1 move the bottom up by 1 line
; 110  :   // rVidDst.bottom-1;  jmccartney 09/06/00
; 111  :   //Overlay screen bottom, right
; 112  : #ifndef WINNT
; 113  :   wOvlScrEndX = min(rOvlDst.right, wDesktopW-1);

  00095	8b b8 02 01 00
	00		 mov	 edi, DWORD PTR [eax+258]
  0009b	4e		 dec	 esi
  0009c	3b fe		 cmp	 edi, esi
  0009e	7c 02		 jl	 SHORT $L37551
  000a0	8b fe		 mov	 edi, esi
$L37551:

; 114  :   wOvlScrEndY = min(rOvlDst.bottom-1, wDesktopH-1);

  000a2	8b 80 06 01 00
	00		 mov	 eax, DWORD PTR [eax+262]
  000a8	8d 75 ff	 lea	 esi, DWORD PTR [ebp-1]
  000ab	48		 dec	 eax
  000ac	3b c6		 cmp	 eax, esi
  000ae	5d		 pop	 ebp
  000af	7c 02		 jl	 SHORT $L37553
  000b1	8b c6		 mov	 eax, esi
$L37553:

; 115  : #else
; 116  :   wOvlScrEndX = (WORD)min(rOvlDst.right, wDesktopW-1);
; 117  :   wOvlScrEndY = (WORD)min(rOvlDst.bottom-1, wDesktopH-1);
; 118  : #endif
; 119  : 
; 120  :   //Set the overlay start and end x,y coordinates on the desktop
; 121  :   GETOVERLAYADDR(wOvlScrX, wOvlScrY, vidOverlayStartAddr );
; 122  :   GETOVERLAYADDR(wOvlScrEndX, wOvlScrEndY, vidOverlayEndAddr );
; 123  : 
; 124  :   SETDW(ghwIO->vidOverlayStartCoords, vidOverlayStartAddr);

  000b3	8b b3 78 1a 00
	00		 mov	 esi, DWORD PTR [ebx+6776]
  000b9	81 e1 ff 0f 00
	00		 and	 ecx, 4095		; 00000fffH
  000bf	c1 e1 0c	 shl	 ecx, 12			; 0000000cH
  000c2	81 e2 ff 0f 00
	00		 and	 edx, 4095		; 00000fffH
  000c8	0b ca		 or	 ecx, edx
  000ca	89 8e 9c 00 00
	00		 mov	 DWORD PTR [esi+156], ecx

; 125  :   SETDW(ghwIO->vidOverlayEndScreenCoord, vidOverlayEndAddr);

  000d0	25 ff 0f 00 00	 and	 eax, 4095		; 00000fffH
  000d5	c1 e0 0c	 shl	 eax, 12			; 0000000cH
  000d8	81 e7 ff 0f 00
	00		 and	 edi, 4095		; 00000fffH
  000de	0b c7		 or	 eax, edi
  000e0	89 86 a0 00 00
	00		 mov	 DWORD PTR [esi+160], eax

; 126  : 
; 127  :   psopd->ddRVal = DD_OK;

  000e6	8b 54 24 10	 mov	 edx, DWORD PTR _psopd$[esp+8]
  000ea	5f		 pop	 edi
  000eb	5e		 pop	 esi
  000ec	c7 42 14 00 00
	00 00		 mov	 DWORD PTR [edx+20], 0

; 128  :   return DDHAL_DRIVER_HANDLED;

  000f3	b8 01 00 00 00	 mov	 eax, 1
  000f8	5b		 pop	 ebx

; 129  : 
; 130  : } // SetOverlayPosition32

  000f9	c2 04 00	 ret	 4
