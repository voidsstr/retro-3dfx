  00059	8b cd		 mov	 ecx, ebp
$L37549:

; 98   : #else
; 99   :   wOvlScrX = (WORD)min(psopd->lXPos, wDesktopW);
; 100  :   wOvlScrY = (WORD)min(psopd->lYPos, wDesktopH);
; 101  : #endif
; 102  : 
; 103  :   //Save the new overlay coordinates in video destination rectangle struct
; 104  :   rOvlDst.right = wOvlScrX + rOvlDst.right - rOvlDst.left;

  0005b	8b 83 14 18 00
	00		 mov	 eax, DWORD PTR [ebx+6164]
