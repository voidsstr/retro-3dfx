_ddatoi	PROC NEAR

; 78   :    int i, n, sign;
; 79   : 
; 80   :    for( i=0; s[i] == ' ' || s[i] == '\n' || s[i] == '\t'; i++)

  00000	8b 54 24 04	 mov	 edx, DWORD PTR _s$[esp-4]
  00004	33 c9		 xor	 ecx, ecx
$L48682:
  00006	8a 04 11	 mov	 al, BYTE PTR [ecx+edx]
  00009	3c 20		 cmp	 al, 32			; 00000020H
  0000b	74 08		 je	 SHORT $L48683
  0000d	3c 0a		 cmp	 al, 10			; 0000000aH
  0000f	74 04		 je	 SHORT $L48683
  00011	3c 09		 cmp	 al, 9
  00013	75 03		 jne	 SHORT $L48684
