_TEXT	SEGMENT
_f$ = 8
_ddftol	PROC NEAR

; 116  :    long       expnt, mantissa;
; 117  :    BOOL       neg = FALSE;
; 118  : 
; 119  :    mantissa = expnt = *( long *) &f;
; 120  : 
; 121  :    // Special Case
; 122  :    if( mantissa == 0 )

  00070	8b 54 24 04	 mov	 edx, DWORD PTR _f$[esp-4]
  00074	56		 push	 esi
  00075	33 f6		 xor	 esi, esi
  00077	85 d2		 test	 edx, edx
  00079	75 04		 jne	 SHORT $L48703

; 123  :      return 0;

  0007b	33 c0		 xor	 eax, eax
  0007d	5e		 pop	 esi

; 157  : 
; 158  :    return mantissa;
; 159  : 
; 160  :    // return( (long) f );
; 161  : 
; 162  : }// ddftol

  0007e	c3		 ret	 0
$L48703:

; 124  : 
; 125  :    if( expnt & 0x80000000 )

  0007f	f7 c2 00 00 00
	80		 test	 edx, -2147483648	; 80000000H
  00085	74 05		 je	 SHORT $L48704

; 126  :      neg = TRUE;

  00087	be 01 00 00 00	 mov	 esi, 1
$L48704:

; 127  : 
; 128  :    // remove the exponent and add in implicit one
; 129  :    mantissa &= 0x007fffff;

  0008c	8b c2		 mov	 eax, edx

; 130  :    mantissa |= 0x00800000;
; 131  : 
; 132  :    // exponent - remove mantissa and adjust for bias
; 133  :    expnt &= 0x7F800000;
; 134  :    expnt >>= 23;
; 135  :    expnt -= 127;
; 136  : 
; 137  :    // shift by the exponent to get rid of the exponent. Need to use
; 138  :    // 23 - expnt because expnt is number of posistions to the left of
; 139  :    // decimal and we want to get rid of the posistions to the right of
; 140  :    // the decimal.
; 141  :    
; 142  : //   mantissa >>= (23 - expnt);
; 143  : //PingZ 8/5/99  The above line is wrong.  It only works if expnt is less than 23. If expnt is 
; 144  : //greater than 23 it will convert matissa to zero!
; 145  : //Here is the correct way to do it.
; 146  : 
; 147  :    expnt = 23 - expnt;

  0008e	c1 fa 17	 sar	 edx, 23			; 00000017H
  00091	81 e2 ff 00 00
	00		 and	 edx, 255		; 000000ffH
  00097	25 ff ff 7f 00	 and	 eax, 8388607		; 007fffffH
  0009c	b9 96 00 00 00	 mov	 ecx, 150		; 00000096H
  000a1	2b ca		 sub	 ecx, edx
  000a3	0d 00 00 80 00	 or	 eax, 8388608		; 00800000H

; 148  : 
; 149  :    if(expnt > 0) 

  000a8	85 c9		 test	 ecx, ecx
  000aa	7e 04		 jle	 SHORT $L48705

; 150  :       mantissa >>= expnt;

  000ac	d3 f8		 sar	 eax, cl

; 151  :    else

  000ae	eb 04		 jmp	 SHORT $L48706
$L48705:

; 152  :       mantissa <<= (-expnt);

  000b0	f7 d9		 neg	 ecx
  000b2	d3 e0		 shl	 eax, cl
$L48706:

; 153  : 
; 154  : 
; 155  :    if( neg )

  000b4	85 f6		 test	 esi, esi
  000b6	74 02		 je	 SHORT $L48698

; 156  :      mantissa = -mantissa;

  000b8	f7 d8		 neg	 eax
$L48698:
  000ba	5e		 pop	 esi

; 157  : 
; 158  :    return mantissa;
; 159  : 
; 160  :    // return( (long) f );
; 161  : 
; 162  : }// ddftol

  000bb	c3		 ret	 0
_ddftol	ENDP
_TEXT	ENDS
PUBLIC	_dddtol
_TEXT	SEGMENT
_f$ = 8
_dddtol	PROC NEAR

; 210  : 
; 211  :    return mantissa;

  000c0	8b 4c 24 04	 mov	 ecx, DWORD PTR _f$[esp-4]
  000c4	8b 54 24 08	 mov	 edx, DWORD PTR _f$[esp]
  000c8	56		 push	 esi
  000c9	33 f6		 xor	 esi, esi
  000cb	c1 e9 15	 shr	 ecx, 21			; 00000015H
  000ce	f7 c2 00 00 00
	80		 test	 edx, -2147483648	; 80000000H
  000d4	74 05		 je	 SHORT $L48719

; 175  :    long       expnt, mantissa;
; 176  :    DWORD      trails;
; 177  :    BOOL       neg = FALSE;
; 178  : 
; 179  :    trails = *( long *) &f;
; 180  :    trails &= 0xffe00000;
; 181  :    trails >>= 21;
; 182  :    mantissa = expnt = *(long *)(( long *)&f + 1);
; 183  : 
; 184  :    if( expnt & 0x80000000 )
; 185  :      neg = TRUE;

  000d6	be 01 00 00 00	 mov	 esi, 1
$L48719:

; 186  : 
; 187  :    // remove the exponent and add in implicit one
; 188  :    mantissa &= 0x000fffff;
; 189  :    mantissa |= 0x00100000;
; 190  : 
; 191  :    mantissa <<= 11;
; 192  :    mantissa |= trails;

  000db	8b c2		 mov	 eax, edx
  000dd	0d 00 00 f0 ff	 or	 eax, -1048576		; fff00000H
  000e2	c1 e0 0b	 shl	 eax, 11			; 0000000bH
  000e5	0b c1		 or	 eax, ecx

; 193  : 
; 194  :    // exponent - remove mantissa and adjust for bias
; 195  : 
; 196  :    expnt &= 0x7FF00000;
; 197  :    expnt >>= 20;
; 198  :    expnt -= 1023;
; 199  : 
; 200  :    expnt = 31 - expnt;

  000e7	c1 fa 14	 sar	 edx, 20			; 00000014H
  000ea	81 e2 ff 07 00
	00		 and	 edx, 2047		; 000007ffH
  000f0	b9 1e 04 00 00	 mov	 ecx, 1054		; 0000041eH
  000f5	2b ca		 sub	 ecx, edx

; 201  : 
; 202  :    if(expnt > 0) 

  000f7	85 c9		 test	 ecx, ecx
  000f9	7e 04		 jle	 SHORT $L48720

; 203  :       mantissa >>= expnt;

  000fb	d3 f8		 sar	 eax, cl

; 204  :    else

  000fd	eb 04		 jmp	 SHORT $L48721
$L48720:

; 205  :       mantissa <<= (-expnt);

  000ff	f7 d9		 neg	 ecx
  00101	d3 e0		 shl	 eax, cl
$L48721:

; 206  : 
; 207  : 
; 208  :    if( neg )

  00103	85 f6		 test	 esi, esi
  00105	5e		 pop	 esi
  00106	74 02		 je	 SHORT $L48722

; 209  :      mantissa = -mantissa;

  00108	f7 d8		 neg	 eax
$L48722:

; 212  : 
; 213  :    // return( (long) f );
; 214  : 
; 215  : }// dddftol

  0010a	c3		 ret	 0
_dddtol	ENDP
