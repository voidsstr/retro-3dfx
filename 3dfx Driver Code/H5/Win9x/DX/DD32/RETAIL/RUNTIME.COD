  00015	41		 inc	 ecx
  00016	eb ee		 jmp	 SHORT $L48682
$L48684:

; 81   :      ;
; 82   :      
; 83   :    sign = 1;
; 84   :    if (s[i] == '+' || s[i] == '-')

  00018	8a 04 11	 mov	 al, BYTE PTR [ecx+edx]
  0001b	3c 2b		 cmp	 al, 43			; 0000002bH
  0001d	56		 push	 esi
  0001e	be 01 00 00 00	 mov	 esi, 1
  00023	74 04		 je	 SHORT $L48687
  00025	3c 2d		 cmp	 al, 45			; 0000002dH
  00027	75 0f		 jne	 SHORT $L48923
$L48687:

; 85   :      sign = (s[i++] == '+') ? 1 : -1;

  00029	41		 inc	 ecx
  0002a	3c 2b		 cmp	 al, 43			; 0000002bH
  0002c	75 07		 jne	 SHORT $L48922
  0002e	be 01 00 00 00	 mov	 esi, 1
  00033	eb 03		 jmp	 SHORT $L48923
$L48922:
  00035	83 ce ff	 or	 esi, -1
$L48923:

; 86   :      
; 87   :    for (n = 0; s[i] >= '0' && s[i] <= '9'; i++)

  00038	03 d1		 add	 edx, ecx
  0003a	8a 0a		 mov	 cl, BYTE PTR [edx]
  0003c	33 c0		 xor	 eax, eax
  0003e	80 f9 30	 cmp	 cl, 48			; 00000030H
  00041	7c 17		 jl	 SHORT $L48690
$L48688:
  00043	80 f9 39	 cmp	 cl, 57			; 00000039H
  00046	7f 12		 jg	 SHORT $L48690

; 88   :      n = 10 * n + s[i] - '0';

  00048	0f be 0a	 movsx	 ecx, BYTE PTR [edx]
  0004b	8d 04 80	 lea	 eax, DWORD PTR [eax+eax*4]
  0004e	42		 inc	 edx
  0004f	8d 44 41 d0	 lea	 eax, DWORD PTR [ecx+eax*2-48]
  00053	8a 0a		 mov	 cl, BYTE PTR [edx]
  00055	80 f9 30	 cmp	 cl, 48			; 00000030H
  00058	7d e9		 jge	 SHORT $L48688
$L48690:

; 89   :      
; 90   :    return(sign * n);

  0005a	0f af c6	 imul	 eax, esi
  0005d	5e		 pop	 esi

; 91   : }// ddatoi

  0005e	c3		 ret	 0
_ddatoi	ENDP
