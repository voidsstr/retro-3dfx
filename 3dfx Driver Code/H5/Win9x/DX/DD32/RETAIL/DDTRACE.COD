PUBLIC	_ddDebugPrint
EXTRN	__imp__wvsprintfA@12:NEAR
EXTRN	__imp__OutputDebugStringA@4:NEAR
_TEXT	SEGMENT
_szFormat$ = 8
_buffer$ = -256
_ddDebugPrint PROC NEAR

; 91   :      char buffer[256];
; 92   : 
; 93   :      wvsprintf(buffer, szFormat, (LPVOID)(&szFormat+1));

  00000	8b 4c 24 04	 mov	 ecx, DWORD PTR _szFormat$[esp-4]
  00004	81 ec 00 01 00
	00		 sub	 esp, 256		; 00000100H
  0000a	8d 84 24 08 01
	00 00		 lea	 eax, DWORD PTR _szFormat$[esp+256]
  00011	50		 push	 eax
  00012	51		 push	 ecx
  00013	8d 54 24 08	 lea	 edx, DWORD PTR _buffer$[esp+264]
  00017	52		 push	 edx
  00018	ff 15 00 00 00
	00		 call	 DWORD PTR __imp__wvsprintfA@12

; 94   :      OutputDebugString(buffer);

  0001e	8d 44 24 00	 lea	 eax, DWORD PTR _buffer$[esp+256]
  00022	50		 push	 eax
  00023	ff 15 00 00 00
	00		 call	 DWORD PTR __imp__OutputDebugStringA@4

; 95   : }// ddDebugPrint

  00029	81 c4 00 01 00
	00		 add	 esp, 256		; 00000100H
  0002f	c3		 ret	 0
_ddDebugPrint ENDP
_TEXT	ENDS
