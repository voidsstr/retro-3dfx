#--------------------------------------------------------------------
# Define macros for the various compilers, assemblers, linkers
# and library managers.

!if exist($(COMP32)\..\common\msdev98\bin)
RC   = $(COMP32)\..\common\msdev98\bin\rc
!else
RC   = $(COMP32)\bin\rc
!endif
LK   = $(COMP32)\bin\link
CL   = $(COMP32)\bin\cl
ML   = $(MASM)\bin\ml
BSC  = $(COMP32)\bin\bscmake


#--------------------------------------------------------------------
# Select our working directory, either DEBUG or RETAIL.

!if "$(DEBUG)"=="debug"
DIR = DEBUG
!else
DIR = RETAIL
!endif

#--------------------------------------------------------------------
# Define 32Bit macros for DEBUG or RETAIL build.

!if "$(DEBUG)"=="debug"

    # Generic Debug build flags

COPT32 = -DDEBUG -D_DEBUG -DDEBLEVEL=1 -DBUILD_DDDDK -YX -Oxa -Z7 -DFXTRACE
MOPT32 = -DDEBUG -D_DEBUG
ROPT32 = -DDEBUG -D_DEBUG
LOPT32  = -debug -debugtype:cv

COPT16 = -DDEBUG -D_DEBUG -Z7i -DFXTRACE
MOPT16 = -DDEBUG -D_DEBUG
ROPT16 = -DDEBUG -D_DEBUG

    # Specific Debug build flags

!else

    # Generic Retail build flags

COPT32 = -Oxa

!ifdef SIW95
COPT32 = $(COPT32) -Z7
!endif

#STB-SK 12/21/98 -- add support for VTUNE profiling
#STB Begin Change
!if "$(VTUNE)" == "1"
COPT32 = $(COPT32) -Zi
!endif
#STB End Change

MOPT32 =
ROPT32 =
LOPT32 =

COPT16 =
MOPT16 =
ROPT16 =

    # Specific Retail build flags

!endif

#--------------------------------------------------------------------
# Define our 32 Bit build flag macros

CDEFS32  = $(TARGET) $(DXDEF) -D__MSC__ -DWRITECOMBINE -DDUAL_HEAP -D_X86_ -DIS_32 -DWIN32 -DDIRECTX
CINCS32  = -I..\..\inc -I..\..\dd32 -I..\..\d3d -I$(DDKDX)\inc -I$(DDK9X)\inc32 -I$(SDK32)\include -I$(COMP32)\include
!if "$(VC6)" == "1"
CFLAGS32 = $(LOGO) $(COPT32) $(CDEFS32) $(CINCS32) -G6s -FAsc -W3 -c -Zp $(BRDCFLAGS)
!else
CFLAGS32 = $(LOGO) $(COPT32) $(CDEFS32) $(CINCS32) -G5s -FAsc -W3 -c -Zp $(BRDCFLAGS)
!endif

#Set warnings as errors
CFLAGS32 = $(CFLAGS32) -WX

MDEFS32  = $(TARGET) $(DXDEF) -DWIN32 -DIS_32 -DSTD_CALL -DBLD_COFF -DMASM6 -D__MSC__
MINCS32  =
MFLAGS32 = $(LOGO) $(MOPT32) $(MDEFS32) $(MINCS32) -Zp4 -coff -W3 -WX -Zd -c -Cx $(BRDAFLAGS)

!if "$(PS)" == "1"
CFLAGS32 = $(CFLAGS32) -Gh
MDEFS32  = $(MDEFS32) -DPERF_MONITORING
!endif


RDEFS32  = -DIS_32 -DWIN32
RINCS32  = -I..\.. -I$(DDK9X)\inc16
RFLAGS32 = $(ROPT32) $(RDEFS32) $(RINCS32) -r $(BRDCFLAGS)

LINCS32  = -LIBPATH:..\..\d3d\$(DIR) -LIBPATH:$(DDKDX)\lib -LIBPATH:$(COMP32)\lib
LFLAGS32 = $(LOGO) $(LOPT32) $(LINCS32) -pdb:none -nodefaultlib -align:0x1000

#STB-SK 12/21/98 -- add support for VTUNE profiling
#STB Begin Change
!if "$(VTUNE)" == "1"
LFLAGS32 = $(LOGO) $(LOPT32) $(LINCS32) -debug -nodefaultlib -align:0x1000
!else
LFLAGS32 = $(LOGO) $(LOPT32) $(LINCS32) -pdb:none -nodefaultlib -align:0x1000
!endif
#STB End Change

!ifdef SIW95
LFLAGS32 = $(LFLAGS32) -debug -debugtype:cv
!endif

#skephart - enable browser file info
!if "$(BROWSE)"=="1" 
CFLAGS32 = $(CFLAGS32) -FR$(@B).sbr
MFLAGS32 = $(MFLAGS32) -FR$(@B).sbr
!endif

#####################################################################
#--------------------------------------------------------------------
# Lets build everything NOW !!!!


debug:  debug.mak

retail: retail.mak

all:    debug retail

debug.mak retail.mak:
        nmake -nologo DEBUG=$(@B) build

!ifdef SIW95
build:  makedir ddhwdir $(DLL32NAME) $(DLL32NAME).dll $(DLL32NAME).nms copy
!else
build:  makedir ddhwdir $(DLL32NAME) $(DLL32NAME).dll copy
!endif

makedir :
        if not exist .\$(DIR)\nul md .\$(DIR)
        @Echo -------Building $(DIR) DD32 Library----------
        @echo Target Hardware .......$(TRTXT)
        @echo Hardware revision .....$(HWREVTXT)
        @echo DirectX Version .......$(DXTXT)
        @echo Command Fifo ..........$(CFTXT)
        @echo Command Fifo Debug ....$(FDTXT)
        @echo Null Driver ...........$(NDTXT)
        @echo DD's Multi Monitor.....$(MULTI_MON)
        @echo Crash Test.............$(CRASHTXT)
        @echo AGP cmdfifo is ........$(AGPCMDFIFOECHO)
        @echo Antialiasing support...$(AATXT)
        @echo Num of Texture units...$(TUTXT)
        @echo K63DNow! optimization..$(K6TXT)
        @echo Performance monitoring.$(PSTXT)
        @echo Special MT modes ......$(SMTXT)
        @echo Win CSIM ..............$(WINSIM)
        @echo SLI AA   ..............$(SLI_STUFF)
        @echo SLI AA 2D..............$(SLI_2D_STUFF)
        @echo Read Abort Error  .....$(RD_STUFF)
	    @Echo SW TnL ................$(SW_TnLTXT)
		@Echo Vertex Buffer DDI......$(VERTBUFFTXT)
		@Echo Stereo glasses support.$(STEREO_STUFF)
                @Echo Z Access Optimization..$(Z_ACCESS_OPT_TXT)
        @Echo ---------------------------------------------

ddhwdir:
        cd .\$(DIR)

!if ("$(HP)" == "H5")
3dfx32vs :
    @Echo ----- Creating $(DIR) 3dfx32vs.dll -----
!elseif ("$(HP)" == "H4")
3dfx32v3 :
    @Echo ----- Creating $(DIR) 3dfx32v3.dll -----
!else
3dfx32vb :
    @Echo ----- Creating $(DIR) 3dfx32vb.dll -----
!endif


copy :
	cd ..\..
	if not exist .\bin\nul md .\bin
	cd bin
	if not exist .\$(DIR)\nul md .\$(DIR)
	cd $(DIR)
	copy ..\..\dd32\$(DIR)\$(DLL32NAME).dll $(DLL32NAME).dll

!ifdef SIW95
	copy ..\..\dd32\$(DIR)\$(DLL32NAME).nms $(DLL32NAME).nms
!endif # !ifdef SIW95
	cd ..\..\dd32\$(DIR)


!ifdef KILLHELP
        killhelp -k
!endif
!ifdef COPYSYS
!if "$(COPY32)" == "1"
        if exist $(COPYSYS) copy $(DLL32NAME).dll $(COPYSYS) /y
        if exist $(COPYSYS)\nul copy $(DLL32NAME).dll $(COPYSYS) /y
!endif
!endif

clean:
        rem <<yes
y
<<
        if exist .\debug\*.* del .\debug <yes >nul
        if exist .\debug\nul rd .\debug >nul
        if exist .\retail\*.* del .\retail <yes >nul
        if exist .\retail\nul rd .\retail >nul

#--------------------------------------------------------------------
# d3dhw.lib - Build if it hasn't been built already

D3DLIB = ..\..\d3d\$(DIR)\d3d.lib

$(D3DLIB):
	cd ..\..\d3d
	$(MAKE) $(LOGO) DEBUG=$(DEBUG) build
	cd ..\dd32\$(DIR)

