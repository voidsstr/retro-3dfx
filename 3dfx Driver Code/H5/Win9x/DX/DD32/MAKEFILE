#--------------------------------------------------------------------
# 3dfx32vb.dll - Build

COPT4 = -DMAPPL_MEMMAP_VXD -DPORTIO_DIRECT -DSST1_HW

$(DLL32NAME).dll:       $(DLL32NAME).res $(OBJ4) $(D3DLIB)
                        $(LK) $(LFLAGS32) @<<link.out
!ifdef ICC
-merge:.text1=.text
-merge:.data1=.data
!endif
-merge:.rdata=.text
-out:$(@F)
-map:$(@B).map
-base:0xbaa00000
-dll
-machine:i386
-subsystem:windows,4.0
-implib:$(@B).lib
-def:..\$(@B).def
$(LIB4) $(@B).res $(OBJ4)
<<KEEP

!if "$(BROWSE)"=="1" 
						$(BSC) /o$(@B).bsc $(SBR4)
!endif

!ifdef SIW95
$(DLL32NAME).nms: $(DLL32NAME).dll
    $(SIW95)\nmsym /source:..;..\..\d3d /prompt /trans:always,package $(DLL32NAME).dll
!endif

$(DLL32NAME).res:       ..\$(@B).rc
                        $(RC) $(RFLAGS32) -Fo$(@F) ..\$(@B).rc

ddfxs32.obj:            ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

ddmemmgr.obj:            ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

memmgr32.obj:           ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

ddinit32.obj:           ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

ddvpe32.obj:            ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

ddovl32.obj:            ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

i2cfx.obj:            	..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

ddblt32.obj:            ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

!if "$(SA)" == "1"
ddsliblt.obj:           ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

ddsli2d.obj:           ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c
!endif

ddtrace.obj:            ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

!IF "$(K6)" == "1"
k6_2.obj:               ..\$(@B).asm ..\k6common.inc
                        $(ML) $(MOPT32) $(MDEFS32) -Zp4 -Zm -coff -c -Cx -Fo$(@B).obj -Fl$(@B).lst ..\$(@B).asm
!endif

runtime.obj:            ..\$(@B).c
                        $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

#############################################################################
#  INFERENCE RULES
#
#
# Macro     Meaning
# $@        Current target's full name (path, base name, extension), as
#           currently specified.
# $$@       Current target's full name (path, base name, extension), as
#           currently specified. Valid only as a dependent in a dependency.
# $*        Current target's path and base name minus file extension.
# $**       All dependents of the current target.
# $?        All dependents with a later timestamp than the current target.
# $<        Dependent file with a later timestamp than the current target.
#           Valid only in commands in inference rules.
#
# To specify part of a predefined filename macro, append a macro modifier
# and enclose the modified macro in parentheses.
#
# Modifier  Resulting filename part
# D         Drive plus directory
# B         Base name
# F         Base name plus extension
# R         Drive plus directory plus base name

{..}.c.obj:
  $(CL) $(CFLAGS32) $(COPT4) -Fo$(@B).obj ..\$(@B).c

