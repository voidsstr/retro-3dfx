!endif
!else
LOGO =
!endif

!if "$(V3TV)" == "1"
TARGET = $(TARGET) -DV3TV
!endif

!if "$(CF)" == "1"
CFTXT = (cf=1) YES
TARGET = $(TARGET) -DCMDFIFO
!else
CFTXT = (cf=0) NO
!endif

!if "$(ND)" == "1"
NDTXT = (nd=1) YES
TARGET = $(TARGET) -DNULLDRIVER
!else
NDTXT = (nd=0) NO
!endif

!if ("$(HP)" == "h5")
HP=H5
!elseif ("$(HP)" == "h4")
HP=H4
!endif

!if ("$(HP)" == "H5")
TRTXT = H5 VSA
TARGET = $(TARGET) -DH5 -DNAPALM_CU
BRDCFLAGS = $(BRDCFLAGS) -DH5
!if "$(DLL32NAME)" == ""
DLL32NAME = 3dfx32vs
!endif
!elseif ("$(HP)" == "H4")
TRTXT = H4 Avenger
TARGET = $(TARGET) -DH4
BRDCFLAGS = $(BRDCFLAGS) -DH4
!if "$(DLL32NAME)" == ""
DLL32NAME = 3dfx32v3
!endif
!else
TRTXT = H3 Banshee
TARGET = $(TARGET) -DH3
BRDCFLAGS = $(BRDCFLAGS) -DH3
!if "$(DLL32NAME)" == ""
DLL32NAME = 3dfx32vb
!endif
!endif

!if ("$(TU)" == "")
TU=1
!endif
TUTXT = (tu=$(TU))
TARGET = $(TARGET)  -DNUMTEXTUREUNITS=$(TU)

!if "$(V3TV)" == "1"
TARGET = $(TARGET) -DV3TV
!endif

!if ("$(DF)" == "1")
FDTXT = (df=1) YES
TARGET = $(TARGET) -DDEBUGFIFO
!else
FDTXT = (df=0) NO
!endif

!if "$(CT)" == "1"
TARGET = $(TARGET) -DCRASH
CRASHTXT = (ct=1) YES
!else #!if "$(CT)" == "1"
CRASHTXT = (ct=0) NO
!endif #!if "$(CT)" == "1"

!if ("$(MULTIMON)" == "0")
MULTI_MON = (MULTIMON=0) NO
!else
MULTI_MON = (MULTIMON=1) YES
TARGET = $(TARGET) -DMM
!endif

!if ("$(HR)" == "B0")
TARGET = $(TARGET) -DH3_A2
HWREV = -DH3_B0
HWREVTXT = (hr=$(HR)) B0 (actually, building for A2)
!elseif ("$(HR)" == "") || ("$(HR)" == "A1")
TARGET = $(TARGET) -DH3_A1
HWREVTXT = A1
!else
TARGET = $(TARGET) -DH3_A2
HWREVTXT = A2
!endif

!if "$(ACF)" == "1"
TARGET = $(TARGET) -DAGP_CMDFIFO
AGPCMDFIFOECHO = (acf=1) ENABLED
!else #!if "$(ACF)" == "1"
AGPCMDFIFOECHO = (acf=0) DISABLED
!endif #!if "$(ACF)" == "1"

!if ("$(AA)" == "")
AATXT = (aa=1) YES
TARGET = $(TARGET) -DENABLE_AA=1
!elseif ("$(AA)" == "1")
AATXT = (aa=1) YES
TARGET = $(TARGET) -DENABLE_AA=1
!elseif ("$(AA)" == "2")
AATXT = (aa=2) YES
TARGET = $(TARGET) -DENABLE_AA=2
!else
AATXT = (aa=0) NO
!endif 

