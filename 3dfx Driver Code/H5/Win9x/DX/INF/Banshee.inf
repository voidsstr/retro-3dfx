;
; Voodoo Banshee(tm) Driver kit: 1.01.02
; Voodoo Banshee DirectX(r) Driver Version: 2.18
; Voodoo Banshee Win9x 2D/3D Display Drivers: 4.10.01.0239-1.00
; Voodoo Banshee Glide(tm) 2.X Driver: 2.60.00.0139
; Voodoo Banshee Glide 3.X Driver: 3.10.00.0139
; Voodoo Banshee Control Panel: 1.0.0.0041
;

[version]
Class=DISPLAY
signature="$CHICAGO$"
Provider=%Mfg%
SetupClass=BASE

[DestinationDirs]
DefaultDestDir   = 11    ; LDID_SYS
Redistrib.System = 11
Redistrib.System.Win95 = 11
Driver.System    = 11
Driver.Windows   = 10
Driver.Inf       = 17

[SourceDisksNames]
1="3Dfx Interactive Voodoo Banshee Windows 9x Install disk",,0

[SourceDisksFiles]
3dfx16vb.drv=1
3dfxvb.vxd=1
3dfx32vb.dll=1
glide2x.dll=1
glide2x.ovl=1
glide3x.dll=1
3DfxVBps.dll=1
3DfxVBps.hlp=1
msvcrt.dll=1
Banshee.inf=1
vgartd.vxd=1
3DfxSpl3.dll=1

[Manufacturer]
%Mfg%=Mfg

[Mfg]
%PCI\VEN_121A&DEV_0003&SUBSYS_0002121A.DeviceDesc.PCI%=Driver.Install.PCI,PCI\VEN_121A&DEV_0003&SUBSYS_0002121A ; PCI_SD
%PCI\VEN_121A&DEV_0003&SUBSYS_0004121A.DeviceDesc.PCI%=Driver.Install.PCI,PCI\VEN_121A&DEV_0003&SUBSYS_0004121A ; PCI_SG
%PCI\VEN_121A&DEV_0003&SUBSYS_0001121A.DeviceDesc%=Driver.Install,PCI\VEN_121A&DEV_0003&SUBSYS_0001121A ; AGP_SD
%PCI\VEN_121A&DEV_0003&SUBSYS_0003121A.DeviceDesc%=Driver.Install,PCI\VEN_121A&DEV_0003&SUBSYS_0003121A ; PCI_SG
%PCI\VEN_121A&DEV_0003&SUBSYS_0001121A.DeviceDesc.Win98%=Driver.Install.Win98,PCI\VEN_121A&DEV_0003&SUBSYS_0001121A ; AGP_SD
%PCI\VEN_121A&DEV_0003&SUBSYS_0003121A.DeviceDesc.Win98%=Driver.Install.Win98,PCI\VEN_121A&DEV_0003&SUBSYS_0003121A ; AGP_SG

[Driver.Install]
CopyFiles=Driver.System, Driver.Windows, Driver.Inf, Redistrib.System, Redistrib.System.Win95
CopyFiles=BansheeGS
DelReg=Prev.DelReg
AddReg=Driver.AddReg, Banshee.AddReg, vgartd.AddReg
Reboot

[Driver.Install.Win98]
CopyFiles=Driver.System, Driver.Windows, Driver.Inf, Redistrib.System
CopyFiles=BansheeGS
DelReg=Prev.DelReg
AddReg=Driver.AddReg, Banshee.AddReg
Reboot

[Driver.Install.PCI]
CopyFiles=Driver.System.PCI, Driver.Windows, Driver.Inf, Redistrib.System
CopyFiles=BansheeGS
DelReg=Prev.DelReg
AddReg=Driver.AddReg, Banshee.AddReg
Reboot

[DefaultUninstall]
DelReg=Banshee.DelReg, Banshee.AddReg, Driver.AddReg
DelFiles=Driver.System, Driver.Windows, Driver.Inf, BansheeGS
Reboot

