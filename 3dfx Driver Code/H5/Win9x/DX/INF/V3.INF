DelReg=Prev.DelReg
AddReg=Driver.AddReg, Voodoo3.AddReg, vgartd.AddReg 
Reboot 

;---- Copy sections ----
[Driver.System]
3dfx16v3.drv,,,%IN_USE%
3dfxv3.vxd,,,%IN_USE%
3dfx32v3.dll,,,%IN_USE%
glide2x.dll,,,%IN_USE%
glide3x.dll,,,%IN_USE%
3dfxSpl2.dll,,,%IN_USE%
3dfxSpl3.dll,,,%IN_USE%
