; INF file for 3dfx Interactive's Voodoo3 Win9x display driver
; Copyright 1999, 3dfx Interactive, Inc.
;
#if (_CUSTOMERNUMBER == 1)
; Release for Retail
#elif (_CUSTOMERNUMBER == 7)
; Release for Gateway
#elif (_CUSTOMERNUMBER == 8)
; Release for Compaq
#elif (_CUSTOMERNUMBER == 9)
; Release for Dell
#endif

[version]
LayoutFile=layout.inf
Class=DISPLAY
signature="$CHICAGO$"
Provider=%Mfg%
;SetupClass=BASE

[DestinationDirs]
DefaultDestDir   = 11		; WINDIR\SYSTEM
Redistrib.System = 11	    ; WINDIR\SYSTEM
Redistrib.System.Win95 = 11 ; WINDIR\SYSTEM
Driver.System    = 11		; WINDIR\SYSTEM
Driver.Windows   = 10		; WINDIR
Driver.Inf       = 17		; WINDIR\INF
Driver.Help      = 18		; WINDIR\HELP

[SourceDisksNames]
1="3dfx Interactive Voodoo3 Windows 9x Install disk",,0

[SourceDisksFiles]
3dfx16v3.drv=1
3dfxv3.vxd=1
3dfx32v3.dll=1
glide2x.dll=1
glide2x.ovl=1
glide3x.dll=1
Voodoo3.inf=1
vgartd.vxd=1
3dfxSpl2.dll=1
3dfxSpl3.dll=1
3dfxOGL.dll=1
#if (_CUSTOMERNUMBER == 9)
STBWTV16.DLL=1
CNVYR16.DLL=1
CNVYR32.DLL=1
#endif
	  
[Manufacturer]
%Mfg%=Mfg

#if (_CUSTOMERNUMBER == 7) // Gateway build - Their Subsystem Device ID is 10xx for add in card and 16xx for motherboard
[Mfg]                                                          ;  ASSY #     BUS  RAM  Speed    TV?     LCD? 
