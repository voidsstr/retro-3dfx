LIBRARY DISPLAY

DESCRIPTION 'Windows95 display driver'

EXETYPE WINDOWS

DATA PRELOAD MOVEABLE SINGLE
;;CODE PRELOAD MOVEABLE DISCARDABLE

;DATA PRELOAD FIXED SINGLE
;CODE PRELOAD FIXED

DATA PRELOAD FIXED SINGLE
CODE PRELOAD SHARED

HEAPSIZE 64

EXPORTS
    WEP
    ValidateMode
    BitBlt              @1
    ColorInfo           @2
    Control             @3
    Disable             @4
    Enable              @5
    EnumDFonts          @6
    EnumObj             @7
    Output              @8
    Pixel               @9
    RealizeObject       @10
    StrBlt              @11
    ScanLR              @12
;   DeviceMode          @13
    ExtTextOut          @14
    GetCharWidth        @15
    DeviceBitmap        @16
;   FastBorder          @17
    SetAttribute        @18
;    DibBlt              @19
    DeviceBitmapBits    @19
    CreateDIBitmap      @20
;    DibToDevice         @21
    SetDIBitsToDevice   @21
    SetPalette          @22
    GetPalette          @23
    SetPaletteTranslate @24
    GetPaletteTranslate @25
    UpdateColors        @26
    StretchBlt          @27
    StretchDIBits       @28
    SelectBitmap        @29
    BitmapBits          @30
    ReEnable            @31
    OEMGammaRamp        @32
    SaveScreenBitmap    @92

    Inquire             @101                    ;Mouse cursor stuff
    SetCursor           @102
    MoveCursor          @103
    CheckCursor         @104

IMPORTS     
    kernel.LoadLibraryEx32W     ;= KERNEL.513
    kernel.FreeLibrary32W       ;= KERNEL.514
    kernel.GetProcAddress32W    ;= KERNEL.515
    kernel._CallProcEx32W       ;= KERNEL.518

	



