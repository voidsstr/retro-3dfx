LOGO =
!endif

!if "$(V3TV)" == "1"
CFLAGS = $(CFLAGS) -DV3TV -Zi
!endif

!if "$(PN)" == "1"
COPT32 = $(COPT32) -DPERFNOP
PERFNOPECHO = (pn=1) ENABLED
!else #!if "$(PN)" == "1"
PERFNOPECHO = (pn=0) DISABLED
!endif #!if "$(PN)" == "1"

!if "$(ND)" == "1"
COPT32 = $(COPT32) -DNULLDRIVER
NULLDRIVEREHCO = (nd=1) ENABLED
!else #!if "$(ND)" == "1"
COPT32 = $(COPT32)
NULLDRIVEREHCO = (nd=0) DISABLED
!endif #!if "$(ND)" == "1"

!if "$(ACF)" == "1"
AGPCMDFIFOECHO = (acf=1) ENABLED
!else #!if "$(ACF)" == "1"
AGPCMDFIFOECHO = (acf=0) DISABLED
!endif #!if "$(ACF)" == "1"

!if "$(MMI)" == "1"
MMI_ECHO = (mmi=1) YES
!else
MMI_ECHO = (mmi=0) NO
!endif

!if "$(CF)" == "1"
CMDFIFOECHO = ON
!else #!if "$(CF)" == "1"
CMDFIFOECHO = OFF
!endif #!if "$(CF)" == "1"

!if "$(DF)" == "1"
DBGFIFOECHO = ON
!else
DBGFIFOECHO = OFF
!endif

!if "$(SSB)" == "1"
SSB_ECHO = (ssb=1) YES
!else
SSB_ECHO = (ssb=0) NO
!endif

!if "$(IFB)" == "1"
IFB_ECHO = (ifb=1) YES
!else
IFB_ECHO = (ifb=0) NO
!endif

!if "$(DDR)" == "1"
DDR_ECHO = (ddr=1) YES
!else
DDR_ECHO = (ddr=0) NO
!endif

!if "$(MT)" == "1"
MODE_ECHO = (mt=1) GLOP RESOLUTIONS
MODE_TYPE = -DGLOP
!else
MODE_ECHO = (mt=0) TOT RESOLUTIONS
MODE_TYPE = 
!endif

!if ("$(SW_TNL)" == "1")
DEFTARGET = $(DEFTARGET) -DTnL_HAL=1
!endif


HWREV = hwrev_undefined_is_an_error
HWREV_ECHO = hwrev_undefined_is_an_error

!if ("$(HR)" == "B0")
HWREV = -DH3_B0
HWREV_ECHO = (hr=$(HR)) B0
!elseif "$(HR)" == "A2"
HWREV = -DH3_A2
HWREV_ECHO = (hr=$(HR)) A2
!elseif "$(HR)" != "A0"
HWREV = -DH3_A1
HWREV_ECHO = (hr=$(HR)) A1
!else
HWREV = -DH3_A0
HWREV_ECHO = (hr=$(HR)) A0
!endif #!if "$(HR)" == "A2"

!if ("$(HP)" == "H5" || "$(HP)" == "h5")
DESCRIPTION = DIB Engine based 3Dfx VSA display driver
HWPRODUCT = -DH5 $(DEFTARGET)
HWPRODUCT_ECHO = (hp=$(HP)) VSA
!elseif ("$(HP)" == "H4" || "$(HP)" == "h4")
DESCRIPTION = DIB Engine based 3Dfx Voodoo3 display driver
HWPRODUCT = -DH4 $(DEFTARGET)
HWPRODUCT_ECHO = (hp=$(HP)) Voodoo3
!else
DESCRIPTION = DIB Engine based 3Dfx Banshee display driver
HWPRODUCT = -DH3 $(DEFTARGET)
HWPRODUCT_ECHO = (hp=$(HP)) Banshee
!endif

!if "$(WCS)" == "1"
WINSIM = (wcs=1) YES
!else
WINSIM = (wcs=0) NO
!endif

!if "$(SA)" == "1"
SLI_STUFF = (SA=1) YES
!else
SLI_STUFF = (SA=0) NO
!endif

!if "$(RA)" == "1"
RA_STUFF = (RA=1) YES
!else
RA_STUFF = (RA=0) NO
!endif

!if "$(RN)" == "1"
RN_STUFF = (RN=1) YES
!else
RN_STUFF = (RN=0) NO
!endif

!if "$(STEREO)" == "1"
STEREO_STUFF = (STEREO=1) YES
!else
STEREO_STUFF = (STEREO=0) NO
!endif

# DirectX version ...
!if ("$(DX)" == "")
DX = 6
!endif
DXTXT = (dx=$(DX))
DXDEF = -DDX=$(DX)


DRVNAME     = display

MY_CFLAGS = /DDEBUG /c /Zp /Zi /G3s /u /Oxat /AMnw 
DRVDEF  = display.def


