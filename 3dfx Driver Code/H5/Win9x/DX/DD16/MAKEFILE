## include common mini driver include file
!include ..\mini.mk

AFLAGS = $(AFLAGS) $(DXDEF)

# Treat warnings as errors
CFLAGS = $(CFLAGS) -WX

# Remove unwanted flags for h2inc
H2FLAGS=$(CFLAGS)
H2FLAGS=$(H2FLAGS:-Z7i=)
H2FLAGS=$(H2FLAGS:-Gf3s=)

h2inc:
#############################################################################
#
#   ALWAYS build all dependent INC Files (On every compile)
#
#############################################################################
HFILES:
        $(MASM)\bin\h2inc $(H2FLAGS) /Fa..\..\inc\shared.inc ..\..\inc\shared.h 
        $(MASM)\bin\h2inc $(H2FLAGS) /Fa..\..\inc\h3g.inc ..\..\inc\h3g.h 
        $(MASM)\bin\h2inc $(H2FLAGS) /Fa..\..\inc\h3gdefs.inc ..\..\inc\h3gdefs.h 
        $(MASM)\bin\h2inc $(H2FLAGS) /Fa..\..\inc\h3regs.inc ..\..\inc\h3regs.h 

echo_target:
    @echo ----------------------------------------------------
    @echo Target hardware revision .. $(HWREV_ECHO)
    @echo Target hardware product ... $(HWPRODUCT_ECHO)
    @echo Save Screen Bitmap ........ $(SSB_ECHO)
    @echo Memory Integrity Check .... $(MMI_ECHO)
    @echo Infinite Frame Buffer ..... $(IFB_ECHO)
    @echo Command Fifo .............. $(CMDFIFOECHO)
    @echo Debug Fifo ................ $(DBGFIFOECHO)
    @echo Give DD Refresh Rates...... $(DDR_ECHO)
    @echo NULL Driver testing is .... $(NULLDRIVEREHCO)
    @echo Perf NOP command is ....... $(PERFNOPECHO)
    @Echo AGP command fifo is ....... $(AGPCMDFIFOECHO)
    @Echo Mode Type is        ....... $(MODE_ECHO)
    @Echo Win CSIM  ................. $(WINSIM)
    @Echo SLI AA  ................... $(SLI_STUFF)
    @Echo Read Abort Error  ......... $(RA_STUFF)
    @Echo Real Networks   ........... $(RN_STUFF)
    @Echo Stereo glasses support..... $(STEREO_STUFF)
    @echo ( Remember to disable MMI and IFB for retail build )
    @echo ----------------------------------------------------

all: debug retail 

