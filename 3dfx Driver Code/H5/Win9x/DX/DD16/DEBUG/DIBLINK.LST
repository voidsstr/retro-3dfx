 009B				__aNulmul:
 009B  CC			        int 3

				;*----------------------------------------------------------------------
				;Function name:  hook_int2f
				;
				;Description:    hook INT 2f so we know when the SysVM is background.
				;
				;Information:
				;
				;Return:         VOID
				;----------------------------------------------------------------------*
				        assume ds:nothing
				        assume es:nothing
				public hook_int2f
 009C				hook_int2f proc far

 009C  B8 4000			        mov     ax,4000h  ;  STOP_IO_TRAP
 009F  CD 2F			        int     2Fh

 00A1  1E			        push    ds
 00A2  B8 ---- R		        mov     ax,_DATA
 00A5  8E D8			        mov     ds,ax
				        assume  ds:_DATA

 00A7  66| 83 3E 0010 R		        cmp     [next_int2f],0
       00
 00AD  75 1C			        jnz     hook_int2f_exit

 00AF  B8 352F			        mov     ax, 352Fh                       ; get interrupt vector
 00B2  CD 21			        int     21h                             ; get the current vector in ES:BX
 00B4  8C 06 0012 R		        mov     word ptr next_int2f[2], es
 00B8  89 1E 0010 R		        mov     word ptr next_int2f[0], bx

 00BC  BA 00F7 R		        mov     dx, offset int_2f               ; ax:dx -> int 2f handler
 00BF  B8 ---- R		        mov     ax, seg int_2f
 00C2  1E			        push    ds                              ; save ds
 00C3  8E D8			        mov     ds, ax                          ; ds:dx -> int 2f handler
 00C5  B8 252F			        mov     ax, 252Fh                       ; set interrupt vector
 00C8  CD 21			        int     21h                             ; set the new vector
 00CA  1F			        pop     ds                              ; restore ds

 00CB				hook_int2f_exit:
 00CB  1F			        pop     ds
 00CC  CB			        retf

 00CD				hook_int2f endp


				;*----------------------------------------------------------------------
				;Function name:  unhook_int2f
				;
				;Description:    unhook previously hooked INT 2f.
				;
				;Information:
				;
				;Return:         VOID
				;----------------------------------------------------------------------*
				        assume ds:nothing
				        assume es:nothing

				public unhook_int2f
 00CD				unhook_int2f proc far

 00CD  B8 4007			        mov     ax,4007h ; START_IO_TRAP
 00D0  CD 2F			        int     2Fh

 00D2  1E			        push    ds
 00D3  B8 ---- R		        mov     ax,_DATA
 00D6  8E D8			        mov     ds,ax
				        assume  ds:_DATA

 00D8  66| 83 3E 0010 R		        cmp     [next_int2f],0
       00
 00DE  74 15			        jz      unhook_int2f_exit

 00E0  33 C0			        xor     ax,ax
 00E2  33 D2			        xor     dx,dx
 00E4  87 06 0012 R		        xchg    ax,word ptr next_int2f[2]      ; ax:dx -> int 2f handler
 00E8  87 16 0010 R		        xchg    dx,word ptr next_int2f[0]

 00EC  1E			        push    ds                              ; save ds
 00ED  8E D8			        mov     ds, ax                          ; ds:dx -> int 2f handler
 00EF  B8 252F			        mov     ax, 252Fh                       ; set interrupt vector
 00F2  CD 21			        int     21h                             ; set the new vector
 00F4  1F			        pop     ds                              ; restore ds

 00F5				unhook_int2f_exit:
 00F5  1F			        pop     ds
 00F6  CB			        retf

 00F7				unhook_int2f endp


				;*----------------------------------------------------------------------
				;Function name:  int_2f
				;
				;Description:    handle the INT 2f.
				;
				;Information:
				;
				;Return:         VOID
				;----------------------------------------------------------------------*
				        assume ds:nothing
				        assume es:nothing

 00F7				int_2f proc far
 00F7  66| 50			        push    eax                         ; +34 make retf frame
 00F9  1E			        push    ds                          ; +32 save this
 00FA  66| 60			        pushad                              ; +0  and these

 00FC  BB ---- R		        mov     bx,_DATA
 00FF  8E DB			        mov     ds,bx
				        assume  ds:_DATA

 0101  8B DC			        mov     bx,sp                       ; ss:bx -> pushad, ds, retf, iret
 0103  66| 8B 0E 0010 R		        mov     ecx,[next_int2f]            ; get next handler
 0108  66| 36: 89 4F 22		        mov     ss:[bx+34],ecx              ; setup so we retf to it.

				;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;
				;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;
 010D  3D 4001			        cmp     ax,4001h
 0110  74 10			        je      background

 0112  3D 4002			        cmp     ax,4002h
 0115  74 02			        je      foreground
				        
 0117  EB 10			        jmp     int_2f_exit

				;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;
				;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;
 0119				foreground:
 0119  06			        push    es
 011A  9A ---- 0000 E		        call    ToForeground
 011F  07			        pop     es
 0120  EB 07			        jmp     int_2f_exit

				;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;
				;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;
 0122				background:
 0122  06			        push    es
 0123  9A ---- 0000 E		        call    ToBackground
 0128  07			        pop     es

				;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;
				;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;
 0129				int_2f_exit:
 0129  66| 61			        popad
 012B  1F			        pop     ds
 012C  CB			        retf

 012D				int_2f endp


				;*----------------------------------------------------------------------
				;Function name:  LibEntry
				;
				;Description:    Called when DLL is loaded.
				;
				;Information:
				; Entry:
				;       CX    = size of heap
				;       DI    = module handle
				;       DS    = automatic data segment
				;       ES:SI = address of command line (not used)
				; Registers Preserved:
				;       SI,DI,DS,BP
				; Registers Destroyed:
				;       AX,BX,CX,DX,ES,FLAGS
				; Calls:
				;       None
				; History:
				;
				;       06-27-89 -by-  Todd Laney [ToddLa]
				;       Created.
				;
				;Return:         AX     TRUE  if success or,
				;                       FALSE if error
				;----------------------------------------------------------------------*
				        assume ds:_DATA
				        assume es:nothing
				        extern  GlobalSmartPageLock:far

 012D				LibEntry:
 012D  E3 09			        jcxz    @f
 012F  66| 6A 00		        pushd   0
 0132  51			        push    cx
 0133  9A ---- 0000 E		        call    LocalInit
 0138				@@:
 0138  57			        push    di
 0139  9A ---- 0000 E		        call    GetExePtr
 013E  A3 0000 E		        mov     [_hModule],ax

 0141  68 ---- R		        push    _TEXT
 0144  9A ---- 0000 E		        call    GlobalSmartPageLock
 0149  68 ---- R		        push    _DATA
 014C  9A ---- 0000 E		        call    GlobalSmartPageLock

 0151  B8 0001			        mov     ax,1
 0154  CB			        retf


				;*----------------------------------------------------------------------
				;Function name:  WEP
				;
				;Description:    Called when the DLL is unloaded.  It is passed 1 WORD
				;                parameter that is TRUE if the system is going down,
				;                or zero if the app is.
				;
				;Information:
				;
				;Return:         AX = 1 is always returned 
				;----------------------------------------------------------------------*
				        assume ds:nothing
				        assume es:nothing

				public  WEP
 0155				WEP     proc far
 0155  55			        push    bp      
 0156  8B EC			        mov     bp, sp
 0158  8B 46 06			        mov     ax, [bp+6]
 015B  0B C0			        or      ax, ax
 015D  74 04			        jz      short SkipUnhook
 015F  0E E8 FF6A		        call    unhook_int2f
 0163				SkipUnhook:
 0163  B8 0001			        mov     ax,1
 0166  5D			        pop     bp
 0167  CA 0002			        retf    2

 016A				WEP     endp

 016A				_TEXT ends

				        end     LibEntry
