				;----------------------------------------------------------------------------
				;----------------------------------------------------------------------------
 0000				_TEXT   SEGMENT  WORD USE16 PUBLIC 'CODE'
 0000				_TEXT   ENDS
 0000				_DATA   SEGMENT  WORD USE16 PUBLIC 'DATA'
 0000				_DATA   ENDS
 0000				CONST   SEGMENT  WORD USE16 PUBLIC 'CONST'
 0000				CONST   ENDS
 0000				_BSS    SEGMENT  WORD USE16 PUBLIC 'BSS'
 0000				_BSS    ENDS
				DGROUP  GROUP   CONST, _BSS, _DATA
				        ASSUME DS: DGROUP
				        ASSUME SS: NOTHING
				;----------------------------------------------------------------------------

				;----------------------------------------------------------------------------
				; MACROS
				;----------------------------------------------------------------------------

				;----------------------------------------------------------------------------
				DIBLINK macro name,target,extra
				;----------------------------------------------------------------------------
				extrn target:FAR
				public name
				name:
				ifnb <extra>
				        mov     ax,_DATA
				        mov     es,ax
				        pop     ecx
				        push    es:[extra]
				        push    ecx
				endif
				        jmp     target
				        endm

				;----------------------------------------------------------------------------
				; D A T A
				;----------------------------------------------------------------------------
 0000				_DATA segment WORD PUBLIC 'DATA' use16

				        ; every windows DLL must has 16 bytes reserved for kernel
 0000  0010 [			resptr  db      16 dup(0)
        00
       ]

				IFDEF GBLDATA_IN_PDEV
				ELSE
				        ; our PDevice
				        extrn _DriverData:DWORD
 = _DriverData			        lpDriverPDevice equ _DriverData
				ENDIF

				        ; our hModule
				        extrn _hModule:WORD


				        extrn _Palettized:FAR             ; Palettized Flag (H3.C)

 0010 00000000			next_int2f      dd      0


 0014				_DATA ends

