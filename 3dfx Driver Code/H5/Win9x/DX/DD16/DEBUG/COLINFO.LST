				;*----------------------------------------------------------------------
				;Function name:  ColorInfo
				;
				;Description:    Converts a logical color (an RGB value) to a physical
				;                color (a physical color value) or converts a physical
				;                to a logical color, depending on the value of the
				;                lpPColor parameter.  Every graphics device driver must
				;                export a ColorInfo function.
				;
				;Information:
				; COLORREF ColorInfo( LPPDEVICE lpDestDev, 
				;                     DWORD     dwColorin, 
				;                     LPPCOLOR  lpPColor);
				; 
				; lpDestDev
				;     Address of a PDEVICE or PBITMAP structure that specifies the
				;     destination device or bitmap.
				; 
				; dwColorin
				;     A logical or physical color, depending on the value of lpPColor
				;     parameter.
				; 
				; lpPColor
				;     Address of a PCOLOR structure or is NULL.  If lpPColor points to a
				;     PCOLOR structure, the function assumes that dwColorin specifies a
				;     logical color (an RGB value) and copies the physical color value
				;     that most closely matches the logical color to this structure.  If
				;     lpPColor is NULL, the function assumes that dwColorin specifies a
				;     physical color and returns the logical color that matches the
				;     physical color.
				; 
				; The export ordinal for this function is 2.  When converting a
				; logical color, ColorInfo chooses the best possible physical color to
				; match the logical color and returns the RGB color value that
				; corresponds to this physical color.  GDI uses the physical colors
				; returned by ColorInfo to set text colors, background colors, and
				; pixel colors using the Pixel function.  If dwColorin is a logical
				; color, it may specify either an RGB value or a color index.  If
				; dwColorin specifies a color index (high-order byte is 0xFF),
				; ColorInfo should return the index without carrying out a conversion.
				; If dwColorin is a physical color, ColorInfo should return an RGB
				; value only for static colors and return color indices for all other
				; colors.  If GDI receives a color index from ColorInfo, it uses other
				; functions to determine the corresponding logical color.
				; 
				;
				;Return:         Returns the logical color (RGB value) that most
				;                closely matches the physical color either specified
				;                by dwColorin or copied to the PCOLOR structure pointed
				;                to by lpPColor.
				;----------------------------------------------------------------------*

 0260				ColorInfo PROC FAR PASCAL PUBLIC,
				         lpDestDev:DWORD, 
				         dwColorin:DWORD, 
				         lpPColor:DWORD

 0263  66| 8B 46 0A		         mov         EAX, dwColorin    ; quick check for black or white
 0267  66| 25 00FFFFFF		         and         EAX, 0FFFFFFh
 026D  75 18			         jne short   Color_003
				         ; Black falls through
 026F  83 7E 08 00		         cmp         word ptr lpPColor+2, 0 ; check for NULL lpPColor
 0273  74 0C			         je short    Color_001
 0275  C4 5E 06			         les         BX, lpPColor
 0278  26: C7 47 02 4000	         mov         word ptr ES:[BX+2], 4000h ; returning 040000000 like DIB ENGINE
 027E  26: 89 07		         mov         ES:[BX], AX     ; AX = 0, so we can use it here
 0281				Color_001:
 0281  33 D2			         xor         DX, DX            ; for physical to logical return 
				         ret
				         
				         ; now check for white
 0287				Color_003:
 0287  66| 3D 00FFFFFF		         cmp         EAX, 0FFFFFFh     ; white check
 028D  75 1B			         jne short   Color_005
 028F  83 7E 08 00		         cmp         word ptr lpPColor+2, 0 ; check for NULL lpPColor
 0293  74 0E			         je short    Color_004
 0295  C4 5E 06			         les         BX, lpPColor
 0298  26: C7 47 02 40FF	         mov         word ptr ES:[BX+2], 40FFh ; returning 40FFFFFF like DIB ENGINE
 029E  26: C7 07 FFFF		         mov         word ptr ES:[BX], 0FFFFh ; AX = 0, so we can use it here
 02A3				Color_004:
 02A3  BA 00FF			         mov         DX, 0FFh          ; for physical to logical return
				         ret

 02AA				Color_005:
 02AA  C4 5E 0E			         les         BX, lpDestDev
 02AD  26: 8A 4F 09		         mov         CL, ES:[BX].deBitsPixel

 02B1  83 7E 08 00		         cmp         WORD PTR lpPColor+2,0
 02B5  74 28			         je short    PhysicalToLogical

 02B7  80 F9 10			         cmp         cl, 16
 02BA  0F 84 00A9		         je          LogicalToPhysical16
 02BE  80 F9 01         cmp         cl, 1
 02C1  74 3F			         je short    LogicalToPhysicalMono
 02C3  80 F9 20			         cmp         cl, 32
 02C6  0F 84 0209		         je          LogicalToPhysical32

 02CA  66| FF 76 0E		         push        lpDestDev
 02CE  66| FF 76 0A		         push        dwColorin
 02D2  66| FF 76 06		         push        lpPColor
 02D6  9A ---- 0000 E		         call        DIB_ColorInfo
				         ret

 02DF				PhysicalToLogical:

 02DF  80 F9 10			         cmp         cl, 16
 02E2  0F 84 018B		         je          PhysicalToLogical16
 02E6  80 F9 20			         cmp         cl, 32
 02E9  0F 84 0203		         je          PhysicalToLogical32

 02ED  66| FF 76 0E		         push        lpDestDev
 02F1  66| FF 76 0A		         push        dwColorin
 02F5  66| FF 76 06		         push        lpPColor
 02F9  9A ---- 0000 E		         call        DIB_ColorInfo
				         ret

 0302				LogicalToPhysicalMono:

 0302  66| 3D 00C0C0C0		         cmp         eax, 0C0C0C0h
 0308  74 48			         jz          monowhite
 030A  66| 3D 00E1E1E1		         cmp         eax, 0E1E1E1h
 0310  74 40			         jz          monowhite
 0312  66| 3D 00919191		         cmp         eax, 0919191h
 0318  74 38			         jz          monowhite
 031A  66| 3D 00FF00FF		         cmp         eax, 0FF00FFh
 0320  74 30			         jz          monowhite
 0322  66| 3D 00FF0000		         cmp         eax, 0FF0000h
 0328  74 15			         jz          monoblack

 032A  66| FF 76 0E		         push        lpDestDev
 032E  66| FF 76 0A		         push        dwColorin
 0332  66| FF 76 06		         push        lpPColor
 0336  9A ---- 0000 E		         call        DIB_ColorInfo
				         ret

 033F				monoblack:

 033F  C4 5E 06			         les         bx, lpPColor
 0342  66| 26: C7 07		         mov         DWORD PTR es:[bx], 80000000h
       80000000
 034A  33 C0			         xor         ax, ax
 034C  33 D2			         xor         dx, dx
				         ret

 0352				monowhite:

 0352  C4 5E 06			         les         bx, lpPColor
 0355  66| 26: C7 07		         mov         DWORD PTR es:[bx], 81000001h
       81000001
 035D  B8 FFFF			         mov         ax, 0FFFFh
 0360  BA 00FF			         mov         dx, 0FFh
				         ret

 0367				LogicalToPhysical16:

 0367  26: F7 47 1C 0040	         test        es:[bx].deFlags, FIVE6FIVE
 036D  0F 85 0080		         jne         LogicalToPhysical16_565

 0371				LogicalToPhysical16_555:

 0371  66| 3D 00C0C0C0		         cmp         eax, 0C0C0C0h
 0377  74 54			         je          LtoP16_C0_555

 0379  66| 3D 00808080		         cmp         eax, 0808080h
 037F  74 5E			         je          LtoP16_80_555

				         ; NOTE: Logical color is passed in as XBGR format... Blue Green Red

 0381  66| 8B D8		         mov         ebx, eax
 0384  66| C1 EB 10		         shr         ebx, 16
 0388  66| 33 C9		         xor         ecx, ecx
 038B  8B D3			         mov         dx, bx
 038D  2E: 8A 8F 0000 R		         mov         cl, BYTE PTR CS:[OFFSET ByteTo5BitLookup + bx]
 0392  57			         push        di
 0393  0F B6 F9			         movzx       di, cl
 0396  2E: 8A 95 0200 R		         mov         dl, BYTE PTR CS:[OFFSET PhysLog15BitLookup + di]
 039B  8A D8			         mov         bl, al
 039D  2E: 8A AF 0000 R		         mov         ch, BYTE PTR CS:[OFFSET ByteTo5BitLookup + bx]
 03A2  0F B6 FD			         movzx       di, ch
