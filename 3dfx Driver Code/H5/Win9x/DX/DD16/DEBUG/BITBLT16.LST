			      C 				;   (used to space out a font)
 0018  00000000		      C   LbkColor	dd	0	;Logical background color		    ;*/ unsigned long int LbkColor;   /*
 001C  00000000		      C   LTextColor	dd	0	;Logical Text (forground) color 	    ;*/ unsigned long int LTextColor; /*
 0020  00000000		      C   ICMCXform	dd	0	;Transform for DIC image color matcher	    ;*/ DWORD		  ICMCXform;  /*
