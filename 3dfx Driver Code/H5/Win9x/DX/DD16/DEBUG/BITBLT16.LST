       0007 0001 0007
       0007 0003
 01A0  0007 0007 0007				dw 7, 7, 7, 7, 7, 7, 7, 7               ; D0h
       0007 0007 0007
       0007 0007
 01B0  0007 0007 0007				dw 7, 7, 7, 7, 7, 5, 7, 7
       0007 0007 0005
       0007 0007
 01C0  0007 0007 0007				dw 7, 7, 7, 7, 7, 7, 7, 7               ; E0h
       0007 0007 0007
       0007 0007
