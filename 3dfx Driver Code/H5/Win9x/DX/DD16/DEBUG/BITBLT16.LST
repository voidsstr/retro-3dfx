				; **********************************************************************
				;  Table of rops
				;  Bit 0 : blt uses source
				;  Bit 1 : blt uses pattern
				;  Bit 2 : blt uses destination
				;  Bits 8-15 : Rop code to use when doing pattern blt
				; **********************************************************************
				                      
				ifdef PERF_NEW16BITBLT
				    
 = 0001				USES_SRC    EQU 1
 = 0002				USES_PAT    EQU 2
 = 0004				USES_DEST   EQU 4
				                      
				align 2

