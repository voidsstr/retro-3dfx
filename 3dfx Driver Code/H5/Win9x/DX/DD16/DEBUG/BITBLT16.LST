 0008  00000000		      C   TextColor	dd	0	;Physical text (forground) color	    ;*/ unsigned long int TextColor;  /*
 000C  0000		      C   TBreakExtra	dw	0	; total pixles to stuff into a line	    ;*/ short int	  TBreakExtra;/*
 000E  0000		      C   BreakExtra	dw	0	; div(TBreakExtra, BreakCount)		    ;*/ short int	  BreakExtra; /*
 0010  0000		      C   BreakErr	dw	0	; running error term			    ;*/ short int	  BreakErr;   /*
 0012  0000		      C   BreakRem	dw	0	; mod(TBreakExtra, BreakCount)		    ;*/ short int	  BreakRem;   /*
 0014  0000		      C   BreakCount	dw	0	; count of breaks in the line		    ;*/ short int	  BreakCount; /*
