				endif ; PERF_NEW16BITBLT

 0204				_DATA   ENDS

				        EXTRN _lpDriverData:FAR PTR
				        EXTRN _lph3IORegs:DWORD
				        EXTRN _h3READ:FAR
				        EXTRN wFlatDataSel:WORD


				.586p
				.MMX


 0000				_TEXT   SEGMENT WORD PUBLIC 'CODE' USE16 

				;********************
				; EXTERN PROTOTYPES
				;********************

				DIB_BitBlt          PROTO   FAR PASCAL
				ifdef PERF_NEW16BITBLT
				_InsertBitmapIntoCache  PROTO   FAR PASCAL
				endif

				IFDEF STB_16BIT_BITBLT
				BitBltC             PROTO   FAR PASCAL
				ENDIF

				IFDEF STBPERF_CMBITBLT
				        extern  _EvictBmp:FAR
				ENDIF

				IFNDEF SKIP_STAGE2
				ENDIF

				IFDEF PERF_NEW16BITBLT
				   BANSHEE_SYNC MACRO
				           local   DoRead, SkipRead
				           mov     ax, _DATA
				           mov     ds, ax
				           push    ds
				           lds     si, _lpDriverData ; Global Data
				           lds     si, DWORD PTR [si]         ; Dib Engine of Main Device
				           test    BYTE PTR [si+1Ch], BUSY  ; Is Device Busy
				           pop     ds
				           jnz     short SkipRead
				           push    ebx
				           push    esi
				           mov     esi, _lph3IORegs
				           mov     bx, wFlatDataSel
				           mov     ds, bx
				   DoRead:
				           mov     ebx, [esi]
				           test    bh, 2
				           jnz     short DoRead
				           pop     esi
				           pop     ebx
				   SkipRead:
				   ENDM
				ENDIF ; PERF_NEW16BITBLT

				;**************************
				; BitBlt
				;
				; Handles BitBlt calls
				;
				;**************************


				; Prepare equates for locals
 = (dword ptr [RBP-(NEXTLOC	COLOR       equ     (dword ptr [RBP-(NEXTLOC+00)])
   +00)])
 = (dword ptr [RBP-(NEXTLOC	DSTSIZE     equ     (dword ptr [RBP-(NEXTLOC+04)])
   +04)])
 = (dword ptr [RBP-(NEXTLOC	DSTXY       equ     (dword ptr [RBP-(NEXTLOC+08)])
   +08)])
				ifdef PERF_NEW16BITBLT

 = (dword ptr [RBP-(NEXTLOC	COMMANDREG  equ     (dword ptr [RBP-(NEXTLOC+12)])
   +12)])
 = (dword ptr [RBP-(NEXTLOC	DIBDELTASCAN equ    (dword ptr [RBP-(NEXTLOC+16)])
   +16)])
 = (fword ptr [RBP-(NEXTLOC	DIBSYSADDR  equ     (fword ptr [RBP-(NEXTLOC+22)])
   +22)])
 = (word ptr [RBP-(NEXTLOC+	CURRENTROPFLAGS equ (word ptr [RBP-(NEXTLOC+24)])
   24)])
 = (word ptr [RBP-(NEXTLOC+	XCOUNTER    equ     (word ptr [RBP-(NEXTLOC+26)])
   26)])
 = (word ptr [RBP-(NEXTLOC+	YCOUNTER    equ     (word ptr [RBP-(NEXTLOC+28)])
   28)])
 = 0052				LOCALS      equ     NEXTLOC+30
				else
				endif

				; Prepare equates for parameters
 = 0006				PBASE   equ     6       ; (far return CS:IP + BP)

 = (DWORD  PTR [RBP+(PBASE+	lpDestDev   EQU (DWORD  PTR [RBP+(PBASE+28)])       ;--> to dest bitmap descriptor
   28)])
 = (WORD   PTR [RBP+(PBASE+	wDestX      EQU (WORD   PTR [RBP+(PBASE+26)])       ;Destination origin - x coordinate
   26)])
 = (WORD   PTR [RBP+(PBASE+	wDestY      EQU (WORD   PTR [RBP+(PBASE+24)])       ;Destination origin - y coordinate
   24)])
 = (DWORD  PTR [RBP+(PBASE+	lpSrcDev    EQU (DWORD  PTR [RBP+(PBASE+20)])       ;--> to source bitmap descriptor
   20)])
 = (WORD   PTR [RBP+(PBASE+	wSrcX       EQU (WORD   PTR [RBP+(PBASE+18)])       ;Source origin - x coordinate
   18)])
 = (WORD   PTR [RBP+(PBASE+	wSrcY       EQU (WORD   PTR [RBP+(PBASE+16)])       ;Source origin - y coordinate
   16)])
 = (WORD   PTR [RBP+(PBASE+	wXext       EQU (WORD   PTR [RBP+(PBASE+14)])       ;x extent of the BLT
   14)])
 = (WORD   PTR [RBP+(PBASE+	wYext       EQU (WORD   PTR [RBP+(PBASE+12)])       ;y extent of the BLT
   12)])
 = (DWORD  PTR [RBP+(PBASE+	Rop3        EQU (DWORD  PTR [RBP+(PBASE+8)])        ;Raster operation descriptor
   8)])
 = (DWORD  PTR [RBP+(PBASE+	lpPBrush    EQU (DWORD  PTR [RBP+(PBASE+4)])        ;--> to a physical brush (pattern)
   4)])
 = (DWORD  PTR [RBP+(PBASE+	lpDrawMode  EQU (DWORD  PTR [RBP+(PBASE+0)])        ;--> to a drawmode
   0)])
 = (BYTE   PTR Rop3[2])		bRop        EQU (BYTE   PTR Rop3[2])                ;Rop code is in byte 2 of Rop dword


				ifdef STB_16BIT_BITBLT
 0000				BitBlt          PROC    FAR PASCAL PUBLIC
				else
				endif




				        ;******************************
				        ; Setup passed stack reference 
				        ;******************************
 0000  55			        push    bp
 0001  8B EC			        mov     bp, sp                      ;setup EBP for accessing stack params
 0003  66| 33 E4		        xor     esp, esp
 0006  8B E5			        mov     sp,bp
 0008  83 EC 52			        sub     sp, LOCALS                 ; Make room for locals
 000B  1E			        push    ds
 000C  66| 56			        push    esi
 000E  57			        push    di

				ifdef PERF_NEW16BITBLT
 000F  0F B4 7E 22		        lfs     di, lpDestDev

				; *************************
				; * The DoHostStage2 Code *
				; *************************
				IFNDEF PERF_NEWMM
				ENDIF        
				; ********************************
				; * End of the DoHostStage2 code *
				; ********************************


 0013  64: 83 3D 00		        cmp     fs:[di].DIBENGINE.deType, 0     ; Is the dest mono?
 0017  0F 84 0611		        je      MonoDest                  
 001B  64: 8B 45 1C		        mov     ax, fs:[di].DIBENGINE.deFlags 
 001F  A9 1010			        test    ax, BUSY+PALETTE_XLAT       
 0022  0F 85 0E97		        jnz     BB16PuntToDibEngine
 0026  A9 8000			        test    ax, VRAM
 0029  0F 84 0661		        jz      DestInSysMem

 002D				DestInVidMem:
				        
 002D  B8 ---- R		        mov     ax, _DATA       
 0030  8E D8			        mov     ds, ax          

				;       cmp     fs:[di].DIBENGINE.deBitsPixel, 8
				;       jz      BB16JumpBacktoC
				    
				        ; Look up the rop table to find out if the blt uses src/pat/dest
 0032  66| 0F B6 5E 10		        movzx   ebx, byte ptr [Rop3+2]
 0037  67& 8B 04 5D		        mov     ax, word ptr RopFlags[ebx*2]
       00000000 R
 003F  89 46 B4			        mov     [CURRENTROPFLAGS], ax
 0042  A9 0001			        test    ax, USES_SRC 
 0045  0F 85 021F		        jnz     BltUsesSrc

 0049  66| 0F BE 76 10		        movsx   esi, byte ptr [Rop3+2]
 004E  A8 02			        test    al, USES_PAT    ; Is pattern used?
 0050  74 21			        jz      BB16PatCopyCont    ; we are doing a black/whiteness blt
				        
				        ;************************
				        ; PATCOPY Case
				        ;************************
 0052				BB16DoPatCopy:
				        ; Check to see if we have a solid
				        ; rect fill condtion.  If not
				        ; Let 32-bit side handle it

 0052  66| 33 F6		        xor     esi, esi
 0055  0F B5 76 0A		        lgs     si, lpPBrush                ;Let's check the brush

 0059  65: 8B 44 02		        mov     ax, gs:[si].DIB_Brush8.dp8BrushStyle
 005D  65: 8A 0C		        mov     cl, gs:[si].DIB_Brush8.dp8BrushFlags                 
				                
 0060  83 F8 00			        cmp     ax, BS_SOLID
 0063  0F 85 09A2		        jne     NotSolidBrush        
				        
 0067  F6 C1 01			        test    cl, COLORSOLID      
 006A  0F 84 0BC9		        jz      ColourPatBlt
				        
 006E  66| 65: 8B 74 4E		        mov     esi, DWORD PTR gs:[si].DIB_Brush8.dp8BrushBits

 0073				BB16PatCopyCont:
				        ; PRS 4457 - web browser hang - hardware WAX bug
 0073  66| 0F B7 46 1E		        movzx   eax, wDestY                     ; need to save the lastY because 16bit FXENTER cannot  
 0078  66| A3 1A7C E		        mov     GLOB.lastY, eax                 ; (it does not have the destination bounds)            
				        
				        ;****************************************
				        ; Prepare FIFO access
				        ;****************************************
				        FXENTER_FAST BB16JumpBacktoC 
 007C  66| 33 D2	     1	        xor     edx, edx
 007F  8B 16 0000 E	     1	        mov     dx, _FlatSel
 0083  8E C2		     1	        mov     es, dx
 0085  66| 8B 1E 0004 E	     1	        mov     ebx, dword ptr GLOB.lpDeFlags 
 008A  67& 26: 0F BA 2B	     1	        bts     word ptr es:[ebx], BUSY_BIT      ; pDeFlags = lpDriverData->lpDeFlags;
       04
 0090  0F 82 01B4	     1	        jb      Use_DibEngine                    ; SET_BUSY(pDeFlags);
 0094  66| 33 C0	     1	        xor     eax, eax        ; default to dst not a device bitmap
 0097  64: F7 45 1C 0008     1	        test    word ptr LPDST.DIBENGINE.deFlags, OFFSCREEN ; we already know its VRAM :)
 009D  0F 95 C0		     1	        setnz   al
 00A0  66| 89 46 E0	     1	        mov     dword ptr DSTDBM, eax
 00A4  66| 8B 16 0008 E	     1	        mov     edx, GLOB.gdiFlags
 00A9  66| 81 E2 0000A01E    1	        and     edx, SKIP_TO_C_FLAGS + SDATA_GDIFLAGS_2D_DIRTY + SDATA_GDIFLAGS_DST_WAS_DEVBIT + SKIP_TOTAL_FLAGS
 00B0  66| 0B C2	     1	        or      eax, edx
 00B3  66| 83 F8 00	     1	        cmp     eax, 0 
 00B7  75 03		     1	        jne     ??0009
 00B9  E9 00FE		     1	        jmp     ??0001
 00BC			     1	??0009: 
 00BC  F7 06 0008 E 4008     1	        test    word ptr GLOB.gdiFlags, SKIP_TOTAL_FLAGS
 00C2  0F 85 0176	     1	        jnz     ExclusiveMode
 00C6			     1	??0000:
 00C6  F6 06 0008 E 02	     1	        test    byte ptr GLOB.gdiFlags, SDATA_GDIFLAGS_2D_DIRTY
 00CB  74 0E		     1	        jz      ??0004
 00CD  66| 33 C9	     1	        xor     ecx, ecx
 00D0  B1 07		     1	        mov     cl, (RESET_DST + RESET_SRC + RESET_PDEV) 
 00D2  E8 0000 E	     1	        call    reset_Invariants
 00D5  66| 83 26 0008 E	     1	        and     GLOB.gdiFlags, NOT (SDATA_GDIFLAGS_2D_DIRTY + SDATA_GDIFLAGS_DST_WAS_DEVBIT + SDATA_GDIFLAGS_SRC_WAS_DEVBIT)
       CD
 00DB			     1	??0004:        
 00DB  F6 06 0008 E 10	     1	        test    byte ptr GLOB.gdiFlags, SDATA_GDIFLAGS_DST_WAS_DEVBIT   ; was the last operation to offscreen? 
 00E0  74 15		     1	        jz      short ??0005         ; No, jmp
 00E2  66| 83 7E E0 00	     1	        cmp     dword ptr DSTDBM, 0 ; Current operation to onscreen?
