			      C page
			      C ;	General definitions that almost everyone will use.
			      C 
			      C 
			      C 
			      C ;	Physical Bitmap Structure
			      C ;
			      C ;	Bitmap data structure passed to OEM routines.  Defines the location and
			      C ;	size of a main memory bitmap.
			      C 
			      C 
			      C 
 0020			      C BITMAP		struc							    ;*/ typedef struct {		 /*
			      C 
 0000  0000		      C   bmType	    dw	0	; 0 means main memory bitmap.  Non-zero     ;*/ short int bmType;		 /*
			      C 				; is number of physical display and format
			      C 				; of the rest of the structure known only
			      C 				; to device driver
 0002  0000		      C   bmWidth	    dw	0	; Width of bitmap in pixels		    ;*/ unsigned short int bmWidth;	 /*
 0004  0000		      C   bmHeight	    dw	0	; Height of bitmap in pixels		    ;*/ unsigned short int bmHeight;	 /*
 0006  0000		      C   bmWidthBytes	    dw	0	; #bytes per scan line			    ;*/ unsigned short int bmWidthBytes; /*
 0008  00		      C   bmPlanes	    db	0	; # of planes in bitmap 		    ;*/ BYTE		   bmPlanes;	 /*
 0009  00		      C   bmBitsPixel	    db	0	; # of bits per pixel			    ;*/ BYTE		   bmBitsPixel;  /*
 000A  00000000		      C   bmBits	    dd	0	; Far pointer to bits of main memory bitmap ;*/ BYTE FAR	  *bmBits;	 /*
 000E  00000000		      C   bmWidthPlanes     dd	0	; Product of bmWidthBytes and bmHeight	    ;*/ unsigned long int  bmWidthPlanes;/*
 0012  00000000		      C   bmlpPDevice	    dd	0	; Pointer to associated PDevice 	    ;*/ BYTE FAR	  *bmlpPDevice;  /*
 0016  0000		      C   bmSegmentIndex    dw	0	; Index to plaens next segment if non-zero  ;*/ unsigned short int bmSegmentIndex; /*
 0018  0000		      C   bmScanSegment     dw	0	; Number of scans per segment		    ;*/ unsigned short int bmScanSegment; /*
 001A  0000		      C   bmFillBytes	    dw	0	; Number of unused bytes per segment	    ;*/ unsigned short int bmFillBytes;   /*
 001C  0000		      C 		    dw	0						    ;*/ unsigned short int futureUse4;	  /*
 001E  0000		      C 		    dw	0						    ;*/ unsigned short int futureUse5;	  /*
			      C BITMAP		    ends						    ;*/ } BITMAP;			  /*
			      C 
			      C ; structures used for Device Independent Bitmap (DIB) processing.
			      C ; all taken out of Presentation Manager's documentation 
			      C ;  Tuesday 25-October-1988 15:04   -by-   Ron Gery [rong]
			      C 
			      C ; C definitions are provided below (separately).
			      C 
			      C ; triple used in PM1.1 (BitmapCoreInfo) format color table
 0003			      C RGBTriple	    struc	
 0000  00		      C   rgbtBlue 	    db	0
 0001  00		      C   rgbtGreen 	    db	0
 0002  00		      C   rgbtRed 	    db	0
			      C RGBTriple	    ends
			      C 
			      C ; RGB DWORD used in PM2.0 format color table
 0004			      C RGBQuad		    struc
 0000  00		      C   rgbBlue 	    db	0
 0001  00		      C   rgbGreen 	    db	0
 0002  00		      C   rgbRed 	    db	0
 0003  00		      C   rgbReserved 	    db	0
			      C RGBQuad		    ends
			      C 
 000C			      C BitmapCoreHeader    struc
 0000  00000000		      C   bcSize 	    dd	0
 0004  0000		      C   bcWidth 	    dw	0
 0006  0000		      C   bcHeight 	    dw	0
 0008  0000		      C   bcPlanes 	    dw	0
 000A  0000		      C   bcBitCount 	    dw	0
			      C BitmapCoreHeader    ends
			      C 
			      C ; new format bitmap structure based on PM2.0 format DCR.
			      C ;  Tuesday 23-May-1989 16:05   -by-   Ron Gery [rong]
			      C 
 0028			      C BitmapInfoHeader    struc
 0000  00000000		      C   biSize 	    dd	0
 0004  00000000		      C   biWidth 	    dd	0
 0008  00000000		      C   biHeight 	    dd	0
 000C  0000		      C   biPlanes 	    dw	0
 000E  0000		      C   biBitCount 	    dw	0
			      C 
 0010  00000000		      C   biCompression	    dd  0
 0014  00000000		      C   biSizeImage 	    dd	0
 0018  00000000		      C   biXPelsPerMeter   dd	0
 001C  00000000		      C   biYPelsPerMeter   dd	0
 0020  00000000		      C   biClrUsed	    dd	0
 0024  00000000		      C   biClrImportant    dd	0
			      C BitmapInfoHeader    ends
			      C 
 0029			      C BitmapInfo	    struc
 0000  0028 [		      C   bmiHeader	db (size BitmapInfoHeader) DUP (?)
        00
       ]
 0028  00		      C   bmiColors	db ?			; array of RGBQUADS
			      C BitmapInfo	    ends
			      C 
 000D			      C BitmapCoreInfo	    struc
 0000  000C [		      C   bmciHeader	db (size BitmapCoreHeader) DUP (?)
        00
       ]
 000C  00		      C   bmciColors	db ?			; array of RGBTRIPLES
			      C BitmapCoreInfo	    ends
			      C 
 = 0000			      C BI_RGB          equ    0h
 = 0001			      C BI_RLE8         equ    1h
 = 0002			      C BI_RLE4         equ    2h
