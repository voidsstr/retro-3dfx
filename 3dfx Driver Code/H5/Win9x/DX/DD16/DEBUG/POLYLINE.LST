				;
				; PolyLine16
				;
				; Handles Output call for the OS_POLYLINE style
				;

				; Prepare equates for locals
 = (dword ptr [RBP-(NEXTLOC	COMMAND     equ     (dword ptr [RBP-(NEXTLOC+00)])
   +00)])
 = (dword ptr [RBP-(NEXTLOC	BGCOLOR     equ     (dword ptr [RBP-(NEXTLOC+04)])
   +04)])
 = (dword ptr [RBP-(NEXTLOC	FGCOLOR     equ     (dword ptr [RBP-(NEXTLOC+08)])
   +08)])

 = 0040				LOCALS      equ     NEXTLOC+12

				; Prepare equates for parameters
 = 0006				PBASE       equ     6     ; (far return CS:IP + BP)


				STB_SAVEREGS Macro
				        pushad          ; 32 bytes: EAX, ECX, EDX, EBX, original ESP, EBP, ESI, EDI; 5 clock-ticks on PII
				        push    ds      ;  2 bytes
				        push    es      ;  2 bytes
				        push    fs      ;  2 bytes
				ENDM

				STB_RESTOREREGS Macro
				        pop     fs      ;  2 bytes
				        pop     es      ;  2 bytes
				        pop     ds      ;  2 bytes
				        popad           ; 32 bytes: EDI, ESI, EBP, EDX, ECX, <add 4 to current ESP>, EBX, EDX, ECX, EAX; 5 clock-ticks on PII
				ENDM

				;THESE ARE FOR USE AFTER THE STACK FRAME IS INITIALIZED ("push bp; sub sp LOCALS").
 = (dword ptr [RBP+(PBASE+1	lpDestDev       equ (dword ptr [RBP+(PBASE+18h)])
   8h)])
 = (word  ptr [RBP+(PBASE+1	wStyle          equ (word  ptr [RBP+(PBASE+16h)])
   6h)])
 = (word  ptr [RBP+(PBASE+1	wCount          equ (word  ptr [RBP+(PBASE+14h)])
   4h)])
 = (dword ptr [RBP+(PBASE+1	lpPoints        equ (dword ptr [RBP+(PBASE+10h)])
   0h)])
 = (dword ptr [RBP+(PBASE+0	lpPPen          equ (dword ptr [RBP+(PBASE+0Ch)])
   Ch)])
 = (dword ptr [RBP+(PBASE+0	lpPBrush        equ (dword ptr [RBP+(PBASE+08h)])
   8h)])
 = (dword ptr [RBP+(PBASE+0	lpDrawMode      equ (dword ptr [RBP+(PBASE+04h)])
   4h)])
 = (dword ptr [RBP+(PBASE+0	lpClipRect      equ (dword ptr [RBP+(PBASE+00h)])
   0h)])


 = 0012				OS_POLYLINE     equ 18


				;*----------------------------------------------------------------------
				;Function name: PolyLine16
				;
				;Description:   The 16-bit "Output(OS_POLYLINE)" workhorse
				;
				;Information:   
				;
				;Return:        VOID
				;----------------------------------------------------------------------*
 0000				PolyLine16      PROC    FAR PASCAL PUBLIC

				        ;******************************
				        ; Setup passed stack reference 
				        ;******************************
 0000  55			        push    bp
 0001  8B EC			        mov     bp, sp                      ;setup EBP for accessing stack params
 0003  66| 33 E4		        xor     esp, esp
 0006  8B E5			        mov     sp,bp
 0008  83 EC 40			        sub     sp, LOCALS                 ; Make room for locals
 000B  1E			        push    ds
 000C  56			        push    si
 000D  57			        push    di

 000E  C5 76 1E			        lds     si, lpDestDev


				;;; RBISSELL,990204: ADDED THESE "SKIP_STAGE2" SECTIONS TO FIX BUG (NEED TO CALL "_HostStage2")
				ifndef SKIP_STAGE2
				endif ;SKIP_STAGE2

