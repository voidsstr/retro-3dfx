 = 0001			      C RESET_DST       equ     0001h
 = 0002			      C RESET_SRC       equ     0002h
 = 0004			      C RESET_PDEV      equ     0004h
			      C 
 = cmdFifo0		      C PRIMARY_CMDFIFO equ     cmdFifo0
			      C 
			      C ;
			      C ; Equates to make things easier
			      C ;
			      C 
 = bp			      C RBP     equ     bp
			      C 
			      C ; These locals will be the same in all routines that use the cmdfifo
			      C 
 = [RBP-04]		      C CF      equ     [RBP-04]
 = [RBP-08]		      C IDX     equ     [RBP-08]
 = [RBP-12]		      C CLIPSEL equ     [RBP-12]
 = [RBP-16]		      C DSTADDR equ     [RBP-16]
 = [RBP-20]		      C DSTFMT  equ     [RBP-20]
 = [RBP-24]		      C SRCADDR equ     [RBP-24]
 = [RBP-28]		      C SRCFMT  equ     [RBP-28]
 = [RBP-32]		      C DSTDBM  equ     [RBP-32]
 = [RBP-36]		      C SRCDBM  equ     [RBP-36]
 = [RBP-40]		      C P6SWAP  equ     [RBP-40]
 = [RBP-44]		      C RSTWRDS equ     [RBP-44]
 = [RBP-48]		      C RSTMASK equ     [RBP-48]
 = 0034			      C NEXTLOC equ     52      ; should always be last one + 4
			      C 
 = _DriverData		      C GLOB    equ     _DriverData
			      C 
			      C ;****************************
			      C ; P6FENCE
			      C ;
			      C ; Flush write-combine cache
			      C ;****************************
			      C P6FENCE Macro
			      C    ifdef WRITECOMBINE
			      C 		;db 00fh		; Tried sfence, was not any faster
			      C 		;db 0aeh
			      C 		;db 0ffh
			      C         xchg    eax, P6SWAP
			      C    endif        
			      C Endm
			      C 
			      C ;****************************
			      C ; LOAD_CMDFIFO_RDPTR
			      C ;****************************
			      C LOAD_CMDFIFO_RDPTR Macro
			      C         push    edi
			      C         mov     edi, GLOB.lpCRegs
			      C         lea     edi, [edi].SstCRegs.PRIMARY_CMDFIFO.readPtrL ;
			      C         mov     edx, es:[edi]   ; GET( ((SstCRegs *) p)->PRIMARY_CMDFIFO.readPtrL )
			      C         pop     edi
			      C Endm
			      C 
			      C CMDFIFO_PROLOG Macro
			      C Endm
			      C 
			      C 
			      C ;*******************************************************
			      C ; CMDFIFO_SETUP
			      C ;
			      C ; Retrieves the current CMDFIFO pointer from DriverData
			      C ; Sets up ES with FlatSel
			      C ;*******************************************************
			      C CMDFIFO_SETUP Macro
			      C ifdef STB_FIFO16_ENABLE
			      C         mov     eax, GLOB.mainFifo.FXptr
			      C         xor     edx, edx
			      C         mov     dword ptr IDX, edx      ; initialize HWINDEX to 0
			      C         mov     dx, _FlatSel
			      C         mov     dword ptr CF, eax       ; initialize local CMDFIFO pointer
			      C         mov     es, dx
			      C endif
			      C Endm
			      C 
			      C ;*******************************************************
			      C ; CMDFIFO_SETUP_LITE
			      C ;
			      C ; Retrieves the current CMDFIFO pointer from DriverData
			      C ; Assumes ES is already the FlatSel
			      C ;*******************************************************
			      C CMDFIFO_SETUP_LITE Macro
			      C ifdef STB_FIFO16_ENABLE
			      C         mov     eax, GLOB.mainFifo.FXptr
			      C         xor     edx, edx
			      C         mov     dword ptr IDX, edx      ; initialize HWINDEX to 0
			      C         mov     dword ptr CF, eax       ; initialize local CMDFIFO pointer
			      C endif
			      C Endm
			      C 
			      C ;**************************************************************
			      C ; CMDFIFO_EPILOG
			      C ;
			      C ; Finishes using the CMDFIFO by saving the current CMDFIFOPTR
			      C ; in the global data structure and a few other things
			      C ;**************************************************************
			      C CMDFIFO_EPILOG Macro
			      C         Local   CF_10
			      C         mov     eax, IDX
			      C         sub     GLOB.mainFifo.space, eax  ; _FF(mainFifo.space) -= hwIndex 
			      C         xor     edx, edx
			      C         shl     eax, 2
			      C         add     CF, eax                 ; hwPtr += (hwIndex << 2)
			      C         mov     IDX, edx                ; hwIndex = 0
			      C    ifdef AGP_CMDFIFO
			      C         cmp     GLOB.doAgpCF, 0         ; if (_FF(doAgpCF))
			      C         je      short CF_10
			      C         push    dword ptr CF
			      C         call    myAgpEpilog             ;    myAgpEpilog((DWORD)hwPtr)
			      C         add     sp, 1 * 4
			      C CF_10:        
			      C    endif        
			      C         mov     eax, CF
			      C         mov     GLOB.mainFifo.FXptr, eax    ; _FF(mainFifo.FXptr) = hwPtr
			      C Endm
			      C 
			      C ;***********
			      C ; SETCF
			      C ;***********
			      C SETCF Macro SetData
			      C         mov     dword ptr es:[ebx], SetData
			      C         add     ebx, 4
			      C Endm        
			      C         
			      C ;**************************************************
			      C ; SETI
			      C ;
			      C ; Puts a literal value or register into the packet
			      C ;**************************************************
			      C SETI Macro FxReg, LitVal
			      C         SETCF   LitVal
			      C Endm
			      C 
			      C ;*************************************************************
			      C ; SETPH
			      C ;
			      C ; Sets up the packet header
			      C ; Prepares EBX with the current CMDFIFO value for SETx macros
			      C ;*************************************************************
			      C SETPH Macro SetBits
			      C         mov     ebx, CF         ; setup hwPtr for packet programming
			      C         SETCF   SetBits
			      C Endm
			      C 
			      C 
			      C ;*****************************************************************
			      C ; SETM
			      C ;
			      C ; Store the data at the specified memory location into the packet
			      C ;*****************************************************************
			      C SETM Macro FxReg, DataAddr
			      C         mov     eax, dword ptr DataAddr
			      C         SETCF   eax
			      C Endm
			      C 
			      C ;********************************************
			      C ; SETCMD
			      C ;
			      C ; Store the command starter into the packet
			      C ;********************************************
			      C SETCMD Macro FxReg, SetBits
			      C         Local   SC_10, SC_11
			      C    ifdef PERFNOP
			      C         cmp     doPerfNop, 0
			      C         je      short SC_10
			      C         SETI    FxReg, 0
			      C         jmp     short SC_11
			      C SC_10:
			      C         SETI    FxReg, SetBits
			      C SC_11:
			      C    else
			      C         SETI    FxReg, SetBits
			      C    endif        
			      C Endm        
			      C 
			      C ;*************************************************************
			      C ; GET_CF_OFFSET
			      C ;
			      C ; Prepares EBX with the current CMDFIFO value for SETx macros
			      C ;*************************************************************
			      C GET_CF_OFFSET Macro SetBits
			      C         mov     ebx, CF         ; setup hwPtr for packet programming
			      C Endm
			      C 
			      C ;*************************************************************
			      C ; GET_CF_OFFSET_FAST
			      C ;
			      C ; Prepares EBX with the current CMDFIFO value for SETx macros
			      C ; Special version of GET_CF_OFFSET for use with the optimised
			      C ; CMDFIFO_CHECKROOM_FAST
			      C ;*************************************************************
			      C IFDEF PERF_NEW16BITBLT
			      C GET_CF_OFFSET_FAST Macro SetBits
			      C         mov     ebx, GLOB.mainFifo.FXptr
			      C Endm
			      C ENDIF
			      C 
			      C ;****************************************
			      C ; BUMP
			      C ;
			      C ; Increments our hardware index counter
			      C ; Decrements our fifo dword count
			      C ;****************************************
			      C BUMP Macro HowMany
			      C         add     dword ptr IDX, HowMany
			      C         ;sub     GLOB.fifoDwordCount, HowMany
			      C Endm                                
			      C 
			      C ;****************************************
			      C ; BUMP_FAST
			      C ;
			      C ; This is a special case of BUMP for use 
			      C ; with CMDFIFO_CHECKROOM_FAST 
			      C ;
			      C ; Increments our hardware index counter
			      C ; Decrements our fifo dword count
			      C ;****************************************
			      C IFDEF PERF_NEW16BITBLT
			      C BUMP_FAST Macro HowMany
			      C       add   ebx, HowMany
			      C       mov   GLOB.mainFifo.FXptr, ebx   
			      C Endm                  
			      C ENDIF              
			      C                                
			      C ;*********************
			      C ; CMDFIFO_CHECKBUMP - check whether fencing needs to occur, to prevent bump overflow
			      C ;*********************
			      C CMDFIFO_CHECKBUMP Macro HowMany
			      C 		Local	Update_bumpval
			      C 		mov		eax, dword ptr GLOB.mainFifo.bump
			      C 		add		eax, HowMany
			      C 		cmp		eax, 0ffffh
			      C 		jb		Update_bumpval
			      C 		P6FENCE
			      C 		mov		eax, HowMany
			      C Update_bumpval:
			      C 		mov		dword ptr GLOB.mainFifo.bump, eax
			      C Endm
			      C 
			      C ;*********************
			      C ; CMDFIFO_CHECKROOM
			      C ;*********************
			      C CMDFIFO_CHECKROOM Macro HowMany
			      C         Local   CR_10
			      C 		CMDFIFO_CHECKBUMP HowMany
			      C         mov     eax, IDX
			      C         sub     GLOB.mainFifo.space, eax
			      C         xor     edx, edx
			      C         shl     eax, 2
			      C         add     CF, eax
			      C         mov     IDX, edx
			      C         cmp     dword ptr GLOB.mainFifo.space, HowMany
			      C         jae     short CR_10
			      C         mov     ebx, CF
			      C         mov     ecx, HowMany
			      C         call    fifo_MakeRoom
			      C         mov     CF, ebx
			      C CR_10:
			      C Endm
			      C      
			      C ;************************
			      C ; CMDFIFO_CHECKROOM_FAST
			      C ;************************
			      C IFDEF PERF_NEW16BITBLT
			      C CMDFIFO_CHECKROOM_FAST Macro HowMany
			      C         Local   CR_9, CR_10
			      C 		CMDFIFO_CHECKBUMP HowMany        
			      C         sub     dword ptr GLOB.mainFifo.space, HowMany
			      C         jl      short CR_9      ; Fall Through in majority of calls
			      C         jmp     short CR_10
			      C CR_9:        
			      C         mov     ecx, HowMany
			      C         call    fifo_MakeRoom_Fast
			      C         sub     GLOB.mainFifo.space, ecx        
			      C CR_10:
			      C Endm
			      C ENDIF
			      C      
			      C 
			      C ;***********************************************************************
			      C ; FXENTER
			      C ;
			      C ; Monster macro for handling common pre-drawing stuff
			      C ; (softare cursor exclusion, destination type (screen or device bitmap)
			      C ; checking, etc.
			      C ;
			      C ; Use the FXENTER <label to jmp on SW cursor>, SRC_PRESENT form 
			      C ;  when source is present
			      C ;
			      C ;   rbissell@stb,990128: made "OnSoftwareCursor" param optional
			      C ;                        to cater to situations where we can handle it.
			      C ;
			      C ; Register assumes:
			      C ;
			      C ;       FS:DI   = pointer to destination device (lpDst)
			      C ;       GS:SI   = pointer to source if present
			      C ;***********************************************************************
			      C 
			      C ; SRC_PRESENT equ 1
			      C 
 = fs:[di]		      C LPDST   equ     fs:[di]
 = gs:[si]		      C LPSRC   equ     gs:[si]
			      C ifdef SLI_AA
 = 6004			      C SKIP_TO_C_FLAGS equ SDATA_GDIFLAGS_SW_CURSOR or SDATA_GDIFLAGS_SLI_AA_MASTER or SDATA_GDIFLAGS_SLI_AA_SLAVE
 = 4008			      C SKIP_TOTAL_FLAGS equ SDATA_GDIFLAGS_HWC_EXCLUSIVE or SDATA_GDIFLAGS_SLI_AA_SLAVE
			      C else
			      C endif
			      C 
			      C FXENTER Macro   OnSoftwareCursor, SrcPresent 
			      C         Local   FX_50, FX_60, FX_61, FX_62, FX_63, FX_16, FX_65
			      C 
			      C 		;******************************
			      C 		; Need to Pre-Load the FlatSel
			      C 		;******************************
			      C 		xor		edx, edx
			      C         mov     dx, _FlatSel
			      C         mov     es, dx
			      C 
			      C 		mov		ebx, dword ptr GLOB.lpDeFlags 
			      C         test    word ptr es:[ebx], (BUSY + PALETTE_XLAT)  ;     goto Use_DibEng;
			      C         jnz     Use_DibEngine
			      C         bts     word ptr es:[ebx], BUSY_BIT      ; pDeFlags = lpDriverData->lpDeFlags;
			      C         jc      Use_DibEngine                                     ; SET_BUSY(pDeFlags);
			      C         
			      C         xor     eax, eax        ; default to dst not a device bitmap
			      C         test    word ptr LPDST.DIBENGINE.deFlags, OFFSCREEN ; we already know its VRAM :)
			      C         setnz   al
			      C         mov     dword ptr DSTDBM, eax
			      C         xor     eax, eax        ; default to src not a device bitmap
			      C      IFNB <SrcPresent>
			      C         movzx   edx, gs:[si].DIBENGINE.deFlags  ; if ((lpSrc->deFlags & VRAM+OFFSCREEN) ==
			      C         and     edx, (VRAM + OFFSCREEN)         ;       (VRAM+OFFSCREEN))
			      C         cmp     edx, (VRAM + OFFSCREEN)
			      C         jne     short FX_15
			      C         mov     eax, 1                          ; then Yes, we have a src device bitmap
			      C FX_15:
			      C      ENDIF
			      C         mov     dword ptr SRCDBM, eax
			      C         
			      C         cmp     GLOB.gdiFlags, 0
			      C         je      FX_60
			      C         
			      C         ;mov        eax, GLOB.gdiFlags 
			      C         test    word ptr GLOB.gdiFlags, SKIP_TOTAL_FLAGS
			      C         jz      short FX_16
			      C 		mov		ebx, dword ptr GLOB.lpDeFlags 
			      C         and     word ptr es:[ebx], NOT BUSY
			      C         jmp     All_Done
			      C FX_16:        
			      C         test    byte ptr GLOB.gdiFlags, SDATA_GDIFLAGS_2D_DIRTY
			      C         jz      FX_61
			      C         
			      C         ; if direct draw changed some 2d registers, or changed the desktop
			      C         ; from being linear to tiled or vice-versa,
			      C         ; we need to reset the invariant 2d regs and the stride of the
			      C         ; screen's pDevice so that dib engine rendering will be correct
			      C 
			      C         xor     ecx, ecx
			      C         mov     cl, (RESET_DST + RESET_SRC + RESET_PDEV) 
			      C         call    reset_Invariants
			      C         and     GLOB.gdiFlags, NOT (SDATA_GDIFLAGS_2D_DIRTY + SDATA_GDIFLAGS_DST_WAS_DEVBIT + SDATA_GDIFLAGS_SRC_WAS_DEVBIT)
			      C         
			      C FX_61:        
			      C         
			      C         ; if the previous drawing operation was to a device bitmap,
			      C         ; the invariants were clobbered, so we need to reset them,
			      C         ; but there's no need to do this if we're not going to clobber
			      C         ; them again anyway, unless we need to save away the current
			      C         ; dstBaseAddr and dstFormat (e.g., StretchBltBufferToScreen),
			      C         ; so we'd need to put them to known states anyway
			      C 
			      C         test    byte ptr GLOB.gdiFlags, SDATA_GDIFLAGS_DST_WAS_DEVBIT
			      C         jz      short FX_62
			      C         cmp     dword ptr DSTDBM, 0
			      C         jne     short FX_62
			      C         xor     ecx, ecx
			      C         mov     cl, RESET_DST
			      C         call    reset_Invariants
			      C         and     GLOB.gdiFlags, NOT SDATA_GDIFLAGS_DST_WAS_DEVBIT
			      C FX_62:        
			      C 
			      C      IFNB  <SrcPresent>
			      C         ; if the previous drawing operation used a device bitmap as a
			      C         ; source, and the current operation doesn't use a device bitmap
			      C         ; as a source, reset the source 2d invariants
			      C 
			      C         test    GLOB.gdiFlags, SDATA_GDIFLAGS_SRC_WAS_DEVBIT
			      C         jz      short FX_63
			      C         cmp     dword ptr SRCDBM, 0       ; is source a device bitmap?
			      C         jne     short FX_63
			      C         mov     ecx, RESET_SRC
			      C         call    reset_Invariants
			      C         and     GLOB.gdiFlags, NOT SDATA_GDIFLAGS_SRC_WAS_DEVBIT
			      C      ENDIF
			      C FX_63:
			      C ifdef SLI_AA
			      C         ; If SW cursor is on or SLI_AA forget this and go back to
			      C         ; the trusty C code.
			      C         test    word ptr GLOB.gdiFlags, SKIP_TO_C_FLAGS
			      C         jz      short FX_65
			      C 		mov		ebx, dword ptr GLOB.lpDeFlags 
			      C         and     word ptr es:[ebx], NOT BUSY
			      C 		jmp		OnSoftwareCursor
			      C FX_65:
			      C else
			      C     IFNB <OnSoftwareCursor>
			      C         ; If SW cursor is on, for get this and go back to
			      C         ; the trusty C code.
			      C         test    word ptr GLOB.gdiFlags, SKIP_TO_C_FLAGS
			      C         jz      short FX_65
			      C 		mov		ebx, dword ptr GLOB.lpDeFlags 
			      C         and     word ptr es:[ebx], NOT BUSY
			      C 		jmp		OnSoftwareCursor
			      C FX_65:
			      C     ENDIF
			      C endif
			      C 
			      C FX_60:        
			      C         CMDFIFO_SETUP_LITE
			      C         
			      C      IFNB  <SrcPresent>
			      C         cmp     dword ptr SRCDBM, 0       ; is source a device bitmap?
			      C         je      FX_70           ; if not, outta here!
			      C         mov     eax, dword ptr LPSRC.DIBENGINE.deBits
			      C         sub     eax, dword ptr GLOB.lfbBase
			      C         mov     dword ptr SRCADDR, eax
			      C         mov     eax, GLOB.screenFormat                                    ;  srcFormat = _FF(screenFormat) & ~(SSTG_DST_LINEAR_STRIDE |
			      C         and     eax, NOT (SSTG_DST_LINEAR_STRIDE + SSTG_DST_TILE_STRIDE)  ;                    SSTG_DST_TILE_STRIDE);
			      C         mov     edx, gs:[si].DIBENGINE.deDeltaScan                        ;  srcFormat |= mylpSrc->deDeltaScan & SSTG_DST_LINEAR_STRIDE;
			      C         and     edx, SSTG_DST_LINEAR_STRIDE                               ;
			      C         or      eax, edx
			      C         mov     dword ptr SRCFMT, eax
			      C         
			      C         xor     ecx, ecx
			      C         mov     cl, 3
			      C         CMDFIFO_CHECKROOM      ecx 
			      C         SETPH   (SSTCP_PKT2 + srcBaseAddrBit + srcFormatBit)
			      C         SETM    srcBaseAddr, SRCADDR
			      C         SETM    srcFormat, SRCFMT
			      C         BUMP    3
			      C         or      GLOB.gdiFlags, SDATA_GDIFLAGS_SRC_WAS_DEVBIT        
			      C         ; DANGER
			      C         ; missing the C enterleave FXENTER_COMPUTE_DSTBA_FORMAT stuff
			      C         ; DANGER
			      C FX_70:        
			      C      ENDIF
			      C         cmp     dword ptr DSTDBM, 0       ; is destination a device bitmap
			      C         je      FX_50     ; if not, outta here!
			      C         
			      C         mov     eax, dword ptr LPDST.DIBENGINE.deBits
			      C         sub     eax, dword ptr GLOB.lfbBase
			      C         mov     dword ptr DSTADDR, eax
			      C         
			      C         mov     eax, dword ptr GLOB.screenFormat
			      C         and     eax, 70000h                     ; & SSTG_DST_FORMAT
			      C         mov     edx, dword ptr LPDST.DIBENGINE.deDeltaScan
			      C         and     edx, 03fffh                         ; & SSTG_SRC_LINEAR_STRIDE
			      C         or      eax, edx
			      C         mov     dword ptr DSTFMT, eax
			      C 
			      C         xor     ecx, ecx
			      C         mov     cl, 5
			      C         CMDFIFO_CHECKROOM     ecx
			      C         GET_CF_OFFSET
			      C         xor     eax, eax
			      C         mov     ax, (SSTCP_PKT2 + clip0minBit + clip0maxBit + dstBaseAddrBit + dstFormatBit)
			      C         mov     es:[ebx], eax ;PH
			      C         add     ebx, 4
			      C         xor     eax, eax
			      C         mov     es:[ebx], eax ; clip0min
			      C         add     ebx, 4
			      C         mov     eax, dword ptr LPDST.DIBENGINE.deWidth 
			      C         mov     es:[ebx], eax ; clip0max
			      C         add     ebx, 4
			      C         mov     eax,dword ptr DSTADDR 
			      C         mov     es:[ebx], eax ; dstBaseAddr
			      C         add     ebx, 4
			      C         mov     eax,dword ptr DSTFMT 
			      C         mov     es:[ebx], eax ; dstFormat
			      C 
			      C         BUMP    5
			      C         or      GLOB.gdiFlags, SDATA_GDIFLAGS_DST_WAS_DEVBIT
			      C         ; DANGER
			      C         ; missing the C enterleave FXENTER_COMPUTE_DSTBA_FORMAT stuff
			      C         ; DANGER
			      C FX_50:
			      C Endm
			      C 
			      C ;***********************************************************************
			      C ; FXENTER_FAST
			      C ;
			      C ; Monster macro for handling common pre-drawing stuff
			      C ; (softare cursor exclusion, destination type (screen or device bitmap)
			      C ; checking, etc.
			      C ;
			      C ; Use the FXENTER_FAST <label to jmp on SW cursor>, SRC_PRESENT form 
			      C ;  when source is present
			      C ;
			      C ;   rbissell@stb,990128: made "OnSoftwareCursor" param optional
			      C ;                        to cater to situations where we can handle it.
			      C ;
			      C ;   shouston@3dfx.com,10-7-99:  Specially optimised version of FXENTER 
			      C ;                               for bitblt and ExtTextOut
			      C ; Register assumes:
			      C ;
			      C ;       FS:DI   = pointer to destination device (lpDst)
			      C ;       GS:SI   = pointer to source if present
			      C ;***********************************************************************
			      C 
			      C IFDEF PERF_NEW16BITBLT
			      C FXENTER_FAST Macro   OnSoftwareCursor, SrcPresent2 
			      C         Local   FX_16, FX_50, FX_60, FX_65, FX_61, FX_62, FX_63, FX_70, FX_71, Check_Invariants
			      C 
			      C         ;******************************
			      C         ; Need to Pre-Load the FlatSel
			      C         ;******************************
			      C 
			      C         xor     edx, edx
			      C         mov     dx, _FlatSel
			      C         mov     es, dx
			      C 
			      C         mov     ebx, dword ptr GLOB.lpDeFlags 
			      C 
			      C         bts     word ptr es:[ebx], BUSY_BIT      ; pDeFlags = lpDriverData->lpDeFlags;
			      C         jb      Use_DibEngine                    ; SET_BUSY(pDeFlags);
			      C 
			      C         xor     eax, eax        ; default to dst not a device bitmap
			      C         test    word ptr LPDST.DIBENGINE.deFlags, OFFSCREEN ; we already know its VRAM :)
			      C         setnz   al
			      C         mov     dword ptr DSTDBM, eax
			      C 
			      C IFNB <SrcPresent2>
			      C         xor     eax, eax
			      C         test    word ptr LPSRC.DIBENGINE.deFlags, OFFSCREEN ; just test offscreen, we already know its VRAM
			      C         setnz   al
			      C         mov     dword ptr SRCDBM, eax
			      C 
			      C         ; TODO: This could be further optimized.... most of the time (in WB99) all Check_Invariants 
			      C         ; will do is set the src base addr. An faster routine could be written that removes the other
			      C         ; invariant checks, as is done for the dest invariants check.
			      C 
			      C         jmp     Check_Invariants
			      C ELSE 
			      C         mov     edx, GLOB.gdiFlags
			      C ;        and      edx, SDATA_GDIFLAGS_2D_DIRTY + SKIP_TOTAL_FLAGS + SDATA_GDIFLAGS_DST_WAS_DEVBIT + SDATA_GDIFLAGS_SW_CURSOR
			      C         and     edx, SKIP_TO_C_FLAGS + SDATA_GDIFLAGS_2D_DIRTY + SDATA_GDIFLAGS_DST_WAS_DEVBIT + SKIP_TOTAL_FLAGS
			      C ENDIF 
			      C         or      eax, edx
			      C         cmp     eax, 0 
			      C         jne     Check_Invariants
			      C         jmp     FX_50
			      C       
			      C Check_Invariants: 
			      C 
			      C         test    word ptr GLOB.gdiFlags, SKIP_TOTAL_FLAGS
			      C         jnz     ExclusiveMode
			      C       
			      C FX_16:
			      C 
			      C         test    byte ptr GLOB.gdiFlags, SDATA_GDIFLAGS_2D_DIRTY
			      C         jz      FX_61
			      C 
			      C         ; if direct draw changed some 2d registers, or changed the desktop
			      C         ; from being linear to tiled or vice-versa,
			      C         ; we need to reset the invariant 2d regs and the stride of the
			      C         ; screen's pDevice so that dib engine rendering will be correct
			      C       
			      C         xor     ecx, ecx
			      C         mov     cl, (RESET_DST + RESET_SRC + RESET_PDEV) 
			      C         call    reset_Invariants
			      C         and     GLOB.gdiFlags, NOT (SDATA_GDIFLAGS_2D_DIRTY + SDATA_GDIFLAGS_DST_WAS_DEVBIT + SDATA_GDIFLAGS_SRC_WAS_DEVBIT)
			      C         
			      C FX_61:        
			      C         
			      C         ; if the previous drawing operation was to a device bitmap,
			      C         ; the invariants were clobbered, so we need to reset them,
			      C         ; but there's no need to do this if we're not going to clobber
			      C         ; them again anyway, unless we need to save away the current
			      C         ; dstBaseAddr and dstFormat (e.g., StretchBltBufferToScreen),
			      C         ; so we'd need to put them to known states anyway
			      C 
			      C         test    byte ptr GLOB.gdiFlags, SDATA_GDIFLAGS_DST_WAS_DEVBIT   ; was the last operation to offscreen? 
			      C         jz      short FX_62         ; No, jmp
			      C         cmp     dword ptr DSTDBM, 0 ; Current operation to onscreen?
			      C         jne     short FX_62         ; No, jmp
			      C         
			      C         ; we get here if the last operation was to offscreen and the current is to onscreen
			      C         
			      C         xor     ecx, ecx
			      C         mov     cl, RESET_DST
			      C         call    reset_Invariants
			      C         and     GLOB.gdiFlags, NOT SDATA_GDIFLAGS_DST_WAS_DEVBIT
			      C FX_62: 
			      C      IFNB  <SrcPresent2>
			      C         ; if the previous drawing operation used an offscreen bitmap as a
			      C         ; source, and the current operation doesn't use an offscreen bitmap
			      C         ; as a source, reset the source 2d invariants
			      C 
			      C         test    GLOB.gdiFlags, SDATA_GDIFLAGS_SRC_WAS_DEVBIT    ; was the last src offscreen?
			      C         jz      short FX_63                 ; No, jmp
			      C         cmp     dword ptr SRCDBM, 0         ; is the src onscreen?
			      C         jne     short FX_63                 ; No, jmp
			      C         mov     ecx, RESET_SRC
			      C         call    reset_Invariants
			      C         and     GLOB.gdiFlags, NOT SDATA_GDIFLAGS_SRC_WAS_DEVBIT
			      C      ENDIF
			      C 
			      C           
			      C 
			      C FX_63:
			      C      IFNB <OnSoftwareCursor>
			      C         ; If SW cursor is on, for get this and go back to
			      C         ; the trusty C code.
			      C ;        test    byte ptr GLOB.gdiFlags, SDATA_GDIFLAGS_SW_CURSOR
			      C         test    word ptr GLOB.gdiFlags, SKIP_TO_C_FLAGS
			      C         jz      short FX_65
			      C         mov     ebx, dword ptr GLOB.lpDeFlags 
			      C         and     word ptr es:[ebx], NOT BUSY
			      C         jmp     OnSoftwareCursor
			      C FX_65:
			      C     ENDIF
			      C 
			      C FX_60:        
			      C 
			      C      IFNB  <SrcPresent2>
			      C         cmp     dword ptr SRCDBM, 0       ; is source in offscreen memory?
			      C         je      FX_70                     ; if not, outta here!
			      C         
			      C         xor     ecx, ecx
			      C         mov     cl, 2
			      C         GET_CF_OFFSET_FAST          
			      C         CMDFIFO_CHECKROOM_FAST       ecx 
			      C                  
			      C         mov     es:[ebx], dword ptr (SSTCP_PKT2 + srcBaseAddrBit)
			      C         mov     eax, dword ptr LPSRC.DIBENGINE.deBits
			      C         sub     eax, dword ptr GLOB.lfbBase        
			      C         mov     es:[ebx+4], eax
			      C         
			      C         mov     eax, GLOB.screenFormat                                    ;  srcFormat = _FF(screenFormat) & ~(SSTG_DST_LINEAR_STRIDE |
			      C         and     eax, NOT SSTG_SRC_LINEAR_STRIDE
			      C         mov     edx, gs:[si].DIBENGINE.deDeltaScan                        ;  srcFormat |= mylpSrc->deDeltaScan & SSTG_DST_LINEAR_STRIDE;
			      C         and     edx, SSTG_SRC_LINEAR_STRIDE                               
			      C         or      eax, edx        
			      C         mov     [SrcFormat], eax
			      C 
			      C         BUMP_FAST   8      
			      C         or      GLOB.gdiFlags, SDATA_GDIFLAGS_SRC_WAS_DEVBIT        
			      C         jmp     FX_71
			      C         ; DANGER
			      C         ; missing the C enterleave FXENTER_COMPUTE_DSTBA_FORMAT stuff
			      C         ; DANGER
			      C FX_70: 
			      C         ; The src is onscreen memory, set the format correspondingly
			      C         mov     eax, GLOB.screenFormat
			      C         mov     [SrcFormat], eax 
			      C FX_71:       
			      C      ENDIF
			      C         
			      C         cmp     dword ptr DSTDBM, 0       ; is current operation to onscreen?
			      C         je      FX_50     ; yes, outta here!
			      C         
			      C         ; we get here if the current operation is to offscreen
			      C         
			      C         mov     eax, dword ptr LPDST.DIBENGINE.deBits
			      C         sub     eax, dword ptr GLOB.lfbBase
			      C         mov     dword ptr DSTADDR, eax
			      C         
			      C         mov     eax, dword ptr GLOB.screenFormat
			      C         and     eax, 70000h                     ; & SSTG_DST_FORMAT
			      C         mov     edx, dword ptr LPDST.DIBENGINE.deDeltaScan
			      C         and     edx, 03fffh                         ; & SSTG_SRC_LINEAR_STRIDE
			      C         or      eax, edx
			      C         mov     dword ptr DSTFMT, eax
			      C 
			      C         xor     ecx, ecx
			      C         mov     cl, 5
			      C         GET_CF_OFFSET_FAST
			      C         CMDFIFO_CHECKROOM_FAST     ecx
			      C 
			      C         xor     eax, eax
			      C         mov     ax, (SSTCP_PKT2 + clip0minBit + clip0maxBit + dstBaseAddrBit + dstFormatBit)
			      C         mov     es:[ebx], eax ;PH
			      C         xor     eax, eax
			      C         mov     es:[ebx+4], eax ; clip0min
			      C         mov     eax, dword ptr LPDST.DIBENGINE.deWidth 
			      C         mov     es:[ebx+8], eax ; clip0max
			      C         mov     eax,dword ptr DSTADDR 
			      C         mov     es:[ebx+12], eax ; dstBaseAddr
			      C         mov     eax,dword ptr DSTFMT 
			      C         mov     es:[ebx+16], eax ; dstFormat
			      C         BUMP_FAST     20
			      C 
			      C         or      GLOB.gdiFlags, SDATA_GDIFLAGS_DST_WAS_DEVBIT
			      C         ; DANGER
			      C         ; missing the C enterleave FXENTER_COMPUTE_DSTBA_FORMAT stuff
			      C         ; DANGER
			      C FX_50:
			      C 
			      C Endm FXENTER_FAST 
			      C ENDIF ; PERF_NEW16BITBLT
			      C 
			      C 
			      C FXLEAVE Macro
			      C         Local   FXL_10 
			      C         CMDFIFO_EPILOG
			      C 		mov		ebx, dword ptr GLOB.lpDeFlags 
			      C         and     word ptr es:[ebx], NOT BUSY
			      C         jmp     short All_Done
			      C Use_DibEngine:
			      C         test    byte ptr GLOB.gdiFlags, SDATA_GDIFLAGS_2D_DIRTY
			      C         jz      short FXL_10
			      C         xor     ecx, ecx
			      C         mov     cl, RESET_PDEV
			      C         call    reset_Invariants
			      C FXL_10:        
			      C All_Done:        
			      C Endm
			      C 
			      C IFDEF PERF_NEW16BITBLT
			      C FXLEAVE_FAST Macro
			      C         Local   FXL_10 
			      C ExclusiveMode:        
			      C         mov     ebx, dword ptr GLOB.lpDeFlags 
			      C         and     word ptr es:[ebx], NOT BUSY
			      C         jmp     short All_Done
			      C Use_DibEngine:
			      C         test    byte ptr GLOB.gdiFlags, SDATA_GDIFLAGS_2D_DIRTY
			      C         jz      short FXL_10
			      C         xor     ecx, ecx
			      C         mov     cl, RESET_PDEV
			      C         call    reset_Invariants
			      C FXL_10:        
			      C All_Done:        
			      C Endm
			      C ENDIF
			      C 
			      C ;
			      C ; External data that these macros need
			      C ;
			      C 
 0000			      C _DATA   SEGMENT WORD PUBLIC 'DATA' USE16 
			      C 
			      C EXTERN  _DriverData:GLOBALDATA
			      C ifdef STB_FIFO16_ENABLE 
			      C EXTERN  _FlatSel:WORD
			      C endif
			      C 
 0000			      C _DATA   ENDS
			      C 
			      C ASSUME DS:_DATA
			      C 
 0000			      C _TEXT   SEGMENT WORD PUBLIC 'CODE' USE16 
			      C 
			      C ifndef FIFO16FILE       ; don't include these externs in FIFO16.ASM
			      C 
			      C EXTERN  fifo_MakeRoom:NEAR
			      C ifdef PERF_NEW16BITBLT
			      C EXTERN  fifo_MakeRoom_Fast:NEAR
			      C endif
			      C EXTERN  fifo_Wrap:NEAR
			      C EXTERN  reset_Invariants:NEAR
			      C 
			      C endif
			      C 
			      C ifdef AGP_CMDFIFO
			      C endif
			      C 
			      C ifdef DEBUGFIFO
			      C endif
			      C 
 0000			      C _TEXT ENDS
			      C 
			      C 
				        .list

				ifdef INCSTBPERF
				INCLUDE ..\..\BUILD\STBPERF.INC
			      C ;/*
			      C ;-----------------------------Module-Header-----------------------------;
			      C ; Module Name:  STBPERF.INC
			      C ;
			      C ; This file contains optimization definitions used by the STB build of the
			      C ; Voodoo3 source.
			      C ;
			      C ; Created: 12/15/97
			      C ; Author:  Steve Rogers
			      C ;
			      C ; History:  Who	What?
			      C ; 12/15/98  SR  Created
			      C ; 12/16/98  sr  Added Handle1to1Str
			      C ; 12/16/98  sr  Added Handle1X1
			      C ; 12/16/98  sr  Added HandleSTR1X1
			      C ; 01/11/99  pz  Added STB_MMGR_TWK
			      C ; 01/13/99  sr  Added STB 16BIT Textout function from bj
			      C ; 03/08/99  mgm Comment out SKIP_STAGE2 to fix PRS 4898 (mgm=michael@3dfx)
			      C ;-----------------------------------------------------------------------;
			      C ;
			      C 
			      C ; Define Assembly performance optimizations here
			      C ; Name                     Description
			      C ; Example
			      C ; STBPERF_FASTRECIP    EQU 1  ; SR Uses table lookup for a faster, less acurate reciprocal
 = 0001			      C STBPERF_HANDLE1X1      EQU 1  ; SR Pokes pixel through framebuffer for 1 pixel bitmap copies
 = 0001			      C STBPERF_HANDLESTR1X1   EQU 1  ; SR Pokes pixel through framebuffer for 1 pixel bitmap 1 to 1 stretches
 = 0001			      C STB_FIFO16_ENABLE	   EQU 1  ; BJ Enable/Allow 16 bit FIFO code to be used
 = 0001			      C STBPERF_CMBITBLT       EQU 1  ; PZ Special case for color to mono blit
 = 0001			      C STBPERF_DEVBITFIX      EQU 1  ; PZ A replacement scheme to work around a GDI bug in device bmp management
			      C ifdef STBPERF_DEVBITFIX
			      C ;  SKIP_STAGE2            EQU 1  ; PZ Do SKIP_STAGE2 only if STBPERF_DEVBITFIX is enabled
			      C endif
			      C ifdef STB_FIFO16_ENABLE
 = 0001			      C 	STB_16BIT_TEXTOUT  EQU 1  ; BJ Use 16 bit FIFO CODE in ExtTextOut
 = 0001			      C 	STBPERF_POLYLINE16 EQU 1  ; RVB 16-bit code for Output::OS_POLYLINE
 = 0001			      C     STB_16BIT_BITBLT   EQU 1  ; BJ Use 16 bit FIFO CODE in BitBlt (PatCopy, Whiteness, Blackness)
 = 0001			      C     STB_FASTER_TR      EQU 1  ; BJ No need to have 2 segment loads to check TR
 = 0001			      C     PERF_NEW16BITBLT   EQU 1  ; SteveH - optimized 16-bit BitBlt 
 = 0001			      C     PERF_NEWMM         EQU 1  ; SteveH - optimized 2D memory manager
			      C endif
			      C ifdef PERF_NEWMM
 = 0001			      C     SKIP_STAGE2        EQU 1  ; SteveH - if we're using the new MM, no need to do the hostify code
			      C endif
 = 0001			      C STBPERF_K6_ASM_AUTOSTRIP EQU 1    ; turn on auto-stripping in atrik.asm
			      C 
			      C comment `
			      C 
			      C ;*/
			      C 
			      C // Define C performance optimizations here
			      C //#pragma message("Compiling with Performance optimizations in ../build/STBPERF.INC.")
			      C // #define Name                  Description
			      C // Example
			      C // #define STBPERF_FASTRECIP 1      ; SR Uses table lookup for a faster, less acurate reciprocal
			      C #define STBPERF_HANDLE1TO1STR 1     ; SR Some StretchBlts are called with 1 to 1 stretches, so copy them.
			      C #define STB_FIFO16_ENABLE 1         ; BJ Enable/Allow 16 bit FIFO code to be used
			      C #define STB_16BIT_BITBLT 1          ; BJ Enable/Allow 16 bit PatCopy cases to be done in assembler
			      C #define STBPERF_CMBITBLT            ; PZ Special case for color to mono blit
			      C #define STBPERF_SOLIDCLRPATCPY      ; PZ Special case for patcopy with solid color brush 
			      C //#define STBPERF_RBO_SKIPDIBENGINE 1 ; PZ Skip calling to DIBENGIE when realizing bitmaps
			      C #define STBPERF_DEVBITFIX 1         ; PZ A replacement scheme to work around a GDI bug in device bmp management
			      C #ifdef STBPERF_DEVBITFIX
			      C // #define SKIP_STAGE2 1            ; PZ Do SKIP_STAGE2 only if STBPERF_DEVBITFIX is enabled
			      C #endif
			      C #define PERF_NEWDIB 1               ; SteveH - Handle all ROPs and 4bpp sources in DIB functions
			      C #define PERF_NEW16BITBLT 1
			      C #define PERF_NEWMM 1                
			      C #ifdef PERF_NEWMM
			      C     #define SKIP_STAGE2 1
			      C #endif    
			      C 
			      C //#define STBPERF_2DAGPCMDFIFO        ; SR Allows 2D Cmd Fifo to reside in AGP Memory.
			      C //                                    ; To get AGP to work, you must set two registry entries
			      C //									  ; "aFifo" must be set to 1, and "force1xrate" must be set to 1
			      C //									  ; both are DWORDs under 
			      C //									  ; HKLM/System/CurrentControlSet/Services/Class/Display/XXXX/DEFAULT
			      C #define STBPERF_USE_FLIPNOVSYNC       ; enable FLIPNOVSYNC for WB 2000 mls 7/20/99
			      C #define STBPERF_FAST_TEXTURE_DOWNLOAD ; forces explicit rep movsd loop for non-kni texture download: mls 7/30/99
			      C #define C_AUTOSTRIP                   ; turn on the auto stripping code in the C files
			      C #define PERF_USE_255_LOOKUP_TABLE     ; turn on int to float translation by lookup table instead of fpu conversion
			      C //#define PERF_TXTR_LIST_STATIC_CNTR  ; use a static list index in the texture list instead of starting from 1 each time
			      C 
			      C // Changes made by Bob S. just prior to departure - 6/29/2000
			      C #define TEXTURE_REPEAT_NOT_SCALED     ; Sets dwMaxTextureRepeat to 256 and sets the D3DPTEXTURECAPS_TEXREPEATNOTSCALEDBYSIZE
			      C //                                    ; bit for lines and triangles. Per Gary Tarolli.
			      C //                                    ;
			      C #define COLUMNBANDCONTROL_DEFAULT     ; Change the default for CBC to 8 (register value of zero) to be in synch with Glide/Ogl.
			      C //                                    ; Prior default was 32 (register value of 2).
			      C //                                    ;
			      C #define MAXPENDINGBUFFERS             ; Allow pending buffer max to be controlled via the registry.
			      C //                                    ;
			      C #define LODDITHER                     ; Allow Lod Dithering to be controlled via the registry.
			      C //                                    ;
			      C #define LODBIASPERCHIP                ; Allow per-chip Lod Bias values, if multitexturing,
			      C //                                    ; trilinear filtering and > 1 chip. This also requires
			      C //                                    ; LODDITHER code.
			      C //									  ;
			      C #define SLI_ABOVE_1280				  ; Allow SLI operation via the registry at modes 1280 and greater.
			      C //									  ;	Previously we reverted to single chip mode at these
			      C //									  ;	high resolutions due to visual artifacts
			      C 
			      C ;/*
			      C ;end comment `
			      C ;*/
			      C 
				endif ;INCSTBPERF

				ifdef STBPERF_POLYLINE16

 0000				_THK16TEXT   SEGMENT WORD USE16 PUBLIC 'CODE'
 0000				_THK16TEXT   ENDS

 = 0005				PS_NULL         equ 5
 = 0000				LS_SOLID        equ 0
 = 0006				LS_INSIDEFRAME  equ 6

				;; on bit is foreground.
 = 000F				DOT         equ 00000000fh  ;on bit is foreground
 = 00FFFFFF			DASH        equ 000ffffffh  ;dash=24, bkgrnd=8
 = 00F00FFF			DOTDASH     equ 000f00fffh  ;dash=12, bkgrnd=8, dot=4
 = 0F0F0FFF			DASHDOTDOT  equ 00f0f0fffh  ;dash=12, dot1=4, dot2=4, bkgrnd=4

 = 0007				DOT_STYLE_SIZE          equ 7
 = 001F				DASH_STYLE_SIZE         equ 31
 = 001F				DOTDASH_STYLE_SIZE      equ 31
 = 001F				DASHDOTDOT_STYLE_SIZE   equ 31

 = 08000000			MATCH_DIB           equ (8 SHL SSTG_LSPOS_INT_SHIFT)

 = 08001F00			DASH_STYLE          equ (DASH_STYLE_SIZE SHL SSTG_LSSIZE_SHIFT) + MATCH_DIB
 = 0700				DOT_STYLE           equ (DOT_STYLE_SIZE SHL SSTG_LSSIZE_SHIFT)
 = 08001F00			DOTDASH_STYLE       equ (DOTDASH_STYLE_SIZE SHL SSTG_LSSIZE_SHIFT) + MATCH_DIB
 = 08001F00			DASHDOTDOT_STYLE    equ (DASHDOTDOT_STYLE_SIZE SHL SSTG_LSSIZE_SHIFT) + MATCH_DIB

 = 1200				CMD_STIPPLE         equ (SSTG_EN_LINESTIPPLE + SSTG_REVERSIBLE)


				OutputC32       PROTO   FAR PASCAL

				;*----------------------------------------------------------------------
				;Function name: PREPARE_STACK
				;
				;Description:   Align the stack and make room for pParams
				;
				;Information:   This is a MACRO.
				;
				;Return:        VOID
				;----------------------------------------------------------------------*
				extrn _dwDevNode:DWORD
				STB_PREPARESTACK Macro
				        and     sp, NOT 3       ; align stack
				        push    _dwDevNode      ; leave room on stack for pParams
				Endm


				;*----------------------------------------------------------------------
				;Function name: FARCALL32
				;
				;Description:   The call that "thunks" to the 32-bit side.
				;
				;Information:   This is a MACRO.
				;
				;Return:        VOID
				;----------------------------------------------------------------------*
				extrn _apfnTable32:DWORD
				extrn wFlatDataSel:WORD
				;;;extrn _pfnTemp32:FWORD
				STB_FARCALL32 Macro FnNumber
				        mov     ax, wFlatDataSel
				        mov     es, ax
				        mov     ecx, _apfnTable32
				        mov     edx, es:[ecx][FnNumber*4]
				        call    DWORD PTR [edx]
				;;;        mov     DWORD PTR _pfnTemp32, edx
				;;;        call    [_pfnTemp32]
				Endm


 0000				_DATA   SEGMENT WORD USE16 PUBLIC 'DATA'

				;;   **********************************************************************   
				;;/*  
				;;/*   
				;;   << THIS TABLE, rop2ConvertTable, is FOR LINES ONLY >>
				;;   The rop2ConvertTable converts the Rop2 in Drawmode to rop3.
				;;   that use src argument instead of pattern arguement.
				;;   Rop2 operate on dest and pattern.  However the hardware feeds the
				;;   stipple patterns as source input into the rops.
				;;*/
				;;   **********************************************************************   
 0000 00000000			rop2ConvertTable    dd  000000000h       ;; filler
 0004  00000000			                    dd  000000000h       ;; R2_BLACK
 0008  11000000			                    dd  011000000h       ;; notmergepen   DSon
 000C  22000000			                    dd  022000000h       ;; masknotpen    DSna   
 0010  33000000			                    dd  033000000h       ;; notcopypen    Sn
 0014  44000000			                    dd  044000000h       ;; maskpennot    SDna
 0018  55000000			                    dd  055000000h       ;; not           Dn
 001C  66000000			                    dd  066000000h       ;; xorpen        DSx
 0020  77000000			                    dd  077000000h       ;; notmaskpen    DSan
 0024  88000000			                    dd  088000000h       ;; maskpen       DSa
 0028  99000000			                    dd  099000000h       ;; notxorpen     DSxn
 002C  AA000000			                    dd  0AA000000h       ;; nop           D
 0030  BB000000			                    dd  0BB000000h       ;; mergenotpen   DSno
 0034  CC000000			                    dd  0CC000000h       ;; copy pen      S
 0038  DD000000			                    dd  0DD000000h       ;; mergepennot   SDno
 003C  EE000000			                    dd  0EE000000h       ;; mergepen      DSo
 0040  FF000000			                    dd  0FF000000h       ;; white         1


				;// To reduce the amount of code needed to process pen styles, this
				;// array contains the lineStyle, lineStipple, and cmdData values
				;// needed for each style. We can then look up the values based on
				;// the given pen style instead of calculating the values each time.
				;// Note, we use the GDIDEFS.H MaxLineStyle, but we add one because
				;// the styles start with 0!
 0044 00000000 00000000		PenConvert          dd  000000000h, 000000000h,         000000000h      ;LS_SOLID
       00000000
 0050  00FFFFFF 08001F00	                    dd  DASH,       DASH_STYLE,         CMD_STIPPLE     ;LS_DASHED
       00001200
 005C  0000000F 00000700	                    dd  DOT,        DOT_STYLE,          CMD_STIPPLE     ;LS_DOTTED
       00001200
 0068  00F00FFF 08001F00	                    dd  DOTDASH,    DOTDASH_STYLE,      CMD_STIPPLE     ;LS_DOTDASHED
       00001200
 0074  0F0F0FFF 08001F00	                    dd  DASHDOTDOT, DASHDOTDOT_STYLE,   CMD_STIPPLE     ;LS_DASHDOTDOT
       00001200
 0080  00000000 00000000	                    dd  000000000h, 000000000h,         000000000h      ;LS_NOLINE
       00000000


 008C 00000000			NumSingleLine       dd 0
 0090 00000000			NumSinglePixelLine  dd 0
				                        
