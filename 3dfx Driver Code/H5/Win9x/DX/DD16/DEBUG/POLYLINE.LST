 0014  81 F2 8000		        xor     dx,                 VRAM                        ; flip polarity of the VRAM bit
 0018  F7 C2 9010		        test    dx,                 VRAM+BUSY+PALETTE_XLAT		; check this here to avoid loading ds again later!
 001C  75 62			        jnz     pl_trivialreject								; if not in the FB, or hardware is BUSY, or XLAT req'd, then punt

