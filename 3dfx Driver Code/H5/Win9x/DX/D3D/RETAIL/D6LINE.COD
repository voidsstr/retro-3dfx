__real@4@3ffd90a3d70000000000 DD 03e90a3d7r	; 0.2825
CONST	ENDS
_TEXT	SEGMENT
_ax$ = 8
_ay$ = 12
_bx$ = 16
_by$ = 20
_xAdj1$ = 24
_yAdj1$ = 28
_xAdj2$ = 32
_yAdj2$ = 36
_yAdj$ = 16
_tan$ = 16
_calcSubPixelAdj PROC NEAR

; 268  :   DWORD quad;
; 269  :   float xAdj, yAdj;
; 270  :   float dy, dx;
; 271  :   float xa, ya;
; 272  :   float tan;
; 273  : 
; 274  : #if 0
; 275  :   // Adjust on the fly--for debugging...
; 276  :   xa = fSubPixAdj[ ndxXAdj ];  // Get X Adjust value
; 277  :   ya = fSubPixAdj[ ndxYAdj ];  // Get Y Adjust value
; 278  : #endif
; 279  : 
; 280  :   // Base values that give the closest match.
; 281  :   //
; 282  :   xa = 0.565f;  // Get X Adjust value
; 283  :   ya = 0.565f;  // Get X Adjust value
; 284  : 
; 285  :   dx = bx - ax;

  00000	d9 44 24 0c	 fld	 DWORD PTR _bx$[esp-4]
  00004	d8 64 24 04	 fsub	 DWORD PTR _ax$[esp-4]

; 286  :   dy = by - ay;

  00008	d9 44 24 10	 fld	 DWORD PTR _by$[esp-4]
  0000c	d8 64 24 08	 fsub	 DWORD PTR _ay$[esp-4]

; 287  : 
; 288  :   // Quad 3   |  Quad 2
; 289  :   // ---------+---------
; 290  :   // Quad 4   |  Quad 1
; 291  :   //
; 292  :   if ( dx >= 0.0f )  // dx is positive

  00010	d9 c1		 fld	 ST(1)
  00012	d8 1d 00 00 00
	00		 fcomp	 DWORD PTR __real@4@00000000000000000000
  00018	df e0		 fnstsw	 ax

; 293  :   {
; 294  :     if ( dy >= 0.0f ) quad = 1;

  0001a	d8 15 00 00 00
	00		 fcom	 DWORD PTR __real@4@00000000000000000000
  00020	f6 c4 01	 test	 ah, 1
  00023	df e0		 fnstsw	 ax
  00025	75 13		 jne	 SHORT $L36130
  00027	f6 c4 01	 test	 ah, 1
  0002a	75 07		 jne	 SHORT $L36131
  0002c	b9 01 00 00 00	 mov	 ecx, 1

; 295  :     else              quad = 2;

  00031	eb 16		 jmp	 SHORT $L36135
$L36131:
  00033	b9 02 00 00 00	 mov	 ecx, 2

; 296  :   }
; 297  :   else // dx is negative

  00038	eb 0f		 jmp	 SHORT $L36135
$L36130:

; 298  :   {
; 299  :     if ( dy >= 0.0f ) quad = 4;

  0003a	f6 c4 01	 test	 ah, 1
  0003d	b9 04 00 00 00	 mov	 ecx, 4
  00042	74 05		 je	 SHORT $L36135

; 300  :     else             quad = 3;

  00044	b9 03 00 00 00	 mov	 ecx, 3
$L36135:

; 301  :   }
; 302  : 
; 303  :   // Make absolute values..
; 304  :   if (dx < 0.f) dx = -dx;

  00049	d9 c1		 fld	 ST(1)
  0004b	d8 1d 00 00 00
	00		 fcomp	 DWORD PTR __real@4@00000000000000000000
  00051	df e0		 fnstsw	 ax
  00053	f6 c4 01	 test	 ah, 1
  00056	74 06		 je	 SHORT $L36136
  00058	d9 c9		 fxch	 ST(1)
  0005a	d9 e0		 fchs
  0005c	d9 c9		 fxch	 ST(1)
$L36136:

; 305  :   if (dy < 0.f) dy = -dy;

  0005e	d8 15 00 00 00
	00		 fcom	 DWORD PTR __real@4@00000000000000000000
  00064	df e0		 fnstsw	 ax
  00066	f6 c4 01	 test	 ah, 1
  00069	74 02		 je	 SHORT $L36137
  0006b	d9 e0		 fchs
$L36137:

; 306  : 
; 307  :   if ( dx == 0 )	// vertical line

  0006d	d9 c1		 fld	 ST(1)
  0006f	d8 1d 00 00 00
	00		 fcomp	 DWORD PTR __real@4@00000000000000000000
  00075	df e0		 fnstsw	 ax
  00077	f6 c4 40	 test	 ah, 64			; 00000040H
  0007a	74 17		 je	 SHORT $L36138
  0007c	dd d8		 fstp	 ST(0)

; 308  :   {
; 309  :     xAdj = xa;
; 310  :     yAdj = 0;

  0007e	c7 44 24 0c 00
	00 00 00	 mov	 DWORD PTR _yAdj$[esp-4], 0
  00086	dd d8		 fstp	 ST(0)
  00088	d9 05 00 00 00
	00		 fld	 DWORD PTR __real@4@3ffe90a3d70000000000

; 311  :     goto SignFixup;

  0008e	e9 a8 00 00 00	 jmp	 $SignFixup$36139
$L36138:

; 312  :   }
; 313  :   else if ( dy == 0 )	// horizontal line

  00093	d8 15 00 00 00
	00		 fcom	 DWORD PTR __real@4@00000000000000000000
  00099	df e0		 fnstsw	 ax
  0009b	f6 c4 40	 test	 ah, 64			; 00000040H
  0009e	74 17		 je	 SHORT $L36141
  000a0	dd d8		 fstp	 ST(0)

; 314  :   {
; 315  :     xAdj = 0;
; 316  :     yAdj = ya;

  000a2	c7 44 24 0c d7
	a3 10 3f	 mov	 DWORD PTR _yAdj$[esp-4], 1058055127 ; 3f10a3d7H
  000aa	dd d8		 fstp	 ST(0)
  000ac	d9 05 00 00 00
	00		 fld	 DWORD PTR __real@4@00000000000000000000

; 317  :     goto SignFixup;

  000b2	e9 84 00 00 00	 jmp	 $SignFixup$36139
$L36141:

; 318  :   }
; 319  : 
; 320  :   if (dx > dy)

  000b7	d9 c1		 fld	 ST(1)
  000b9	d8 d9		 fcomp	 ST(1)
  000bb	df e0		 fnstsw	 ax
  000bd	f6 c4 41	 test	 ah, 65			; 00000041H
  000c0	75 2e		 jne	 SHORT $L36142

; 321  :   { 
; 322  :     // X Major - This is the region of a quadarant from the 45 degree
; 323  :     //           down to the X axis, i.e. as we move away from the 45
; 324  :     //           degree angle, Y diminishes to 0.
; 325  : 
; 326  :     // Percentage of the height (Y) w.r.t the width (X)
; 327  :     //
; 328  :     tan = dy / dx; // Goes from 1.0 ---> 0.0 as Y decreases

  000c2	d8 f1		 fdiv	 ST(0), ST(1)
  000c4	d9 5c 24 0c	 fstp	 DWORD PTR _tan$[esp-4]
  000c8	dd d8		 fstp	 ST(0)

; 329  : 
; 330  :     // At the 45 degree angle of the quadrant, i.e. tan == 1.0, and we return
; 331  :     // XAdj/2, YAdj/2.  As we move from the 45 degree angle
; 332  :     // (tan == 1.0) towards the X axis, XAdj decreases to zero and 
; 333  :     // YAdj increases to the full value, in order make a T cross bar perpendicular
; 334  :     // to the X axis.
; 335  :     xAdj = (float)(( xa * tan ) / 2.0f);

  000ca	d9 44 24 0c	 fld	 DWORD PTR _tan$[esp-4]
  000ce	d8 0d 00 00 00
	00		 fmul	 DWORD PTR __real@4@3ffe90a3d70000000000
  000d4	d8 0d 00 00 00
	00		 fmul	 DWORD PTR __real@4@3ffe8000000000000000

; 336  :     yAdj = (float) ( ya - ((ya  / 2.0f) * tan ));

  000da	d9 44 24 0c	 fld	 DWORD PTR _tan$[esp-4]
  000de	d8 0d 00 00 00
	00		 fmul	 DWORD PTR __real@4@3ffd90a3d70000000000
  000e4	d8 2d 00 00 00
	00		 fsubr	 DWORD PTR __real@4@3ffe90a3d70000000000
  000ea	d9 5c 24 0c	 fstp	 DWORD PTR _yAdj$[esp-4]

; 337  :   }
; 338  :   else if ( dy > dx )

  000ee	eb 4b		 jmp	 SHORT $SignFixup$36139
$L36142:
  000f0	d8 d1		 fcom	 ST(1)
  000f2	df e0		 fnstsw	 ax
  000f4	f6 c4 41	 test	 ah, 65			; 00000041H
  000f7	75 30		 jne	 SHORT $L36146

; 339  :   {
; 340  :     // Y Major - This is the region of a quadarant from the 45 degree
; 341  :     //           over to the Y axis, i.e. as we move away from the 45
; 342  :     //           degree angle, X diminishes to 0.
; 343  : 
; 344  :     // Percentage of the width (X) w.r.t the height (Y)
; 345  :     //
; 346  :     tan = dx / dy;

  000f9	d9 c9		 fxch	 ST(1)
  000fb	d8 f1		 fdiv	 ST(0), ST(1)
  000fd	d9 5c 24 0c	 fstp	 DWORD PTR _tan$[esp-4]
  00101	dd d8		 fstp	 ST(0)

; 347  : 
; 348  :     // At the 45 degree angle of the quadrant, i.e. tan == 1.0, and we return
; 349  :     // XAdj/2, YAdj/2.  As we move from the 45 degree angle
; 350  :     // (tan == 1.0) towards the Y axis, XAdj increases to full value and
; 351  :     // YAdj decreases to zero, , in order make a T cross bar perpendicular
; 352  :     // to the Y axis.
; 353  :     xAdj = (float) ( xa - ((xa  / 2.0f) * tan ));

  00103	d9 44 24 0c	 fld	 DWORD PTR _tan$[esp-4]
  00107	d8 0d 00 00 00
	00		 fmul	 DWORD PTR __real@4@3ffd90a3d70000000000
  0010d	d8 2d 00 00 00
	00		 fsubr	 DWORD PTR __real@4@3ffe90a3d70000000000

; 354  :     yAdj = (float)(( ya * tan ) / 2.0f);

  00113	d9 44 24 0c	 fld	 DWORD PTR _tan$[esp-4]
  00117	d8 0d 00 00 00
	00		 fmul	 DWORD PTR __real@4@3ffe90a3d70000000000
  0011d	d8 0d 00 00 00
	00		 fmul	 DWORD PTR __real@4@3ffe8000000000000000
