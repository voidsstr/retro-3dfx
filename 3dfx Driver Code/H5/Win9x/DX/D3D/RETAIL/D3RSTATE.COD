_dummy@8 PROC NEAR

; 802  :   D3DPRINT( 255, "Warning: This state is unsupported. Check capability flags" );
; 803  :   RENDERFXN_OK;

  00000	33 c0		 xor	 eax, eax

; 804  : }

  00002	c2 08 00	 ret	 8
_dummy@8 ENDP
_pRc$ = 8
_state$ = 12
_antialiasing@8 PROC NEAR

; 815  :   SETUP_PPDEV(pRc)
; 816  : 
; 817  :   D3DPRINT( RSTATE_DBG_LVL, "Antialiasing Renderstate %d", state );
; 818  : 
; 819  :   CHECK_STATE_LIMITS(state, D3DANTIALIAS_NONE, D3DANTIALIAS_SORTINDEPENDENT);
; 820  : 
; 821  :   // If we are allowing antialiasing, then set to passed state.
; 822  :   // Otherwise, force it to be off.
; 823  :   if ( _D3( enableAntialias ) )

  00010	8b 44 24 04	 mov	 eax, DWORD PTR _pRc$[esp-4]
  00014	8b 48 08	 mov	 ecx, DWORD PTR [eax+8]
  00017	8b 91 1c 18 00
	00		 mov	 edx, DWORD PTR [ecx+6172]
  0001d	8b 8a d0 00 00
	00		 mov	 ecx, DWORD PTR [edx+208]
  00023	85 c9		 test	 ecx, ecx
  00025	74 0c		 je	 SHORT $L37349

; 824  :   {
; 825  :     pRc->antialias = state;

  00027	8b 4c 24 08	 mov	 ecx, DWORD PTR _state$[esp-4]
  0002b	89 48 10	 mov	 DWORD PTR [eax+16], ecx

; 830  :   }
; 831  : 
; 832  :   RENDERFXN_OK;

  0002e	33 c0		 xor	 eax, eax

; 833  : }

  00030	c2 08 00	 ret	 8
$L37349:

; 826  :   }
; 827  :   else
; 828  :   {
; 829  :     pRc->antialias = 0;

  00033	c7 40 10 00 00
	00 00		 mov	 DWORD PTR [eax+16], 0

; 830  :   }
; 831  : 
; 832  :   RENDERFXN_OK;

  0003a	33 c0		 xor	 eax, eax

; 833  : }

  0003c	c2 08 00	 ret	 8
_antialiasing@8 ENDP
_edgeAntialiasing@8 PROC NEAR

; 844  :   D3DPRINT( RSTATE_DBG_LVL, "Edge Antialiasing Renderstate %d", state );
; 845  :   RENDERFXN_OK;

  00040	33 c0		 xor	 eax, eax

; 846  : }

  00042	c2 08 00	 ret	 8
_edgeAntialiasing@8 ENDP
_TEXT	ENDS
