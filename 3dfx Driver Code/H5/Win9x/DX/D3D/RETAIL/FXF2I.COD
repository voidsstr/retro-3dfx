PUBLIC	_float2int
_TEXT	SEGMENT
_f$ = 8
_float2int PROC NEAR

; 75   :   int  expnt, mantissa;
; 76   :   BOOL neg = FALSE;
; 77   :   
; 78   :   mantissa = expnt = *(int *)&f;
; 79   : 
; 80   : //  D3DPRINT( 255,"float2Int float=0x%x ",*(int *)&f );
; 81   : 
; 82   :   // special case
; 83   :   if( mantissa == 0 )

  00000	8b 54 24 04	 mov	 edx, DWORD PTR _f$[esp-4]
  00004	56		 push	 esi
  00005	33 f6		 xor	 esi, esi
  00007	85 d2		 test	 edx, edx
  00009	75 04		 jne	 SHORT $L35976

; 84   :     return 0;

  0000b	33 c0		 xor	 eax, eax
  0000d	5e		 pop	 esi

; 115  : 
; 116  : //  D3DPRINT( 0,"float2Int int=%d ",mantissa );
; 117  : 
; 118  :   return mantissa;
; 119  : }

  0000e	c3		 ret	 0
$L35976:

; 85   : 
; 86   :   if( expnt & 0x80000000 )

  0000f	f7 c2 00 00 00
	80		 test	 edx, -2147483648	; 80000000H
  00015	74 05		 je	 SHORT $L35977

; 87   :     neg = TRUE;

  00017	be 01 00 00 00	 mov	 esi, 1
$L35977:

; 88   : 
; 89   :   // remove the exponent and add in implicit one
; 90   :   mantissa = (mantissa & 0x007fffff) | 0x00800000;

  0001c	8b c2		 mov	 eax, edx

; 91   : 
; 92   :   // exponent - remove mantissa and adjust for bias
; 93   :   expnt = 23 - (((expnt & 0x7F800000) >> 23) - 127);

  0001e	c1 fa 17	 sar	 edx, 23			; 00000017H
  00021	81 e2 ff 00 00
	00		 and	 edx, 255		; 000000ffH
  00027	25 ff ff 7f 00	 and	 eax, 8388607		; 007fffffH
  0002c	b9 96 00 00 00	 mov	 ecx, 150		; 00000096H
  00031	2b ca		 sub	 ecx, edx
  00033	0d 00 00 80 00	 or	 eax, 8388608		; 00800000H

; 94   : 
; 95   :   // shift by the exponent to get rid of the exponent. Need to use
; 96   :   // 23 - expnt because expnt is number of positions to the left of
; 97   :   // decimal and we want to get rid of the positions to the right of decimal
; 98   : /*
; 99   :   if( expnt > 31 )
; 100  :     mantissa = 0;
; 101  :   else
; 102  :     mantissa = mantissa >> expnt;
; 103  : */
; 104  : //PingZ 8/5/99  The above line is wrong.  It only works if expnt is less than 23. If expnt is 
; 105  : //greater than 23 but less than 31 it will convert matissa to zero!
; 106  : //Here is the correct way to do it.
; 107  : 
; 108  :    if(expnt > 0) 

  00038	85 c9		 test	 ecx, ecx
  0003a	7e 04		 jle	 SHORT $L35978

; 109  :       mantissa >>= expnt;

  0003c	d3 f8		 sar	 eax, cl

; 110  :    else

  0003e	eb 04		 jmp	 SHORT $L35979
$L35978:

; 111  :       mantissa <<= (-expnt);

  00040	f7 d9		 neg	 ecx
  00042	d3 e0		 shl	 eax, cl
$L35979:

; 112  : 
; 113  :   if (neg)

  00044	85 f6		 test	 esi, esi
  00046	74 02		 je	 SHORT $L35971

; 114  :     mantissa = -mantissa;

  00048	f7 d8		 neg	 eax
$L35971:
  0004a	5e		 pop	 esi

; 115  : 
; 116  : //  D3DPRINT( 0,"float2Int int=%d ",mantissa );
; 117  : 
; 118  :   return mantissa;
; 119  : }

  0004b	c3		 ret	 0
_float2int ENDP
_TEXT	ENDS
END
