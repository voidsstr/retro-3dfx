  00001	8b 74 24 08	 mov	 esi, DWORD PTR _ppdev$[esp]
  00005	f7 86 1e 2a 00
	00 00 00 02 00	 test	 DWORD PTR [esi+10782], 131072 ; 00020000H
  0000f	75 04		 jne	 SHORT $L37087
  00011	33 c0		 xor	 eax, eax
  00013	5e		 pop	 esi

; 846  : }

  00014	c3		 ret	 0
$L37087:

; 719  : #endif
