  0003b	f7 d8		 neg	 eax
  0003d	1b c0		 sbb	 eax, eax
  0003f	40		 inc	 eax
  00040	89 44 24 08	 mov	 DWORD PTR _optEnable$[esp], eax

; 723  : 
; 724  :   if (optEnable) {

  00044	0f 84 ca 00 00
	00		 je	 $L37090
$L37850:

; 725  :     _3DNowAllowed = TRUE;
