; 721  :   if (GETENV(regDisOptKey))

  00015	68 00 00 00 00	 push	 OFFSET FLAT:_?regDisOptKey@?1??ADJUST3DNOWPOINTERS@@9@9
  0001a	56		 push	 esi
  0001b	e8 00 00 00 00	 call	 _ddgetenv
  00020	83 c4 08	 add	 esp, 8
  00023	85 c0		 test	 eax, eax
  00025	74 23		 je	 SHORT $L37850

; 722  :     optEnable=!(BOOL)atoi(GETENV(regDisOptKey));

