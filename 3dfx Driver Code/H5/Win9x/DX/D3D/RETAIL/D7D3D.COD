  000a3	53		 push	 ebx
  000a4	8b 5c 24 14	 mov	 ebx, DWORD PTR _ppdev$[esp+36]
  000a8	57		 push	 edi
  000a9	55		 push	 ebp
  000aa	53		 push	 ebx
