; 333  :     // find or allocate the HNDLLIST associated with this pDDLcl
; 334  :     pHndlList = GetHndlListPtr(ppdev, pDDLcl);

  00077	8b 44 24 10	 mov	 eax, DWORD PTR _ppdev$[esp+32]
  0007b	55		 push	 ebp
  0007c	50		 push	 eax
  0007d	e8 00 00 00 00	 call	 _GetHndlListPtr
  00082	8b f8		 mov	 edi, eax
  00084	83 c4 08	 add	 esp, 8

; 335  :     if (NULL == pHndlList)

