; 235  :   }
; 236  : 
; 237  :   // We check that what we are handling is a texture, zbuffer or a rendering
; 238  :   // target buffer. We don't check if it is however stored in local video
; 239  :   // memory since it might also be a system memory texture that we will later
; 240  :   // blt with __TextureBlt.
