; 288  : #else
; 289  :   ppdev = (NT9XDEVICEDATA *)pcsxd->lpDDLcl->lpGbl->dwReserved3;
; 290  : #endif
; 291  : 
; 292  :   // Now allocate the texture data space
; 293  :   do
; 294  :   {
; 295  :     D3DPRINT(NORMAL_DBG_LEVEL, "pDDLcl = %8lXh, pDDSLcl = %8lXh, dwHandle = %ld, dwCaps = %08lXh",
; 296  :              pDDLcl, pDDSLcl, pDDSLcl->lpSurfMore->dwSurfaceHandle, pDDSLcl->ddsCaps.dwCaps);
; 297  : 
; 298  : #if defined(WINNT) && DBG
; 299  :     // print out surface desc info for system memory surfaces
; 300  :     if (DDSCAPS_SYSTEMMEMORY & pDDSLcl->ddsCaps.dwCaps)
; 301  :     {
; 302  :       extern VOID DUMP_SURFACEINFO(NT9XDEVICEDATA*,LPDDRAWI_DDRAWSURFACE_LCL);
; 303  :       DUMP_SURFACEINFO(ppdev,pDDSLcl);
; 304  :       if (DDSCAPS_MIPMAP & pDDSLcl->ddsCaps.dwCaps)
; 305  :       {
; 306  :         LPDDRAWI_DDRAWSURFACE_LCL pSurf = pDDSLcl;
; 307  :         int i;
; 308  : 
; 309  :         D3DPRINT(NORMAL_DBG_LEVEL, "    mipmap count = %8lXh", pDDSLcl->lpSurfMore->dwMipMapCount);
; 310  : 
; 311  :         i = 0;
; 312  :         while (NULL != pSurf)
; 313  :         {
; 314  :           D3DPRINT(NORMAL_DBG_LEVEL,"      surf=%d pSurf=%8lXh handle=%4ld fpVidMem=%8lXh lPitch=%8lXh, width=%8lXh, height=%8lXh",
; 315  :                    i++, pSurf, pSurf->lpSurfMore->dwSurfaceHandle, pSurf->lpGbl->fpVidMem, pSurf->lpGbl->lPitch, pSurf->lpGbl->wWidth, pSurf->lpGbl->wHeight);
; 316  : 
; 317  :           if (NULL != pSurf->lpAttachList)
; 318  :             pSurf = pSurf->lpAttachList->lpAttached;
; 319  :           else
; 320  :             pSurf = NULL;
; 321  :         }
; 322  :       }
; 323  :     }
; 324  : #endif
; 325  : 
; 326  :     if (0 == pDDSLcl->lpSurfMore->dwSurfaceHandle)

  0005b	8b 16		 mov	 edx, DWORD PTR [esi]
  0005d	8b 45 04	 mov	 eax, DWORD PTR [ebp+4]
  00060	8b 88 30 04 00
	00		 mov	 ecx, DWORD PTR [eax+1072]
  00066	53		 push	 ebx
  00067	8b 5a 64	 mov	 ebx, DWORD PTR [edx+100]
  0006a	85 db		 test	 ebx, ebx
  0006c	57		 push	 edi
  0006d	89 4c 24 10	 mov	 DWORD PTR _ppdev$[esp+32], ecx
  00071	0f 84 34 02 00
	00		 je	 $L36155
$L36153:

; 327  :     {
; 328  :       D3DPRINT(0,"ddiCreateSurfaceEx got 0 dwSurfaceHandle, dwCaps=%08lXh",
; 329  :                pDDSLcl->ddsCaps.dwCaps);
; 330  :       break;
; 331  :     }
