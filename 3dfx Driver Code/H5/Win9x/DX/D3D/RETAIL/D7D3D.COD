; 246  :                                    DDSCAPS_3DDEVICE |
; 247  :                                    DDSCAPS_ZBUFFER  |
; 248  :                                    DDSCAPS_EXECUTEBUFFER)))
; 249  : #else
; 250  : 
; 251  :   if (!(pDDSLcl->ddsCaps.dwCaps & (DDSCAPS_TEXTURE  |
; 252  :                                    DDSCAPS_3DDEVICE |
; 253  :                                    DDSCAPS_ZBUFFER)))

  0004e	f7 46 20 00 30
	02 00		 test	 DWORD PTR [esi+32], 143360 ; 00023000H

; 254  : #endif // TnL_HAL & Vertex Buffer support
; 255  :   {
; 256  :     D3DPRINT(NORMAL_DBG_LEVEL,"ddiCreateSurfaceEx w/o "
; 257  :                               "DDSCAPS_TEXTURE/3DDEVICE/ZBUFFER Ignored, "
; 258  :                               "dwCaps=%8lXh dwSurfaceHandle=%ld",
; 259  :              pDDSLcl->ddsCaps.dwCaps,
; 260  :              pDDSLcl->lpSurfMore->dwSurfaceHandle);
; 261  : 
; 262  :     return DDHAL_DRIVER_HANDLED;

  00055	0f 84 5f 02 00
	00		 je	 $L36146

; 263  :   }
; 264  : #endif // DX8
; 265  : #ifdef DEBUG
; 266  :   if (pDDSLcl->ddsCaps.dwCaps & DDSCAPS_TEXTURE)
; 267  :   {
; 268  :       D3DPRINT(17, "ddiCreateSurfaceEx: TEXTURE, dwCaps=%8lXh dwSurfaceHandle=%ld",
; 269  :              pDDSLcl->ddsCaps.dwCaps,
; 270  :              pDDSLcl->lpSurfMore->dwSurfaceHandle);
; 271  :   }
; 272  :   if (pDDSLcl->ddsCaps.dwCaps & DDSCAPS_3DDEVICE)
; 273  :   {
; 274  :       D3DPRINT(17, "ddiCreateSurfaceEx: 3DDEVICE, dwCaps=%8lXh dwSurfaceHandle=%ld",
; 275  :              pDDSLcl->ddsCaps.dwCaps,
; 276  :              pDDSLcl->lpSurfMore->dwSurfaceHandle);
; 277  :   }
; 278  :   if (pDDSLcl->ddsCaps.dwCaps & DDSCAPS_ZBUFFER)
; 279  :   {
; 280  :       D3DPRINT(17, "ddiCreateSurfaceEx: ZBUFFER, dwCaps=%8lXh dwSurfaceHandle=%ld",
; 281  :              pDDSLcl->ddsCaps.dwCaps,
; 282  :              pDDSLcl->lpSurfMore->dwSurfaceHandle);
; 283  :   }
; 284  : #endif
