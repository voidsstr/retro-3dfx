PUBLIC	_DecodeBlockRGB
_TEXT	SEGMENT
_pblockSrc$ = 8
_colorDst$ = 12
_clut$ = -16
_DecodeBlockRGB PROC NEAR

; 91   : {

  00000	83 ec 10	 sub	 esp, 16			; 00000010H
  00003	53		 push	 ebx
  00004	55		 push	 ebp

; 92   :    int         lev;
; 93   :    DXT_COLOR   clut[4];
; 94   :    PIXBM       pixbm;
; 95   :    int         pixel;
; 96   :    int         primary;
; 97   : 
; 98   :    // if source block is invalid, ...
; 99   :    if (pblockSrc == 0)

  00005	8b 6c 24 1c	 mov	 ebp, DWORD PTR _pblockSrc$[esp+20]
  00009	33 db		 xor	 ebx, ebx
  0000b	3b eb		 cmp	 ebp, ebx
  0000d	0f 84 f2 00 00
	00		 je	 $L36074

; 100  :       return;
; 101  : 
; 102  :    // determine the number of color levels in the block
; 103  :    lev = (pblockSrc->rgb0 <= pblockSrc->rgb1) ? 2 : 3;

  00013	66 8b 45 00	 mov	 ax, WORD PTR [ebp]
  00017	66 39 45 02	 cmp	 WORD PTR [ebp+2], ax
  0001b	56		 push	 esi
  0001c	57		 push	 edi
  0001d	8d 7d 02	 lea	 edi, DWORD PTR [ebp+2]
  00020	1b f6		 sbb	 esi, esi

; 104  : 
; 105  :    // Fill extrema values into pixel code lookup table.
; 106  :    RGBToColor(&pblockSrc->rgb0, &clut[0]);

  00022	8d 4c 24 10	 lea	 ecx, DWORD PTR _clut$[esp+32]
  00026	51		 push	 ecx
  00027	f7 de		 neg	 esi
  00029	55		 push	 ebp
  0002a	83 c6 02	 add	 esi, 2
  0002d	e8 00 00 00 00	 call	 _RGBToColor

; 107  :    RGBToColor(&pblockSrc->rgb1, &clut[1]);

  00032	8d 54 24 1c	 lea	 edx, DWORD PTR _clut$[esp+44]
  00036	52		 push	 edx
  00037	57		 push	 edi
  00038	e8 00 00 00 00	 call	 _RGBToColor
  0003d	83 c4 10	 add	 esp, 16			; 00000010H

; 108  : 
; 109  :    clut[0].rgba[ALFA] =
; 110  :    clut[1].rgba[ALFA] =
; 111  :    clut[2].rgba[ALFA] = 255;
; 112  : 
; 113  :    if (lev == 3)

  00040	83 fe 03	 cmp	 esi, 3
  00043	c6 44 24 1b ff	 mov	 BYTE PTR _clut$[esp+43], 255 ; 000000ffH
  00048	c6 44 24 17 ff	 mov	 BYTE PTR _clut$[esp+39], 255 ; 000000ffH
  0004d	c6 44 24 13 ff	 mov	 BYTE PTR _clut$[esp+35], 255 ; 000000ffH
  00052	75 53		 jne	 SHORT $L36057

; 114  :    { // No transparency info present, all color info.
; 115  :       for (primary = 0; primary < NUM_PRIMARIES; ++primary)

  00054	33 ff		 xor	 edi, edi
$L36058:

; 116  :       {
; 117  :          WORD temp0 = clut[0].rgba[primary];   // jvanaken fixed overflow bug

  00056	66 0f b6 4c 3c
	10		 movzx	 cx, BYTE PTR _clut$[esp+edi+32]

; 118  :          WORD temp1 = clut[1].rgba[primary];

  0005c	66 0f b6 74 3c
	14		 movzx	 si, BYTE PTR _clut$[esp+edi+36]

; 119  :          clut[2].rgba[primary] = (BYTE)((2*temp0 + temp1 + 1)/3);

  00062	b8 56 55 55 55	 mov	 eax, 1431655766		; 55555556H
  00067	81 e1 ff ff 00
	00		 and	 ecx, 65535		; 0000ffffH
  0006d	81 e6 ff ff 00
	00		 and	 esi, 65535		; 0000ffffH
  00073	8d 54 4e 01	 lea	 edx, DWORD PTR [esi+ecx*2+1]
  00077	f7 ea		 imul	 edx
  00079	8b c2		 mov	 eax, edx
  0007b	c1 e8 1f	 shr	 eax, 31			; 0000001fH
  0007e	03 d0		 add	 edx, eax
  00080	88 54 3c 18	 mov	 BYTE PTR _clut$[esp+edi+40], dl

; 120  :          clut[3].rgba[primary] = (BYTE)((temp0 + 2*temp1 + 1)/3);

  00084	8d 4c 71 01	 lea	 ecx, DWORD PTR [ecx+esi*2+1]
  00088	b8 56 55 55 55	 mov	 eax, 1431655766		; 55555556H
  0008d	f7 e9		 imul	 ecx
  0008f	8b ca		 mov	 ecx, edx
  00091	c1 e9 1f	 shr	 ecx, 31			; 0000001fH
  00094	03 d1		 add	 edx, ecx
  00096	88 54 3c 1c	 mov	 BYTE PTR _clut$[esp+edi+44], dl
  0009a	47		 inc	 edi
  0009b	83 ff 03	 cmp	 edi, 3
  0009e	7c b6		 jl	 SHORT $L36058

; 121  :       }
; 122  :       clut[3].rgba[ALFA] = 255;

  000a0	c6 44 24 1f ff	 mov	 BYTE PTR _clut$[esp+47], 255 ; 000000ffH

; 123  :    }
; 124  :    else

  000a5	eb 27		 jmp	 SHORT $L36065
$L36057:

; 125  :    {  // transparency info.
; 126  :       for (primary = 0; primary < NUM_PRIMARIES; ++primary)

  000a7	33 c9		 xor	 ecx, ecx
$L36066:

; 127  :       {
; 128  :          WORD temp0 = clut[0].rgba[primary];   // jvanaken fixed overflow bug
; 129  :          WORD temp1 = clut[1].rgba[primary];
; 130  :          clut[2].rgba[primary] = (BYTE)((temp0 + temp1)/2);

  000a9	33 c0		 xor	 eax, eax
  000ab	8a 44 0c 14	 mov	 al, BYTE PTR _clut$[esp+ecx+36]
  000af	33 d2		 xor	 edx, edx
  000b1	8a 54 0c 10	 mov	 dl, BYTE PTR _clut$[esp+ecx+32]
  000b5	03 c2		 add	 eax, edx
  000b7	99		 cdq
  000b8	2b c2		 sub	 eax, edx
  000ba	d1 f8		 sar	 eax, 1
  000bc	88 44 0c 18	 mov	 BYTE PTR _clut$[esp+ecx+40], al

; 131  :          clut[3].rgba[primary] = 0;     // jvanaken added this

  000c0	88 5c 0c 1c	 mov	 BYTE PTR _clut$[esp+ecx+44], bl
  000c4	41		 inc	 ecx
  000c5	83 f9 03	 cmp	 ecx, 3
  000c8	7c df		 jl	 SHORT $L36066

; 132  :       }
; 133  :       clut[3].rgba[ALFA] = 0;

  000ca	88 5c 24 1f	 mov	 BYTE PTR _clut$[esp+47], bl
$L36065:

; 134  :    }
; 135  : 
; 136  :    // munge a local copy
; 137  :    pixbm = pblockSrc->pixbm;

  000ce	8b 75 04	 mov	 esi, DWORD PTR [ebp+4]
  000d1	8b 4c 24 28	 mov	 ecx, DWORD PTR _colorDst$[esp+28]
  000d5	bf 10 00 00 00	 mov	 edi, 16			; 00000010H
$L36072:

; 138  : 
; 139  :    // Look up the actual pixel color in the table.
; 140  :    for (pixel=0; pixel < DXT_BLOCK_PIXELS; ++pixel)
; 141  :    {
; 142  :       // lookup color from pixel bitmap
; 143  :       for (primary = 0; primary < NUM_PRIMARIES; ++primary)

  000da	8b c6		 mov	 eax, esi
  000dc	83 e0 03	 and	 eax, 3
  000df	c1 e0 02	 shl	 eax, 2

; 144  :          colorDst[pixel].rgba[primary] = clut[pixbm & 3].rgba[primary];

  000e2	66 8b 5c 04 10	 mov	 bx, WORD PTR _clut$[esp+eax+32]
  000e7	8b d1		 mov	 edx, ecx
  000e9	66 89 1a	 mov	 WORD PTR [edx], bx
  000ec	8a 5c 04 12	 mov	 bl, BYTE PTR _clut$[esp+eax+34]

; 145  : 
; 146  :       colorDst[pixel].rgba[ALFA] = clut[pixbm & 3].rgba[ALFA];

  000f0	8a 44 04 13	 mov	 al, BYTE PTR _clut$[esp+eax+35]
  000f4	88 5a 02	 mov	 BYTE PTR [edx+2], bl
  000f7	88 41 03	 mov	 BYTE PTR [ecx+3], al

; 147  : 
; 148  :       // prepare to extract next index
; 149  :       pixbm >>= 2;

  000fa	c1 ee 02	 shr	 esi, 2
  000fd	83 c1 04	 add	 ecx, 4
  00100	4f		 dec	 edi
  00101	75 d7		 jne	 SHORT $L36072
  00103	5f		 pop	 edi
  00104	5e		 pop	 esi
$L36074:
  00105	5d		 pop	 ebp
  00106	5b		 pop	 ebx

; 150  :    }
; 151  : }

  00107	83 c4 10	 add	 esp, 16			; 00000010H
  0010a	c3		 ret	 0
_DecodeBlockRGB ENDP
_prgb$ = 8
_pcolor$ = 12
_rgb$ = 8
_color$ = 8
_RGBToColor PROC NEAR

; 46   :    WORD        rgb;
; 47   :    DXT_COLOR   color;
; 48   : 
; 49   :    rgb = *((WORD *)prgb);

  00110	8b 44 24 04	 mov	 eax, DWORD PTR _prgb$[esp-4]
  00114	33 c9		 xor	 ecx, ecx
  00116	66 8b 08	 mov	 cx, WORD PTR [eax]

; 50   : 
; 51   :    // pick off bits in groups of 5, 6, and 5
; 52   :    color.rgba[BLU] = (unsigned char) rgb;

  00119	8a d1		 mov	 dl, cl

; 53   :    rgb >>= BLU_BITS;
; 54   :    color.rgba[GRN] = (unsigned char) rgb;
; 55   :    rgb >>= GRN_BITS;
; 56   :    color.rgba[RED] = (unsigned char) rgb;
; 57   : 
; 58   :    // shift primaries into the appropriate LSBs
; 59   :    color.rgba[BLU] <<= BLU_SHIFT;

  0011b	c0 e2 03	 shl	 dl, 3
  0011e	53		 push	 ebx

; 60   :    color.rgba[GRN] <<= GRN_SHIFT;
; 61   :    color.rgba[RED] <<= RED_SHIFT;
; 62   : 
; 63   :    // replicate primaries MSBs into LSBs
; 64   : 
; 65   :    color.rgba[BLU] |= color.rgba[BLU] >> BLU_BITS;

  0011f	8a da		 mov	 bl, dl
  00121	c0 eb 05	 shr	 bl, 5
  00124	0a d3		 or	 dl, bl
  00126	89 4c 24 08	 mov	 DWORD PTR _rgb$[esp], ecx
  0012a	66 c1 6c 24 08
	05		 shr	 WORD PTR _rgb$[esp], 5
  00130	8b 44 24 08	 mov	 eax, DWORD PTR _rgb$[esp]
  00134	8a 4c 24 08	 mov	 cl, BYTE PTR _rgb$[esp]
  00138	c0 e1 02	 shl	 cl, 2
  0013b	88 54 24 0a	 mov	 BYTE PTR _color$[esp+2], dl

; 66   :    color.rgba[GRN] |= color.rgba[GRN] >> GRN_BITS;

  0013f	8a d1		 mov	 dl, cl
  00141	c1 e8 06	 shr	 eax, 6
  00144	c0 ea 06	 shr	 dl, 6
  00147	0a ca		 or	 cl, dl

; 67   :    color.rgba[RED] |= color.rgba[RED] >> RED_BITS;
; 68   : 
; 69   :    *pcolor = color;

  00149	8b 54 24 0c	 mov	 edx, DWORD PTR _pcolor$[esp]
  0014d	c0 e0 03	 shl	 al, 3
  00150	88 4c 24 09	 mov	 BYTE PTR _color$[esp+1], cl
  00154	8a c8		 mov	 cl, al
  00156	c0 e9 05	 shr	 cl, 5
  00159	0a c1		 or	 al, cl
  0015b	88 44 24 08	 mov	 BYTE PTR _color$[esp], al
  0015f	8b 44 24 08	 mov	 eax, DWORD PTR _color$[esp]
  00163	89 02		 mov	 DWORD PTR [edx], eax
  00165	5b		 pop	 ebx

; 70   : }

  00166	c3		 ret	 0
_RGBToColor ENDP
_TEXT	ENDS
PUBLIC	_EncodeBlockRGB
_TEXT	SEGMENT
_colorSrc$ = 8
_pblockDst$ = 12
_EncodeBlockRGB PROC NEAR

; 318  :    EncodeBlockRGB_i(colorSrc,pblockDst,0);

  00170	8b 44 24 08	 mov	 eax, DWORD PTR _pblockDst$[esp-4]
  00174	8b 4c 24 04	 mov	 ecx, DWORD PTR _colorSrc$[esp-4]
  00178	6a 00		 push	 0
  0017a	50		 push	 eax
  0017b	51		 push	 ecx
  0017c	e8 00 00 00 00	 call	 _EncodeBlockRGB_i
  00181	83 c4 0c	 add	 esp, 12			; 0000000cH

; 319  : }

  00184	c3		 ret	 0
_EncodeBlockRGB ENDP
_colorSrc$ = 8
_pblockDst$ = 12
_ignore_alpha$ = 16
_i$ = -52
_dcolor1$ = -24
_dcolor2$ = -20
_lev$ = -48
_nIdx$ = 8
_tclr1$ = 16
_tclr2$ = -52
