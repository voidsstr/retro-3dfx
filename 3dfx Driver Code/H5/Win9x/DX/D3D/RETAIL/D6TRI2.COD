_dp2TriangleAllFill PROC NEAR

; 257  : {

  00000	53		 push	 ebx
  00001	55		 push	 ebp
  00002	56		 push	 esi

; 258  :   LPDWORD   pA, pB, pC;
; 259  : #ifdef TnL_HAL
; 260  :   DWORD         c0, c1, c2;
; 261  :   LPDWORD       clipcodes = (LPDWORD) pRc->tl.pClipBuf;
; 262  :   DWORD         ClipContinue = 0;       // Tells us if we need to continue the 
; 263  :                                         // clipped triangle alreasy in progress
; 264  :   DWORD         dwNumClippedVertices;
; 265  :   LPBYTE pTLV = (LPVOID) pRc->tl.clipping.ClipBuf.alignedBuf;
; 266  :   DWORD dwUnion;
; 267  :   DWORD dwMask;
; 268  :   DWORD TLV_idx;
; 269  : #endif
; 270  : 
; 271  :   int       sign;
; 272  : 
; 273  : #if( PERFTEST == TRI_NULL )
; 274  :   return;
; 275  : #endif
; 276  : 
; 277  :   switch( pRc->fillMode )
; 278  :   {

  00003	8b 74 24 10	 mov	 esi, DWORD PTR _pRc$[esp+8]
  00007	8b 46 1c	 mov	 eax, DWORD PTR [esi+28]
  0000a	48		 dec	 eax
  0000b	57		 push	 edi
  0000c	0f 84 d5 00 00
	00		 je	 $L37002
  00012	48		 dec	 eax
  00013	0f 85 90 01 00
	00		 jne	 $L37005

; 279  :     case D3DFILL_WIREFRAME :
; 280  : 
; 281  :       for( ; count > 0; count-- )

  00019	8b 44 24 18	 mov	 eax, DWORD PTR _count$[esp+12]
  0001d	85 c0		 test	 eax, eax
  0001f	0f 86 84 01 00
	00		 jbe	 $L37005
  00025	8b 5c 24 20	 mov	 ebx, DWORD PTR _vertices$[esp+12]
  00029	89 44 24 14	 mov	 DWORD PTR 8+[esp+12], eax
$L36989:

; 282  :       {
; 283  : #ifdef TnL_HAL
; 284  :         // Okay, were compiling in the software TnL HAL
; 285  :         // We might have clipping to do so let's start the process
; 286  : 
; 287  :         // Any clipping needed?
; 288  :         if ( CLIPPING_NEEDED )
; 289  :         {
; 290  :           // Check to see if we had started a multi triangle clip
; 291  :           // in the last loop.
; 292  :           if(ClipContinue)
; 293  :           {
; 294  :             // Yes, we have a cliped triangle in progress
; 295  :             // Don't bother pulling out new vertex data 
; 296  :             // from the command stream. Just re-arrange the
; 297  :             // vertex pointers from the new output clip
; 298  :             // FVF buffer for the next blade of the fan to clip
; 299  : 
; 300  :                      // pA is the center of the Fan, it does NOT change
; 301  :             pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 302  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 303  : 
; 304  :             ClipContinue--;     // Decrement the ClipContine value
; 305  :             TLV_idx++;          // Increment the new FVF buf index
; 306  :           }
; 307  :           else
; 308  :           {
; 309  :             // No clipping in the previous pass of
; 310  :             // the master loop, just get the next 
; 311  :             // vertices and continue.
; 312  :             TRI_NEXT_WITH_CLIP();
; 313  : 
; 314  :             // !!! QUICK TRIVIAL REJECT TEST !!!
; 315  :             // Clipping test for this triangle
; 316  :             if ((c0 & c1 & c2))
; 317  :             {
; 318  :               // This triangle is totaly clipped
; 319  :               // skip it and go on to teh next one
; 320  :               // in the command stream
; 321  :               continue;
; 322  :             }
; 323  : 
; 324  :             // This Triangle is not TR clipped 
; 325  :             // Get the OR flags and clip mask to see if we can trivial 
; 326  :             // accept it
; 327  :             dwUnion = (c0 | c1 | c2);
; 328  :             dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 329  :                      TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 330  :    
; 331  :             if (pRc->tl.dwTLState & TLPV_GUARDBAND) 
; 332  :             {
; 333  :               dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 334  :                        TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 335  :             }
; 336  : 
; 337  :             // If all the vertices are in, 
; 338  :             // No clipping is neeed! 
; 339  :             // Let it pass down to the FIFO stuffing
; 340  :             if ((dwUnion & dwMask) != 0)
; 341  :             {
; 342  :               if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 343  :               {
; 344  :                 ClipContinue = dwNumClippedVertices - 3; 
; 345  : 
; 346  :                 pA = (LPDWORD) (pTLV); 
; 347  :                 pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 348  :                 pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 349  :                 TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 350  : 
; 351  :                 // Let the master loop know that we ne need to process more 
; 352  :                 // triangles if the clippeing calls for it.
; 353  :                 count += ClipContinue;
; 354  :               }
; 355  :               else
; 356  :               {
; 357  :                 // Clip routine said that there was nothing to
; 358  :                 // clip, skip it and go on to teh next one
; 359  :                 // in the command stream
; 360  :                 continue;
; 361  :               }
; 362  : 
; 363  :             } // if clipping on this triangle
; 364  : 
; 365  :           } // not a clip continuation
; 366  : 
; 367  :         } // if valid clipBuf pointer
; 368  :         else
; 369  :         {
; 370  :           // No valid clip code buffer, just update the 
; 371  :           // vertex pointers for the next triangle to process 
; 372  :           TRI_NEXT();
; 373  :         }
; 374  : 
; 375  :          // check this triangle for culling imediately
; 376  :         ((float*)&sign)[0] = ((FLTP(pA)[FVFO_SX] - FLTP(pB)[FVFO_SX]) * (FLTP(pB)[FVFO_SY] - FLTP(pC)[FVFO_SY])) -
; 377  :                              ((FLTP(pB)[FVFO_SX] - FLTP(pC)[FVFO_SX]) * (FLTP(pA)[FVFO_SY] - FLTP(pB)[FVFO_SY]));
; 378  : 
; 379  :         sign &= 0x80000000;
; 380  : 
; 381  :         if ((sign ^ pRc->cullMask) != 0x80000000)
; 382  :         {
; 383  :           dp2Line( pRc, pA, pA, pB, vertexType );
; 384  :           dp2Line( pRc, pA, pB, pC, vertexType );
; 385  :           dp2Line( pRc, pA, pC, pA, vertexType );
; 386  :         }
; 387  : 
; 388  : #else // If not the TnL HAL
; 389  : 
; 390  :         TRI_NEXT();

  0002d	8b 86 a4 05 00
	00		 mov	 eax, DWORD PTR [esi+1444]

; 391  : 
; 392  :         ((float*)&sign)[0] = ((FLTP(pA)[FVFO_SX] - FLTP(pB)[FVFO_SX]) * (FLTP(pB)[FVFO_SY] - FLTP(pC)[FVFO_SY])) -
; 393  :                              ((FLTP(pB)[FVFO_SX] - FLTP(pC)[FVFO_SX]) * (FLTP(pA)[FVFO_SY] - FLTP(pB)[FVFO_SY]));

  00033	8b 8e a0 05 00
	00		 mov	 ecx, DWORD PTR [esi+1440]
  00039	c1 e0 02	 shl	 eax, 2
  0003c	8b eb		 mov	 ebp, ebx
  0003e	03 d8		 add	 ebx, eax
  00040	8b fb		 mov	 edi, ebx
  00042	03 d8		 add	 ebx, eax
  00044	8b d3		 mov	 edx, ebx
  00046	03 d8		 add	 ebx, eax
  00048	8d 04 49	 lea	 eax, DWORD PTR [ecx+ecx*2]
  0004b	c1 e0 03	 shl	 eax, 3
  0004e	2b c1		 sub	 eax, ecx
  00050	c1 e0 02	 shl	 eax, 2
  00053	8b 88 08 00 00
	00		 mov	 ecx, DWORD PTR _fvfOffsetTable[eax+8]
  00059	8b 80 04 00 00
	00		 mov	 eax, DWORD PTR _fvfOffsetTable[eax+4]
  0005f	c1 e1 02	 shl	 ecx, 2
  00062	d9 04 39	 fld	 DWORD PTR [ecx+edi]
  00065	c1 e0 02	 shl	 eax, 2
  00068	d8 24 11	 fsub	 DWORD PTR [ecx+edx]
  0006b	89 54 24 18	 mov	 DWORD PTR _pC$[esp+12], edx
  0006f	d9 04 28	 fld	 DWORD PTR [eax+ebp]
  00072	d8 24 38	 fsub	 DWORD PTR [eax+edi]
  00075	de c9		 fmulp	 ST(1), ST(0)
  00077	d9 04 38	 fld	 DWORD PTR [eax+edi]
  0007a	d8 24 10	 fsub	 DWORD PTR [eax+edx]

; 394  :         
; 395  :         sign &= 0x80000000;
; 396  : 
; 397  :         if (((sign ^ pRc->cullMask) != 0x80000000))

  0007d	8b 96 88 00 00
	00		 mov	 edx, DWORD PTR [esi+136]
  00083	d9 04 29	 fld	 DWORD PTR [ecx+ebp]
  00086	d8 24 39	 fsub	 DWORD PTR [ecx+edi]
  00089	de c9		 fmulp	 ST(1), ST(0)
  0008b	de e9		 fsubp	 ST(1), ST(0)
  0008d	d9 5c 24 20	 fstp	 DWORD PTR _sign$[esp+12]
  00091	8b 44 24 20	 mov	 eax, DWORD PTR _sign$[esp+12]
  00095	25 00 00 00 80	 and	 eax, -2147483648	; 80000000H
  0009a	33 c2		 xor	 eax, edx
  0009c	3d 00 00 00 80	 cmp	 eax, -2147483648	; 80000000H
  000a1	74 35		 je	 SHORT $L36990

; 398  :         {
; 399  :           dp2Line( pRc, pA, pA, pB, vertexType );

  000a3	8b 4c 24 24	 mov	 ecx, DWORD PTR _vertexType$[esp+12]
  000a7	51		 push	 ecx
  000a8	57		 push	 edi
  000a9	55		 push	 ebp
  000aa	55		 push	 ebp
  000ab	56		 push	 esi
  000ac	e8 00 00 00 00	 call	 _dp2Line

; 400  :           dp2Line( pRc, pA, pB, pC, vertexType );

  000b1	8b 54 24 38	 mov	 edx, DWORD PTR _vertexType$[esp+32]
  000b5	8b 44 24 2c	 mov	 eax, DWORD PTR _pC$[esp+32]
  000b9	52		 push	 edx
  000ba	50		 push	 eax
  000bb	57		 push	 edi
  000bc	55		 push	 ebp
  000bd	56		 push	 esi
  000be	e8 00 00 00 00	 call	 _dp2Line

; 401  :           dp2Line( pRc, pA, pC, pA, vertexType );

  000c3	8b 4c 24 4c	 mov	 ecx, DWORD PTR _vertexType$[esp+52]
  000c7	8b 54 24 40	 mov	 edx, DWORD PTR _pC$[esp+52]
  000cb	51		 push	 ecx
  000cc	55		 push	 ebp
  000cd	52		 push	 edx
  000ce	55		 push	 ebp
  000cf	56		 push	 esi
  000d0	e8 00 00 00 00	 call	 _dp2Line
  000d5	83 c4 3c	 add	 esp, 60			; 0000003cH
$L36990:
  000d8	ff 4c 24 14	 dec	 DWORD PTR 8+[esp+12]
  000dc	0f 85 4b ff ff
	ff		 jne	 $L36989
  000e2	5f		 pop	 edi
  000e3	5e		 pop	 esi
  000e4	5d		 pop	 ebp
  000e5	5b		 pop	 ebx

; 540  :         }
; 541  : #endif // endif for TnL_HAL
; 542  :       }
