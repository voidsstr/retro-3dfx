_dp2FanAllFill PROC NEAR

; 213  : {

  00000	53		 push	 ebx
  00001	55		 push	 ebp
  00002	56		 push	 esi

; 214  :   LPDWORD   pA, pB, pC;
; 215  : #ifdef TnL_HAL
; 216  :   LPDWORD       pAOrig, pBOrig, pCOrig;
; 217  :   DWORD         c0, c1, c2;
; 218  :   LPDWORD       clipcodes = (LPDWORD) pRc->tl.pClipBuf;
; 219  :   DWORD         ClipContinue = 0;       // Tells us if we need to continue the 
; 220  :   // clipped triangle alreasy in progress
; 221  :   DWORD         dwNumClippedVertices;
; 222  :   LPBYTE pTLV = (LPVOID) pRc->tl.clipping.ClipBuf.alignedBuf;
; 223  :   DWORD dwUnion;
; 224  :   DWORD dwMask;
; 225  :   DWORD TLV_idx = 3;
; 226  :   BOOL  RestoreVertexPointers = 0;
; 227  : #endif
; 228  : 
; 229  :   int       sign;
; 230  : 
; 231  : #if( PERFTEST == TRI_NULL )
; 232  :   return;
; 233  : #endif
; 234  : 
; 235  :   switch( pRc->fillMode )
; 236  :   {

  00003	8b 74 24 10	 mov	 esi, DWORD PTR _pRc$[esp+8]
  00007	8b 46 1c	 mov	 eax, DWORD PTR [esi+28]
  0000a	48		 dec	 eax
  0000b	57		 push	 edi
  0000c	0f 84 e1 00 00
	00		 je	 $L37002
  00012	48		 dec	 eax
  00013	0f 85 a6 01 00
	00		 jne	 $L37005

; 237  :     case D3DFILL_WIREFRAME :
; 238  : 
; 239  : #ifdef TnL_HAL
; 240  :     if ( clipcodes != NULL )
; 241  :     {
; 242  :       TRI_INIT_WITH_CLIP;
; 243  :     }
; 244  :     else
; 245  :     {
; 246  :       TRI_INIT;
; 247  :     }
; 248  : #else
; 249  :     TRI_INIT;

  00019	8b 6c 24 20	 mov	 ebp, DWORD PTR _vertices$[esp+12]
  0001d	8b 86 a4 05 00
	00		 mov	 eax, DWORD PTR [esi+1444]
  00023	c1 e0 02	 shl	 eax, 2
  00026	8b d5		 mov	 edx, ebp
  00028	03 e8		 add	 ebp, eax
  0002a	8b dd		 mov	 ebx, ebp
  0002c	03 e8		 add	 ebp, eax

; 250  : #endif
; 251  :       for( ; count > 0; count-- )

  0002e	8b 44 24 18	 mov	 eax, DWORD PTR _count$[esp+12]
  00032	85 c0		 test	 eax, eax
  00034	89 54 24 20	 mov	 DWORD PTR _pA$[esp+12], edx
  00038	0f 86 81 01 00
	00		 jbe	 $L37005

; 237  :     case D3DFILL_WIREFRAME :
; 238  : 
; 239  : #ifdef TnL_HAL
; 240  :     if ( clipcodes != NULL )
; 241  :     {
; 242  :       TRI_INIT_WITH_CLIP;
; 243  :     }
; 244  :     else
; 245  :     {
; 246  :       TRI_INIT;
; 247  :     }
; 248  : #else
; 249  :     TRI_INIT;

  0003e	89 44 24 14	 mov	 DWORD PTR 8+[esp+12], eax
$L36989:

; 252  :       {
; 253  : #ifdef TnL_HAL
; 254  :     // Okay, were compiling in the software TnL HAL
; 255  :     // We might have clipping to do so let's start the process
; 256  : 
; 257  :         // Any clipping needed?
; 258  :         if ( CLIPPING_NEEDED )
; 259  :         {
; 260  :           // Check to see if we had started a multi triangle clip
; 261  :           // in the last loop.
; 262  :           if(ClipContinue)
; 263  :           {
; 264  :             // Yes, we have a cliped triangle in progress
; 265  :             // Don't bother pulling out new vertex data 
; 266  :             // from the command stream. Just re-arrange the
; 267  :             // vertex pointers from the new output clip
; 268  :             // FVF buffer for the next blade of the fan to clip
; 269  :     
; 270  :             // pA is the center of the Fan, it does NOT change
; 271  :             pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 272  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 273  :     
; 274  :             ClipContinue--;     // Decrement the ClipContine value
; 275  :             TLV_idx++;          // Increment the new FVF buf index
; 276  :           }
; 277  :           else
; 278  :           {
; 279  :             TRI_CLIP_RESTORE;
; 280  :             // No clipping in the previous pass of
; 281  :             // the master loop, just get the next 
; 282  :             // vertices and continue.
; 283  :             TRI_NEXT_WITH_CLIP;
; 284  :     
; 285  :             // !!! QUICK TRIVIAL REJECT TEST !!!
; 286  :             // Clipping test for this triangle
; 287  :             if ((c0 & c1 & c2))
; 288  :             {
; 289  :               // This triangle is totaly clipped
; 290  :               // skip it and go on to teh next one
; 291  :               // in the command stream
; 292  :               continue;
; 293  :             }
; 294  : 
; 295  :             // This Triangle is not TR clipped 
; 296  :             // Get the OR flags and clip mask to see if we can trivial 
; 297  :             // accept it
; 298  :             dwUnion = (c0 | c1 | c2);
; 299  :             dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 300  :                 TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 301  : 
; 302  :             if (pRc->tl.dwTLState & TLPV_GUARDBAND)
; 303  :             {
; 304  :               dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 305  :                   TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 306  :             }
; 307  : 
; 308  :             // If all the vertices are in, 
; 309  :             // No clipping is neeed! 
; 310  :             // Let it pass down to the FIFO stuffing
; 311  :             if ((dwUnion & dwMask) != 0)
; 312  :             {
; 313  :               if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 314  :               {
; 315  :                 ClipContinue = dwNumClippedVertices - 3; 
; 316  : 
; 317  :                 TRI_CLIP_SAVE;
; 318  :                 pA = (LPDWORD) (pTLV); 
; 319  :                 pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 320  :                 pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 321  :                 TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 322  : 
; 323  :                 // Let the master loop know that we ne need to process more 
; 324  :                 // triangles if the clippeing calls for it.
; 325  :                 count += ClipContinue;
; 326  :               }
; 327  :               else
; 328  :               {
; 329  : 
; 330  :                 // Clip routine said that there was nothing to
; 331  :                 // clip, skip it and go on to teh next one
; 332  :                 // in the command stream
; 333  :                 continue;
; 334  :               }
; 335  : 
; 336  :             } // if clipping on this triangle
; 337  : 
; 338  :           } // not a clip continuation
; 339  :     
; 340  :         } // if valid clipBuf pointer
; 341  :         else
; 342  :         {
; 343  :           // No valid clip code buffer, just update the 
; 344  :           // vertex pointers for the next triangle to process 
; 345  :           TRI_NEXT;
; 346  :         }
; 347  : 
; 348  : #else
; 349  :         TRI_NEXT;

  00042	8b 86 a4 05 00
	00		 mov	 eax, DWORD PTR [esi+1444]

; 350  : 
; 351  : #endif //endif for TnL_HAL
; 352  : 
; 353  :         ((float*)&sign)[0] = ((FLTP(pA)[FVFO_SX] - FLTP(pB)[FVFO_SX]) * (FLTP(pB)[FVFO_SY] - FLTP(pC)[FVFO_SY])) -
; 354  :                              ((FLTP(pB)[FVFO_SX] - FLTP(pC)[FVFO_SX]) * (FLTP(pA)[FVFO_SY] - FLTP(pB)[FVFO_SY]));

  00048	8b 8e a0 05 00
	00		 mov	 ecx, DWORD PTR [esi+1440]
  0004e	8b fb		 mov	 edi, ebx
  00050	8b dd		 mov	 ebx, ebp
  00052	8d 6c 85 00	 lea	 ebp, DWORD PTR [ebp+eax*4]
  00056	8d 04 49	 lea	 eax, DWORD PTR [ecx+ecx*2]
  00059	c1 e0 03	 shl	 eax, 3
  0005c	2b c1		 sub	 eax, ecx
  0005e	c1 e0 02	 shl	 eax, 2
  00061	8b 88 08 00 00
	00		 mov	 ecx, DWORD PTR _fvfOffsetTable[eax+8]
  00067	8b 80 04 00 00
	00		 mov	 eax, DWORD PTR _fvfOffsetTable[eax+4]
  0006d	c1 e1 02	 shl	 ecx, 2
  00070	d9 04 39	 fld	 DWORD PTR [ecx+edi]
  00073	c1 e0 02	 shl	 eax, 2
  00076	d8 24 19	 fsub	 DWORD PTR [ecx+ebx]
  00079	d9 04 10	 fld	 DWORD PTR [eax+edx]
  0007c	d8 24 38	 fsub	 DWORD PTR [eax+edi]
  0007f	de c9		 fmulp	 ST(1), ST(0)
  00081	d9 04 38	 fld	 DWORD PTR [eax+edi]
  00084	d8 24 18	 fsub	 DWORD PTR [eax+ebx]

; 355  : 
; 356  :         sign &= 0x80000000;
; 357  : 
; 358  :         if ((sign ^ pRc->cullMask) != 0x80000000)

  00087	8b 86 88 00 00
	00		 mov	 eax, DWORD PTR [esi+136]
  0008d	d9 04 11	 fld	 DWORD PTR [ecx+edx]
  00090	d8 24 39	 fsub	 DWORD PTR [ecx+edi]
  00093	de c9		 fmulp	 ST(1), ST(0)
  00095	de e9		 fsubp	 ST(1), ST(0)
  00097	d9 5c 24 18	 fstp	 DWORD PTR _sign$[esp+12]
  0009b	8b 4c 24 18	 mov	 ecx, DWORD PTR _sign$[esp+12]
  0009f	81 e1 00 00 00
	80		 and	 ecx, -2147483648	; 80000000H
  000a5	33 c8		 xor	 ecx, eax
  000a7	81 f9 00 00 00
	80		 cmp	 ecx, -2147483648	; 80000000H
  000ad	74 35		 je	 SHORT $L36990

; 359  :         {
; 360  :           dp2Line( pRc, pB, pA, pB, vertexType );

  000af	8b 44 24 24	 mov	 eax, DWORD PTR _vertexType$[esp+12]
  000b3	50		 push	 eax
  000b4	57		 push	 edi
  000b5	52		 push	 edx
  000b6	57		 push	 edi
  000b7	56		 push	 esi
  000b8	e8 00 00 00 00	 call	 _dp2Line

; 361  :           dp2Line( pRc, pB, pB, pC, vertexType );

  000bd	8b 4c 24 38	 mov	 ecx, DWORD PTR _vertexType$[esp+32]
  000c1	51		 push	 ecx
  000c2	53		 push	 ebx
  000c3	57		 push	 edi
  000c4	57		 push	 edi
  000c5	56		 push	 esi
  000c6	e8 00 00 00 00	 call	 _dp2Line

; 362  :           dp2Line( pRc, pB, pC, pA, vertexType );

  000cb	8b 54 24 4c	 mov	 edx, DWORD PTR _vertexType$[esp+52]
  000cf	8b 44 24 48	 mov	 eax, DWORD PTR _pA$[esp+52]
  000d3	52		 push	 edx
  000d4	50		 push	 eax
  000d5	53		 push	 ebx
  000d6	57		 push	 edi
  000d7	56		 push	 esi
  000d8	e8 00 00 00 00	 call	 _dp2Line
  000dd	8b 54 24 5c	 mov	 edx, DWORD PTR _pA$[esp+72]
  000e1	83 c4 3c	 add	 esp, 60			; 0000003cH
$L36990:
  000e4	ff 4c 24 14	 dec	 DWORD PTR 8+[esp+12]
  000e8	0f 85 54 ff ff
	ff		 jne	 $L36989
  000ee	5f		 pop	 edi
  000ef	5e		 pop	 esi
  000f0	5d		 pop	 ebp
