#--------------------------------------------------------------------
# Lets build everything NOW !!!!


debug:  debug.mak

retail: retail.mak

all:    debug retail

debug.mak retail.mak:
        nmake -nologo DEBUG=$(@B) build

#build:  makedir d3dhwdir d3dhw.lib ddhwdir\
build:  makedir d3ddir d3d.lib 

makedir :
        if not exist .\$(DIR)\nul md .\$(DIR)
        @echo -------Building $(DIR) D3D Library----------
        @echo Target Hardware .......$(TRTXT)
        @echo Hardware revision......$(HWREVTXT)
        @echo DirectX Version .......$(DXTXT)
        @echo Command Fifo ..........$(CFTXT)
        @echo Command Fifo Debug ....$(FDTXT)
        @echo Null Driver ...........$(NDTXT)
        @echo OVERIDE NullDriver :
        @echo 1 Texture Downloads.....$(OND_TEXDTXT)
        @echo 2 Render Texture States.$(OND_STATETXT)
        @echo 3 Triangle Rendering....$(OND_TRITXT)
        @echo 4 Clearing ZBuffer......$(OND_ZBTXT)
        @echo 5 Hardware Setup........$(OND_HWSUTXT)
        @echo Texture Profiling......$(TPTXT)
        @echo Flavor Profiling ......$(FPTXT)
        @echo Crash Test.............$(CRASHTXT)
        @echo Anti-alias ............$(AATXT)
        @echo Num Texture Units......$(TUTXT)
        @echo K63DNow! Optimization..$(K6TXT)
        @echo SDRAM support is ......$(SDRAM_TEXT)
        @echo AGP cmdfifo is ........$(AGPCMDFIFOECHO)
        @echo Special MT modes ......$(SMTXT)
        @echo KNI Texture Download ..$(KTTXT)
        @echo KNI Optimizations .....$(KNITXT)
        @echo Deferred Txtr Dwnld ...$(DTDTXT)
        @echo Deferred Txtr Dwnld ...$(WINSIM)
        @echo SLI AA   ..............$(SLI_STUFF)
        @echo SLI AA 2D..............$(SLI_2D_STUFF)
        @echo Read Abort Error ......$(RD_STUFF)
	    @Echo SW TnL ................$(SW_TnLTXT)
	    @Echo TnL Profiling..........$(TNL_PROFTXT)
		@Echo C Autostripping .......$(C_AutoTXT)
		@Echo Vertex Buffer DDI......$(VERTBUFFTXT)
		@Echo New KNI-3DNow Asm Tri..$(NEWASMTRITXT) *MASM 6.14 REQUIRED!*
                @Echo Z Access Optimization..$(Z_ACCESS_OPT_TXT)
        @echo --------------------------------------------

d3ddir:
        cd .\$(DIR)

!ifdef KILLHELP
        killhelp -k
!endif 

