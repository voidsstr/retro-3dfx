!endif

#--------------------------------------------------------------------
# Define 32Bit macros for DEBUG or RETAIL build.

!if "$(DEBUG)"=="debug"

    # Generic Debug build flags

# SK -- clean this up later -- we need different flags to make winice 4.0 happy
#		This really isn't specific to SW T&L.
!if "$(SW_TNL)" == "1"
COPT32 = -DDEBUG -D_DEBUG -DDEBLEVEL=1 -DBUILD_DDDDK -YX -Od -Zi -DFXTRACE
!else
COPT32 = -DDEBUG -D_DEBUG -DDEBLEVEL=1 -DBUILD_DDDDK -YX -Oxa -Z7 -DFXTRACE
!endif
!ifdef ICC
COPT32ICL = -Od -Oy- -G6s -Qvec -Qkscalar -QxK -DDEBUG -D_DEBUG -DDEBLEVEL=1 -DBUILD_DDDDK -Zi -DFXTRACE -DSSECPP
# Warning -- Stack alignment is DISABLED for the SOA code!
COPT32ICLSOA = -Od -Oy- -G6s -Qsfalign- -DDEBUG -D_DEBUG -DDEBLEVEL=1 -DBUILD_DDDDK -Zi -DFXTRACE -DSSECPP
!endif

#SK -- add support for the beta Visual C++ Processor Pack.
#SK -- if only this were as simple as replacing the default C compiler. But no, it's not. The AMD code won't compile with
#SK -- the processor pack. 
!ifdef VCPP
COPT32PP = $(COPT32) -DVCPP
!endif

MOPT32 = -DDEBUG -D_DEBUG
ROPT32 = -DDEBUG -D_DEBUG
LOPT32  = -debug -debugtype:cv

COPT16 = -DDEBUG -D_DEBUG -Z7i -DFXTRACE
MOPT16 = -DDEBUG -D_DEBUG
ROPT16 = -DDEBUG -D_DEBUG

    # Specific Debug build flags

!else

    # Generic Retail build flags

COPT32 = -Oxa
!ifdef ICC
COPT32ICL = -Ox -G6s -Qvec -Qkscalar -QxK -DSSECPP
# Warning -- Stack alignment is DISABLED for the SOA code!
COPT32ICLSOA = -Ox -G6s -Qsfalign- -DSSECPP
!endif

#SK -- add support for the beta Visual C++ Processor Pack.
#SK -- if only this were as simple as replacing the default C compiler. But no, it's not. The AMD code won't compile with
#SK -- the processor pack. 
!ifdef VCPP
COPT32PP = $(COPT32) -DVCPP
!endif

!ifdef SIW95
!if "$(SW_TNL)" == "1"
COPT32 = $(COPT32) -Zi
!ifdef ICC
COPT32ICL = $(COPT32ICL) -Zi
COPT32ICLSOA = $(COPT32ICLSOA) -Zi
!endif

!ifdef VCPP
COPT32PP = $(COPT32PP) -Zi
!endif

!else
COPT32 = $(COPT32) -Z7
!endif
!endif

MOPT32 =
ROPT32 =
LOPT32 =

COPT16 =
MOPT16 = 
ROPT16 =

    # Specific Retail build flags

!endif
#STB-SK 12/21/98 -- add support for VTUNE profiling
#STB Begin Change
!if "$(VTUNE)" == "1"
COPT32 = $(COPT32) -Zi
MFLAGS32 = $(MFLAGS32) -Zi
!ifdef VCPP
COPT32PP = $(COPT32PP) -Zi
!endif
!endif
#STB End Change



#--------------------------------------------------------------------
# Define our 32 Bit build flag macros

CDEFS32  = $(TARGET) $(DXDEF) -D__MSC__ -DWRITECOMBINE -DDUAL_HEAP -DGLIDE_MUTEX -D_X86_ -DIS_32 -DWIN32 -DDIRECTX
CINCS32  = -I..\..\inc -I..\..\dd32 -I..\..\d3d -I$(DDKDX)\inc -I$(DDK9X)\inc32 -I$(SDK32)\include -I$(COMP32)\include 
!ifdef ICC
CINCS32 = $(CINCS32) -I$(ICC)\include
!endif
!ifdef VCPP
CINCS32PP  = -I..\..\inc -I..\..\dd32 -I..\..\d3d -I$(DDKDX)\inc -I$(DDK9X)\inc32 -I$(SDK32)\include -I$(VCPP)\include 
!endif
!if "$(VC6)" == "1"
CFLAGS32 = $(LOGO) $(COPT32) $(CDEFS32) $(CINCS32) $(BRDCFLAGS) -G6s -FAsc -W3 -c -Zp
!else
CFLAGS32 = $(LOGO) $(COPT32) $(CDEFS32) $(CINCS32) $(BRDCFLAGS) -G5s -FAsc -W3 -c -Zp
!endif

#SK -- add support for the beta Visual C++ Processor Pack.
#SK -- if only this were as simple as replacing the default C compiler. But no, it's not. The AMD code won't compile with
#SK -- the processor pack. 
!ifdef VCPP
CFLAGS32PP = $(LOGO) $(COPT32PP) $(CDEFS32) $(CINCS32PP) $(BRDCFLAGS) -G6s -FAsc -W3 -c -Zp
!endif

!ifdef ICC
COPTICL =  $(LOGO) $(COPT32ICL) $(CDEFS32) $(CINCS32) $(BRDCFLAGS)  -c -Zp1 -Qwd344,186 -FAsc
COPTICLSOA =  $(LOGO) $(COPT32ICLSOA) $(CDEFS32) $(CINCS32) $(BRDCFLAGS)  -c -Zp1 -Qwd344,186 -FAsc
!endif

#Preprocess, but don't compile. Generate a listing file.
#CFLAGS32 = $(CFLAGS32) -E -C

#Set warnings as errors
CFLAGS32 = $(CFLAGS32) -WX

#skephart - enable browser file info
!if "$(BROWSE)"=="1" 
CFLAGS32 = $(CFLAGS32) -FR$(@B).sbr
!ifdef ICC
COPTICL =  $(COPTICL)  -FR$(@B).sbr
!endif

!ifdef VCPP
CFLAGS32PP = $(CFLAGS32PP) -FR$(@B).sbr
!endif
!endif

!if "$(PS)" == "1"
CFLAGS32 = $(CFLAGS32) -Gh
!endif

MDEFS32  = $(TARGET) $(DXDEF) -DWIN32 -DIS_32 -DSTD_CALL -DBLD_COFF -DMASM6 -D__MSC__
MINCS32  = 
!if "$(STBKNI)" == "1"
MINCS32  = -I..\..\inc
!endif
MFLAGS32 = $(LOGO) $(MOPT32) $(MDEFS32) $(MINCS32) -Zp4 -coff -W3 -WX -Zd -c -Cx

#skephart - enable browser file info
!if "$(BROWSE)"=="1" 
MFLAGS32 = $(MFLAGS32) -FR$(@B).sbr
!endif

!if "$(PS)" == "1"
MDEFS32  = $(MDEFS32) -DPERF_MONITORING
!endif

RDEFS32  = -DIS_32 -DWIN32
RINCS32  = -I.. -I$(DDKDX)\inc
RFLAGS32 = $(ROPT32) $(RDEFS32) $(RINCS32) -r 

LINCS32  = -LIBPATH:..\..\d3d\$(DIR) -LIBPATH:$(DIRECTXSDK)\lib -LIBPATH:$(COMP32)\lib
#STB-SK 12/21/98 -- add support for VTUNE profiling
#STB Begin Change
!if "$(VTUNE)" == "1"
LFLAGS32 = $(LOGO) $(LOPT32) $(LINCS32) -nodefaultlib -align:0x1000
!else
LFLAGS32 = $(LOGO) $(LOPT32) $(LINCS32) -pdb:none -nodefaultlib -align:0x1000
!endif
#STB End Change

