TARGET =  $(TARGET) -DNEW_CLIP_FOR_GB

# Use the CCU for single stage rendering ops (for trilinear and chromakey).

TARGET =  $(TARGET) -DNEW_CCU

!if ("$(HP)" == "H5" || "$(HP)" == "h5")
