; 581  : #ifdef TnL_HAL
; 582  :     // Okay, were compiling in the software TnL HAL
; 583  :     // We might have clipping to do so let's start the process
; 584  : 
; 585  :     // Any clipping needed?
; 586  :     if ( CLIPPING_NEEDED )
; 587  :     {
; 588  :       // Check to see if we had started a multi triangle clip
; 589  :       // in the last loop.
; 590  :       if(ClipContinue)
; 591  :       {
; 592  :         // Yes, we have a cliped triangle in progress
; 593  :         // Don't bother pulling out new vertex data 
; 594  :         // from the command stream. Just re-arrange the
; 595  :         // vertex pointers from the new output clip
; 596  :         // FVF buffer for the next blade of the fan to clip
; 597  : 
; 598  :         // pA is the center of the Fan, it does NOT change
; 599  :         pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 600  :         pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 601  : 
; 602  :         ClipContinue--;     // Decrement the ClipContine value
; 603  :         TLV_idx++;          // Increment the new FVF buf index
; 604  :       }
; 605  :       else
; 606  :       {
; 607  : 
; 608  :         TRI_CLIP_RESTORE;
; 609  :         // No clipping in the previous pass of
; 610  :         // the master loop, just get the next 
; 611  :         // vertices and continue.
; 612  :         TRI_NEXT_WITH_CLIP;
; 613  : 
; 614  :         // !!! QUICK TRIVIAL REJECT TEST !!!
; 615  :         // Clipping test for this triangle
; 616  :         if ((c0 & c1 & c2))
; 617  :         {
; 618  :           // This triangle is totaly clipped
; 619  :           // skip it and go on to teh next one
; 620  :           // in the command stream
; 621  :           continue;
; 622  :         }
; 623  : 
; 624  :         // This Triangle is not TR clipped 
; 625  :         // Get the OR flags and clip mask to see if we can trivial 
; 626  :         // accept it
; 627  :         dwUnion = (c0 | c1 | c2);
; 628  :         dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 629  :             TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 630  : 
; 631  :         if (pRc->tl.dwTLState & TLPV_GUARDBAND)
; 632  :         {
; 633  :           dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 634  :               TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 635  :         }
; 636  : 
; 637  :         // If all the vertices are in, 
; 638  :         // No clipping is neeed! 
; 639  :         // Let it pass down to the FIFO stuffing
; 640  :         if ((dwUnion & dwMask) != 0)
; 641  :         {
; 642  : 		  //AllenH 7/23/00 Swapped order for flat shading (on fans color comes from vertex B)
; 643  :           //if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 644  :           if((dwNumClippedVertices = ClipFVFTriangle( pRc, pB, pC, pA, c1, c2, c0, dwMask)))
; 645  :           {
; 646  :             ClipContinue = dwNumClippedVertices - 3; 
; 647  : 
; 648  :             TRI_CLIP_SAVE;
; 649  :             pA = (LPDWORD) (pTLV); 
; 650  :             pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 651  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 652  :             TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 653  : 
; 654  :             // Let the master loop know that we ne need to process more 
; 655  :             // triangles if the clippeing calls for it.
; 656  :             count += ClipContinue;
; 657  :           }
; 658  :           else
; 659  :           {
; 660  : 
; 661  :             // Clip routine said that there was nothing to
; 662  :             // clip, skip it and go on to teh next one
; 663  :             // in the command stream
; 664  :             continue;
; 665  :           }
; 666  : 
; 667  :         } // if clipping on this triangle
; 668  : 
; 669  :       } // not a clip continuation
; 670  : 
; 671  :     } // if valid clipBuf pointer
; 672  :     else
; 673  :     {
; 674  :       // No valid clip code buffer, just update the 
; 675  :       // vertex pointers for the next triangle to process 
; 676  :       TRI_NEXT;
; 677  :     }
; 678  : 
; 679  : #else
