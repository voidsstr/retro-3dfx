; 390  :         {
; 391  :           // Check to see if we had started a multi triangle clip
; 392  :           // in the last loop.
; 393  :           if(ClipContinue)
; 394  :           {
; 395  :             // Yes, we have a cliped triangle in progress
; 396  :             // Don't bother pulling out new vertex data 
; 397  :             // from the command stream. Just re-arrange the
; 398  :             // vertex pointers from the new output clip
; 399  :             // FVF buffer for the next blade of the fan to clip
; 400  :     
; 401  :             // pA is the center of the Fan, it does NOT change
; 402  :             pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 403  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 404  :     
; 405  :             ClipContinue--;     // Decrement the ClipContine value
; 406  :             TLV_idx++;          // Increment the new FVF buf index
; 407  :           }
; 408  :           else
; 409  :           {
; 410  :             TRI_CLIP_RESTORE;
; 411  :             // No clipping in the previous pass of
; 412  :             // the master loop, just get the next 
; 413  :             // vertices and continue.
; 414  :             TRI_NEXT_WITH_CLIP;
; 415  :     
; 416  :             // !!! QUICK TRIVIAL REJECT TEST !!!
; 417  :             // Clipping test for this triangle
; 418  :             if ((c0 & c1 & c2))
; 419  :             {
; 420  :               // This triangle is totaly clipped
; 421  :               // skip it and go on to teh next one
; 422  :               // in the command stream
; 423  :               continue;
; 424  :             }
; 425  : 
; 426  :             // This Triangle is not TR clipped 
; 427  :             // Get the OR flags and clip mask to see if we can trivial 
; 428  :             // accept it
; 429  :             dwUnion = (c0 | c1 | c2);
; 430  :             dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 431  :                 TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 432  : 
; 433  :             if (pRc->tl.dwTLState & TLPV_GUARDBAND)
; 434  :             {
; 435  :               dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 436  :                   TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 437  :             }
; 438  : 
; 439  :             // If all the vertices are in, 
; 440  :             // No clipping is neeed! 
; 441  :             // Let it pass down to the FIFO stuffing
; 442  :             if ((dwUnion & dwMask) != 0)
; 443  :             {
; 444  :               if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 445  :               {
; 446  :                 ClipContinue = dwNumClippedVertices - 3; 
; 447  : 
; 448  :                 TRI_CLIP_SAVE;
; 449  :                 pA = (LPDWORD) (pTLV); 
; 450  :                 pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 451  :                 pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 452  :                 TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 453  : 
; 454  :                 // Let the master loop know that we ne need to process more 
; 455  :                 // triangles if the clippeing calls for it.
; 456  :                 count += ClipContinue;
; 457  :               }
; 458  :               else
