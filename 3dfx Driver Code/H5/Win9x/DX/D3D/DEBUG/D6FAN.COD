$SG37057 DB	'Illegal D3D Fill Mode %d', 00H
_DATA	ENDS
_TEXT	SEGMENT
_pRc$ = 8
_count$ = 12
_vertices$ = 20
_vertexType$ = 24
_pA$ = -4
_pB$ = -8
_pC$ = -12
_sign$ = -16
_dp2FanAllFill PROC NEAR

; 213  : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp
  00003	83 ec 14	 sub	 esp, 20			; 00000014H
  00006	56		 push	 esi

; 214  :   LPDWORD   pA, pB, pC;
; 215  : #ifdef TnL_HAL
; 216  :   LPDWORD       pAOrig, pBOrig, pCOrig;
; 217  :   DWORD         c0, c1, c2;
; 218  :   LPDWORD       clipcodes = (LPDWORD) pRc->tl.pClipBuf;
; 219  :   DWORD         ClipContinue = 0;       // Tells us if we need to continue the 
; 220  :   // clipped triangle alreasy in progress
; 221  :   DWORD         dwNumClippedVertices;
; 222  :   LPBYTE pTLV = (LPVOID) pRc->tl.clipping.ClipBuf.alignedBuf;
; 223  :   DWORD dwUnion;
; 224  :   DWORD dwMask;
; 225  :   DWORD TLV_idx = 3;
; 226  :   BOOL  RestoreVertexPointers = 0;
; 227  : #endif
; 228  : 
; 229  :   int       sign;
; 230  : 
; 231  : #if( PERFTEST == TRI_NULL )
; 232  :   return;
; 233  : #endif
; 234  : 
; 235  :   switch( pRc->fillMode )
; 236  :   {

  00007	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  0000a	8b 48 1c	 mov	 ecx, DWORD PTR [eax+28]
  0000d	89 4d ec	 mov	 DWORD PTR -20+[ebp], ecx
  00010	83 7d ec 01	 cmp	 DWORD PTR -20+[ebp], 1
  00014	0f 84 b4 01 00
	00		 je	 $L37042
  0001a	83 7d ec 02	 cmp	 DWORD PTR -20+[ebp], 2
  0001e	74 05		 je	 SHORT $L37028
  00020	e9 43 03 00 00	 jmp	 $L37056
$L37028:

; 237  :     case D3DFILL_WIREFRAME :
; 238  : 
; 239  : #ifdef TnL_HAL
; 240  :     if ( clipcodes != NULL )
; 241  :     {
; 242  :       TRI_INIT_WITH_CLIP;
; 243  :     }
; 244  :     else
; 245  :     {
; 246  :       TRI_INIT;
; 247  :     }
; 248  : #else
; 249  :     TRI_INIT;

  00025	8b 55 14	 mov	 edx, DWORD PTR _vertices$[ebp]
  00028	89 55 fc	 mov	 DWORD PTR _pA$[ebp], edx
  0002b	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  0002e	8b 88 a4 05 00
	00		 mov	 ecx, DWORD PTR [eax+1444]
  00034	8b 55 14	 mov	 edx, DWORD PTR _vertices$[ebp]
  00037	8d 04 8a	 lea	 eax, DWORD PTR [edx+ecx*4]
  0003a	89 45 14	 mov	 DWORD PTR _vertices$[ebp], eax
  0003d	8b 4d 14	 mov	 ecx, DWORD PTR _vertices$[ebp]
  00040	89 4d f4	 mov	 DWORD PTR _pC$[ebp], ecx
  00043	8b 55 08	 mov	 edx, DWORD PTR _pRc$[ebp]
  00046	8b 82 a4 05 00
	00		 mov	 eax, DWORD PTR [edx+1444]
  0004c	8b 4d 14	 mov	 ecx, DWORD PTR _vertices$[ebp]
  0004f	8d 14 81	 lea	 edx, DWORD PTR [ecx+eax*4]
  00052	89 55 14	 mov	 DWORD PTR _vertices$[ebp], edx

; 250  : #endif
; 251  :       for( ; count > 0; count-- )

  00055	eb 09		 jmp	 SHORT $L37029
$L37030:
  00057	8b 45 0c	 mov	 eax, DWORD PTR _count$[ebp]
  0005a	83 e8 01	 sub	 eax, 1
  0005d	89 45 0c	 mov	 DWORD PTR _count$[ebp], eax
$L37029:
  00060	83 7d 0c 00	 cmp	 DWORD PTR _count$[ebp], 0
  00064	0f 86 5f 01 00
	00		 jbe	 $L37031

; 253  : #ifdef TnL_HAL
; 254  :     // Okay, were compiling in the software TnL HAL
; 255  :     // We might have clipping to do so let's start the process
; 256  : 
; 257  :         // Any clipping needed?
; 258  :         if ( CLIPPING_NEEDED )
; 259  :         {
; 260  :           // Check to see if we had started a multi triangle clip
; 261  :           // in the last loop.
; 262  :           if(ClipContinue)
; 263  :           {
; 264  :             // Yes, we have a cliped triangle in progress
; 265  :             // Don't bother pulling out new vertex data 
; 266  :             // from the command stream. Just re-arrange the
; 267  :             // vertex pointers from the new output clip
; 268  :             // FVF buffer for the next blade of the fan to clip
; 269  :     
; 270  :             // pA is the center of the Fan, it does NOT change
; 271  :             pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 272  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 273  :     
; 274  :             ClipContinue--;     // Decrement the ClipContine value
; 275  :             TLV_idx++;          // Increment the new FVF buf index
; 276  :           }
; 277  :           else
; 278  :           {
; 279  :             TRI_CLIP_RESTORE;
; 280  :             // No clipping in the previous pass of
; 281  :             // the master loop, just get the next 
; 282  :             // vertices and continue.
; 283  :             TRI_NEXT_WITH_CLIP;
; 284  :     
; 285  :             // !!! QUICK TRIVIAL REJECT TEST !!!
; 286  :             // Clipping test for this triangle
; 287  :             if ((c0 & c1 & c2))
; 288  :             {
; 289  :               // This triangle is totaly clipped
; 290  :               // skip it and go on to teh next one
; 291  :               // in the command stream
; 292  :               continue;
; 293  :             }
; 294  : 
; 295  :             // This Triangle is not TR clipped 
; 296  :             // Get the OR flags and clip mask to see if we can trivial 
; 297  :             // accept it
; 298  :             dwUnion = (c0 | c1 | c2);
; 299  :             dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 300  :                 TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 301  : 
; 302  :             if (pRc->tl.dwTLState & TLPV_GUARDBAND)
; 303  :             {
; 304  :               dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 305  :                   TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 306  :             }
; 307  : 
; 308  :             // If all the vertices are in, 
; 309  :             // No clipping is neeed! 
; 310  :             // Let it pass down to the FIFO stuffing
; 311  :             if ((dwUnion & dwMask) != 0)
; 312  :             {
; 313  :               if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 314  :               {
; 315  :                 ClipContinue = dwNumClippedVertices - 3; 
; 316  : 
; 317  :                 TRI_CLIP_SAVE;
; 318  :                 pA = (LPDWORD) (pTLV); 
; 319  :                 pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 320  :                 pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 321  :                 TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 322  : 
; 323  :                 // Let the master loop know that we ne need to process more 
; 324  :                 // triangles if the clippeing calls for it.
; 325  :                 count += ClipContinue;
; 326  :               }
; 327  :               else
; 328  :               {
; 329  : 
; 330  :                 // Clip routine said that there was nothing to
; 331  :                 // clip, skip it and go on to teh next one
; 332  :                 // in the command stream
; 333  :                 continue;
; 334  :               }
; 335  : 
; 336  :             } // if clipping on this triangle
; 337  : 
; 338  :           } // not a clip continuation
; 339  :     
; 340  :         } // if valid clipBuf pointer
; 341  :         else
; 342  :         {
; 343  :           // No valid clip code buffer, just update the 
; 344  :           // vertex pointers for the next triangle to process 
; 345  :           TRI_NEXT;
; 346  :         }
; 347  : 
; 348  : #else
; 349  :         TRI_NEXT;

  0006a	8b 4d f4	 mov	 ecx, DWORD PTR _pC$[ebp]
  0006d	89 4d f8	 mov	 DWORD PTR _pB$[ebp], ecx
  00070	8b 55 14	 mov	 edx, DWORD PTR _vertices$[ebp]
  00073	89 55 f4	 mov	 DWORD PTR _pC$[ebp], edx
  00076	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  00079	8b 88 a4 05 00
	00		 mov	 ecx, DWORD PTR [eax+1444]
  0007f	8b 55 14	 mov	 edx, DWORD PTR _vertices$[ebp]
  00082	8d 04 8a	 lea	 eax, DWORD PTR [edx+ecx*4]
  00085	89 45 14	 mov	 DWORD PTR _vertices$[ebp], eax

; 350  : 
; 351  : #endif //endif for TnL_HAL
; 352  : 
; 353  :         ((float*)&sign)[0] = ((FLTP(pA)[FVFO_SX] - FLTP(pB)[FVFO_SX]) * (FLTP(pB)[FVFO_SY] - FLTP(pC)[FVFO_SY])) -
; 354  :                              ((FLTP(pB)[FVFO_SX] - FLTP(pC)[FVFO_SX]) * (FLTP(pA)[FVFO_SY] - FLTP(pB)[FVFO_SY]));

  00088	8b 4d 08	 mov	 ecx, DWORD PTR _pRc$[ebp]
  0008b	8b 91 a0 05 00
	00		 mov	 edx, DWORD PTR [ecx+1440]
  00091	6b d2 5c	 imul	 edx, 92			; 0000005cH
  00094	8b 82 04 00 00
	00		 mov	 eax, DWORD PTR _fvfOffsetTable[edx+4]
  0009a	8b 4d 08	 mov	 ecx, DWORD PTR _pRc$[ebp]
  0009d	8b 91 a0 05 00
	00		 mov	 edx, DWORD PTR [ecx+1440]
  000a3	6b d2 5c	 imul	 edx, 92			; 0000005cH
  000a6	8b 8a 04 00 00
	00		 mov	 ecx, DWORD PTR _fvfOffsetTable[edx+4]
  000ac	8b 55 fc	 mov	 edx, DWORD PTR _pA$[ebp]
  000af	8b 75 f8	 mov	 esi, DWORD PTR _pB$[ebp]
  000b2	d9 04 82	 fld	 DWORD PTR [edx+eax*4]
  000b5	d8 24 8e	 fsub	 DWORD PTR [esi+ecx*4]
  000b8	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  000bb	8b 88 a0 05 00
	00		 mov	 ecx, DWORD PTR [eax+1440]
  000c1	6b c9 5c	 imul	 ecx, 92			; 0000005cH
  000c4	8b 91 08 00 00
	00		 mov	 edx, DWORD PTR _fvfOffsetTable[ecx+8]
  000ca	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  000cd	8b 88 a0 05 00
	00		 mov	 ecx, DWORD PTR [eax+1440]
  000d3	6b c9 5c	 imul	 ecx, 92			; 0000005cH
  000d6	8b 81 08 00 00
	00		 mov	 eax, DWORD PTR _fvfOffsetTable[ecx+8]
  000dc	8b 4d f8	 mov	 ecx, DWORD PTR _pB$[ebp]
  000df	8b 75 f4	 mov	 esi, DWORD PTR _pC$[ebp]
  000e2	d9 04 91	 fld	 DWORD PTR [ecx+edx*4]
  000e5	d8 24 86	 fsub	 DWORD PTR [esi+eax*4]
  000e8	de c9		 fmulp	 ST(1), ST(0)
  000ea	8b 55 08	 mov	 edx, DWORD PTR _pRc$[ebp]
  000ed	8b 82 a0 05 00
	00		 mov	 eax, DWORD PTR [edx+1440]
  000f3	6b c0 5c	 imul	 eax, 92			; 0000005cH
  000f6	8b 88 04 00 00
	00		 mov	 ecx, DWORD PTR _fvfOffsetTable[eax+4]
