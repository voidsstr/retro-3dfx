; 747  :     PrefetchTriIdx2_12_Asm = PrefetchTriIdx2_12_Asm_K6;
; 748  :     PrefetchTriIdx2_11_Asm = PrefetchTriIdx2_11_Asm_K6;
; 749  :     PrefetchTriIdx2_10_Asm = PrefetchTriIdx2_10_Asm_K6;
; 750  :     PrefetchTriIdx2_9_Asm  = PrefetchTriIdx2_9_Asm_K6;
; 751  :     PrefetchTriIdx2_8_Asm  = PrefetchTriIdx2_8_Asm_K6;
