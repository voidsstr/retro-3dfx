; 710  : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp
  00003	51		 push	 ecx

; 711  :   static char regDisOptKey[]="DISABLEPSGP";
; 712  :   BOOL optEnable=TRUE;

  00004	c7 45 fc 01 00
	00 00		 mov	 DWORD PTR _optEnable$[ebp], 1

; 713  :   extern BOOL _3DNowAllowed;
; 714  : 
; 715  : #ifdef WINNT	// OLD CPUID CODE
; 716  :    if (!detect3DX()) return FALSE;
; 717  : #else
; 718  :    if (! (CPUTYPE & CPU_FEATURE_3DNOW)) return FALSE;

  0000b	8b 45 08	 mov	 eax, DWORD PTR _ppdev$[ebp]
  0000e	8b 88 1e 2a 00
	00		 mov	 ecx, DWORD PTR [eax+10782]
  00014	81 e1 00 00 02
	00		 and	 ecx, 131072		; 00020000H
  0001a	85 c9		 test	 ecx, ecx
  0001c	75 07		 jne	 SHORT $L37128
  0001e	33 c0		 xor	 eax, eax
  00020	e9 03 02 00 00	 jmp	 $L37123
$L37128:

; 719  : #endif
; 720  : 
; 721  :   if (GETENV(regDisOptKey))

  00025	68 00 00 00 00	 push	 OFFSET FLAT:_?regDisOptKey@?1??ADJUST3DNOWPOINTERS@@9@9
  0002a	8b 55 08	 mov	 edx, DWORD PTR _ppdev$[ebp]
  0002d	52		 push	 edx
  0002e	e8 00 00 00 00	 call	 _ddgetenv
  00033	83 c4 08	 add	 esp, 8
  00036	85 c0		 test	 eax, eax
  00038	74 22		 je	 SHORT $L37129

; 722  :     optEnable=!(BOOL)atoi(GETENV(regDisOptKey));

  0003a	68 00 00 00 00	 push	 OFFSET FLAT:_?regDisOptKey@?1??ADJUST3DNOWPOINTERS@@9@9
  0003f	8b 45 08	 mov	 eax, DWORD PTR _ppdev$[ebp]
  00042	50		 push	 eax
  00043	e8 00 00 00 00	 call	 _ddgetenv
  00048	83 c4 08	 add	 esp, 8
  0004b	50		 push	 eax
  0004c	e8 00 00 00 00	 call	 _atoi
  00051	83 c4 04	 add	 esp, 4
  00054	f7 d8		 neg	 eax
  00056	1b c0		 sbb	 eax, eax
  00058	40		 inc	 eax
  00059	89 45 fc	 mov	 DWORD PTR _optEnable$[ebp], eax
$L37129:

; 723  : 
; 724  :   if (optEnable) {

  0005c	83 7d fc 00	 cmp	 DWORD PTR _optEnable$[ebp], 0
  00060	0f 84 e1 00 00
	00		 je	 $L37131

; 725  :     _3DNowAllowed = TRUE;

  00066	c7 05 00 00 00
	00 01 00 00 00	 mov	 DWORD PTR __3DNowAllowed, 1

