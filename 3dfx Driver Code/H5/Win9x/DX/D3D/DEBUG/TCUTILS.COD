_DecodeBlockRGB PROC NEAR

; 91   : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp
  00003	83 ec 30	 sub	 esp, 48			; 00000030H
  00006	56		 push	 esi

; 92   :    int         lev;
; 93   :    DXT_COLOR   clut[4];
; 94   :    PIXBM       pixbm;
; 95   :    int         pixel;
; 96   :    int         primary;
; 97   : 
; 98   :    // if source block is invalid, ...
; 99   :    if (pblockSrc == 0)

  00007	83 7d 08 00	 cmp	 DWORD PTR _pblockSrc$[ebp], 0
  0000b	75 05		 jne	 SHORT $L36089

; 100  :       return;

  0000d	e9 b5 01 00 00	 jmp	 $L36107
$L36089:

; 101  : 
; 102  :    // determine the number of color levels in the block
; 103  :    lev = (pblockSrc->rgb0 <= pblockSrc->rgb1) ? 2 : 3;

  00012	8b 45 08	 mov	 eax, DWORD PTR _pblockSrc$[ebp]
  00015	33 c9		 xor	 ecx, ecx
  00017	66 8b 08	 mov	 cx, WORD PTR [eax]
  0001a	8b 55 08	 mov	 edx, DWORD PTR _pblockSrc$[ebp]
  0001d	33 c0		 xor	 eax, eax
  0001f	66 8b 42 02	 mov	 ax, WORD PTR [edx+2]
  00023	33 d2		 xor	 edx, edx
  00025	3b c8		 cmp	 ecx, eax
  00027	0f 9f c2	 setg	 dl
  0002a	83 c2 02	 add	 edx, 2
  0002d	89 55 fc	 mov	 DWORD PTR _lev$[ebp], edx

; 104  : 
; 105  :    // Fill extrema values into pixel code lookup table.
; 106  :    RGBToColor(&pblockSrc->rgb0, &clut[0]);

  00030	8d 45 e4	 lea	 eax, DWORD PTR _clut$[ebp]
  00033	50		 push	 eax
  00034	8b 4d 08	 mov	 ecx, DWORD PTR _pblockSrc$[ebp]
  00037	51		 push	 ecx
  00038	e8 00 00 00 00	 call	 _RGBToColor
  0003d	83 c4 08	 add	 esp, 8

; 107  :    RGBToColor(&pblockSrc->rgb1, &clut[1]);

  00040	8d 55 e8	 lea	 edx, DWORD PTR _clut$[ebp+4]
  00043	52		 push	 edx
  00044	8b 45 08	 mov	 eax, DWORD PTR _pblockSrc$[ebp]
  00047	83 c0 02	 add	 eax, 2
  0004a	50		 push	 eax
  0004b	e8 00 00 00 00	 call	 _RGBToColor
  00050	83 c4 08	 add	 esp, 8

; 108  : 
; 109  :    clut[0].rgba[ALFA] =
; 110  :    clut[1].rgba[ALFA] =
; 111  :    clut[2].rgba[ALFA] = 255;

  00053	c6 45 ef ff	 mov	 BYTE PTR _clut$[ebp+11], 255 ; 000000ffH
  00057	8a 4d ef	 mov	 cl, BYTE PTR _clut$[ebp+11]
  0005a	88 4d eb	 mov	 BYTE PTR _clut$[ebp+7], cl
  0005d	8a 55 eb	 mov	 dl, BYTE PTR _clut$[ebp+7]
  00060	88 55 e7	 mov	 BYTE PTR _clut$[ebp+3], dl

; 112  : 
; 113  :    if (lev == 3)

  00063	83 7d fc 03	 cmp	 DWORD PTR _lev$[ebp], 3
  00067	0f 85 82 00 00
	00		 jne	 $L36090

; 115  :       for (primary = 0; primary < NUM_PRIMARIES; ++primary)

  0006d	c7 45 f4 00 00
	00 00		 mov	 DWORD PTR _primary$[ebp], 0
  00074	eb 09		 jmp	 SHORT $L36091
$L36092:
  00076	8b 45 f4	 mov	 eax, DWORD PTR _primary$[ebp]
  00079	83 c0 01	 add	 eax, 1
  0007c	89 45 f4	 mov	 DWORD PTR _primary$[ebp], eax
$L36091:
  0007f	83 7d f4 03	 cmp	 DWORD PTR _primary$[ebp], 3
  00083	7d 64		 jge	 SHORT $L36093

; 117  :          WORD temp0 = clut[0].rgba[primary];   // jvanaken fixed overflow bug

  00085	8b 4d f4	 mov	 ecx, DWORD PTR _primary$[ebp]
  00088	66 0f b6 54 0d
	e4		 movzx	 dx, BYTE PTR _clut$[ebp+ecx]
  0008e	66 89 55 dc	 mov	 WORD PTR _temp0$36094[ebp], dx

; 118  :          WORD temp1 = clut[1].rgba[primary];

  00092	8b 45 f4	 mov	 eax, DWORD PTR _primary$[ebp]
  00095	66 0f b6 4c 05
	e8		 movzx	 cx, BYTE PTR _clut$[ebp+eax+4]
  0009b	66 89 4d d8	 mov	 WORD PTR _temp1$36095[ebp], cx

; 119  :          clut[2].rgba[primary] = (BYTE)((2*temp0 + temp1 + 1)/3);

  0009f	8b 55 dc	 mov	 edx, DWORD PTR _temp0$36094[ebp]
  000a2	81 e2 ff ff 00
	00		 and	 edx, 65535		; 0000ffffH
  000a8	8b 45 d8	 mov	 eax, DWORD PTR _temp1$36095[ebp]
  000ab	25 ff ff 00 00	 and	 eax, 65535		; 0000ffffH
  000b0	8d 44 50 01	 lea	 eax, DWORD PTR [eax+edx*2+1]
  000b4	99		 cdq
  000b5	b9 03 00 00 00	 mov	 ecx, 3
  000ba	f7 f9		 idiv	 ecx
  000bc	8b 55 f4	 mov	 edx, DWORD PTR _primary$[ebp]
  000bf	88 44 15 ec	 mov	 BYTE PTR _clut$[ebp+edx+8], al

; 120  :          clut[3].rgba[primary] = (BYTE)((temp0 + 2*temp1 + 1)/3);

  000c3	8b 45 dc	 mov	 eax, DWORD PTR _temp0$36094[ebp]
  000c6	25 ff ff 00 00	 and	 eax, 65535		; 0000ffffH
  000cb	8b 4d d8	 mov	 ecx, DWORD PTR _temp1$36095[ebp]
  000ce	81 e1 ff ff 00
	00		 and	 ecx, 65535		; 0000ffffH
  000d4	8d 44 48 01	 lea	 eax, DWORD PTR [eax+ecx*2+1]
  000d8	99		 cdq
  000d9	b9 03 00 00 00	 mov	 ecx, 3
  000de	f7 f9		 idiv	 ecx
  000e0	8b 55 f4	 mov	 edx, DWORD PTR _primary$[ebp]
  000e3	88 44 15 f0	 mov	 BYTE PTR _clut$[ebp+edx+12], al

; 121  :       }

  000e7	eb 8d		 jmp	 SHORT $L36092
$L36093:

; 122  :       clut[3].rgba[ALFA] = 255;

  000e9	c6 45 f3 ff	 mov	 BYTE PTR _clut$[ebp+15], 255 ; 000000ffH

; 124  :    else

  000ed	eb 5f		 jmp	 SHORT $L36098
$L36090:

; 126  :       for (primary = 0; primary < NUM_PRIMARIES; ++primary)

  000ef	c7 45 f4 00 00
	00 00		 mov	 DWORD PTR _primary$[ebp], 0
  000f6	eb 09		 jmp	 SHORT $L36099
$L36100:
  000f8	8b 45 f4	 mov	 eax, DWORD PTR _primary$[ebp]
  000fb	83 c0 01	 add	 eax, 1
  000fe	89 45 f4	 mov	 DWORD PTR _primary$[ebp], eax
$L36099:
  00101	83 7d f4 03	 cmp	 DWORD PTR _primary$[ebp], 3
  00105	7d 43		 jge	 SHORT $L36101

; 128  :          WORD temp0 = clut[0].rgba[primary];   // jvanaken fixed overflow bug

  00107	8b 4d f4	 mov	 ecx, DWORD PTR _primary$[ebp]
  0010a	66 0f b6 54 0d
	e4		 movzx	 dx, BYTE PTR _clut$[ebp+ecx]
  00110	66 89 55 d4	 mov	 WORD PTR _temp0$36102[ebp], dx

; 129  :          WORD temp1 = clut[1].rgba[primary];

  00114	8b 45 f4	 mov	 eax, DWORD PTR _primary$[ebp]
  00117	66 0f b6 4c 05
	e8		 movzx	 cx, BYTE PTR _clut$[ebp+eax+4]
  0011d	66 89 4d d0	 mov	 WORD PTR _temp1$36103[ebp], cx

; 130  :          clut[2].rgba[primary] = (BYTE)((temp0 + temp1)/2);

  00121	8b 45 d4	 mov	 eax, DWORD PTR _temp0$36102[ebp]
  00124	25 ff ff 00 00	 and	 eax, 65535		; 0000ffffH
  00129	8b 55 d0	 mov	 edx, DWORD PTR _temp1$36103[ebp]
  0012c	81 e2 ff ff 00
	00		 and	 edx, 65535		; 0000ffffH
  00132	03 c2		 add	 eax, edx
  00134	99		 cdq
  00135	2b c2		 sub	 eax, edx
  00137	d1 f8		 sar	 eax, 1
  00139	8b 4d f4	 mov	 ecx, DWORD PTR _primary$[ebp]
  0013c	88 44 0d ec	 mov	 BYTE PTR _clut$[ebp+ecx+8], al

; 131  :          clut[3].rgba[primary] = 0;     // jvanaken added this

  00140	8b 55 f4	 mov	 edx, DWORD PTR _primary$[ebp]
  00143	c6 44 15 f0 00	 mov	 BYTE PTR _clut$[ebp+edx+12], 0

; 132  :       }

  00148	eb ae		 jmp	 SHORT $L36100
$L36101:

; 133  :       clut[3].rgba[ALFA] = 0;

  0014a	c6 45 f3 00	 mov	 BYTE PTR _clut$[ebp+15], 0
$L36098:

; 135  : 
; 136  :    // munge a local copy
; 137  :    pixbm = pblockSrc->pixbm;

  0014e	8b 45 08	 mov	 eax, DWORD PTR _pblockSrc$[ebp]
  00151	8b 48 04	 mov	 ecx, DWORD PTR [eax+4]
  00154	89 4d e0	 mov	 DWORD PTR _pixbm$[ebp], ecx

; 138  : 
; 139  :    // Look up the actual pixel color in the table.
; 140  :    for (pixel=0; pixel < DXT_BLOCK_PIXELS; ++pixel)

  00157	c7 45 f8 00 00
	00 00		 mov	 DWORD PTR _pixel$[ebp], 0
  0015e	eb 09		 jmp	 SHORT $L36105
$L36106:
  00160	8b 55 f8	 mov	 edx, DWORD PTR _pixel$[ebp]
  00163	83 c2 01	 add	 edx, 1
  00166	89 55 f8	 mov	 DWORD PTR _pixel$[ebp], edx
$L36105:
  00169	83 7d f8 10	 cmp	 DWORD PTR _pixel$[ebp], 16 ; 00000010H
  0016d	7d 58		 jge	 SHORT $L36107

; 142  :       // lookup color from pixel bitmap
; 143  :       for (primary = 0; primary < NUM_PRIMARIES; ++primary)

  0016f	c7 45 f4 00 00
	00 00		 mov	 DWORD PTR _primary$[ebp], 0
  00176	eb 09		 jmp	 SHORT $L36108
$L36109:
  00178	8b 45 f4	 mov	 eax, DWORD PTR _primary$[ebp]
  0017b	83 c0 01	 add	 eax, 1
  0017e	89 45 f4	 mov	 DWORD PTR _primary$[ebp], eax
$L36108:
  00181	83 7d f4 03	 cmp	 DWORD PTR _primary$[ebp], 3
  00185	7d 21		 jge	 SHORT $L36110

; 144  :          colorDst[pixel].rgba[primary] = clut[pixbm & 3].rgba[primary];

  00187	8b 4d e0	 mov	 ecx, DWORD PTR _pixbm$[ebp]
  0018a	83 e1 03	 and	 ecx, 3
  0018d	8d 54 8d e4	 lea	 edx, DWORD PTR _clut$[ebp+ecx*4]
  00191	8b 45 f8	 mov	 eax, DWORD PTR _pixel$[ebp]
  00194	8b 4d 0c	 mov	 ecx, DWORD PTR _colorDst$[ebp]
  00197	8d 04 81	 lea	 eax, DWORD PTR [ecx+eax*4]
  0019a	8b 4d f4	 mov	 ecx, DWORD PTR _primary$[ebp]
  0019d	8b 75 f4	 mov	 esi, DWORD PTR _primary$[ebp]
  001a0	8a 14 32	 mov	 dl, BYTE PTR [edx+esi]
  001a3	88 14 08	 mov	 BYTE PTR [eax+ecx], dl
  001a6	eb d0		 jmp	 SHORT $L36109
$L36110:

; 145  : 
; 146  :       colorDst[pixel].rgba[ALFA] = clut[pixbm & 3].rgba[ALFA];

  001a8	8b 45 e0	 mov	 eax, DWORD PTR _pixbm$[ebp]
  001ab	83 e0 03	 and	 eax, 3
  001ae	8b 4d f8	 mov	 ecx, DWORD PTR _pixel$[ebp]
  001b1	8b 55 0c	 mov	 edx, DWORD PTR _colorDst$[ebp]
  001b4	8a 44 85 e7	 mov	 al, BYTE PTR _clut$[ebp+eax*4+3]
  001b8	88 44 8a 03	 mov	 BYTE PTR [edx+ecx*4+3], al

; 147  : 
; 148  :       // prepare to extract next index
