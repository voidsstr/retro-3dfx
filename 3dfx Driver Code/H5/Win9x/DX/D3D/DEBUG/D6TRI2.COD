; 443  : 
; 444  :             // !!! QUICK TRIVIAL REJECT TEST !!!
; 445  :             // Clipping test for this triangle
; 446  :             if ((c0 & c1 & c2))
; 447  :             {
; 448  :               // This triangle is totaly clipped
