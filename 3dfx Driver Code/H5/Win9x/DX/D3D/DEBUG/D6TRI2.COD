; 425  :             // Don't bother pulling out new vertex data 
; 426  :             // from the command stream. Just re-arrange the
; 427  :             // vertex pointers from the new output clip
; 428  :             // FVF buffer for the next blade of the fan to clip
; 429  : 
; 430  :                        // pA is the center of the Fan, it does NOT change
; 431  :             pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 432  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 433  : 
; 434  :             ClipContinue--;     // Decrement the ClipContine value
; 435  :             TLV_idx++;          // Increment the new FVF buf index
; 436  :           }
; 437  :           else
