; 475  : 
; 476  :                 pA = (LPDWORD) (pTLV); 
; 477  :                 pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 478  :                 pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 479  :                 TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 480  : 
; 481  :                 // Let the master loop know that we ne need to process more 
