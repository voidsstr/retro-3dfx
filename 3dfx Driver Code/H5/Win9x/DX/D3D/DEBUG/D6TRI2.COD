; 421  :           // in the last loop.
; 422  :           if(ClipContinue)
; 423  :           {
; 424  :             // Yes, we have a cliped triangle in progress
; 425  :             // Don't bother pulling out new vertex data 
; 426  :             // from the command stream. Just re-arrange the
; 427  :             // vertex pointers from the new output clip
; 428  :             // FVF buffer for the next blade of the fan to clip
; 429  : 
; 430  :                        // pA is the center of the Fan, it does NOT change
; 431  :             pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 432  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 433  : 
; 434  :             ClipContinue--;     // Decrement the ClipContine value
; 435  :             TLV_idx++;          // Increment the new FVF buf index
; 436  :           }
; 437  :           else
; 438  :           {
; 439  :             // No clipping in the previous pass of
; 440  :             // the master loop, just get the next 
; 441  :             // vertices and continue.
; 442  :             TRI_NEXT_WITH_CLIP();
; 443  : 
; 444  :             // !!! QUICK TRIVIAL REJECT TEST !!!
; 445  :             // Clipping test for this triangle
; 446  :             if ((c0 & c1 & c2))
; 447  :             {
; 448  :               // This triangle is totaly clipped
; 449  :               // skip it and go on to teh next one
; 450  :               // in the command stream
; 451  :               continue;
; 452  :             }
; 453  : 
; 454  :             // This Triangle is not TR clipped 
; 455  :             // Get the OR flags and clip mask to see if we can trivial 
; 456  :             // accept it
; 457  :             dwUnion = (c0 | c1 | c2);
; 458  :             dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 459  :                      TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 460  :   
