; 645  :         // vertices and continue.
; 646  :         TRI_NEXT_WITH_CLIP();
; 647  : 
; 648  :         // !!! QUICK TRIVIAL REJECT TEST !!!
; 649  :         // Clipping test for this triangle
; 650  :         if ((c0 & c1 & c2))
; 651  :         {
; 652  :           // This triangle is totaly clipped
; 653  :           // skip it and go on to teh next one
; 654  :           // in the command stream
; 655  : 
; 656  : #ifdef C_AUTOSTRIP
; 657  :           // Reset the Auto Strip/Fan Logic
