; 462  :             {
; 463  :               dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 464  :                        TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 465  :             }
; 466  : 
; 467  :             // If all the vertices are in, 
; 468  :             // No clipping is neeed! 
; 469  :             // Let it pass down to the FIFO stuffing
; 470  :             if ((dwUnion & dwMask) != 0)
; 471  :             {
; 472  :               if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 473  :               {
; 474  :                 ClipContinue = dwNumClippedVertices - 3; 
; 475  : 
; 476  :                 pA = (LPDWORD) (pTLV); 
