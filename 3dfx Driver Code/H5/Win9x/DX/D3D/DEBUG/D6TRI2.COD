; 451  :               continue;
; 452  :             }
; 453  : 
; 454  :             // This Triangle is not TR clipped 
; 455  :             // Get the OR flags and clip mask to see if we can trivial 
; 456  :             // accept it
; 457  :             dwUnion = (c0 | c1 | c2);
; 458  :             dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 459  :                      TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 460  :   
; 461  :             if (pRc->tl.dwTLState & TLPV_GUARDBAND) 
; 462  :             {
; 463  :               dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 464  :                        TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 465  :             }
; 466  : 
; 467  :             // If all the vertices are in, 
; 468  :             // No clipping is neeed! 
; 469  :             // Let it pass down to the FIFO stuffing
; 470  :             if ((dwUnion & dwMask) != 0)
; 471  :             {
; 472  :               if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 473  :               {
