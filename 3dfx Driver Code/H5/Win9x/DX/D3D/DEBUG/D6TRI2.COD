; 283  : #ifdef TnL_HAL
; 284  :         // Okay, were compiling in the software TnL HAL
; 285  :         // We might have clipping to do so let's start the process
; 286  : 
; 287  :         // Any clipping needed?
; 288  :         if ( CLIPPING_NEEDED )
; 289  :         {
; 290  :           // Check to see if we had started a multi triangle clip
; 291  :           // in the last loop.
; 292  :           if(ClipContinue)
; 293  :           {
; 294  :             // Yes, we have a cliped triangle in progress
; 295  :             // Don't bother pulling out new vertex data 
; 296  :             // from the command stream. Just re-arrange the
; 297  :             // vertex pointers from the new output clip
; 298  :             // FVF buffer for the next blade of the fan to clip
; 299  : 
; 300  :                      // pA is the center of the Fan, it does NOT change
; 301  :             pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 302  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 303  : 
; 304  :             ClipContinue--;     // Decrement the ClipContine value
; 305  :             TLV_idx++;          // Increment the new FVF buf index
; 306  :           }
; 307  :           else
; 308  :           {
; 309  :             // No clipping in the previous pass of
; 310  :             // the master loop, just get the next 
; 311  :             // vertices and continue.
; 312  :             TRI_NEXT_WITH_CLIP();
; 313  : 
; 314  :             // !!! QUICK TRIVIAL REJECT TEST !!!
; 315  :             // Clipping test for this triangle
; 316  :             if ((c0 & c1 & c2))
; 317  :             {
; 318  :               // This triangle is totaly clipped
; 319  :               // skip it and go on to teh next one
; 320  :               // in the command stream
; 321  :               continue;
; 322  :             }
; 323  : 
; 324  :             // This Triangle is not TR clipped 
; 325  :             // Get the OR flags and clip mask to see if we can trivial 
; 326  :             // accept it
; 327  :             dwUnion = (c0 | c1 | c2);
; 328  :             dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 329  :                      TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 330  :    
; 331  :             if (pRc->tl.dwTLState & TLPV_GUARDBAND) 
; 332  :             {
; 333  :               dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 334  :                        TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 335  :             }
; 336  : 
; 337  :             // If all the vertices are in, 
; 338  :             // No clipping is neeed! 
; 339  :             // Let it pass down to the FIFO stuffing
; 340  :             if ((dwUnion & dwMask) != 0)
; 341  :             {
; 342  :               if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 343  :               {
; 344  :                 ClipContinue = dwNumClippedVertices - 3; 
; 345  : 
; 346  :                 pA = (LPDWORD) (pTLV); 
; 347  :                 pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 348  :                 pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 349  :                 TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 350  : 
; 351  :                 // Let the master loop know that we ne need to process more 
; 352  :                 // triangles if the clippeing calls for it.
; 353  :                 count += ClipContinue;
; 354  :               }
; 355  :               else
; 356  :               {
; 357  :                 // Clip routine said that there was nothing to
