; 688  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 689  :             TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 690  : 
; 691  :             // Let the master loop know that we ne need to process more 
