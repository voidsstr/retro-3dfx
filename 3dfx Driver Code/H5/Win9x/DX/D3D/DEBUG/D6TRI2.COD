  000c0	d9 04 82	 fld	 DWORD PTR [edx+eax*4]
  000c3	d8 24 8e	 fsub	 DWORD PTR [esi+ecx*4]
  000c6	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  000c9	8b 88 a0 05 00
	00		 mov	 ecx, DWORD PTR [eax+1440]
  000cf	6b c9 5c	 imul	 ecx, 92			; 0000005cH
  000d2	8b 91 08 00 00
	00		 mov	 edx, DWORD PTR _fvfOffsetTable[ecx+8]
  000d8	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  000db	8b 88 a0 05 00
	00		 mov	 ecx, DWORD PTR [eax+1440]
  000e1	6b c9 5c	 imul	 ecx, 92			; 0000005cH
  000e4	8b 81 08 00 00
	00		 mov	 eax, DWORD PTR _fvfOffsetTable[ecx+8]
  000ea	8b 4d f8	 mov	 ecx, DWORD PTR _pB$[ebp]
