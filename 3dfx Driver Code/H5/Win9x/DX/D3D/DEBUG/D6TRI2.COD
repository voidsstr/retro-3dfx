; 1715 : #ifdef TnL_HAL
; 1716 :     // Okay, were compiling in the software TnL HAL
; 1717 :     // We might have clipping to do so let's start the process
; 1718 : 
; 1719 :     // Any clipping needed?
; 1720 :     if ( CLIPPING_NEEDED )
; 1721 :     {
; 1722 :       // Check to see if we had started a multi triangle clip
; 1723 :       // in the last loop.
; 1724 :       if(ClipContinue)
; 1725 :       {
; 1726 :          // Yes, we have a cliped triangle in progress
; 1727 :          // Don't bother pulling out new vertex data 
; 1728 :          // from the command stream. Just re-arrange the
; 1729 :          // vertex pointers from the new output clip
; 1730 :          // FVF buffer for the next blade of the fan to clip
; 1731 : 
; 1732 :                      // pA is the center of the Fan, it does NOT change
; 1733 :          pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 1734 :          pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 1735 : 
; 1736 :          ClipContinue--;     // Decrement the ClipContine value
; 1737 :          TLV_idx++;          // Increment the new FVF buf index
; 1738 :       }
; 1739 :       else
; 1740 :       {
; 1741 :         // No clipping in the previous pass of
; 1742 :         // the master loop, just get the next 
; 1743 :         // vertices and continue.
; 1744 :         TRI_NEXT_WITH_CLIP();
; 1745 : 
; 1746 : 
; 1747 :         // !!! QUICK TRIVIAL REJECT TEST !!!
; 1748 :         // Clipping test for this triangle
; 1749 :         if ((c0 & c1 & c2))
; 1750 :         {
; 1751 :           // This triangle is totaly clipped
; 1752 :           // skip it and go on to teh next one
; 1753 :           // in the command stream
; 1754 : 
; 1755 : #ifdef C_AUTOSTRIP
; 1756 :           // Reset the Auto Strip/Fan Logic
; 1757 :           DoInitialTriangle |= NO_CONTINUE;
; 1758 :           PrevA = PrevB = PrevC = 0;
; 1759 : #endif
; 1760 :           continue;
; 1761 :         }
; 1762 : 
; 1763 :         // This Triangle is not TR clipped 
; 1764 :         // Get the OR flags and clip mask to see if we can trivial 
; 1765 :         // accept it
; 1766 :         dwUnion = (c0 | c1 | c2);
; 1767 :         dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 1768 :                  TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 1769 :    
; 1770 :         if (pRc->tl.dwTLState & TLPV_GUARDBAND) 
; 1771 :         {
; 1772 :           dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 1773 :                    TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 1774 :         }
; 1775 : 
; 1776 :         // If all the vertices are in, 
; 1777 :         // No clipping is neeed! 
; 1778 :         // Let it pass down to the FIFO stuffing
; 1779 :         if ((dwUnion & dwMask) != 0)
; 1780 :         {
; 1781 :           if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 1782 :           {
; 1783 :             ClipContinue = dwNumClippedVertices - 3; 
; 1784 : 
; 1785 :             pA = (LPDWORD) (pTLV); 
; 1786 :             pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 1787 :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 1788 :             TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 1789 : 
; 1790 :             // Let the master loop know that we ne need to process more 
; 1791 :             // triangles if the clippeing calls for it.
