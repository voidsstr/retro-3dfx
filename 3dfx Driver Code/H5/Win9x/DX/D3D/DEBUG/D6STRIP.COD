_dp2StripAllFill PROC NEAR

; 258  : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp
  00003	83 ec 1c	 sub	 esp, 28			; 0000001cH
  00006	56		 push	 esi

; 259  :   LPDWORD       pA, pB, pC, pF;
; 260  : #ifdef TnL_HAL
; 261  :   LPDWORD       pAOrig, pBOrig, pCOrig;
; 262  :   DWORD         c0, c1, c2;
; 263  :   LPDWORD       clipcodes = (LPDWORD) pRc->tl.pClipBuf;
; 264  :   DWORD         ClipContinue = 0;       // Tells us if we need to continue the 
; 265  :   // clipped triangle alreasy in progress
; 266  :   DWORD         dwNumClippedVertices;
; 267  :   LPBYTE pTLV = (LPVOID) pRc->tl.clipping.ClipBuf.alignedBuf;
; 268  :   DWORD dwUnion;
; 269  :   DWORD dwMask;
; 270  :   DWORD TLV_idx = 3;
; 271  :   BOOL  RestoreVertexPointers = 0;
; 272  : #endif
; 273  :   BOOL          flip = 0;

  00007	c7 45 e8 00 00
	00 00		 mov	 DWORD PTR _flip$[ebp], 0

; 274  :   int           sign;
; 275  : 
; 276  : #if( PERFTEST == TRI_NULL )
; 277  :   return;
; 278  : #endif
; 279  : 
; 280  :   switch( pRc->fillMode )
; 281  :   {

  0000e	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  00011	8b 48 1c	 mov	 ecx, DWORD PTR [eax+28]
  00014	89 4d e4	 mov	 DWORD PTR -28+[ebp], ecx
  00017	83 7d e4 01	 cmp	 DWORD PTR -28+[ebp], 1
  0001b	0f 84 e6 01 00
	00		 je	 $L37046
  00021	83 7d e4 02	 cmp	 DWORD PTR -28+[ebp], 2
  00025	74 05		 je	 SHORT $L37030
  00027	e9 a7 03 00 00	 jmp	 $L37062
$L37030:

; 282  :     case D3DFILL_WIREFRAME :
; 283  : 
; 284  : #ifdef TnL_HAL
; 285  :       if ( clipcodes != NULL )
; 286  :       {
; 287  :         TRI_INIT_WITH_CLIP;
; 288  :       }
; 289  :       else
; 290  :       {
; 291  :         TRI_INIT;
; 292  :       }
; 293  : #else
; 294  :       TRI_INIT;

  0002c	8b 55 14	 mov	 edx, DWORD PTR _vertices$[ebp]
  0002f	89 55 fc	 mov	 DWORD PTR _pA$[ebp], edx
  00032	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  00035	8b 88 a4 05 00
	00		 mov	 ecx, DWORD PTR [eax+1444]
  0003b	8b 55 14	 mov	 edx, DWORD PTR _vertices$[ebp]
  0003e	8d 04 8a	 lea	 eax, DWORD PTR [edx+ecx*4]
  00041	89 45 14	 mov	 DWORD PTR _vertices$[ebp], eax
  00044	8b 4d 14	 mov	 ecx, DWORD PTR _vertices$[ebp]
  00047	89 4d f4	 mov	 DWORD PTR _pC$[ebp], ecx
  0004a	8b 55 08	 mov	 edx, DWORD PTR _pRc$[ebp]
  0004d	8b 82 a4 05 00
	00		 mov	 eax, DWORD PTR [edx+1444]
  00053	8b 4d 14	 mov	 ecx, DWORD PTR _vertices$[ebp]
  00056	8d 14 81	 lea	 edx, DWORD PTR [ecx+eax*4]
  00059	89 55 14	 mov	 DWORD PTR _vertices$[ebp], edx

; 295  : #endif
; 296  : 
; 297  :       for( ; count > 0; count-- )

  0005c	eb 09		 jmp	 SHORT $L37031
$L37032:
  0005e	8b 45 0c	 mov	 eax, DWORD PTR _count$[ebp]
  00061	83 e8 01	 sub	 eax, 1
  00064	89 45 0c	 mov	 DWORD PTR _count$[ebp], eax
$L37031:
  00067	83 7d 0c 00	 cmp	 DWORD PTR _count$[ebp], 0
  0006b	0f 86 91 01 00
	00		 jbe	 $L37033

; 299  : #ifdef TnL_HAL
; 300  :         // Okay, were compiling in the software TnL HAL
; 301  :         // We might have clipping to do so let's start the process
; 302  :     
; 303  :         // Any clipping needed?
; 304  :         if ( CLIPPING_NEEDED )
; 305  :         {
; 306  :           // Check to see if we had started a multi triangle clip
; 307  :           // in the last loop.
; 308  :           if(ClipContinue)
; 309  :           {
; 310  :             // Yes, we have a cliped triangle in progress
; 311  :             // Don't bother pulling out new vertex data 
; 312  :             // from the command stream. Just re-arrange the
; 313  :             // vertex pointers from the new output clip
; 314  :             // FVF buffer for the next blade of the fan to clip
; 315  : 
; 316  :             // pA is the center of the Fan, it does NOT change
; 317  :             pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 318  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 319  :     
; 320  :             ClipContinue--;     // Decrement the ClipContine value
; 321  :             TLV_idx++;          // Increment the new FVF buf index
; 322  :           }
; 323  :           else
; 324  :           {
; 325  :             TRI_CLIP_RESTORE;
; 326  :             // No clipping in the previous pass of
; 327  :             // the master loop, just get the next 
; 328  :             // vertices and continue.
; 329  :             TRI_NEXT_WITH_CLIP;
; 330  : 
; 331  :             // !!! QUICK TRIVIAL REJECT TEST !!!
; 332  :             // Clipping test for this triangle
; 333  :             if ((c0 & c1 & c2))
; 334  :             {
; 335  :               // This triangle is totaly clipped
; 336  :               // skip it and go on to teh next one
; 337  :               // in the command stream
; 338  :               continue;
; 339  :             }
; 340  : 
; 341  :             // This Triangle is not TR clipped 
; 342  :             // Get the OR flags and clip mask to see if we can trivial 
; 343  :             // accept it
; 344  :             dwUnion = (c0 | c1 | c2);
; 345  :             dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 346  :                      TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 347  :     
; 348  :             if (pRc->tl.dwTLState & TLPV_GUARDBAND)
; 349  :             {
; 350  :               dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 351  :                        TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 352  :             }
; 353  : 
; 354  :             // If all the vertices are in, 
; 355  :             // No clipping is neeed! 
; 356  :             // Let it pass down to the FIFO stuffing
; 357  :             if ((dwUnion & dwMask) != 0)
; 358  :             {
; 359  : 
; 360  :               if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 361  :               {
; 362  :                 ClipContinue = dwNumClippedVertices - 3; 
; 363  : 
; 364  :                 TRI_CLIP_SAVE;
; 365  :                 pA = (LPDWORD) (pTLV); 
; 366  :                 pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 367  :                 pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 368  :                 TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 369  : 
; 370  :                 // Let the master loop know that we ne need to process more 
; 371  :                 // triangles if the clippeing calls for it.
; 372  :                 count += ClipContinue;
; 373  :               }
; 374  :               else
; 375  :               {
; 376  : 
; 377  :                 // Clip routine said that there was nothing to
; 378  :                 // clip, skip it and go on to teh next one
; 379  :                 // in the command stream
; 380  :                 continue;
; 381  :               }
; 382  : 
; 383  :             } // if clipping on this triangle
; 384  : 
; 385  :           } // not a clip continuation
; 386  :     
; 387  :         } // if valid clipBuf pointer
; 388  :         else
; 389  :         {
; 390  :           // No valid clip code buffer, just update the 
; 391  :           // vertex pointers for the next triangle to process 
; 392  :           TRI_NEXT;
; 393  :         }
; 394  : 
; 395  : #else
; 396  :         TRI_NEXT;

  00071	33 c9		 xor	 ecx, ecx
  00073	83 7d e8 00	 cmp	 DWORD PTR _flip$[ebp], 0
  00077	0f 94 c1	 sete	 cl
  0007a	89 4d e8	 mov	 DWORD PTR _flip$[ebp], ecx
  0007d	83 7d e8 00	 cmp	 DWORD PTR _flip$[ebp], 0
  00081	74 14		 je	 SHORT $L37034
  00083	8b 55 fc	 mov	 edx, DWORD PTR _pA$[ebp]
  00086	89 55 fc	 mov	 DWORD PTR _pA$[ebp], edx
  00089	8b 45 f4	 mov	 eax, DWORD PTR _pC$[ebp]
  0008c	89 45 f8	 mov	 DWORD PTR _pB$[ebp], eax
  0008f	8b 4d fc	 mov	 ecx, DWORD PTR _pA$[ebp]
  00092	89 4d ec	 mov	 DWORD PTR _pF$[ebp], ecx
  00095	eb 12		 jmp	 SHORT $L37035
$L37034:
  00097	8b 55 f4	 mov	 edx, DWORD PTR _pC$[ebp]
  0009a	89 55 fc	 mov	 DWORD PTR _pA$[ebp], edx
  0009d	8b 45 f8	 mov	 eax, DWORD PTR _pB$[ebp]
  000a0	89 45 f8	 mov	 DWORD PTR _pB$[ebp], eax
  000a3	8b 4d f8	 mov	 ecx, DWORD PTR _pB$[ebp]
  000a6	89 4d ec	 mov	 DWORD PTR _pF$[ebp], ecx
$L37035:
  000a9	8b 55 14	 mov	 edx, DWORD PTR _vertices$[ebp]
  000ac	89 55 f4	 mov	 DWORD PTR _pC$[ebp], edx
  000af	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  000b2	8b 88 a4 05 00
	00		 mov	 ecx, DWORD PTR [eax+1444]
  000b8	8b 55 14	 mov	 edx, DWORD PTR _vertices$[ebp]
  000bb	8d 04 8a	 lea	 eax, DWORD PTR [edx+ecx*4]
  000be	89 45 14	 mov	 DWORD PTR _vertices$[ebp], eax

