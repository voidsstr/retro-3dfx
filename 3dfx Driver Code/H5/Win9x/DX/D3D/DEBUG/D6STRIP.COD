; 651  :     // Okay, were compiling in the software TnL HAL
; 652  :     // We might have clipping to do so let's start the process
; 653  : 
; 654  :     // Any clipping needed?
; 655  :     if ( CLIPPING_NEEDED )
; 656  :     {
; 657  :       // Check to see if we had started a multi triangle clip
; 658  :       // in the last loop.
; 659  :       if(ClipContinue)
; 660  :       {
; 661  :         // Yes, we have a cliped triangle in progress
; 662  :         // Don't bother pulling out new vertex data 
; 663  :         // from the command stream. Just re-arrange the
; 664  :         // vertex pointers from the new output clip
; 665  :         // FVF buffer for the next blade of the fan to clip
; 666  : 
; 667  :         // pA is the center of the Fan, it does NOT change
; 668  :         pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 669  :         pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 670  : 
; 671  :         ClipContinue--;     // Decrement the ClipContine value
; 672  :         TLV_idx++;          // Increment the new FVF buf index
; 673  :       }
; 674  :       else
; 675  :       {
; 676  : 
; 677  :         TRI_CLIP_RESTORE;
; 678  :         // No clipping in the previous pass of
; 679  :         // the master loop, just get the next 
; 680  :         // vertices and continue.
; 681  :         TRI_NEXT_WITH_CLIP;
; 682  : 
; 683  :         // !!! QUICK TRIVIAL REJECT TEST !!!
; 684  :         // Clipping test for this triangle
; 685  :         if ((c0 & c1 & c2))
; 686  :         {
; 687  :           // This triangle is totaly clipped
; 688  :           // skip it and go on to teh next one
; 689  :           // in the command stream
; 690  : 
; 691  : #ifdef C_AUTOSTRIP
; 692  :           // Reset the Auto Strip/Fan Logic
; 693  :           DoInitialTriangle |= NO_CONTINUE;
; 694  :           PrevA = PrevB = PrevC = 0;
; 695  : #endif
; 696  :           continue;
; 697  :         }
; 698  : 
; 699  :         // This Triangle is not TR clipped 
; 700  :         // Get the OR flags and clip mask to see if we can trivial 
; 701  :         // accept it
; 702  :         dwUnion = (c0 | c1 | c2);
; 703  :         dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 704  :             TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 705  : 
; 706  :         if (pRc->tl.dwTLState & TLPV_GUARDBAND)
; 707  :         {
; 708  :           dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 709  :               TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 710  :         }
; 711  : 
; 712  :         // If all the vertices are in, 
; 713  :         // No clipping is neeed! 
; 714  :         // Let it pass down to the FIFO stuffing
; 715  :         if ((dwUnion & dwMask) != 0)
; 716  :         {
; 717  : 
; 718  :           if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 719  :           {
; 720  :             ClipContinue = dwNumClippedVertices - 3; 
; 721  : 
; 722  :             TRI_CLIP_SAVE;
; 723  :             pA = (LPDWORD) (pTLV); 
; 724  :             pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 725  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 726  :             TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 727  : 
; 728  :             // Let the master loop know that we ne need to process more 
