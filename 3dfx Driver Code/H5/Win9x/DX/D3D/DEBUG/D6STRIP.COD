; 730  :             count += ClipContinue;
; 731  :           }
; 732  :           else
; 733  :           {
; 734  : 
; 735  :             // Clip routine said that there was nothing to
; 736  :             // clip, skip it and go on to teh next one
; 737  :             // in the command stream
; 738  : #ifdef C_AUTOSTRIP
; 739  :             // Reset the Auto Strip/Fan Logic
