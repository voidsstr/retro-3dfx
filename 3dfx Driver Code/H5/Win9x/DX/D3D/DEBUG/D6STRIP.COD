; 438  :           // Check to see if we had started a multi triangle clip
; 439  :           // in the last loop.
; 440  :           if(ClipContinue)
; 441  :           {
; 442  :             // Yes, we have a cliped triangle in progress
; 443  :             // Don't bother pulling out new vertex data 
; 444  :             // from the command stream. Just re-arrange the
; 445  :             // vertex pointers from the new output clip
; 446  :             // FVF buffer for the next blade of the fan to clip
; 447  : 
; 448  :             // pA is the center of the Fan, it does NOT change
; 449  :             pB = pC;    // pB is assigned to the Previous blade's pC vertex
; 450  :             pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*TLV_idx); // pC is the next vertex in the clipped FVF buf
; 451  :     
; 452  :             ClipContinue--;     // Decrement the ClipContine value
; 453  :             TLV_idx++;          // Increment the new FVF buf index
; 454  :           }
; 455  :           else
; 456  :           {
; 457  :             TRI_CLIP_RESTORE;
; 458  :             // No clipping in the previous pass of
; 459  :             // the master loop, just get the next 
; 460  :             // vertices and continue.
; 461  :             TRI_NEXT_WITH_CLIP;
; 462  : 
; 463  :             // !!! QUICK TRIVIAL REJECT TEST !!!
; 464  :             // Clipping test for this triangle
; 465  :             if ((c0 & c1 & c2))
; 466  :             {
; 467  :               // This triangle is totaly clipped
; 468  :               // skip it and go on to teh next one
; 469  :               // in the command stream
; 470  :               continue;
; 471  :             }
; 472  : 
; 473  :             // This Triangle is not TR clipped 
; 474  :             // Get the OR flags and clip mask to see if we can trivial 
; 475  :             // accept it
; 476  :             dwUnion = (c0 | c1 | c2);
; 477  :             dwMask = TLCLIP_LEFT  | TLCLIP_RIGHT | TLCLIP_TOP | TLCLIP_BOTTOM  |         
; 478  :                 TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 479  :     
; 480  :             if (pRc->tl.dwTLState & TLPV_GUARDBAND)
; 481  :             {
; 482  :               dwMask = TLCLIPGB_LEFT | TLCLIPGB_RIGHT | TLCLIPGB_TOP | TLCLIPGB_BOTTOM |      
; 483  :                   TLCLIP_FRONT | TLCLIP_BACK | TLCLIP_USERPLANES_ALL; 
; 484  :             }
; 485  : 
; 486  :             // If all the vertices are in, 
; 487  :             // No clipping is neeed! 
; 488  :             // Let it pass down to the FIFO stuffing
; 489  :             if ((dwUnion & dwMask) != 0)
; 490  :             {
; 491  : 
; 492  :               if((dwNumClippedVertices = ClipFVFTriangle( pRc, pA, pB, pC, c0, c1, c2, dwMask)))
; 493  :               {
; 494  :                 ClipContinue = dwNumClippedVertices - 3; 
; 495  : 
; 496  :                 TRI_CLIP_SAVE;
; 497  :                 pA = (LPDWORD) (pTLV); 
; 498  :                 pB = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride); 
; 499  :                 pC = (LPDWORD) (pTLV + pRc->tl.TLFVF.dwStride*2); 
; 500  :                 TLV_idx = 3;  // Next vertex for the fan is at postion 3
; 501  : 
; 502  :                 // Let the master loop know that we ne need to process more 
; 503  :                 // triangles if the clippeing calls for it.
; 504  :                 count += ClipContinue;
; 505  :               }
; 506  :               else
; 507  :               {
; 508  : 
; 509  :                 // Clip routine said that there was nothing to
; 510  :                 // clip, skip it and go on to teh next one
; 511  :                 // in the command stream
; 512  :                 continue;
; 513  :               }
; 514  : 
; 515  :             } // if clipping on this triangle
; 516  : 
; 517  :           } // not a clip continuation
; 518  :     
