_DATA	SEGMENT
$SG37375 DB	'Warning: This state is unsupported. Check capability fla'
	DB	'gs', 00H
_DATA	ENDS
_TEXT	SEGMENT
_dummy@8 PROC NEAR

; 801  : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp

; 802  :   D3DPRINT( 255, "Warning: This state is unsupported. Check capability flags" );

  00003	68 00 00 00 00	 push	 OFFSET FLAT:$SG37375
  00008	68 ff 00 00 00	 push	 255			; 000000ffH
  0000d	e8 00 00 00 00	 call	 _D3DPRINT
  00012	83 c4 08	 add	 esp, 8

; 803  :   RENDERFXN_OK;

  00015	33 c0		 xor	 eax, eax

; 804  : }

  00017	5d		 pop	 ebp
  00018	c2 08 00	 ret	 8
_dummy@8 ENDP
_TEXT	ENDS
_DATA	SEGMENT
	ORG $+1
$SG37383 DB	'Antialiasing Renderstate %d', 00H
_DATA	ENDS
_TEXT	SEGMENT
_pRc$ = 8
_state$ = 12
_ppdev$ = -4
_antialiasing@8 PROC NEAR

; 814  : {

  0001b	55		 push	 ebp
  0001c	8b ec		 mov	 ebp, esp
  0001e	51		 push	 ecx

; 815  :   SETUP_PPDEV(pRc)

  0001f	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  00022	8b 48 08	 mov	 ecx, DWORD PTR [eax+8]
  00025	89 4d fc	 mov	 DWORD PTR _ppdev$[ebp], ecx

; 816  : 
; 817  :   D3DPRINT( RSTATE_DBG_LVL, "Antialiasing Renderstate %d", state );

  00028	8b 55 0c	 mov	 edx, DWORD PTR _state$[ebp]
  0002b	52		 push	 edx
  0002c	68 00 00 00 00	 push	 OFFSET FLAT:$SG37383
  00031	6a 18		 push	 24			; 00000018H
  00033	e8 00 00 00 00	 call	 _D3DPRINT
  00038	83 c4 0c	 add	 esp, 12			; 0000000cH

; 818  : 
; 819  :   CHECK_STATE_LIMITS(state, D3DANTIALIAS_NONE, D3DANTIALIAS_SORTINDEPENDENT);
; 820  : 
; 821  :   // If we are allowing antialiasing, then set to passed state.
; 822  :   // Otherwise, force it to be off.
; 823  :   if ( _D3( enableAntialias ) )

  0003b	8b 45 fc	 mov	 eax, DWORD PTR _ppdev$[ebp]
  0003e	8b 88 1c 18 00
	00		 mov	 ecx, DWORD PTR [eax+6172]
  00044	83 b9 d0 00 00
	00 00		 cmp	 DWORD PTR [ecx+208], 0
  0004b	74 0b		 je	 SHORT $L37387

; 825  :     pRc->antialias = state;

  0004d	8b 55 08	 mov	 edx, DWORD PTR _pRc$[ebp]
  00050	8b 45 0c	 mov	 eax, DWORD PTR _state$[ebp]
  00053	89 42 10	 mov	 DWORD PTR [edx+16], eax

; 827  :   else

  00056	eb 0a		 jmp	 SHORT $L37388
