PUBLIC	_SetRenderTarget
EXTRN	_D3DPRINT:NEAR
_DATA	SEGMENT
$SG36164 DB	'SetRenderTarget: New Z buffer %08x', 00H
	ORG $+1
$SG36167 DB	'SetRenderTarget: Z is NULL', 00H
	ORG $+1
$SG36169 DB	'SetRenderTarget: Primary in system memory. Can''t do.', 00H
	ORG $+3
$SG36176 DB	'SetRenderTarget: Z in system memory. Can''t do.', 00H
	ORG $+1
$SG36182 DB	'SetRenderTarget, dwhContext=%08lXh DDSHndl =%08lXh, DDSZ'
	DB	'Hndl =%08lXh', 00H
_DATA	ENDS
_TEXT	SEGMENT
_pRc$ = 8
_hRenderTarg$ = 12
_hZBuffer$ = 16
_pDDS$ = -12
_pDDSZ$ = -8
_ppdev$ = -4
_SetRenderTarget PROC NEAR

; 73   : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp
  00003	83 ec 0c	 sub	 esp, 12			; 0000000cH

; 74   :   TXTRHNDL *pDDS;
; 75   :   TXTRHNDL * pDDSZ;
; 76   : 
; 77   :   SETUP_PPDEV(pRc)

  00006	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  00009	8b 48 08	 mov	 ecx, DWORD PTR [eax+8]
  0000c	89 4d fc	 mov	 DWORD PTR _ppdev$[ebp], ecx

; 78   : 
; 79   :   // lookup local surfaces based on handles
; 80   :   pDDS  = TXTRHNDL_PTR(hRenderTarg);

  0000f	8b 55 08	 mov	 edx, DWORD PTR _pRc$[ebp]
  00012	8b 82 38 05 00
	00		 mov	 eax, DWORD PTR [edx+1336]
  00018	8b 48 08	 mov	 ecx, DWORD PTR [eax+8]
  0001b	8b 55 0c	 mov	 edx, DWORD PTR _hRenderTarg$[ebp]
  0001e	8b 04 91	 mov	 eax, DWORD PTR [ecx+edx*4]
  00021	89 45 f4	 mov	 DWORD PTR _pDDS$[ebp], eax

; 81   : 
; 82   :   if (hZBuffer)

  00024	83 7d 10 00	 cmp	 DWORD PTR _hZBuffer$[ebp], 0
  00028	74 2a		 je	 SHORT $L36163

; 84   :     pDDSZ = TXTRHNDL_PTR(hZBuffer);

  0002a	8b 4d 08	 mov	 ecx, DWORD PTR _pRc$[ebp]
  0002d	8b 91 38 05 00
	00		 mov	 edx, DWORD PTR [ecx+1336]
  00033	8b 42 08	 mov	 eax, DWORD PTR [edx+8]
  00036	8b 4d 10	 mov	 ecx, DWORD PTR _hZBuffer$[ebp]
  00039	8b 14 88	 mov	 edx, DWORD PTR [eax+ecx*4]
  0003c	89 55 f8	 mov	 DWORD PTR _pDDSZ$[ebp], edx

; 85   :     D3DPRINT(NORMAL_DBG_LEVEL, "SetRenderTarget: New Z buffer %08x", pDDSZ);

  0003f	8b 45 f8	 mov	 eax, DWORD PTR _pDDSZ$[ebp]
  00042	50		 push	 eax
  00043	68 00 00 00 00	 push	 OFFSET FLAT:$SG36164
  00048	6a 02		 push	 2
  0004a	e8 00 00 00 00	 call	 _D3DPRINT
  0004f	83 c4 0c	 add	 esp, 12			; 0000000cH

; 87   :   else

  00052	eb 16		 jmp	 SHORT $L36165
$L36163:

; 89   :     pDDSZ = NULL;

  00054	c7 45 f8 00 00
	00 00		 mov	 DWORD PTR _pDDSZ$[ebp], 0

; 90   :     D3DPRINT(NORMAL_DBG_LEVEL, "SetRenderTarget: Z is NULL");

  0005b	68 00 00 00 00	 push	 OFFSET FLAT:$SG36167
  00060	6a 02		 push	 2
  00062	e8 00 00 00 00	 call	 _D3DPRINT
  00067	83 c4 08	 add	 esp, 8
$L36165:

; 92   : 
; 93   :   // cannot render into system memory
; 94   :   if (DDSCAPS_SYSTEMMEMORY & pDDS->dwCaps)

  0006a	8b 4d f4	 mov	 ecx, DWORD PTR _pDDS$[ebp]
  0006d	8b 51 14	 mov	 edx, DWORD PTR [ecx+20]
  00070	81 e2 00 08 00
	00		 and	 edx, 2048		; 00000800H
  00076	85 d2		 test	 edx, edx
  00078	74 19		 je	 SHORT $L36168

; 96   :     D3DPRINT(0, "SetRenderTarget: Primary in system memory. Can't do.");

  0007a	68 00 00 00 00	 push	 OFFSET FLAT:$SG36169
  0007f	6a 00		 push	 0
  00081	e8 00 00 00 00	 call	 _D3DPRINT
  00086	83 c4 08	 add	 esp, 8

; 97   :     return DDERR_CURRENTLYNOTAVAIL;

  00089	b8 28 00 76 88	 mov	 eax, -2005532632	; 88760028H
  0008e	e9 a6 00 00 00	 jmp	 $L36158
$L36168:

; 99   : 
; 100  :   if (pDDSZ)

  00093	83 7d f8 00	 cmp	 DWORD PTR _pDDSZ$[ebp], 0
  00097	74 34		 je	 SHORT $L36174

; 102  :     // cannot render if z buffer is in system memory
; 103  :     if (DDSCAPS_SYSTEMMEMORY & pDDSZ->dwCaps)

  00099	8b 45 f8	 mov	 eax, DWORD PTR _pDDSZ$[ebp]
  0009c	8b 48 14	 mov	 ecx, DWORD PTR [eax+20]
  0009f	81 e1 00 08 00
	00		 and	 ecx, 2048		; 00000800H
  000a5	85 c9		 test	 ecx, ecx
  000a7	74 16		 je	 SHORT $L36175

; 105  :       D3DPRINT(0, "SetRenderTarget: Z in system memory. Can't do.");

  000a9	68 00 00 00 00	 push	 OFFSET FLAT:$SG36176
  000ae	6a 00		 push	 0
  000b0	e8 00 00 00 00	 call	 _D3DPRINT
  000b5	83 c4 08	 add	 esp, 8

; 106  :       return DDERR_CURRENTLYNOTAVAIL;

  000b8	b8 28 00 76 88	 mov	 eax, -2005532632	; 88760028H
  000bd	eb 7a		 jmp	 SHORT $L36158
$L36175:

; 108  : 
; 109  :     pRc->DDSZHndl = hZBuffer;

  000bf	8b 55 08	 mov	 edx, DWORD PTR _pRc$[ebp]
  000c2	8b 45 10	 mov	 eax, DWORD PTR _hZBuffer$[ebp]
  000c5	89 82 34 05 00
	00		 mov	 DWORD PTR [edx+1332], eax

; 120  :   else

  000cb	eb 0d		 jmp	 SHORT $L36181
$L36174:

; 122  :     pRc->DDSZHndl = 0;

  000cd	8b 4d 08	 mov	 ecx, DWORD PTR _pRc$[ebp]
  000d0	c7 81 34 05 00
	00 00 00 00 00	 mov	 DWORD PTR [ecx+1332], 0
$L36181:

; 124  : 
; 125  :   pRc->DDSHndl = hRenderTarg;

  000da	8b 55 08	 mov	 edx, DWORD PTR _pRc$[ebp]
  000dd	8b 45 0c	 mov	 eax, DWORD PTR _hRenderTarg$[ebp]
  000e0	89 82 30 05 00
	00		 mov	 DWORD PTR [edx+1328], eax

; 126  : 
; 127  : #ifdef WINNT
; 128  :   // to fix potential access violation issues with NT Stress
; 129  :   // verify we have a TXTRHNDL for this texture before dereferencing it
; 130  :   //
; 131  :   // no additional check for NULL TXTRHNDL needed here since this function
; 132  :   // won't be called if the TXTRHNDL for DDSHndl is NULL
; 133  : #endif
; 134  :   ASSERTDD((DWORD)pRc->DDSHndl == TXTRHNDL_PTR(pRc->DDSHndl)->txtrID, " render targ surfLcl's don't match!");
; 135  : 
; 136  :   D3DPRINT(NORMAL_DBG_LEVEL, "SetRenderTarget, dwhContext=%08lXh DDSHndl =%08lXh, DDSZHndl =%08lXh",
; 137  :            pRc,pRc->DDSHndl,pRc->DDSZHndl);

  000e6	8b 4d 08	 mov	 ecx, DWORD PTR _pRc$[ebp]
  000e9	8b 91 34 05 00
	00		 mov	 edx, DWORD PTR [ecx+1332]
  000ef	52		 push	 edx
  000f0	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  000f3	8b 88 30 05 00
	00		 mov	 ecx, DWORD PTR [eax+1328]
  000f9	51		 push	 ecx
  000fa	8b 55 08	 mov	 edx, DWORD PTR _pRc$[ebp]
  000fd	52		 push	 edx
  000fe	68 00 00 00 00	 push	 OFFSET FLAT:$SG36182
  00103	6a 02		 push	 2
  00105	e8 00 00 00 00	 call	 _D3DPRINT
  0010a	83 c4 14	 add	 esp, 20			; 00000014H

; 138  : 
; 139  :   _D3(lastContext) = 0;

  0010d	8b 45 fc	 mov	 eax, DWORD PTR _ppdev$[ebp]
  00110	8b 88 1c 18 00
	00		 mov	 ecx, DWORD PTR [eax+6172]
  00116	c7 81 dc 00 00
	00 00 00 00 00	 mov	 DWORD PTR [ecx+220], 0

; 140  :   UPDATE_HW_STATE(SC_SOMETHING|SC_BUFFERS);

  00120	8b 55 08	 mov	 edx, DWORD PTR _pRc$[ebp]
  00123	8b 82 d4 00 00
	00		 mov	 eax, DWORD PTR [edx+212]
  00129	0d 81 00 00 00	 or	 eax, 129		; 00000081H
