_fpFillTriangleLine@16 PROC NEAR

; 113  : {

  0014d	55		 push	 ebp
  0014e	8b ec		 mov	 ebp, esp
  00150	83 ec 10	 sub	 esp, 16			; 00000010H

; 114  :   D3DTLVERTEX   *pA, *pB, *pC;
; 115  :   int           sign;
; 116  : 
; 117  :   //---------------
; 118  :   //
; 119  :   // every triangle
; 120  :   //
; 121  :   //---------------
; 122  :   for (; count > 0; --count)

  00153	eb 0c		 jmp	 SHORT $L36045
$L36046:
  00155	66 8b 45 0c	 mov	 ax, WORD PTR _count$[ebp]
  00159	66 2d 01 00	 sub	 ax, 1
  0015d	66 89 45 0c	 mov	 WORD PTR _count$[ebp], ax
$L36045:
  00161	8b 4d 0c	 mov	 ecx, DWORD PTR _count$[ebp]
  00164	81 e1 ff ff 00
	00		 and	 ecx, 65535		; 0000ffffH
  0016a	85 c9		 test	 ecx, ecx
  0016c	0f 8e 21 01 00
	00		 jle	 $L36047

; 124  :     pA    = &vertices[tri->v1];

  00172	8b 55 10	 mov	 edx, DWORD PTR _tri$[ebp]
  00175	33 c0		 xor	 eax, eax
  00177	66 8b 02	 mov	 ax, WORD PTR [edx]
  0017a	c1 e0 05	 shl	 eax, 5
  0017d	8b 4d 14	 mov	 ecx, DWORD PTR _vertices$[ebp]
  00180	03 c8		 add	 ecx, eax
  00182	89 4d fc	 mov	 DWORD PTR _pA$[ebp], ecx

; 125  :     pB    = &vertices[tri->v2];

  00185	8b 55 10	 mov	 edx, DWORD PTR _tri$[ebp]
  00188	33 c0		 xor	 eax, eax
  0018a	66 8b 42 02	 mov	 ax, WORD PTR [edx+2]
  0018e	c1 e0 05	 shl	 eax, 5
  00191	8b 4d 14	 mov	 ecx, DWORD PTR _vertices$[ebp]
  00194	03 c8		 add	 ecx, eax
  00196	89 4d f8	 mov	 DWORD PTR _pB$[ebp], ecx

; 126  :     pC    = &vertices[tri->v3];

  00199	8b 55 10	 mov	 edx, DWORD PTR _tri$[ebp]
  0019c	33 c0		 xor	 eax, eax
  0019e	66 8b 42 04	 mov	 ax, WORD PTR [edx+4]
  001a2	c1 e0 05	 shl	 eax, 5
  001a5	8b 4d 14	 mov	 ecx, DWORD PTR _vertices$[ebp]
  001a8	03 c8		 add	 ecx, eax
  001aa	89 4d f4	 mov	 DWORD PTR _pC$[ebp], ecx

; 127  : 
; 128  :     ((float*)&sign)[0] = ((pA->sx - pB->sx) * (pB->sy - pC->sy)) -
; 129  :                          ((pB->sx - pC->sx) * (pA->sy - pB->sy));

  001ad	8b 55 fc	 mov	 edx, DWORD PTR _pA$[ebp]
  001b0	8b 45 f8	 mov	 eax, DWORD PTR _pB$[ebp]
  001b3	d9 02		 fld	 DWORD PTR [edx]
  001b5	d8 20		 fsub	 DWORD PTR [eax]
