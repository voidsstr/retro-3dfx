PUBLIC	_fpFillTrianglePt@16
EXTRN	__fltused:NEAR
EXTRN	_fpDrawPoint@28:NEAR
_TEXT	SEGMENT
_pRc$ = 8
_count$ = 12
_tri$ = 16
_vertices$ = 20
_pA$ = -4
_pB$ = -8
_pC$ = -12
_sign$ = -16
_fpFillTrianglePt@16 PROC NEAR

; 72   : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp
  00003	83 ec 10	 sub	 esp, 16			; 00000010H

; 73   :   D3DTLVERTEX   *pA, *pB, *pC;
; 74   :   int           sign;
; 75   : 
; 76   :   //---------------
; 77   :   //
; 78   :   // every triangle
; 79   :   //
; 80   :   //---------------
; 81   :   for (; count > 0; --count)

  00006	eb 0c		 jmp	 SHORT $L36027
$L36028:
  00008	66 8b 45 0c	 mov	 ax, WORD PTR _count$[ebp]
  0000c	66 2d 01 00	 sub	 ax, 1
  00010	66 89 45 0c	 mov	 WORD PTR _count$[ebp], ax
$L36027:
  00014	8b 4d 0c	 mov	 ecx, DWORD PTR _count$[ebp]
  00017	81 e1 ff ff 00
	00		 and	 ecx, 65535		; 0000ffffH
  0001d	85 c9		 test	 ecx, ecx
  0001f	0f 8e 22 01 00
	00		 jle	 $L36029

; 83   :     pA    = &vertices[tri->v1];

  00025	8b 55 10	 mov	 edx, DWORD PTR _tri$[ebp]
  00028	33 c0		 xor	 eax, eax
  0002a	66 8b 02	 mov	 ax, WORD PTR [edx]
  0002d	c1 e0 05	 shl	 eax, 5
  00030	8b 4d 14	 mov	 ecx, DWORD PTR _vertices$[ebp]
  00033	03 c8		 add	 ecx, eax
  00035	89 4d fc	 mov	 DWORD PTR _pA$[ebp], ecx

; 84   :     pB    = &vertices[tri->v2];

  00038	8b 55 10	 mov	 edx, DWORD PTR _tri$[ebp]
  0003b	33 c0		 xor	 eax, eax
  0003d	66 8b 42 02	 mov	 ax, WORD PTR [edx+2]
  00041	c1 e0 05	 shl	 eax, 5
  00044	8b 4d 14	 mov	 ecx, DWORD PTR _vertices$[ebp]
  00047	03 c8		 add	 ecx, eax
  00049	89 4d f8	 mov	 DWORD PTR _pB$[ebp], ecx

; 85   :     pC    = &vertices[tri->v3];

  0004c	8b 55 10	 mov	 edx, DWORD PTR _tri$[ebp]
  0004f	33 c0		 xor	 eax, eax
  00051	66 8b 42 04	 mov	 ax, WORD PTR [edx+4]
  00055	c1 e0 05	 shl	 eax, 5
  00058	8b 4d 14	 mov	 ecx, DWORD PTR _vertices$[ebp]
  0005b	03 c8		 add	 ecx, eax
  0005d	89 4d f4	 mov	 DWORD PTR _pC$[ebp], ecx

; 86   : 
; 87   :     // draw each vertex
; 88   :     ((float*)&sign)[0] = ((pA->sx - pB->sx) * (pB->sy - pC->sy)) -
; 89   :                          ((pB->sx - pC->sx) * (pA->sy - pB->sy));

  00060	8b 55 fc	 mov	 edx, DWORD PTR _pA$[ebp]
  00063	8b 45 f8	 mov	 eax, DWORD PTR _pB$[ebp]
  00066	d9 02		 fld	 DWORD PTR [edx]
  00068	d8 20		 fsub	 DWORD PTR [eax]
  0006a	8b 4d f8	 mov	 ecx, DWORD PTR _pB$[ebp]
  0006d	8b 55 f4	 mov	 edx, DWORD PTR _pC$[ebp]
  00070	d9 41 04	 fld	 DWORD PTR [ecx+4]
  00073	d8 62 04	 fsub	 DWORD PTR [edx+4]
  00076	de c9		 fmulp	 ST(1), ST(0)
  00078	8b 45 f8	 mov	 eax, DWORD PTR _pB$[ebp]
  0007b	8b 4d f4	 mov	 ecx, DWORD PTR _pC$[ebp]
  0007e	d9 00		 fld	 DWORD PTR [eax]
  00080	d8 21		 fsub	 DWORD PTR [ecx]
  00082	8b 55 fc	 mov	 edx, DWORD PTR _pA$[ebp]
  00085	8b 45 f8	 mov	 eax, DWORD PTR _pB$[ebp]
  00088	d9 42 04	 fld	 DWORD PTR [edx+4]
  0008b	d8 60 04	 fsub	 DWORD PTR [eax+4]
  0008e	de c9		 fmulp	 ST(1), ST(0)
  00090	de e9		 fsubp	 ST(1), ST(0)
  00092	d9 5d f0	 fstp	 DWORD PTR _sign$[ebp]

; 90   : 
; 91   :     sign &= 0x80000000;

  00095	8b 4d f0	 mov	 ecx, DWORD PTR _sign$[ebp]
  00098	81 e1 00 00 00
	80		 and	 ecx, -2147483648	; 80000000H
  0009e	89 4d f0	 mov	 DWORD PTR _sign$[ebp], ecx

; 92   : 
; 93   :     if ((sign ^ pRc->cullMask) != 0x80000000)

  000a1	8b 55 08	 mov	 edx, DWORD PTR _pRc$[ebp]
  000a4	8b 45 f0	 mov	 eax, DWORD PTR _sign$[ebp]
  000a7	33 82 88 00 00
	00		 xor	 eax, DWORD PTR [edx+136]
  000ad	3d 00 00 00 80	 cmp	 eax, -2147483648	; 80000000H
  000b2	0f 84 81 00 00
	00		 je	 $L36031

; 95   :       fpDrawPoint(pA->sx, pA->sy, pA, pRc, pA->color);

  000b8	8b 4d fc	 mov	 ecx, DWORD PTR _pA$[ebp]
  000bb	8b 51 10	 mov	 edx, DWORD PTR [ecx+16]
  000be	52		 push	 edx
  000bf	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  000c2	50		 push	 eax
  000c3	8b 4d fc	 mov	 ecx, DWORD PTR _pA$[ebp]
  000c6	51		 push	 ecx
  000c7	8b 55 fc	 mov	 edx, DWORD PTR _pA$[ebp]
  000ca	d9 42 04	 fld	 DWORD PTR [edx+4]
  000cd	83 ec 08	 sub	 esp, 8
  000d0	dd 1c 24	 fstp	 QWORD PTR [esp]
  000d3	8b 45 fc	 mov	 eax, DWORD PTR _pA$[ebp]
  000d6	d9 00		 fld	 DWORD PTR [eax]
  000d8	83 ec 08	 sub	 esp, 8
  000db	dd 1c 24	 fstp	 QWORD PTR [esp]
  000de	e8 00 00 00 00	 call	 _fpDrawPoint@28

; 96   :       fpDrawPoint(pB->sx, pB->sy, pB, pRc, pA->color);

  000e3	8b 4d fc	 mov	 ecx, DWORD PTR _pA$[ebp]
  000e6	8b 51 10	 mov	 edx, DWORD PTR [ecx+16]
  000e9	52		 push	 edx
  000ea	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  000ed	50		 push	 eax
  000ee	8b 4d f8	 mov	 ecx, DWORD PTR _pB$[ebp]
  000f1	51		 push	 ecx
  000f2	8b 55 f8	 mov	 edx, DWORD PTR _pB$[ebp]
  000f5	d9 42 04	 fld	 DWORD PTR [edx+4]
  000f8	83 ec 08	 sub	 esp, 8
  000fb	dd 1c 24	 fstp	 QWORD PTR [esp]
  000fe	8b 45 f8	 mov	 eax, DWORD PTR _pB$[ebp]
  00101	d9 00		 fld	 DWORD PTR [eax]
  00103	83 ec 08	 sub	 esp, 8
  00106	dd 1c 24	 fstp	 QWORD PTR [esp]
  00109	e8 00 00 00 00	 call	 _fpDrawPoint@28

; 97   :       fpDrawPoint(pC->sx, pC->sy, pC, pRc, pA->color);

  0010e	8b 4d fc	 mov	 ecx, DWORD PTR _pA$[ebp]
  00111	8b 51 10	 mov	 edx, DWORD PTR [ecx+16]
  00114	52		 push	 edx
  00115	8b 45 08	 mov	 eax, DWORD PTR _pRc$[ebp]
  00118	50		 push	 eax
  00119	8b 4d f4	 mov	 ecx, DWORD PTR _pC$[ebp]
  0011c	51		 push	 ecx
  0011d	8b 55 f4	 mov	 edx, DWORD PTR _pC$[ebp]
  00120	d9 42 04	 fld	 DWORD PTR [edx+4]
  00123	83 ec 08	 sub	 esp, 8
  00126	dd 1c 24	 fstp	 QWORD PTR [esp]
  00129	8b 45 f4	 mov	 eax, DWORD PTR _pC$[ebp]
  0012c	d9 00		 fld	 DWORD PTR [eax]
  0012e	83 ec 08	 sub	 esp, 8
  00131	dd 1c 24	 fstp	 QWORD PTR [esp]
  00134	e8 00 00 00 00	 call	 _fpDrawPoint@28
$L36031:

; 99   : 
; 100  :     ++tri;

  00139	8b 4d 10	 mov	 ecx, DWORD PTR _tri$[ebp]
  0013c	83 c1 08	 add	 ecx, 8
  0013f	89 4d 10	 mov	 DWORD PTR _tri$[ebp], ecx

; 101  : 
; 102  :   } // every triangle

  00142	e9 c1 fe ff ff	 jmp	 $L36028
$L36029:

; 103  : } // floating point triangle

  00147	8b e5		 mov	 esp, ebp
  00149	5d		 pop	 ebp
  0014a	c2 10 00	 ret	 16			; 00000010H
_fpFillTrianglePt@16 ENDP
_TEXT	ENDS
PUBLIC	_fpFillTriangleLine@16
EXTRN	_fpDrawLine@16:NEAR
_TEXT	SEGMENT
_pRc$ = 8
_count$ = 12
_tri$ = 16
_vertices$ = 20
_pA$ = -4
_pB$ = -8
_pC$ = -12
