	DB	'= %08lXh', 00H
	ORG $+3
$SG36192 DB	'ddiCreateSurfaceEx got 0 dwSurfaceHandle, dwCaps=%08lXh', 00H
$SG36197 DB	'  unable to allocate a HndlList for pDDLcl=%8lXh', 00H
	ORG $+3
$SG36198 DB	'  pHndlList = %8lXh', 00H
$SG36201 DB	'  unable to allocate a TXTRHNDL for handle %ld, pDDLcl ='
	DB	' %8lXh', 00H
	ORG $+1
$SG36209 DB	'  updating palette handle for TxtrHndl[%ld] from %ld to '
	DB	'%ld', 00H
$SG36218 DB	'  setting TxtrHndl[%ld] contextId to %8lXh', 00H
	ORG $+1
