PUBLIC	_calcSubPixelAdj
PUBLIC	__real@4@00000000000000000000
PUBLIC	__real@4@40008000000000000000
EXTRN	__fltused:NEAR
;	COMDAT __real@4@00000000000000000000
; File ..\d6line.c
CONST	SEGMENT
__real@4@00000000000000000000 DD 000000000r	; 0
CONST	ENDS
;	COMDAT __real@4@40008000000000000000
CONST	SEGMENT
__real@4@40008000000000000000 DD 040000000r	; 2
CONST	ENDS
_TEXT	SEGMENT
_ax$ = 8
_ay$ = 12
_bx$ = 16
_by$ = 20
_xAdj1$ = 24
_yAdj1$ = 28
_xAdj2$ = 32
_yAdj2$ = 36
_quad$ = -4
_xAdj$ = -12
_yAdj$ = -16
_dy$ = -32
_dx$ = -28
_xa$ = -20
_ya$ = -24
_tan$ = -8
_calcSubPixelAdj PROC NEAR

; 267  : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp
  00003	83 ec 20	 sub	 esp, 32			; 00000020H

; 268  :   DWORD quad;
; 269  :   float xAdj, yAdj;
; 270  :   float dy, dx;
; 271  :   float xa, ya;
; 272  :   float tan;
; 273  : 
; 274  : #if 0
; 275  :   // Adjust on the fly--for debugging...
; 276  :   xa = fSubPixAdj[ ndxXAdj ];  // Get X Adjust value
; 277  :   ya = fSubPixAdj[ ndxYAdj ];  // Get Y Adjust value
; 278  : #endif
; 279  : 
; 280  :   // Base values that give the closest match.
; 281  :   //
; 282  :   xa = 0.565f;  // Get X Adjust value

  00006	c7 45 ec d7 a3
	10 3f		 mov	 DWORD PTR _xa$[ebp], 1058055127 ; 3f10a3d7H

; 283  :   ya = 0.565f;  // Get X Adjust value

  0000d	c7 45 e8 d7 a3
	10 3f		 mov	 DWORD PTR _ya$[ebp], 1058055127 ; 3f10a3d7H

; 284  : 
; 285  :   dx = bx - ax;

  00014	d9 45 10	 fld	 DWORD PTR _bx$[ebp]
  00017	d8 65 08	 fsub	 DWORD PTR _ax$[ebp]
  0001a	d9 5d e4	 fstp	 DWORD PTR _dx$[ebp]

; 286  :   dy = by - ay;

  0001d	d9 45 14	 fld	 DWORD PTR _by$[ebp]
  00020	d8 65 0c	 fsub	 DWORD PTR _ay$[ebp]
  00023	d9 5d e0	 fstp	 DWORD PTR _dy$[ebp]

; 287  : 
; 288  :   // Quad 3   |  Quad 2
; 289  :   // ---------+---------
; 290  :   // Quad 4   |  Quad 1
; 291  :   //
; 292  :   if ( dx >= 0.0f )  // dx is positive

  00026	d9 45 e4	 fld	 DWORD PTR _dx$[ebp]
  00029	d8 1d 00 00 00
	00		 fcomp	 DWORD PTR __real@4@00000000000000000000
  0002f	df e0		 fnstsw	 ax
  00031	f6 c4 01	 test	 ah, 1
  00034	75 22		 jne	 SHORT $L36163

; 294  :     if ( dy >= 0.0f ) quad = 1;

  00036	d9 45 e0	 fld	 DWORD PTR _dy$[ebp]
  00039	d8 1d 00 00 00
	00		 fcomp	 DWORD PTR __real@4@00000000000000000000
  0003f	df e0		 fnstsw	 ax
  00041	f6 c4 01	 test	 ah, 1
  00044	75 09		 jne	 SHORT $L36164
  00046	c7 45 fc 01 00
	00 00		 mov	 DWORD PTR _quad$[ebp], 1

; 295  :     else              quad = 2;

  0004d	eb 07		 jmp	 SHORT $L36165
$L36164:
  0004f	c7 45 fc 02 00
	00 00		 mov	 DWORD PTR _quad$[ebp], 2
$L36165:

; 297  :   else // dx is negative

  00056	eb 20		 jmp	 SHORT $L36168
$L36163:

; 299  :     if ( dy >= 0.0f ) quad = 4;

  00058	d9 45 e0	 fld	 DWORD PTR _dy$[ebp]
  0005b	d8 1d 00 00 00
	00		 fcomp	 DWORD PTR __real@4@00000000000000000000
  00061	df e0		 fnstsw	 ax
  00063	f6 c4 01	 test	 ah, 1
  00066	75 09		 jne	 SHORT $L36167
  00068	c7 45 fc 04 00
	00 00		 mov	 DWORD PTR _quad$[ebp], 4

; 300  :     else             quad = 3;

  0006f	eb 07		 jmp	 SHORT $L36168
$L36167:
  00071	c7 45 fc 03 00
	00 00		 mov	 DWORD PTR _quad$[ebp], 3
$L36168:

; 302  : 
; 303  :   // Make absolute values..
; 304  :   if (dx < 0.f) dx = -dx;

  00078	d9 45 e4	 fld	 DWORD PTR _dx$[ebp]
  0007b	d8 1d 00 00 00
	00		 fcomp	 DWORD PTR __real@4@00000000000000000000
  00081	df e0		 fnstsw	 ax
  00083	f6 c4 01	 test	 ah, 1
  00086	74 08		 je	 SHORT $L36169
  00088	d9 45 e4	 fld	 DWORD PTR _dx$[ebp]
  0008b	d9 e0		 fchs
  0008d	d9 5d e4	 fstp	 DWORD PTR _dx$[ebp]
$L36169:

; 305  :   if (dy < 0.f) dy = -dy;

  00090	d9 45 e0	 fld	 DWORD PTR _dy$[ebp]
  00093	d8 1d 00 00 00
	00		 fcomp	 DWORD PTR __real@4@00000000000000000000
  00099	df e0		 fnstsw	 ax
  0009b	f6 c4 01	 test	 ah, 1
  0009e	74 08		 je	 SHORT $L36170
  000a0	d9 45 e0	 fld	 DWORD PTR _dy$[ebp]
  000a3	d9 e0		 fchs
  000a5	d9 5d e0	 fstp	 DWORD PTR _dy$[ebp]
$L36170:

; 306  : 
; 307  :   if ( dx == 0 )	// vertical line

  000a8	d9 45 e4	 fld	 DWORD PTR _dx$[ebp]
  000ab	d8 1d 00 00 00
	00		 fcomp	 DWORD PTR __real@4@00000000000000000000
  000b1	df e0		 fnstsw	 ax
  000b3	f6 c4 40	 test	 ah, 64			; 00000040H
  000b6	74 12		 je	 SHORT $L36171

; 309  :     xAdj = xa;

  000b8	8b 45 ec	 mov	 eax, DWORD PTR _xa$[ebp]
  000bb	89 45 f4	 mov	 DWORD PTR _xAdj$[ebp], eax

; 310  :     yAdj = 0;

  000be	c7 45 f0 00 00
	00 00		 mov	 DWORD PTR _yAdj$[ebp], 0

; 311  :     goto SignFixup;

  000c5	e9 ac 00 00 00	 jmp	 $SignFixup$36172
$L36171:

; 313  :   else if ( dy == 0 )	// horizontal line

  000ca	d9 45 e0	 fld	 DWORD PTR _dy$[ebp]
  000cd	d8 1d 00 00 00
	00		 fcomp	 DWORD PTR __real@4@00000000000000000000
  000d3	df e0		 fnstsw	 ax
  000d5	f6 c4 40	 test	 ah, 64			; 00000040H
  000d8	74 12		 je	 SHORT $L36174

; 315  :     xAdj = 0;

  000da	c7 45 f4 00 00
	00 00		 mov	 DWORD PTR _xAdj$[ebp], 0

; 316  :     yAdj = ya;

  000e1	8b 4d e8	 mov	 ecx, DWORD PTR _ya$[ebp]
  000e4	89 4d f0	 mov	 DWORD PTR _yAdj$[ebp], ecx

; 317  :     goto SignFixup;

  000e7	e9 8a 00 00 00	 jmp	 $SignFixup$36172
$L36174:

; 319  : 
; 320  :   if (dx > dy)

  000ec	d9 45 e4	 fld	 DWORD PTR _dx$[ebp]
  000ef	d8 5d e0	 fcomp	 DWORD PTR _dy$[ebp]
  000f2	df e0		 fnstsw	 ax
  000f4	f6 c4 41	 test	 ah, 65			; 00000041H
  000f7	75 2c		 jne	 SHORT $L36175

; 322  :     // X Major - This is the region of a quadarant from the 45 degree
; 323  :     //           down to the X axis, i.e. as we move away from the 45
; 324  :     //           degree angle, Y diminishes to 0.
; 325  : 
; 326  :     // Percentage of the height (Y) w.r.t the width (X)
; 327  :     //
; 328  :     tan = dy / dx; // Goes from 1.0 ---> 0.0 as Y decreases

  000f9	d9 45 e0	 fld	 DWORD PTR _dy$[ebp]
  000fc	d8 75 e4	 fdiv	 DWORD PTR _dx$[ebp]
  000ff	d9 5d f8	 fstp	 DWORD PTR _tan$[ebp]

; 329  : 
; 330  :     // At the 45 degree angle of the quadrant, i.e. tan == 1.0, and we return
; 331  :     // XAdj/2, YAdj/2.  As we move from the 45 degree angle
; 332  :     // (tan == 1.0) towards the X axis, XAdj decreases to zero and 
; 333  :     // YAdj increases to the full value, in order make a T cross bar perpendicular
; 334  :     // to the X axis.
; 335  :     xAdj = (float)(( xa * tan ) / 2.0f);

  00102	d9 45 ec	 fld	 DWORD PTR _xa$[ebp]
  00105	d8 4d f8	 fmul	 DWORD PTR _tan$[ebp]
  00108	d8 35 00 00 00
	00		 fdiv	 DWORD PTR __real@4@40008000000000000000
  0010e	d9 5d f4	 fstp	 DWORD PTR _xAdj$[ebp]

; 336  :     yAdj = (float) ( ya - ((ya  / 2.0f) * tan ));

  00111	d9 45 e8	 fld	 DWORD PTR _ya$[ebp]
  00114	d8 35 00 00 00
	00		 fdiv	 DWORD PTR __real@4@40008000000000000000
  0011a	d8 4d f8	 fmul	 DWORD PTR _tan$[ebp]
  0011d	d8 6d e8	 fsubr	 DWORD PTR _ya$[ebp]
  00120	d9 5d f0	 fstp	 DWORD PTR _yAdj$[ebp]

; 338  :   else if ( dy > dx )

  00123	eb 51		 jmp	 SHORT $SignFixup$36172
$L36175:
  00125	d9 45 e0	 fld	 DWORD PTR _dy$[ebp]
  00128	d8 5d e4	 fcomp	 DWORD PTR _dx$[ebp]
  0012b	df e0		 fnstsw	 ax
  0012d	f6 c4 41	 test	 ah, 65			; 00000041H
  00130	75 2c		 jne	 SHORT $L36179

; 340  :     // Y Major - This is the region of a quadarant from the 45 degree
; 341  :     //           over to the Y axis, i.e. as we move away from the 45
; 342  :     //           degree angle, X diminishes to 0.
; 343  : 
; 344  :     // Percentage of the width (X) w.r.t the height (Y)
; 345  :     //
; 346  :     tan = dx / dy;

  00132	d9 45 e4	 fld	 DWORD PTR _dx$[ebp]
  00135	d8 75 e0	 fdiv	 DWORD PTR _dy$[ebp]
  00138	d9 5d f8	 fstp	 DWORD PTR _tan$[ebp]

; 347  : 
; 348  :     // At the 45 degree angle of the quadrant, i.e. tan == 1.0, and we return
; 349  :     // XAdj/2, YAdj/2.  As we move from the 45 degree angle
; 350  :     // (tan == 1.0) towards the Y axis, XAdj increases to full value and
