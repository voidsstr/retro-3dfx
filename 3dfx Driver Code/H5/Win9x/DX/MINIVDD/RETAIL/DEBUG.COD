	TITLE	..\debug.c
	.386P
include listing.inc
if @Version gt 510
.model FLAT
else
_TEXT	SEGMENT PARA USE32 PUBLIC 'CODE'
_TEXT	ENDS
_DATA	SEGMENT DWORD USE32 PUBLIC 'DATA'
_DATA	ENDS
CONST	SEGMENT DWORD USE32 PUBLIC 'CONST'
CONST	ENDS
_BSS	SEGMENT DWORD USE32 PUBLIC 'BSS'
_BSS	ENDS
$$SYMBOLS	SEGMENT BYTE USE32 'DEBSYM'
$$SYMBOLS	ENDS
$$TYPES	SEGMENT BYTE USE32 'DEBTYP'
$$TYPES	ENDS
_TLS	SEGMENT DWORD USE32 PUBLIC 'TLS'
_TLS	ENDS
_DB2DATA	SEGMENT DWORD USE32 PUBLIC 'DBOCODE'
_DB2DATA	ENDS
_DB1CODE	SEGMENT PARA USE32 PUBLIC 'DBOCODE'
_DB1CODE	ENDS
_PTEXT	SEGMENT PARA USE32 PUBLIC 'PCODE'
_PTEXT	ENDS
_LTEXT	SEGMENT PARA USE32 PUBLIC 'LCODE'
_LTEXT	ENDS
_PDATA	SEGMENT DWORD USE32 PUBLIC 'PDATA'
_PDATA	ENDS
_LDATA	SEGMENT DWORD USE32 PUBLIC 'LCODE'
_LDATA	ENDS
FLAT	GROUP _DATA, CONST, _BSS, _DB2DATA, _PDATA, _LDATA
	ASSUME	CS: FLAT, DS: FLAT, SS: FLAT
endif
