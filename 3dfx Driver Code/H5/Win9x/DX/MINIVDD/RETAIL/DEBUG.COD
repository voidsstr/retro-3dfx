$SG11306 DB	0aH, 'Napalm Debug Command Summary', 0aH, 0aH, 00H
$SG11307 DB	'P[CI] <Bus#> <Dev#>              - Display PCI Info for '
	DB	'Device', 0aH, 00H
$SG11308 DB	'W[r] Bus# Dev# Func# Reg# Value  - Toggles int1 in the c'
	DB	'ode', 0aH, 00H
	ORG $+3
$SG11309 DB	'S[LI] <Bus#> <Dev#>              - Display PCI SLI Info '
	DB	'for Device', 0aH, 00H
$SG11310 DB	'E[xit]                           - Exits back to debugge'
	DB	'r', 0aH, 00H
	ORG $+1
$SG11311 DB	'H[elp] [Command]                 - Prints Help Informati'
	DB	'on', 0aH, 00H
$SG11312 DB	'Q[uit]                           - Quits back to debugge'
	DB	'r', 0aH, 00H
	ORG $+1
$SG11313 DB	'R[eg]                            - Dumps VGA registers', 0aH
	DB	00H
$SG11314 DB	'M[ode]                           - Resets the last mode', 0aH
	DB	00H
	ORG $+3
$SG11315 DB	'A[gp]                            - Dump the AGP register'
	DB	's', 0aH, 00H
	ORG $+1
$SG11316 DB	'C[lock] s v r                    - Program the ICS 307 C'
	DB	'lock', 0aH, 00H
	ORG $+2
$SG11515 DB	'Device ID/Vendor ID %08x', 0aH, 00H
	ORG $+2
$SG11516 DB	'Status/Command %08x', 0aH, 00H
	ORG $+3
$SG11517 DB	'Class_Code/Revision ID %08x', 0aH, 00H
	ORG $+3
$SG11518 DB	'BIST/Header Type/Latency Timer/Cache_line_size %08x', 0aH
	DB	00H
	ORG $+3
$SG11519 DB	'memBaseAddr0 %08x', 0aH, 00H
	ORG $+1
$SG11520 DB	'memBaseAddr1 %08x', 0aH, 00H
	ORG $+1
$SG11521 DB	'IoBaseAddr %08x', 0aH, 00H
	ORG $+3
$SG11522 DB	'SubSystemID/SubVendorID %08x', 0aH, 00H
	ORG $+2
$SG11523 DB	'RomBaseAddr %08x', 0aH, 00H
	ORG $+2
$SG11524 DB	'Cap Ptr %08x', 0aH, 00H
	ORG $+2
$SG11525 DB	'Max_lat/Min_gnt/Interrupt_Pin/Interrupt_Line %08x', 0aH, 00H
	ORG $+1
$SG11526 DB	'cfgInitEnable/FABID %08x', 0aH, 00H
	ORG $+2
$SG11527 DB	'ACPI Reset %08x', 0aH, 00H
	ORG $+3
$SG11528 DB	'cfgPciDecode %08x', 0aH, 00H
	ORG $+1
$SG11529 DB	'CfgStatus %08x', 0aH, 00H
$SG11530 DB	'CfgScratch %08x', 0aH, 00H
	ORG $+3
$SG11531 DB	'AGP CAP_ID %08x', 0aH, 00H
	ORG $+3
$SG11532 DB	'AGP status %08x', 0aH, 00H
	ORG $+3
$SG11533 DB	'AGP_Cmd %08x', 0aH, 00H
	ORG $+2
$SG11534 DB	'ACPI Cap ID %08x', 0aH, 00H
	ORG $+2
$SG11535 DB	'ACPI cntrl/status %08x', 0aH, 00H
$SG11536 DB	'cfgVideoCtrl0 %08x', 0aH, 00H
$SG11537 DB	'cfgVideoCtrl1 %08x', 0aH, 00H
$SG11538 DB	'cfgVideoCtrl2  %08x', 0aH, 00H
