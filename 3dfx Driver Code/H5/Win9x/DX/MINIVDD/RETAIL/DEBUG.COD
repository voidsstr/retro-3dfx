_Unknown_Fmt DB	0aH, 'Unknown command "%s"!', 00H
	ORG $+1
_PCI_Hlp DB	0aH, 'Pci <Bus#> <Dev#>           - Dump PCI Info', 00H
	ORG $+3
_WR_Hlp	DB	0aH, 'Wr Bus# Dev# Func# Reg# Value             - Wr PCI '
	DB	'Info', 00H
	ORG $+3
_SLI_Hlp DB	0aH, 'SLI <Bus#> <Dev#> - Dump the hidden SLI Config Regi'
	DB	'ster for the Device', 00H
_Exit_Hlp DB	0aH, 'Exit           - Exits control back to the debugger'
	DB	00H
	ORG $+3
_Help_Hlp DB	0aH, 'Help           - Prints the general help message', 0aH
	DB	'Help Command   - Prints command specific help', 00H
_Quit_Hlp DB	0aH, 'Quit           - Quits back to the debugger', 00H
	ORG $+3
_Reg_Hlp DB	0aH, 'Reg            - Dump VGA Registers', 00H
	ORG $+3
_Mode_Hlp DB	0aH, 'Mode           - Resets the last mode', 00H
	ORG $+1
_Mtrr_Hlp DB	0aH, 'Mtrr           - Print MTRRs', 00H
	ORG $+2
_Agp_Hlp DB	0aH, 'Agp            - Print AGP Registers', 00H
	ORG $+2
_Clock_Hlp DB	0aH, 'Clock s v r    - Reprogram the ICS 307', 00H
