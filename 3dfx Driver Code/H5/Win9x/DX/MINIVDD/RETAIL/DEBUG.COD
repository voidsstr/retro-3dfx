; 267  : *
; 268  : *       //TODO: Pseudocode
; 269  : *
; 270  : *******************************************************************************/
; 271  : BYTE Get_Parameter(BYTE* input, BYTE* inOffset, BYTE  paramTerm, BYTE* delimTable, BYTE  buffTerm, BYTE* output, BYTE  outBuffLen, BYTE  maxParamLen, BYTE* actualDelim)
; 272  : {
; 273  :    BYTE *pIn;
; 274  :    BYTE *pOut;
; 275  :    BYTE *pDelim;
; 276  : 
; 277  :    pIn = input + *inOffset;
; 278  :    pOut = output;
; 279  :         
; 280  :    if(outBuffLen > 1)
; 281  :       {
; 282  :       while((*pIn == ASCII_SPACE) || (*pIn == ASCII_HT))
; 283  :          pIn++;
; 284  : 
; 285  :       if(maxParamLen == 0)
; 286  :          maxParamLen = outBuffLen;
; 287  : 
; 288  :       while(*input != buffTerm)
; 289  :          {
; 290  :          pDelim = delimTable;
; 291  :          while((*pDelim != TAB_END) && (*pDelim != *pIn))
; 292  :             pDelim++;
; 293  : 
; 294  :          if(*pDelim == TAB_END)
; 295  :             {
; 296  :             if((*pIn != ASCII_SPACE) && (*pIn != ASCII_HT))
; 297  :                {
; 298  :                if(outBuffLen > 1)
; 299  :                   {
; 300  :                   *pOut++ = *pIn;
; 301  :                   outBuffLen--;
; 302  :                   if(--maxParamLen == 0)
; 303  :                      break;
; 304  :                   }
; 305  :                }
; 306  :                                 
; 307  :             pIn++;
; 308  :             }
; 309  :          else
; 310  :             break;
; 311  :          }
; 312  :                 
; 313  :          *pOut = buffTerm;
; 314  :          if(actualDelim != NULL)
; 315  :             *actualDelim = *input;
; 316  :          *inOffset = (BYTE)((DWORD)pIn - (DWORD)input);
; 317  :          return (BYTE)((DWORD)pOut - (DWORD)output);
; 318  :       }
; 319  :         
; 320  :    if(outBuffLen > 0)
; 321  :       *output = buffTerm;
; 322  :    if(actualDelim != NULL)
; 323  :       *actualDelim = buffTerm;
; 324  :    *inOffset = (BYTE)((DWORD)pIn - (DWORD)input);
; 325  :    return 0;
; 326  : }
; 327  : 
; 328  : /*******************************************************************************
; 329  : *
; 330  : *       Match
; 331  : *
; 332  : *       Input:
; 333  : *               terminator      -       Terminator byte
; 334  : *               table           -       Pointer to the match table
; 335  : *               str             -       Pointer to the string to match
; 336  : *
; 337  : *       Output:
; 338  : *               len             -       Pointer to a byte to return the
; 339  : *                                       match length used in
; 340  : *               Return          -       The match table entry on success or
; 341  : *                                       0xff on failure
; 342  : *
; 343  : *       Find the string length
; 344  : *       Get the table entry count
; 345  : *       Initialize the match entry
; 346  : *       Get a pointer to the first table entry
; 347  : *       DO
; 348  : *               Initialize this entry as matching
; 349  : *               FOREACH character in str until the string length or
; 350  : *                                              the match length is reached
; 351  : *                       IF the string character doesn't match the match character
; 352  : *                               Flag the entry as not matching
; 353  : *                               End the loop
; 354  : *                       ENDIF
; 355  : *               ENDFOREACH
; 356  : *               IF the entry matched
; 357  : *                       IF the return match length isn't null
; 358  : *                               Copy the length
; 359  : *                       ENDIF
; 360  : *                       RETURN the match entry index
; 361  : *               ENDIF
; 362  : *               Goto the next entry
; 363  : *               Get a pointer to the next entry
; 364  : *       WHILE the table entry pointer doesn't point to the end of the table
; 365  : *       RETURN failure
; 366  : *
; 367  : *******************************************************************************/
; 368  : BYTE Match(BYTE terminator, BYTE* table, BYTE* str, BYTE *len)
; 369  : {
; 370  :    BYTE* pEntry;
; 371  :    BYTE nEntry;
; 372  :    DWORD strLen;
; 373  :    DWORD i;
; 374  :    BOOL bMatch;
; 375  :    BYTE size;
; 376  : 
; 377  :    for(strLen=0; str[strLen]!=terminator; strLen++)
; 378  :       ;
; 379  : 
; 380  :    size = table[0];
; 381  :    nEntry = 0;
; 382  :    pEntry = table + 1;
; 383  :    do
; 384  :       {
