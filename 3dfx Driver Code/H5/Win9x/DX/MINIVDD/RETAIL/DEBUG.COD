; 238  : 
; 239  : /*----------------------------------------------------------------------
; 240  : Function name:  Upper_Case
; 241  : 
; 242  : Description: Convert a string to upper case
; 243  :                 
; 244  : Information:    Nothing
; 245  : 
; 246  : Return:         
; 247  : ----------------------------------------------------------------------*/
; 248  : #define TOUPPER(ch) (ch) = (((ch >= 'a') && (ch <= 'z')) ? (ch) - 'a' + 'A' : (ch))
; 249  : void Upper_Case(BYTE bLength, BYTE * pStr)
; 250  : {
; 251  :    for (;bLength != 0; bLength--)
; 252  :       {
; 253  :       TOUPPER(*pStr);
; 254  :       pStr++;
; 255  :       }
; 256  : }
; 257  : 
; 258  : /*******************************************************************************
; 259  : *
; 260  : *       Get_Parameter
; 261  : *
; 262  : *       Input:
; 263  : *               //TODO: Input arguments
; 264  : *
; 265  : *       Output:
