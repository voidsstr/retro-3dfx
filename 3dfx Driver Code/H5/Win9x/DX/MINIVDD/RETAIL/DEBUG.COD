; 412  : 
; 413  : /*******************************************************************************
; 414  : *
; 415  : *       Napalm_Debug
; 416  : *
; 417  : *       Input:
; 418  : *
; 419  : *       Output:
; 420  : *
; 421  : *       WHILE 1
; 422  : *               Print the debug prompt
; 423  : *               Call to get debug input
; 424  : *               IF the call succeedes
; 425  : *                       IF the length greater than zero
; 426  : *                               Set the offset to zero
; 427  : *                               Get the first parameter
; 428  : *                               IF the parameter length is greater than zero
; 429  : *                                       Convert the parameter to upper case
; 430  : *                                       Find a match in the Command_Table
; 431  : *                                       IF there was a match
; 432  : *                                               Jump to the appropriate command
; 433  : *                                       ELSE
; 434  : *                                               Print an error message
; 435  : *                                       ENDIF
; 436  : *                               ENDIF
; 437  : *                       ENDIF
; 438  : *               ELSE
; 439  : *                       RETURN
; 440  : *               ENDIF
; 441  : *       ENDWHILE
; 442  : *
; 443  : *******************************************************************************/
; 444  : void Napalm_Debug()
; 445  : {
; 446  :    DWORD length;
; 447  :    DWORD paramLen;
; 448  :    BYTE offset;
; 449  :    BYTE entry;
; 450  :         
; 451  :    while(1)
; 452  :       {
; 453  :       PF(Debug_Prompt);
; 454  :       if(Debug_Input(DEBUG_LENGTH, Debug_Buffer, &length))
; 455  :          {
; 456  :          if(length > 0)
; 457  :             {
; 458  :             offset = 0;
; 459  :                                 
; 460  :             paramLen = Get_Parameter(Debug_Buffer, &offset, 0, Delimiter_Table, 0, Parm_Buffer, DEBUG_LENGTH - 1, 0, NULL);
; 461  :             if(paramLen > 0)
; 462  :                {
; 463  :                Upper_Case((BYTE)paramLen, Parm_Buffer);
; 464  :                entry = Match(0, Command_Table, Parm_Buffer, NULL);
; 465  :                if(entry != 0xff)
; 466  :                   {
; 467  :                   if(Jump_Table[entry](offset))
; 468  :                      return;
; 469  :                   }
; 470  :                else
; 471  :                   {
; 472  :                   PF(Unknown_Fmt, *Unknown_Arg);
; 473  :                   }
; 474  :                }
; 475  :             }
; 476  :          }
; 477  :       else
; 478  :          return;
; 479  :       }
; 480  : }
; 481  : 
; 482  : /*******************************************************************************
; 483  : *
; 484  : *       Debug_Input
; 485  : *
; 486  : *       Input:
; 487  : *               bufflen         -       Buffer length
; 488  : *               pBuff           -       Buffer to recieve debug input
; 489  : *               pInLen          -       Pointer to dword to recieve input length
; 490  : *
; 491  : *       Output:
; 492  : *               Return          -       TRUE to indicate success
; 493  : *
; 494  : *       Set the shadow input length to zero
; 495  : *       DO
; 496  : *               Get a character
; 497  : *               SWITCH on the character
; 498  : *               null:   IF the input length pointer isn't null
; 499  : *                               Set it to the local shadow
; 500  : *                       RETURN false
; 501  : *               escape: Set the input length to zero
; 502  : *                       Set the input char to null
; 503  : *               cr:     Set the input char to null
; 504  : *               bs:     IF the input length is greater than 1
; 505  : *                               Decrement the input length
; 506  : *                               Increment the buffer size
; 507  : *                               Output the backspace char
; 508  : *                       ENDIF
; 509  : *               default:IF the buffer size is greater than one
; 510  : *                               Store the character
; 511  : *                               Increment the input length
; 512  : *                               Decrement the buffer size
; 513  : *                               Output the character
; 514  : *                       ENDIF
; 515  : *               ENDSWITCH
; 516  : *       WHILE the character isn't null
; 517  : *       Terminate the input string with a null
; 518  : *       IF the input length pointer isn't null
; 519  : *               Copy the shadow input to the pointer
; 520  : *       ENDIF
; 521  : *       RETURN true
; 522  : *
; 523  : *******************************************************************************/
; 524  : BOOL Debug_Input(DWORD buffLen, char *pBuff, DWORD *pInLen)
; 525  : {
; 526  :    DWORD inLen;
; 527  :    char c;
; 528  : 
; 529  :    inLen = 0;
; 530  : 
; 531  :    do
; 532  :       {
; 533  :       c = (BYTE)Get_Input();
; 534  :       switch(c)
; 535  :          {
; 536  :          case ASCII_NULL:
; 537  :             if(pInLen != NULL)
; 538  :                *pInLen = inLen;
; 539  :             return FALSE;
; 540  :       
; 541  :          case ASCII_ESCAPE:
; 542  :             inLen = 0;
; 543  :             c = ASCII_NULL;
; 544  :             break;
; 545  : 
; 546  :          case ASCII_CR:
; 547  :             c = ASCII_NULL;
; 548  :             break;
; 549  : 
; 550  :          case ASCII_BS:
; 551  :             if(inLen > 0)
; 552  :                {
; 553  :                inLen--;
; 554  :                buffLen++;
; 555  :                Output_Debug_Chr(c);
; 556  :                }
; 557  :             break;
; 558  : 
; 559  :          default:
; 560  :             if(buffLen > 0)
; 561  :                {
; 562  :                pBuff[inLen] = c;
; 563  :                inLen++;
; 564  :                buffLen--;
; 565  :                Output_Debug_Chr(c);
; 566  :                }
; 567  :          }
; 568  :       }
; 569  :    while(c != ASCII_NULL);
; 570  : 
; 571  :    pBuff[inLen] = ASCII_NULL;
; 572  :    if(pInLen != NULL)
; 573  :       *pInLen = inLen;
; 574  : 
; 575  :    return TRUE;
; 576  : }
; 577  : 
; 578  : /*******************************************************************************
; 579  : *
; 580  : *       Check_Abort
; 581  : *
; 582  : *       Input:
