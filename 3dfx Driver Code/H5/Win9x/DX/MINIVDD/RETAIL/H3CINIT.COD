_h3InitSgram PROC NEAR

; 458  : {

  00070	83 ec 0c	 sub	 esp, 12			; 0000000cH
  00073	53		 push	 ebx
  00074	55		 push	 ebp

; 459  :   FxU32
; 460  :       memType,                  // SGRAM or SDRAM
; 461  :       partSize,                 // size of SGRAM chips in Mbits
; 462  :       memSize,                  // total size of memory in MBytes
; 463  :       nChips,                   // # chips of SDRAM/SGRAM
; 464  :       dramInit0_strap,    
; 465  :       dramInit1_strap,    
; 466  :       dramInit0,
; 467  :       dramInit1,
; 468  :       miscInit1;
; 469  :   FxU32 vendorID;
; 470  :   FxU32 Bus_Mem_Strap;
; 471  : 
; 472  :   // determine memory type: SDRAM or SGRAM
; 473  :   memType = MEM_TYPE_SGRAM;
; 474  :   dramInit1_strap = IGET32(dramInit1);

  00075	8b 6c 24 18	 mov	 ebp, DWORD PTR _regBase$[esp+16]
  00079	56		 push	 esi
  0007a	57		 push	 edi
  0007b	33 db		 xor	 ebx, ebx
  0007d	8d 45 1c	 lea	 eax, DWORD PTR [ebp+28]
  00080	89 5c 24 10	 mov	 DWORD PTR _memType$[esp+28], ebx
  00084	50		 push	 eax
  00085	e8 00 00 00 00	 call	 _my_inpd
  0008a	83 c4 04	 add	 esp, 4

; 475  :   dramInit1_strap &= SST_MCTL_TYPE_SDRAM;
; 476  :   if ( dramInit1_strap & SST_MCTL_TYPE_SDRAM )

  0008d	a9 00 00 00 40	 test	 eax, 1073741824		; 40000000H
  00092	74 0c		 je	 SHORT $L11369

; 477  :     memType = MEM_TYPE_SDRAM;

  00094	c7 44 24 10 01
	00 00 00	 mov	 DWORD PTR _memType$[esp+28], 1
  0009c	8b 5c 24 10	 mov	 ebx, DWORD PTR _memType$[esp+28]
$L11369:

; 478  : 
; 479  :   // set memory interface delay values and enable refresh
; 480  :   // these apply to all RAM vendors
; 481  :   dramInit1 = 0x0;
; 482  : 
; 483  :   dramInit1 |= SST_DRAM_REFRESH_EN;
; 484  :   dramInit1 |= (0x18 << SST_DRAM_REFRESH_VALUE_SHIFT) & SST_DRAM_REFRESH_VALUE;  
; 485  :   dramInit1 |= SST_SGRAM_USE_INV_SAMPLE;
; 486  :   dramInit1 |= SST_SGRAM_DEL_CLK_INVERT;
; 487  :   dramInit1 |= (8<<SST_SGRAM_CLK_ADJ_SHIFT);
; 488  :   dramInit1 |= (2<<SST_SGRAM_OFLOP_DEL_ADJ_SHIFT);
; 489  : 
; 490  : #if !defined(H3VDD) && !defined(DIAG_BUILD) && !defined(MACOS_GDX)
; 491  :   if ( GETENV("SSTH3_DRAMINIT1") )
; 492  :     dramInit1 = strtoul(GETENV("SSTH3_DRAMINIT1"),NULL,0);
; 493  : 
; 494  :   dramInit1 &= ~SST_MCTL_TYPE_SDRAM;
; 495  :   dramInit1 |= dramInit1_strap;
; 496  : 
; 497  :   GDBG_INFO(80, "h3InitSgram: dramInit1 = 0x%x\n",dramInit1);
; 498  :   ISET32(dramInit1, dramInit1);
; 499  : #endif // #ifndef H3VDD
; 500  : 
; 501  :   /* Determine memory size from strapping pins (dramInit0). */
; 502  : 
; 503  :   dramInit0_strap = IGET32(dramInit0);

  000a0	8d 4d 18	 lea	 ecx, DWORD PTR [ebp+24]
  000a3	51		 push	 ecx
  000a4	e8 00 00 00 00	 call	 _my_inpd
  000a9	8b f8		 mov	 edi, eax

; 504  : 
; 505  :   if (IS_NAPALM(dwVendorDeviceID))

  000ab	8b 44 24 34	 mov	 eax, DWORD PTR _dwVendorDeviceID$[esp+28]
  000af	83 c4 04	 add	 esp, 4
  000b2	3d 1a 12 06 00	 cmp	 eax, 397850		; 0006121aH
  000b7	0f 84 97 00 00
	00		 je	 $L11375
  000bd	3d 1a 12 07 00	 cmp	 eax, 463386		; 0007121aH
  000c2	0f 84 8c 00 00
	00		 je	 $L11375
  000c8	3d 1a 12 08 00	 cmp	 eax, 528922		; 0008121aH
  000cd	0f 84 81 00 00
	00		 je	 $L11375
  000d3	3d 1a 12 09 00	 cmp	 eax, 594458		; 0009121aH
  000d8	74 7a		 je	 SHORT $L11375
  000da	3d 1a 12 0a 00	 cmp	 eax, 659994		; 000a121aH
  000df	74 73		 je	 SHORT $L11375
  000e1	3d 1a 12 0b 00	 cmp	 eax, 725530		; 000b121aH
  000e6	74 6c		 je	 SHORT $L11375
  000e8	3d 1a 12 0c 00	 cmp	 eax, 791066		; 000c121aH
  000ed	74 65		 je	 SHORT $L11375
  000ef	3d 1a 12 0d 00	 cmp	 eax, 856602		; 000d121aH
  000f4	74 5e		 je	 SHORT $L11375
  000f6	3d 1a 12 0e 00	 cmp	 eax, 922138		; 000e121aH
  000fb	74 57		 je	 SHORT $L11375
  000fd	3d 1a 12 0f 00	 cmp	 eax, 987674		; 000f121aH
  00102	74 50		 je	 SHORT $L11375

; 537  :     }
; 538  :   }
; 539  :   else
; 540  :   {
