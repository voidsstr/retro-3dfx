$SG11424 DB	'h3InitSgram: %d x %d Mbit %s %s parts = %d MBytes', 0aH, 00H
	ORG $+1
$SG11425 DB	'SDRAM', 00H
	ORG $+2
$SG11426 DB	'SGRAM', 00H
