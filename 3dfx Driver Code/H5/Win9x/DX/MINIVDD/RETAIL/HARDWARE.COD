; 433  : 
; 434  : // STB Begin Changes
; 435  : // STB-SR 1/28/99 Adding support for 2D AGP Cmd Fifo
; 436  : // Most of the code was taken from dd32/ddflip.c code
; 437  : // inside the function TOAFIFO().
; 438  : #ifdef STBPERF_2DAGPCMDFIFO
; 439  :   if (_FF(enableAGPCF))
; 440  :   {
; 441  :       FxU32  startVirtualAddr;
; 442  :       DWORD fifoLength;
; 443  : 
; 444  :       // Base size should be 4 MB, need to change
; 445  :       baseSize = (_FF(agpMain.sizeInB) + 4095) & ~4095;
; 446  : 
; 447  :       _FF(doAgpCF) = 1;
; 448  : 
; 449  :       _FF(mainFifo.base)  = (_FF(agpMain.linAddr ) + 4095) & ~4095;
; 450  :       _FF(mainFifo.start) = _FF(mainFifo.base);
; 451  : 
; 452  :       // disable command fifo 0
; 453  :       //
; 454  :       SETDW( _FF(lpCRegs)->PRIMARY_CMDFIFO.baseSize,  0 );
; 455  : 
; 456  : // MAGIC_SCRIPT was defined for the 9X driver in dd32/ddflip.c
; 457  : // I asked Andrew Sobczyk about this and he said, "On Banshee, we could not 
; 458  : // get AGP to work without doing this.  I have no explanation for why it makes 
; 459  : // AGP work but it does."  The Magic Script code has since moved to the vxd, and
; 460  : // since I don't think I can call a vxd function from within the 32-bit display
; 461  : // driver attatched to the VXD, I'm using the old MAGIC SCRIPT function.
; 462  : //#ifdef MAGIC_SCRIPT
; 463  :       // Do a config causes this is a good thing
; 464  :       DoConfig(0x0003121a);
; 465  : //#endif
; 466  : 
; 467  :       //
; 468  :       // h/w bug workaround for Swap hang
; 469  :       //
; 470  :      if (IS_NAPALM(_FF(VendorDeviceID)))
; 471  :         {
; 472  :         SETDW(_FF(lpCRegs)->cmdFifoThresh,             (20 << 5) | 8 );
; 473  :         }
; 474  :      else
; 475  :         {
; 476  :         SETDW(_FF(lpCRegs)->cmdFifoThresh,             (15 << 5) | 8 );
; 477  :         }
; 478  : 
; 479  : 	  SETDW(_FF(lpCRegs)->PRIMARY_CMDFIFO.readPtrL,  _FF(agpMain.physAddr) );
; 480  : 	  SETDW(_FF(lpCRegs)->PRIMARY_CMDFIFO.readPtrH,  0);
; 481  : 	  SETDW(_FF(lpCRegs)->PRIMARY_CMDFIFO.aMin,      _FF(agpMain.physAddr) - 4);
; 482  : 	  SETDW(_FF(lpCRegs)->PRIMARY_CMDFIFO.aMax,      _FF(agpMain.physAddr) - 4);
; 483  : 	  SETDW(_FF(lpCRegs)->PRIMARY_CMDFIFO.depth,     0);
; 484  : 	  SETDW(_FF(lpCRegs)->PRIMARY_CMDFIFO.holeCount, 0);
; 485  : 
; 486  : 	  SETDW(_FF(lpCRegs)->PRIMARY_CMDFIFO.baseAddrL, (_FF(agpMain.physAddr) >> 12) );
; 487  : 	  SETDW(_FF(lpCRegs)->PRIMARY_CMDFIFO.baseSize,  SST_EN_CMDFIFO  |
; 488  :                                             SST_CMDFIFO_AGP |
; 489  :                                             SST_CMDFIFO_DISABLE_HOLES);
; 490  : 
; 491  :       startVirtualAddr     = _FF(agpMain.linAddr );
; 492  : 	  fifoLength           = _FF(agpMain.sizeInB );
; 493  : 
; 494  :       if (fifoLength > (4 * 1024L * 1024L))
; 495  : 	      fifoLength = 4 * 1024L * 1024L;
; 496  : 	
; 497  :       _FF(cmdFifoBasePtr)  = (FxU32)&_FF(mainFifo.base);
; 498  : 
; 499  : 	  CMDFIFOPTR           = startVirtualAddr;
; 500  : 	  CMDFIFOSTART         = startVirtualAddr;
; 501  : 	  CMDFIFOSPACE         = (fifoLength / 4) - 3;
; 502  : 	  CMDFIFOEND           = startVirtualAddr + fifoLength - 12;
; 503  : 
; 504  : 	  CMDFIFOOFFSET        = startVirtualAddr - _FF(agpMain.physAddr);
; 505  : 	  CMDFIFOJMP           = SSTCP_PKT0_JMP_AGP | (((_FF(agpMain.physAddr) & 0x00FFFFFF) >> 2) << 6);
; 506  : 	  CMDFIFOJMP2          = (_FF(agpMain.physAddr) >> 25) & ((1L << 12) - 1);
; 507  : 
; 508  : 	  CMDFIFOEPILOGPTR     = CMDFIFOSTART;
; 509  : 	  CMDFIFOUNBUMPEDWORDS = 0;
