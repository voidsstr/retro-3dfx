_MUX_Napalm PROC NEAR

; 62   :   //RYAN@TODO,990902:  The polarity and the actual bit for this mux is not yet known.
; 63   :   //srogers,000116: It looks like from the schematics, I've seen, we should at least
; 64   :   // set the DDC Enable on.  Also, the schematics say to set GPIO_1 to 0 for monitor
; 65   :   // detection and set GPIO_1 to 1 for FLATPANEL detection
; 66   :   I2C_REGBASEPTR(pContext)->vidSerialParallelPort |= SST_SERPAR_DDC_EN;

  00000	8b 44 24 04	 mov	 eax, DWORD PTR _pContext$[esp-4]
  00004	8b 80 90 00 00
	00		 mov	 eax, DWORD PTR [eax+144]
  0000a	8b 48 78	 mov	 ecx, DWORD PTR [eax+120]
  0000d	81 c9 00 00 04
	00		 or	 ecx, 262144		; 00040000H
  00013	89 48 78	 mov	 DWORD PTR [eax+120], ecx

; 67   :   switch (value)
; 68   :   {

  00016	8b 4c 24 08	 mov	 ecx, DWORD PTR _value$[esp-4]
  0001a	83 e9 02	 sub	 ecx, 2
  0001d	74 18		 je	 SHORT $L10433
  0001f	49		 dec	 ecx
  00020	74 03		 je	 SHORT $L10436

; 76   :       DEBUGI2C(1, ("I2C: i2c_getaccess(\"Access granted for FLATPANEL DDC purposes.\")\n"));
; 77   :       break;
; 78   : 
; 79   :     default:
; 80   :       return I2C_FAILURE;

  00022	33 c0		 xor	 eax, eax

; 84   : }

  00024	c3		 ret	 0
$L10436:

; 71   :       DEBUGI2C(1, ("I2C: i2c_getaccess(\"Access granted for MONITOR DDC purposes.\")\n"));
; 72   :       break;
; 73   : 
; 74   :     case MUX_FLATPANELDDC:
; 75   :       I2C_REGBASEPTR(pContext)->vidSerialParallelPort |= SST_SERPAR_GPIO_1;

  00025	8b 50 78	 mov	 edx, DWORD PTR [eax+120]
  00028	81 ca 00 00 00
	20		 or	 edx, 536870912		; 20000000H
  0002e	89 50 78	 mov	 DWORD PTR [eax+120], edx

; 81   :   }
; 82   : 
; 83   :   return I2C_SUCCESS;

  00031	b8 01 00 00 00	 mov	 eax, 1

; 84   : }

  00036	c3		 ret	 0
$L10433:

; 69   :     case MUX_MONITORDDC:
; 70   :       I2C_REGBASEPTR(pContext)->vidSerialParallelPort &= ~SST_SERPAR_GPIO_1;

  00037	8b 48 78	 mov	 ecx, DWORD PTR [eax+120]
  0003a	81 e1 ff ff ff
	df		 and	 ecx, -536870913		; dfffffffH
  00040	89 48 78	 mov	 DWORD PTR [eax+120], ecx

; 81   :   }
; 82   : 
; 83   :   return I2C_SUCCESS;

  00043	b8 01 00 00 00	 mov	 eax, 1

; 84   : }

  00048	c3		 ret	 0
_MUX_Napalm ENDP
