PUBLIC	_GETGBL_dwOvlOffset
_TEXT	SEGMENT
_lpDriverData$ = 8
_GETGBL_dwOvlOffset PROC NEAR

; 65   :    return( ((GLOBALDATA *)lpDriverData)->dwOvlOffset );

  00000	8b 44 24 04	 mov	 eax, DWORD PTR _lpDriverData$[esp-4]
  00004	8b 80 b8 1a 00
	00		 mov	 eax, DWORD PTR [eax+6840]

; 66   : }

  0000a	c3		 ret	 0
_GETGBL_dwOvlOffset ENDP
_TEXT	ENDS
