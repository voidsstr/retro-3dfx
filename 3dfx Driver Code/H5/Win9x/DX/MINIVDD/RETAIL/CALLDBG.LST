				        .486
				        .MODEL  FLAT, C

				;=======================================================================
				;       type definitions
				;=======================================================================

				PPROC16 TYPEDEF FAR16 PTR


				;=======================================================================
 00000000			        .DATA
				;=======================================================================

 00000000 00000000		dbgfcn  PPROC16 ?
 00000000			        .CODE
				;=======================================================================


				;*----------------------------------------------------------------------
				;Function name:  CallOutputDebugString
				;
				;Description:    Send a string to the debug output device.
				;
				;Information:
				;
				;Return:         VOID
				;----------------------------------------------------------------------*
 00000000			CallOutputDebugString PROC PUBLIC, 
									buff:dword,
									msgfcn:dword
				;-----------------------------------------------------------------------
 00000003  0F B7 ED		        movzx   ebp, bp
 00000006  0E			        push    cs
 00000007  68 0000001B R	        push    OFFSET done
 0000000C  8B 45 0C				mov eax, dword ptr ss:[msgfcn]
 0000000F  A3 00000000 R			mov dbgfcn, eax
 00000014  66| FF 2D				jmp [dbgfcn]
	   00000000 R

 0000001B			done:
					ret

 0000001D			CallOutputDebugString  endp


				end

