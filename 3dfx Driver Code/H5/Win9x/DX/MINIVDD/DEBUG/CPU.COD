	TITLE	..\cpu.c
	.386P
include listing.inc
if @Version gt 510
.model FLAT
else
_TEXT	SEGMENT PARA USE32 PUBLIC 'CODE'
_TEXT	ENDS
_DATA	SEGMENT DWORD USE32 PUBLIC 'DATA'
_DATA	ENDS
CONST	SEGMENT DWORD USE32 PUBLIC 'CONST'
CONST	ENDS
_BSS	SEGMENT DWORD USE32 PUBLIC 'BSS'
_BSS	ENDS
$$SYMBOLS	SEGMENT BYTE USE32 'DEBSYM'
$$SYMBOLS	ENDS
$$TYPES	SEGMENT BYTE USE32 'DEBTYP'
$$TYPES	ENDS
_TLS	SEGMENT DWORD USE32 PUBLIC 'TLS'
_TLS	ENDS
_ITEXT	SEGMENT PARA USE32 PUBLIC 'ICODE'
_ITEXT	ENDS
_PTEXT	SEGMENT PARA USE32 PUBLIC 'PCODE'
_PTEXT	ENDS
_LTEXT	SEGMENT PARA USE32 PUBLIC 'LCODE'
_LTEXT	ENDS
_PDATA	SEGMENT DWORD USE32 PUBLIC 'PDATA'
_PDATA	ENDS
_LDATA	SEGMENT DWORD USE32 PUBLIC 'LCODE'
_LDATA	ENDS
FLAT	GROUP _DATA, CONST, _BSS, _PDATA, _LDATA
	ASSUME	CS: FLAT, DS: FLAT, SS: FLAT
endif
PUBLIC	_cpVendorId_Intel
PUBLIC	_cpVendorId_Amd
PUBLIC	_cpVendorId_Cyrix
PUBLIC	_cpVendorId_Centaur
PUBLIC	_cpVendorId_Rise
PUBLIC	_cpVendorId_Transmetta
CONST	SEGMENT
_cpVendorId_Intel DB 'GenuineIntel', 00H
	ORG $+3
_cpVendorId_Amd DB 'AuthenticAMD', 00H
	ORG $+3
_cpVendorId_Cyrix DB 'CyrixInstead', 00H
	ORG $+3
_cpVendorId_Centaur DB 'CentaurHauls', 00H
	ORG $+3
_cpVendorId_Rise DB 'RiseRiseRise', 00H
	ORG $+3
_cpVendorId_Transmetta DB 'GenuineTMx86', 00H
CONST	ENDS
PUBLIC	_GetCpuFeatures
PUBLIC	_HasCpuid
PUBLIC	_DoCpuid
PUBLIC	_fxstrncmp
PUBLIC	_fxstrncpy
_LTEXT	SEGMENT
_CpuFeatures$ = 8
