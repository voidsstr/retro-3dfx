_DB2DATA	SEGMENT
_Debug_Prompt DB 0aH, 'Napalm>', 00H
	ORG $+3
_Help_Fmt DD	FLAT:$SG11271
	DD	FLAT:$SG11272
	DD	FLAT:$SG11273
	DD	FLAT:$SG11274
	DD	FLAT:$SG11275
