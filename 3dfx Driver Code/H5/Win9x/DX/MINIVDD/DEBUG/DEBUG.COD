$SG11271 DB	0aH, 'Napalm Debug Command Summary', 0aH, 0aH, 00H
$SG11272 DB	'P[CI] <Bus#> <Dev#>              - Display PCI Info for '
	DB	'Device', 0aH, 00H
$SG11273 DB	'W[r] Bus# Dev# Func# Reg# Value  - Toggles int1 in the c'
	DB	'ode', 0aH, 00H
	ORG $+3
$SG11274 DB	'S[LI] <Bus#> <Dev#>              - Display PCI SLI Info '
	DB	'for Device', 0aH, 00H
$SG11275 DB	'E[xit]                           - Exits back to debugge'
	DB	'r', 0aH, 00H
	ORG $+1
$SG11276 DB	'H[elp] [Command]                 - Prints Help Informati'
	DB	'on', 0aH, 00H
$SG11277 DB	'Q[uit]                           - Quits back to debugge'
	DB	'r', 0aH, 00H
	ORG $+1
$SG11278 DB	'R[eg]                            - Dumps VGA registers', 0aH
	DB	00H
$SG11279 DB	'M[ode]                           - Resets the last mode', 0aH
	DB	00H
	ORG $+3
$SG11280 DB	'A[gp]                            - Dump the AGP register'
	DB	's', 0aH, 00H
	ORG $+1
$SG11281 DB	'C[lock] s v r                    - Program the ICS 307 C'
	DB	'lock', 0aH, 00H
	ORG $+2
$SG11480 DB	'Device ID/Vendor ID %08x', 0aH, 00H
	ORG $+2
$SG11481 DB	'Status/Command %08x', 0aH, 00H
	ORG $+3
$SG11482 DB	'Class_Code/Revision ID %08x', 0aH, 00H
	ORG $+3
$SG11483 DB	'BIST/Header Type/Latency Timer/Cache_line_size %08x', 0aH
	DB	00H
	ORG $+3
$SG11484 DB	'memBaseAddr0 %08x', 0aH, 00H
	ORG $+1
$SG11485 DB	'memBaseAddr1 %08x', 0aH, 00H
	ORG $+1
$SG11486 DB	'IoBaseAddr %08x', 0aH, 00H
	ORG $+3
$SG11487 DB	'SubSystemID/SubVendorID %08x', 0aH, 00H
	ORG $+2
$SG11488 DB	'RomBaseAddr %08x', 0aH, 00H
	ORG $+2
$SG11489 DB	'Cap Ptr %08x', 0aH, 00H
	ORG $+2
$SG11490 DB	'Max_lat/Min_gnt/Interrupt_Pin/Interrupt_Line %08x', 0aH, 00H
	ORG $+1
$SG11491 DB	'cfgInitEnable/FABID %08x', 0aH, 00H
	ORG $+2
$SG11492 DB	'ACPI Reset %08x', 0aH, 00H
	ORG $+3
$SG11493 DB	'cfgPciDecode %08x', 0aH, 00H
	ORG $+1
$SG11494 DB	'CfgStatus %08x', 0aH, 00H
$SG11495 DB	'CfgScratch %08x', 0aH, 00H
	ORG $+3
$SG11496 DB	'AGP CAP_ID %08x', 0aH, 00H
	ORG $+3
$SG11497 DB	'AGP status %08x', 0aH, 00H
	ORG $+3
$SG11498 DB	'AGP_Cmd %08x', 0aH, 00H
	ORG $+2
$SG11499 DB	'ACPI Cap ID %08x', 0aH, 00H
	ORG $+2
$SG11500 DB	'ACPI cntrl/status %08x', 0aH, 00H
$SG11501 DB	'cfgVideoCtrl0 %08x', 0aH, 00H
$SG11502 DB	'cfgVideoCtrl1 %08x', 0aH, 00H
$SG11503 DB	'cfgVideoCtrl2  %08x', 0aH, 00H
	ORG $+3
$SG11504 DB	'cfgSliLfbCtrl %08x', 0aH, 00H
$SG11505 DB	'cfgAaDepthBufferAperture %08x', 0aH, 00H
	ORG $+1
$SG11506 DB	'cfgAALfbCtrl %08x', 0aH, 00H
	ORG $+1
$SG11507 DB	'agpTestCtrl %08x', 0aH, 00H
	ORG $+2
$SG11508 DB	'agpTestData0 %08x', 0aH, 00H
	ORG $+1
$SG11509 DB	'agpTestData1 %08x', 0aH, 00H
	ORG $+1
$SG11510 DB	'agpTestData2 %08x', 0aH, 00H
	ORG $+1
$SG11511 DB	'agpTestData3 %08x', 0aH, 00H
	ORG $+1
$SG11512 DB	'cfgSliAAmisc %08x', 0aH, 00H
_DB2DATA	ENDS
PUBLIC	_Upper_Case
_DB1CODE	SEGMENT
_bLength$ = 8
_pStr$ = 12
_Upper_Case PROC NEAR

; 250  : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp
  00003	51		 push	 ecx

; 251  :    for (;bLength != 0; bLength--)

  00004	eb 08		 jmp	 SHORT $L11315
$L11316:
  00006	8a 45 08	 mov	 al, BYTE PTR _bLength$[ebp]
  00009	2c 01		 sub	 al, 1
  0000b	88 45 08	 mov	 BYTE PTR _bLength$[ebp], al
$L11315:
  0000e	8b 4d 08	 mov	 ecx, DWORD PTR _bLength$[ebp]
  00011	81 e1 ff 00 00
	00		 and	 ecx, 255		; 000000ffH
  00017	85 c9		 test	 ecx, ecx
  00019	74 44		 je	 SHORT $L11317

; 253  :       TOUPPER(*pStr);

  0001b	8b 55 0c	 mov	 edx, DWORD PTR _pStr$[ebp]
  0001e	33 c0		 xor	 eax, eax
  00020	8a 02		 mov	 al, BYTE PTR [edx]
  00022	83 f8 61	 cmp	 eax, 97			; 00000061H
  00025	7c 1b		 jl	 SHORT $L11758
  00027	8b 4d 0c	 mov	 ecx, DWORD PTR _pStr$[ebp]
  0002a	33 d2		 xor	 edx, edx
  0002c	8a 11		 mov	 dl, BYTE PTR [ecx]
  0002e	83 fa 7a	 cmp	 edx, 122		; 0000007aH
  00031	7f 0f		 jg	 SHORT $L11758
  00033	8b 45 0c	 mov	 eax, DWORD PTR _pStr$[ebp]
  00036	33 c9		 xor	 ecx, ecx
  00038	8a 08		 mov	 cl, BYTE PTR [eax]
  0003a	83 e9 20	 sub	 ecx, 32			; 00000020H
  0003d	89 4d fc	 mov	 DWORD PTR -4+[ebp], ecx
  00040	eb 0a		 jmp	 SHORT $L11759
$L11758:
  00042	8b 55 0c	 mov	 edx, DWORD PTR _pStr$[ebp]
  00045	33 c0		 xor	 eax, eax
  00047	8a 02		 mov	 al, BYTE PTR [edx]
  00049	89 45 fc	 mov	 DWORD PTR -4+[ebp], eax
$L11759:
  0004c	8b 4d 0c	 mov	 ecx, DWORD PTR _pStr$[ebp]
  0004f	8a 55 fc	 mov	 dl, BYTE PTR -4+[ebp]
  00052	88 11		 mov	 BYTE PTR [ecx], dl

; 254  :       pStr++;

  00054	8b 45 0c	 mov	 eax, DWORD PTR _pStr$[ebp]
  00057	83 c0 01	 add	 eax, 1
  0005a	89 45 0c	 mov	 DWORD PTR _pStr$[ebp], eax

; 255  :       }

  0005d	eb a7		 jmp	 SHORT $L11316
$L11317:

; 256  : }

  0005f	8b e5		 mov	 esp, ebp
  00061	5d		 pop	 ebp
  00062	c3		 ret	 0
_Upper_Case ENDP
_DB1CODE	ENDS
PUBLIC	_Get_Parameter
_DB1CODE	SEGMENT
_input$ = 8
_inOffset$ = 12
_delimTable$ = 20
_buffTerm$ = 24
_output$ = 28
_outBuffLen$ = 32
_maxParamLen$ = 36
_actualDelim$ = 40
_pIn$ = -12
_pOut$ = -8
_pDelim$ = -4
_Get_Parameter PROC NEAR

; 272  : {

  00063	55		 push	 ebp
  00064	8b ec		 mov	 ebp, esp
  00066	83 ec 0c	 sub	 esp, 12			; 0000000cH

; 273  :    BYTE *pIn;
; 274  :    BYTE *pOut;
; 275  :    BYTE *pDelim;
; 276  : 
; 277  :    pIn = input + *inOffset;

  00069	8b 45 0c	 mov	 eax, DWORD PTR _inOffset$[ebp]
  0006c	33 c9		 xor	 ecx, ecx
  0006e	8a 08		 mov	 cl, BYTE PTR [eax]
  00070	8b 55 08	 mov	 edx, DWORD PTR _input$[ebp]
  00073	03 d1		 add	 edx, ecx
  00075	89 55 f4	 mov	 DWORD PTR _pIn$[ebp], edx

; 278  :    pOut = output;

  00078	8b 45 1c	 mov	 eax, DWORD PTR _output$[ebp]
  0007b	89 45 f8	 mov	 DWORD PTR _pOut$[ebp], eax

; 279  :         
; 280  :    if(outBuffLen > 1)

  0007e	8b 4d 20	 mov	 ecx, DWORD PTR _outBuffLen$[ebp]
  00081	81 e1 ff 00 00
	00		 and	 ecx, 255		; 000000ffH
  00087	83 f9 01	 cmp	 ecx, 1
  0008a	0f 8e 1f 01 00
	00		 jle	 $L11341
$L11343:

; 282  :       while((*pIn == ASCII_SPACE) || (*pIn == ASCII_HT))

  00090	8b 55 f4	 mov	 edx, DWORD PTR _pIn$[ebp]
  00093	33 c0		 xor	 eax, eax
  00095	8a 02		 mov	 al, BYTE PTR [edx]
  00097	83 f8 20	 cmp	 eax, 32			; 00000020H
  0009a	74 0c		 je	 SHORT $L11345
  0009c	8b 4d f4	 mov	 ecx, DWORD PTR _pIn$[ebp]
  0009f	33 d2		 xor	 edx, edx
  000a1	8a 11		 mov	 dl, BYTE PTR [ecx]
  000a3	83 fa 09	 cmp	 edx, 9
  000a6	75 0b		 jne	 SHORT $L11344
$L11345:

; 283  :          pIn++;

  000a8	8b 45 f4	 mov	 eax, DWORD PTR _pIn$[ebp]
  000ab	83 c0 01	 add	 eax, 1
  000ae	89 45 f4	 mov	 DWORD PTR _pIn$[ebp], eax
  000b1	eb dd		 jmp	 SHORT $L11343
$L11344:

; 284  : 
; 285  :       if(maxParamLen == 0)

  000b3	8b 4d 24	 mov	 ecx, DWORD PTR _maxParamLen$[ebp]
  000b6	81 e1 ff 00 00
	00		 and	 ecx, 255		; 000000ffH
  000bc	85 c9		 test	 ecx, ecx
  000be	75 06		 jne	 SHORT $L11346

; 286  :          maxParamLen = outBuffLen;

  000c0	8a 55 20	 mov	 dl, BYTE PTR _outBuffLen$[ebp]
  000c3	88 55 24	 mov	 BYTE PTR _maxParamLen$[ebp], dl
$L11346:

; 287  : 
; 288  :       while(*input != buffTerm)

  000c6	8b 45 08	 mov	 eax, DWORD PTR _input$[ebp]
  000c9	33 c9		 xor	 ecx, ecx
  000cb	8a 08		 mov	 cl, BYTE PTR [eax]
  000cd	8b 55 18	 mov	 edx, DWORD PTR _buffTerm$[ebp]
  000d0	81 e2 ff 00 00
	00		 and	 edx, 255		; 000000ffH
  000d6	3b ca		 cmp	 ecx, edx
  000d8	0f 84 a6 00 00
	00		 je	 $L11349

; 290  :          pDelim = delimTable;

  000de	8b 45 14	 mov	 eax, DWORD PTR _delimTable$[ebp]
  000e1	89 45 fc	 mov	 DWORD PTR _pDelim$[ebp], eax
$L11351:

; 291  :          while((*pDelim != TAB_END) && (*pDelim != *pIn))

  000e4	8b 4d fc	 mov	 ecx, DWORD PTR _pDelim$[ebp]
  000e7	33 d2		 xor	 edx, edx
  000e9	8a 11		 mov	 dl, BYTE PTR [ecx]
  000eb	83 fa 1a	 cmp	 edx, 26			; 0000001aH
  000ee	74 1d		 je	 SHORT $L11352
  000f0	8b 45 fc	 mov	 eax, DWORD PTR _pDelim$[ebp]
  000f3	33 c9		 xor	 ecx, ecx
  000f5	8a 08		 mov	 cl, BYTE PTR [eax]
  000f7	8b 55 f4	 mov	 edx, DWORD PTR _pIn$[ebp]
  000fa	33 c0		 xor	 eax, eax
  000fc	8a 02		 mov	 al, BYTE PTR [edx]
  000fe	3b c8		 cmp	 ecx, eax
  00100	74 0b		 je	 SHORT $L11352

; 292  :             pDelim++;

  00102	8b 4d fc	 mov	 ecx, DWORD PTR _pDelim$[ebp]
  00105	83 c1 01	 add	 ecx, 1
  00108	89 4d fc	 mov	 DWORD PTR _pDelim$[ebp], ecx
  0010b	eb d7		 jmp	 SHORT $L11351
$L11352:

; 293  : 
; 294  :          if(*pDelim == TAB_END)

  0010d	8b 55 fc	 mov	 edx, DWORD PTR _pDelim$[ebp]
  00110	33 c0		 xor	 eax, eax
  00112	8a 02		 mov	 al, BYTE PTR [edx]
  00114	83 f8 1a	 cmp	 eax, 26			; 0000001aH
  00117	75 64		 jne	 SHORT $L11353

; 296  :             if((*pIn != ASCII_SPACE) && (*pIn != ASCII_HT))

  00119	8b 4d f4	 mov	 ecx, DWORD PTR _pIn$[ebp]
  0011c	33 d2		 xor	 edx, edx
  0011e	8a 11		 mov	 dl, BYTE PTR [ecx]
  00120	83 fa 20	 cmp	 edx, 32			; 00000020H
  00123	74 4d		 je	 SHORT $L11356
  00125	8b 45 f4	 mov	 eax, DWORD PTR _pIn$[ebp]
  00128	33 c9		 xor	 ecx, ecx
  0012a	8a 08		 mov	 cl, BYTE PTR [eax]
  0012c	83 f9 09	 cmp	 ecx, 9
  0012f	74 41		 je	 SHORT $L11356

; 298  :                if(outBuffLen > 1)

  00131	8b 55 20	 mov	 edx, DWORD PTR _outBuffLen$[ebp]
  00134	81 e2 ff 00 00
	00		 and	 edx, 255		; 000000ffH
  0013a	83 fa 01	 cmp	 edx, 1
  0013d	7e 33		 jle	 SHORT $L11356

; 300  :                   *pOut++ = *pIn;

  0013f	8b 45 f8	 mov	 eax, DWORD PTR _pOut$[ebp]
  00142	8b 4d f4	 mov	 ecx, DWORD PTR _pIn$[ebp]
  00145	8a 11		 mov	 dl, BYTE PTR [ecx]
  00147	88 10		 mov	 BYTE PTR [eax], dl
  00149	8b 45 f8	 mov	 eax, DWORD PTR _pOut$[ebp]
  0014c	83 c0 01	 add	 eax, 1
  0014f	89 45 f8	 mov	 DWORD PTR _pOut$[ebp], eax

; 301  :                   outBuffLen--;

  00152	8a 4d 20	 mov	 cl, BYTE PTR _outBuffLen$[ebp]
  00155	80 e9 01	 sub	 cl, 1
  00158	88 4d 20	 mov	 BYTE PTR _outBuffLen$[ebp], cl

; 302  :                   if(--maxParamLen == 0)

  0015b	8a 55 24	 mov	 dl, BYTE PTR _maxParamLen$[ebp]
