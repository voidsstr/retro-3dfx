COMM	_hwBitBltPS:DWORD
COMM	_hwBitBltHS:DWORD
_DATA	ENDS
PUBLIC	_GETGBL_dwOvlOffset
_TEXT	SEGMENT
_lpDriverData$ = 8
_GETGBL_dwOvlOffset PROC NEAR

; 64   : {

  00000	55		 push	 ebp
  00001	8b ec		 mov	 ebp, esp

; 65   :    return( ((GLOBALDATA *)lpDriverData)->dwOvlOffset );

  00003	8b 45 08	 mov	 eax, DWORD PTR _lpDriverData$[ebp]
  00006	8b 80 b8 1a 00
	00		 mov	 eax, DWORD PTR [eax+6840]

; 66   : }

  0000c	5d		 pop	 ebp
  0000d	c3		 ret	 0
_GETGBL_dwOvlOffset ENDP
_TEXT	ENDS
PUBLIC	_GETGBL_KMVTBuff
_TEXT	SEGMENT
_lpDriverData$ = 8
_GETGBL_KMVTBuff PROC NEAR

; 78   : {

  0000e	55		 push	 ebp
  0000f	8b ec		 mov	 ebp, esp

; 79   :    return( ((GLOBALDATA *)lpDriverData)->KMVTBuff );

  00011	8b 45 08	 mov	 eax, DWORD PTR _lpDriverData$[ebp]
  00014	8b 40 2c	 mov	 eax, DWORD PTR [eax+44]

; 80   : }

  00017	5d		 pop	 ebp
  00018	c3		 ret	 0
_GETGBL_KMVTBuff ENDP
_TEXT	ENDS
