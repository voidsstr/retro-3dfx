_PDATA	SEGMENT
$SG11389 DB	'h3InitSgram: %d x %d Mbit %s %s parts = %d MBytes', 0aH, 00H
	ORG $+1
$SG11390 DB	'SDRAM', 00H
	ORG $+2
$SG11391 DB	'SGRAM', 00H
	ORG $+2
$SG11397 DB	'h3InitSgram: sgramMode = 0x%x', 0aH, 00H
_PDATA	ENDS
_PTEXT	SEGMENT
_regBase$ = 8
_sgramMode$ = 12
_sgramMask$ = 16
_sgramColor$ = 20
_dwVendorDeviceID$ = 24
_vendorName$ = 28
_memType$ = -12
_partSize$ = -28
_memSize$ = -20
_nChips$ = -44
_dramInit0_strap$ = -24
_dramInit1_strap$ = -32
_dramInit0$ = -8
_dramInit1$ = -16
_miscInit1$ = -40
_vendorID$ = -36
_Bus_Mem_Strap$ = -4
_i$11373 = -56
_v$11374 = -52
_t$11375 = -48
_found$11376 = -60
_h3InitSgram PROC NEAR

; 458  : {

  0006d	55		 push	 ebp
  0006e	8b ec		 mov	 ebp, esp
  00070	83 ec 50	 sub	 esp, 80			; 00000050H

; 459  :   FxU32
; 460  :       memType,                  // SGRAM or SDRAM
; 461  :       partSize,                 // size of SGRAM chips in Mbits
; 462  :       memSize,                  // total size of memory in MBytes
; 463  :       nChips,                   // # chips of SDRAM/SGRAM
; 464  :       dramInit0_strap,    
; 465  :       dramInit1_strap,    
; 466  :       dramInit0,
; 467  :       dramInit1,
; 468  :       miscInit1;
; 469  :   FxU32 vendorID;
; 470  :   FxU32 Bus_Mem_Strap;
; 471  : 
; 472  :   // determine memory type: SDRAM or SGRAM
; 473  :   memType = MEM_TYPE_SGRAM;

  00073	c7 45 f4 00 00
	00 00		 mov	 DWORD PTR _memType$[ebp], 0

; 474  :   dramInit1_strap = IGET32(dramInit1);

  0007a	8b 45 08	 mov	 eax, DWORD PTR _regBase$[ebp]
  0007d	83 c0 1c	 add	 eax, 28			; 0000001cH
  00080	50		 push	 eax
  00081	e8 00 00 00 00	 call	 _my_inpd
  00086	83 c4 04	 add	 esp, 4
  00089	89 45 e0	 mov	 DWORD PTR _dramInit1_strap$[ebp], eax

; 475  :   dramInit1_strap &= SST_MCTL_TYPE_SDRAM;

  0008c	8b 4d e0	 mov	 ecx, DWORD PTR _dramInit1_strap$[ebp]
  0008f	81 e1 00 00 00
	40		 and	 ecx, 1073741824		; 40000000H
  00095	89 4d e0	 mov	 DWORD PTR _dramInit1_strap$[ebp], ecx

; 476  :   if ( dramInit1_strap & SST_MCTL_TYPE_SDRAM )

  00098	8b 55 e0	 mov	 edx, DWORD PTR _dramInit1_strap$[ebp]
  0009b	81 e2 00 00 00
	40		 and	 edx, 1073741824		; 40000000H
  000a1	85 d2		 test	 edx, edx
  000a3	74 07		 je	 SHORT $L11334

; 477  :     memType = MEM_TYPE_SDRAM;

  000a5	c7 45 f4 01 00
	00 00		 mov	 DWORD PTR _memType$[ebp], 1
$L11334:

; 478  : 
; 479  :   // set memory interface delay values and enable refresh
; 480  :   // these apply to all RAM vendors
; 481  :   dramInit1 = 0x0;

  000ac	c7 45 f0 00 00
	00 00		 mov	 DWORD PTR _dramInit1$[ebp], 0

; 482  : 
; 483  :   dramInit1 |= SST_DRAM_REFRESH_EN;

  000b3	8b 45 f0	 mov	 eax, DWORD PTR _dramInit1$[ebp]
  000b6	0c 01		 or	 al, 1
  000b8	89 45 f0	 mov	 DWORD PTR _dramInit1$[ebp], eax

; 484  :   dramInit1 |= (0x18 << SST_DRAM_REFRESH_VALUE_SHIFT) & SST_DRAM_REFRESH_VALUE;  

  000bb	8b 4d f0	 mov	 ecx, DWORD PTR _dramInit1$[ebp]
  000be	83 c9 30	 or	 ecx, 48			; 00000030H
  000c1	89 4d f0	 mov	 DWORD PTR _dramInit1$[ebp], ecx

; 485  :   dramInit1 |= SST_SGRAM_USE_INV_SAMPLE;

  000c4	8b 55 f0	 mov	 edx, DWORD PTR _dramInit1$[ebp]
  000c7	80 ce 40	 or	 dh, 64			; 00000040H
  000ca	89 55 f0	 mov	 DWORD PTR _dramInit1$[ebp], edx

; 486  :   dramInit1 |= SST_SGRAM_DEL_CLK_INVERT;

  000cd	8b 45 f0	 mov	 eax, DWORD PTR _dramInit1$[ebp]
  000d0	80 cc 80	 or	 ah, -128		; ffffff80H
  000d3	89 45 f0	 mov	 DWORD PTR _dramInit1$[ebp], eax

; 487  :   dramInit1 |= (8<<SST_SGRAM_CLK_ADJ_SHIFT);

  000d6	8b 4d f0	 mov	 ecx, DWORD PTR _dramInit1$[ebp]
