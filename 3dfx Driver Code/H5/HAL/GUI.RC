IDD_CSIM_MAIN DIALOGEX 0, 0, 191, 340
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CSIM Controls"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "&Quit",IDCANCEL,111,10,55,14
