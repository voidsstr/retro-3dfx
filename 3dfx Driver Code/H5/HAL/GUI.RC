IDR_APPMENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit\t       Alt+F4",        ID_FILE_EXIT
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&New Window",                 ID_WINDOW_NEWWINDOW
        MENUITEM "&Properties...\t      F1",    ID_WINDOW_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "&Close\t      Ctrl+F4",       ID_WINDOW_CLOSE
        MENUITEM "Close &All",                  ID_WINDOW_CLOSE_ALL
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents",                   ID_HELP_CONTENTS
        MENUITEM SEPARATOR
        MENUITEM "&About CSIM...",              ID_HELP_ABOUT
    END
END

IDR_APPMENU1 MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Save\t       Ctrl+W",        ID_FILE_SAVE
