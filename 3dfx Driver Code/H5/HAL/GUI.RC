    CONTROL         "&Flush after cmds",IDC_CHECK1,"Button",BS_AUTOCHECKBOX | 
                    WS_GROUP | WS_TABSTOP,15,20,66,10
    CONTROL         "&Pause",IDC_CHECK2,"Button",BS_AUTOCHECKBOX,15,35,63,10
    CONTROL         "&Save after swap",IDC_CHECK4,"Button",BS_AUTOCHECKBOX,
                    15,50,64,10
    CONTROL         "Bit &accurate",IDC_CHECK6,"Button",BS_AUTOCHECKBOX,15,
                    65,60,10
    CONTROL         "",IDC_CHECK3,"Button",BS_AUTOCHECKBOX | WS_DISABLED,15,
                    80,65,10
    CONTROL         "&Reset pixels in",IDC_CHECK5,"Button",BS_AUTOCHECKBOX,
                    15,96,60,10
