                    WS_TABSTOP
    PUSHBUTTON      "GDBG_LEVEL",IDC_BUTTON_GDBG,127,249,53,14
    EDITTEXT        IDC_EDIT1,11,275,35,13,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT2,11,295,35,13,ES_AUTOHSCROLL
