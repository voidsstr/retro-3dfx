######		SETUPASSISTANT######	synopsis :###		SETUPASSISTANT###### Do not exit on errorSet		Exit 		0Set		myDir		"`Directory`"### Launch the setupassistant ...(Execute "{myDir}scripts:make_abstartup.mpw")If {status} == 0	Echo "¶n>>> The Setup Assistant created the ab¶¥startup file successfully"	If "`Exists -f "{TempFolder}abErr"`"		Delete -y "{TempFolder}abErr"	EndElse	Echo "### An error occured ... here is the log file :"	Catenate "{TempFolder}abErr"	Echo "¶n>>> You can find the temporary file in {TempFolder} folder"End