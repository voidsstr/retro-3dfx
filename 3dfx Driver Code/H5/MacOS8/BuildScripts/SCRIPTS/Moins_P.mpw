######		MOINS_P######	synopsis :###		MOINS_P.mpw cw_file###### InitializationSet		WipeType		"{1}"Set		cwfiles			"{2}"Set		current			1### Check if cw_filename existsIf "`Exists -f {cwfiles}`"	Set fileNum 	`count -l {cwfiles}`Else	{abEcho} "{FNF}{cwfiles}"	Exit 42End### Touch/purge the Error & Warning fileEcho "VERSION : {cwfiles}¶n"### Exit if no project to buildIf ({fileNum} == 0)	{abEcho} "{FIE}{cwfiles}"	#ExitEnd### Open cwfilesOpen -r -t {cwfiles}### Loop on each line of the cwfilesLoop	Find {current}		Set currProject "`Catenate ¤`"		### Call the CWBuild project	({scriptsPath}WipeBinary.mpw {WipeType} {currProject})	    Evaluate current+=1    Break If {current} > {fileNum}End # >>Dev:StdErrClose {cwfiles} -y{abEcho} ">>> All Files Checked¶n"