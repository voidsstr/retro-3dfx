###### COMPILE ALL###### synopsis :### 	Compile_All.mpw cw_filename###### Call CW to Build projets (w/ target) present in cw_filename{abEcho} "¶n!`date -t`{BNS}COMPILE ALL"### Initialization#Set		CWPath			":::CodeWarrior Pro 5:Metrowerks CodeWarrior:CodeWarrior IDE 4.0"#Set		cwName		"CodeWarrior IDE 4.0"Set		ErrWarnFile		"{reportPath}ErrWarnMsg"Set		FinalEWF		"{reportPath}CompilerInfo"Set		cwfiles			"{1}"Set		current			1Set 	makeErr			0### DEBUG VARIABLES# Set the path to {MPW}Directory "{MPW}"# Run CodeWarrior{abEcho} "> Run {cwName}¶n""{CWPath}{cwName}"# Close all opened projectsLoop	Set res "`SendAE -t "{cwName}" -e MMPRClsP  -dot`" ·· {ErrWarnFile}	Break If "{res}" != ""End### Check if cw_filename existsIf "`Exists -f {cwfiles}`"	Set fileNum 	`count -l {cwfiles}`Else	{abEcho} "{FNF}{cwfiles}"	Exit 42End	### Touch/purge the Error & Warning fileEcho "VERSION : {cwfiles}¶n¶n" > {ErrWarnFile}### Exit if no project to buildIf ({fileNum} == 0)	{abEcho} "{FIE}{cwfiles}"	#ExitEnd### Open cwfilesOpen -r -t {cwfiles}### Loop on each line of the cwfilesLoop	Find {current}		Set currProject "`Catenate ¤`"		### Call the CWBuild project	({scriptsPath}CWBuild.mpw {currProject})	Evaluate makeErr+={status}    Evaluate current+=1    Break If {current} > {fileNum}End # >>Dev:StdErrClose {cwfiles} -y{abEcho} ">>> Build Projects : Completed¶n"# Quit CodeWarrior{abEcho} "> Quit {cwName}"Set	res		`SendAE -t "{cwName}" -e aevtquit` ·· {ErrWarnFile}Echo ">> `date`" >> {ErrWarnFile}Echo "##################################" >> {ErrWarnFile}Echo "## Build Projects : FINISHED    ##" >> {ErrWarnFile}Echo "##################################" >> {ErrWarnFile}Rename {ErrWarnFile} {FinalEWF} -yIf ( {makeErr} > 0)	{abEcho} "### {makeErr} project(s) did not build successfully"	Exit {makeErr}End{abEcho} "`Date -t`{ENS}COMPILE ALL"