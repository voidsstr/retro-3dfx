######		SENDMAIL				######	synopsis :###		SendMail.mpw [priority]###### send the final email (if no priority -> normal){abEcho} "¶n!`date -t`{BNS}SENDMAIL"### Lunch ms Outlook Express"{scriptsPath}msoe.mpw"### Check for prioritySet		priority		"¶'{1}¶'"Set		subject			"Built Report ({report})"{abEcho} "> mail priority : {priority}"### Set the content of the mail If ({priority} == "!nrm")	Set content "> Tgt : {MAKEVERSION} / Ref : {report}¶n¶n>>> Build SUCCESSFUL ({ABRes})"Else 	If ({priority} == "!hgh")		Set content "> Tgt : {MAKEVERSION} / Ref : {report}¶n¶n>>> Build FAILED ({ABRes})"		#Set content ">>> Automated Built : {report}¶n¶n> Built target : {MAKEVERSION}¶n> the built FAILED, read the FinalReport for more informations"	Else 		If 	"{priority}" == "''"			Set	priority		"!nrm"			{abEcho} "> No priority param was found. Priority was set to 'normal'"			Set content "DO NOT KNOW ... FOUND NO INFORMATIONS"		End	EndEndecho "Content : {content}"### Initialization{abEcho} "> Initialization"Set		lb				"["Set		rb				"]"{abEcho} "> Look for file abFinalReport"If "`Exists -f "{reportPath}abFinalReport"`"	Duplicate -y "{reportPath}aBFinalReport" "{Boot}FinalReport"	Set		FinalReport		"{Boot}FinalReport"Else	{abEcho} "{FNF}{reportPath}abFinalReport"	Set		FinalReport		"{reportPath}abFinalReport"EndIf "`Exists -f "{reportPath}CompilerInfo"`"	Duplicate -y "{reportPath}CompilerInfo" "{Boot}CompilerInfo"	Set		CompilerInfo	", Ò{Boot}CompilerInfoÓ"Else	{abEcho} "{FNF}{reportPath}CompilerInfo"	Set		lb			""	Set		rb			""End### Creation du mail{abEcho} "> Creating the draft mail in {outlName}"Set res "`SendAE -t "{outlName}" -e "corecrel" -prdt "¶{subj:Ò{subject}Ó, ctnt:Ò{content}Ó, prty:{priority}, rcpt:Ò{userEmail}Ó, cAtc:{lb}Ò{FinalReport}Ó{CompilerInfo}{rb}¶}" -kocl "type(outm)"`" ·· "{reportPath}abFinalReport"### Gather the handle for sending the mailEvaluate "{res}" =~ /Åseld:([0-9]+)¨1[¶}]/Set Hdl "{¨1}"### Construct the AE sendmail {abEcho} "> Constructing the Apple Event for sending the mail"If {Hdl} != ""	Set aebuilt	"obj ¶{form:ID  , want:type(outm), seld:{Hdl}, from:'null'()¶}"Else	{abEcho} "### A problem occured with the mail handle"	{abEcho} "### Handle ¶: ¶'Null{Hdl}¶'"End### Send the mail{abEcho} "> Send mail"SendAE -t "{outlName}" -e "mailsend" ----- "{aebuilt}" ·· "{reportPath}abFinalReport"### Quit Disk Copy#{abEcho} "¶n> Quit {outlName}¶n"#Set res "`SendAE -t "{outlName}" -e "aevtquit"`" ·· "{reportPath}abFinalReport"{abEcho} "¶n> Message : Outlook is still running ..."§## Clean up the messIf "`Exists -f "{Boot}FinalReport"`"	Delete -y "{Boot}FinalReport"EndIf "`Exists -f "{Boot}CompilerInfo"`"	Delete -y "{Boot}CompilerInfo"End