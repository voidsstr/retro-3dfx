######		VALIDATE_HOST							###### synopsis :###		Validate_Host.mpw vh_sfiles vh_cfiles### ### Check if the computer can run the A_B{abEcho} "¶n!`date -t`{BNS}VALIDATE HOST"{abEcho} "> Initialization¶n"Set		sitCodec		"BinHex4"Set 	JavaVersion 	"MRJLib¶t2.2.2"If ( "{1}" == "" || "{2}" == "")	{abEcho} "{NEP}"	{abEcho} "# Usage - Validate_Host vh_sfiles vh_cfiles"	Exit 42Else	Set		vhsfiles		"{1}"	Set		vhcfiles		"{2}"End### Run the Update script#Execute ("{scriptsPath}Update_Scripts.mpw")#If ("{status}" > 0)#	Exit 42#Else#	{abEcho} "¶n> Update Scripts : Passed¶n"#End{abEcho} "> Check Applications"Set sdir	`Directory`Directory "{MPW}"### Check for CW / DC / SItIf !"`Exists -f "{CWPath}{cwName}"`"	{abEcho} "{FNF}{CWPath}{cwName}"	Exit 42Else	{abEcho} "> application {cwName} found"EndIf !"`Exists -f	"{sitPath}{sitName}"`"	{abEcho} "{FNF}{sitPath}{sitName}"	Exit 42Else	{abEcho} "> application {sitName} found"EndIf !"`Exists -f	"{dcpyPath}{dcpyName}"`"	{abEcho} "{FNF}{dcpyPath}{dcpyName}"	Exit 42Else	{abEcho} "> application {dcpyName} found"EndIf !"`Exists -f	"{outlPath}{outlName}"`"	{abEcho} "{FNF}{outlPath}{outlName}"	Exit 42Else	{abEcho} "> application {outlName} found"End{abEcho} "Check Applications : Passed¶n"Directory "{sdir}"### System Files test ...{abEcho} "> Check System Folder Files"Set 	current 		1Set 	errNbr 			0If "`Exists -f {vhsfiles}`"	Set 	fileNum 		`count -l {vhsfiles}`Else	{abEcho} "{FNF}{vhsfiles}"	Exit 42End### Remove old fNameList file if existsIf "`Exists -f {reportPath}fNameList`"	Delete {reportPath}fNameList -y -iEnd### Exit if no paths in fileIf {fileNum} == 0	{abEcho} "{FIE}{vhsfiles}"End### Open vhsfilesOpen -r -t {vhsfiles}### Loop on each line of the fileLoop	Find {current}	#    If !"`Exists -q -f "?`Catenate ¤?`"`"		Set 	fName 		"`Catenate ¤`"	Set 	fName 		"{SystemFolder}{fName}"		If !"`Exists -q "{fName}"`"      	Echo "* File {fName} not found" >> {reportPath}fNameList		Evaluate errNbr+=1	End	    Evaluate current+=1    Break If {current} > {fileNum}End >>Dev:StdErrClose {vhsfiles} -y### Exit test if file(s) not foundIf {errNbr} > 0	{abEcho} "### System Folder Files test : Failed"	{abEcho} "### Could not find the file(s) listed below :"	Catenate {reportPath}fNameList	Catenate {reportPath}fNameList >> {reportPath}abFinalReport	Exit 42Else	{abEcho} "> {fileNum} file(s) checked"	{abEcho} ">>> System Folder Files : Passed¶n"End### MRJ Version test ...{abEcho} "> Check MRJ version"Set 	ver 			"`versionlist "MRJLib" -raw -u "{SystemFolder}Extensions:MRJ Libraries:" -t shlb`"If "{ver}" == "{JavaVersion}"	{abEcho} "> MRJ Version : {ver}"	{abEcho} ">>> MRJ version : Passed¶n"Else	{abEcho} "### MRJ version test : Failed"	{abEcho} "### This OS is running {ver} / You need to install {JavaVersion}" 	Exit 42EndDirectory "{MPW}"### Essential tools test ...{abEcho} "> Check for essential Tools"Set 	current 	1Set 	errNbr 		0If "`Exists -f {vhcfiles}`"	Set 	fileNum 	`count -l {vhcfiles}`Else	{abEcho} "{FNF}{vhcfiles}"	Exit 42End### Remove old fNameList file if existsIf "`Exists -f {reportPath}fNameList`"	Delete {reportPath}fNameList -y -iEnd### Exit if no paths in fileIf {fileNum} == 0	{abEcho} "{FIE}{vhcfiles}"	Exit 42End	### Open vhcfilesOpen -r -t {vhcfiles}### Loop on each line of the fileLoop	Find {current}	Set fName "`Catenate ¤`"	(Evaluate "{fName}" =~ /¶'*(([Â:]*:)+)¨1([Â:]*)¨2/ ) · Dev:Null 	Set FullName "{¨2}"	If !"`Exists -q {fName}`"      			If "`Exists -f {abtoolsPath}{FullName}`"			Delete -y {abtoolsPath}{FullName}			{abEcho} "> Delete an old {FullName}"		End				If "`Exists -f {abtoolsPath}{FullName}.hqx`"			{abEcho} "### The file {FullName} is missing"						### Execute {sitName}			{abEcho} "> Execute {sitName}"			Execute "{sitPath}{sitName}"						### Decode {FullName}.hqx			set res `SendAE -t "{sitName}" -e "SIT!TRAN" -----alis {abtoolsPath}{FullName}.hqx -trnmTEXT "{sitCodec}"` ·· {reportPath}abFinalReport			{abEcho} "> Translate file {FullName}.hqx using {sitCodec}"						### Quit {sitName}			{abEcho} "> Quit {sitName}"			SendAE -t "{sitName}" -e aevtquit -dot						### Duplicate the file to the destination folder			If "`Exists -f {abtoolsPath}{FullName}`"				Move -y {abtoolsPath}{FullName} {fName}				If {status} == 0					{abEcho} ">> Good news : AB found a NEW one for you"				Else					{abEcho} "### A problem occured while copying the file {abtoolsPath}{FullName}"					Echo "* File {fName} not found" >> {reportPath}fNameList					Evaluate errNbr+=1				End			Else				{abEcho} "### A problem occured while decoding the {sitCodec} file"				Echo "* File {fName} not found" >> {reportPath}fNameList				Evaluate errNbr+=1			End		Else			Echo "* File {fName} not found" >> {reportPath}fNameList			Evaluate errNbr+=1		End    Else		{abEcho} "> {FullName} file : Checked"	End	    Evaluate current+=1    Break If {current} > {fileNum}End >>Dev:StdErrClose {vhcfiles} -y### Exit test if file(s) not foundIf {errNbr} > 0	{abEcho} "### Essential tools test : Failed"	{abEcho} "### Could not find the file(s) listed below :"	Catenate {reportPath}fNameList	Catenate {reportPath}fNameList >> {reportPath}fNameList	Exit 42Else	{abEcho} "> {fileNum} file(s) checked"	{abEcho} ">>> Essential Tools : Passed¶n"End### Check for starteam-sdk.jar fileSet	HDfilePath 		"{SystemFolder}Extensions:MRJ Libraries:MRJClasses:starteam-sdk.jar"Set	FullName		"starteam-sdk.jar"If !"`Exists -f "{HDfilePath}"`"	{abEcho} "{FNF}{HDfilePath}"		If "`Exists -f {abtoolsPath}{FullName}`"		Delete -y {abtoolsPath}{FullName}		{abEcho} "> Delete an old {FullName}"	End			If "`Exists -f {abtoolsPath}{FullName}.hqx`"		### Execute {sitName}		{abEcho} "> Execute {sitName}"		Execute "{sitPath}{sitName}"				### Decode {FullName}.hqx		set res `SendAE -t "{sitName}" -e "SIT!TRAN" -----alis {abtoolsPath}{FullName}.hqx -trnmTEXT "{sitCodec}"` ·· {reportPath}abFinalReport		{abEcho} "> Translate file {FullName}.hqx using {sitCodec}"				### Quit {sitName}		{abEcho} "> Quit {sitName}"		SendAE -t "{sitName}" -e aevtquit -dot				### Duplicate the file to the destination folder		If "`Exists -f {abtoolsPath}{FullName}`"			Move -y {abtoolsPath}{FullName} "{HDfilePath}"			If {status} == 0				{abEcho} ">> Good news : AB found a NEW one for you"			Else				{abEcho} "### A problem occured while copying the file {abtoolsPath}{FullName}"				Exit 42			End		Else			{abEcho} "### A problem occured while decoding the {sitCodec} file"			Exit 42		End	Else		Exit 42	EndEnd{abEcho} "> {FullName} file : Checked"Directory "{MPW}"################################################################## Check for Finder Flags Panel fileSet	HDfilePath 		"{CWPath}CodeWarrior Plugins:Preference Panels:Finder Flags Panel"Set	FullName		"Finder Flags Panel.pnl"If !"`Exists -f "{HDfilePath}"`"	{abEcho} "{FNF}{HDfilePath}"		If "`Exists -f {abtoolsPath}"{FullName}"`"		Delete -y "{abtoolsPath}{FullName}"		{abEcho} "> Delete an old {FullName}"	End			If "`Exists -f "{abtoolsPath}{FullName}.hqx"`"		### Execute {sitName}		{abEcho} "> Execute {sitName}"		Execute "{sitPath}{sitName}"				### Decode {FullName}.hqx		set res `SendAE -t "{sitName}" -e "SIT!TRAN" -----alis "{abtoolsPath}{FullName}.hqx" -trnmTEXT "{sitCodec}"` ·· {reportPath}abFinalReport		{abEcho} "> Translate file {FullName}.hqx using {sitCodec}"				### Quit {sitName}		{abEcho} "> Quit {sitName}"		SendAE -t "{sitName}" -e aevtquit -dot				### Duplicate the file to the destination folder		If "`Exists -f "{abtoolsPath}{FullName}"`"			Move -y "{abtoolsPath}{FullName}" "{HDfilePath}"			If {status} == 0				{abEcho} ">> Good news : AB found a NEW one for you"			Else				{abEcho} "### A problem occured while copying the file {abtoolsPath}{FullName}"				Exit 42			End		Else			{abEcho} "### A problem occured while decoding the {sitCodec} file"			Exit 42		End	Else		Exit 42	EndEnd{abEcho} "> {FullName} file : Checked"### Check for Finder Flags PostLinker fileSet	HDfilePath 		"{CWPath}CodeWarrior Plugins:Linkers:Finder Flags PostLinker"Set	FullName		"Finder Flags PostLinker.lnk"If !"`Exists -f "{HDfilePath}"`"	{abEcho} "{FNF}{HDfilePath}"		If "`Exists -f {abtoolsPath}"{FullName}"`"		Delete -y "{abtoolsPath}{FullName}"		{abEcho} "> Delete an old {FullName}"	End			If "`Exists -f "{abtoolsPath}{FullName}.hqx"`"		### Execute {sitName}		{abEcho} "> Execute {sitName}"		Execute "{sitPath}{sitName}"				### Decode {FullName}.hqx		set res `SendAE -t "{sitName}" -e "SIT!TRAN" -----alis "{abtoolsPath}{FullName}.hqx" -trnmTEXT "{sitCodec}"` ·· {reportPath}abFinalReport		{abEcho} "> Translate file {FullName}.hqx using {sitCodec}"				### Quit {sitName}		{abEcho} "> Quit {sitName}"		SendAE -t "{sitName}" -e aevtquit -dot				### Duplicate the file to the destination folder		If "`Exists -f {abtoolsPath}"{FullName}"`"			Move -y "{abtoolsPath}{FullName}" "{HDfilePath}"			If {status} == 0				{abEcho} ">> Good news : AB found a NEW one for you"			Else				{abEcho} "### A problem occured while copying the file {abtoolsPath}{FullName}"				Exit 42			End		Else			{abEcho} "### A problem occured while decoding the {sitCodec} file"			Exit 42		End	Else		Exit 42	EndEnd{abEcho} "> {FullName} file : Checked"{abEcho} "`Date -t`{ENS}VALIDATE HOST"