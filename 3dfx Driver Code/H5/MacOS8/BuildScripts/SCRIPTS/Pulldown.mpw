######		PULLDOWN				######	synopsis :###		Pulldown.mpw pd_filename###### Download files from the Starteam tree present in pd_filename{abEcho} "¶n!`date -t`{BNS}PULLDOWN"### Initialization ...{abEcho} "> Initialization¶n"Set 	pwdCRC 				0Set 	SavedDirectory 		`Directory`Set 	current 			1Set		pdfiles				"{1}"# Set the new directory pathDirectory "{tdfx_builtPath}devel:"If {status} > 0	{abEcho} "> {tdfx_builtPath}devel:"EndSet BuildRoot `Directory`# Create the password.txt file ...Echo {StarteamPwd} > Password.txtIf ({status} != 0)	{abEcho} "{CCF}{BuildRoot}password.txt"	Set pwdCRC 1EndIf "`Exists -f {reportPath}starteam.out`"	Delete {reportPath}starteam.out -y -iEnd{abEcho} "> BuildRoot : {BuildRoot}¶n"#simple function test line#runjava stcmd list -p "{ownerName}:password@starteam:49201/3dfx/devel/h3/glide/" -is -rp "" -filter "GMOU" -x -nologoIf "`Exists -f {pdfiles}`"	Set fileNum 	`count -l {pdfiles}`Else	{abEcho} "{FNF}{pdfiles}"	Exit 42End	### Exit if no file to downloadIf ({fileNum} == 0)	{abEcho} "{FIE}{pdfiles}"End### Open pdfilesOpen -r -t {pdfiles}### Loop on each line of the pdfilesLoop	Find {current}	Set 	attempt		1	Set 	fPath 		"`Catenate ¤`"		{abEcho} "> [ Checking out ..{fPath}*.* ]"	Loop		### List all the files to check out to be able to check if all have been downloaded from the tree		java com.starbase.starteam.commandline.StarTeamCmd List -p "{StarteamOwner}@starteam:49201{fPath}" -pwdfile "password.txt" -is -nologo -x > {reportPath}treelist		search -q -w /missing/ {reportPath}treelist > {reportPath}fromtree		set pdTotal `count -l {reportPath}fromtree`		{abEcho} "> {pdTotal} file(s) in tree"				### run the starteam.jar to check out the files needed		java com.starbase.starteam.commandline.StarTeamCmd co -p "{StarteamOwner}@starteam:49201{fPath}" -o -is -pwdfile "password.txt" -cmp -x -rp "{tdfx_builtPath}devel:" ·· {reportPath}starteam.out			### Check if CheckOut did work (by looking if the directory is here)		Echo "{fPath}" > {reportPath}dir		Open -t {reportPath}dir		Find ¥ ; Replace -c ° /¶// ":" {reportPath}dir		Save {reportPath}dir		Find ¥ ; Replace -c ° /":3dfx:"/ "{tdfx_builtPath}" {reportPath}dir		Save {reportPath}dir		Find 1 ; Set mfPath "`Catenate ¤`"		Close {reportPath}dir -y				### Check the number of files downloaded from the tree		If "`Exists -d "{mfPath}"`"			Files -r "{mfPath}" > {reportPath}treelist		Else			Echo "" > {reportPath}treelist		End				Search -r -q -w /:/ {reportPath}treelist > {reportPath}fromtree		Set compteur `count -l {reportPath}fromtree`		Set ligne 1		Set realTotal 0		Open -t {reportPath}fromtree		Loop			Find {ligne}			### check if it's not a blank line			If "`Catenate ¤`" != ""				Evaluate realTotal +=1			End			Evaluate ligne +=1			If {ligne} > {compteur}				break			End		End		Close {reportPath}fromtree -y				set temp 0		Evaluate temp = {pdTotal} -1		If ({pdTotal} == {realTotal} || {realTotal} == {temp})			{abEcho} "> Downloaded all file(s) successfully ! [{realTotal}]"			{abEcho} ">> `date -t` !¶t¶t..{fPath}*.* => Completed (attempt #{attempt})"			Break		Else			{abEcho} "# {realTotal} file(s) downloaded"			If ({pdTotal} == 0)				set final 	0				### List all the files to check out to be able to check if all have been downloaded from the tree				java com.starbase.starteam.commandline.StarTeamCmd List -p "{StarteamOwner}@starteam:49201{fPath}" -pwdfile "password.txt" -is -nologo -x > {reportPath}treelist				search -q -w /missing/ {reportPath}treelist > {reportPath}fromtree				set pdTotal `count -l {reportPath}fromtree`				Set temp2 0				Evaluate temp2 = {pdTotal} -1				{abEcho} "> After a recheck, AB found {pdTotal} file(s) in tree !"				If ("{pdTotal}" == "{realTotal}" || "{pdTotal}" == "{temp2}")					{abEcho} "> Downloaded all file(s) successfully ! [{realTotal}]"					{abEcho} ">> `date -t` !¶t¶t..{fPath}*.* => Completed (attempt #{attempt})"					Set final	1				End			End						If {final} == 0				{abEcho} "> Attempt #{attempt} FAILED"				Evaluate attempt +=1			Else				break			End		End				If ({attempt} > {pdRetry})			Break		End	End			If ( {attempt} > {pdRetry} )		Evaluate attempt-=1		{abEcho} "### Could not download ..{fPath}*.* (after {attempt} attempt(s))"		Exit 42	End	    Evaluate current+=1    Break If {current} > {fileNum}End >>Dev:StdErrClose {pdfiles} -y{abEcho} ">>> Starteam download : Completed¶n"### Fix all Files Types and Creator Code ...If "`Exists -f "{MPW}"Tools:FixTypes.mpt`"	"{MPW}"Tools:FixTypes.mpt "{BuildRoot}"	{abEcho} ">>> Files Type/Creator : Fixed¶n"Else	{abEcho} "{FNF}{MPW}Tools:FixTypes.mpt"	Set fixCRC 1End### Deleting password.txt fileIf ({pwdCRC} == 0)	Delete password.txt -y -iEnd### Deleting {reportPath}dirIf "`Exists -f {reportPath}dir`"	Delete {reportPath}dir -i -yEnd### Deleting {reportPath}1If "`Exists -f {reportPath}treelist`"	Delete {reportPath}treelist -i -yEnd### Deleting {reportPath}2If "`Exists -f {reportPath}fromtree`"	Delete {reportPath}fromtree -i -yEndDirectory "{SavedDirectory}"{abEcho} "SavedDir : {SavedDirectory}"### Wait to put back the SavedDirectory before exiting for an errorExit If {fixCRC} == 1{abEcho} "`Date -t`{ENS}PULLDOWN ALL"