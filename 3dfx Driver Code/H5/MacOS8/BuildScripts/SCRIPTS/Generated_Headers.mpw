###### GENERATED HEADERS###### synopsis:###		Generated_Headers.mpw######	load some scripts to generate some headers{abEcho} "¶n!`date -t`{BNS}GENERATED HEADERS¶n"Set genErr 0Execute ({scriptsPath}GenDate.mpw)Evaluate genErr += {status}Execute ({scriptsPath}PPCInLine.mpw)Evaluate genErr += {status}If {genErr} == 0	Exit 0Else	Exit 1End{abEcho} "`Date -t`{ENS}GENERATED HEADERS"