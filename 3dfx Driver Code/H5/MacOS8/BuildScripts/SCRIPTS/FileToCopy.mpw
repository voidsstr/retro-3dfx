######		FILE TO COPY			######	synopsis :###		FileToCopy.mpw COPYPATH FileName DestFolder [XPos YPos]###### little routine to copy files ...### Initialization ...{abEcho} "¶n"Set		copyPath		"{1}"Set		theFile			"{2}"Set		DestFolder		"{3}"Set		XPos			"{4}"Set		YPos			"{5}"Set		finderName		"Finder"Set		ftcErr			0Set		hack 0If ("{theFile}" == "")	Exit 0End{abEcho} "FileToCopy : {theFile}"{abEcho} "Destination folder : {DestFolder}"### Look for the fileWhereis -s "{tdfx_builtPath}" -c "{theFile}" > "{reportPath}F2CSearch"set fileNum "`count -l "{reportPath}F2CSearch"`"if {fileNum} > 1	Set hack 1	### there is more than ONE file with this name ...	### look for the last one ... the newer !	{abEcho} "# The AB found more than one file with the filename {FileName}"	Catenate "{reportPath}F2CSearch"	Catenate "{reportPath}F2CSearch" >> {reportPath}abFinalReport		### Open CWBuildSearch	Open -t "{reportPath}F2CSearch"	Find ¥ ; Replace -c ° /¶n/ " " "{reportPath}F2CSearch"	Save "{reportPath}F2CSearch"	Find ¥ ; Replace -c ° /¶'/ "¶¶¶"" "{reportPath}F2CSearch"	Save "{reportPath}F2CSearch"	Find 1		### find the newer	set resultat "`Catenate ¤`"	echo {resultat}	set theFilePath "`Newer {resultat}`"	{abEcho} "> Here is the newest file to copy : {theFilePath}"	Close -y "{reportPath}F2CSearch"Else if {fileNum} == 1	Open -t "{reportPath}F2CSearch"	Find ¥ ;Replace -c ° /¶'/ "¶¶¶"¶¶¶"" "{reportPath}F2CSearch"	Save "{reportPath}F2CSearch"	Find 1		### find the newer	set theFilePath "`Catenate ¤`"		Close -y "{reportPath}F2CSearch"Else	Echo "> There is no file named : {theFile}"End#echo "filenum: {fileNum}"#echo "Hack: {hack}"#catenate {reportPath}F2CSearch#echo "Resultat: {resultat}"#echo "thefilePath: {theFilePath}"If "`Exists -f "{reportPath}F2CSearch"`"	Delete "{reportPath}F2CSearch" -y -iEnd{abEcho} "theFilePath : {theFilePath}"### Check for Destination FolderIf ("{DestFolder}" != "" )	Set	DestFolder "{DestFolder}:"	If !"`Exists -d "{copyPath}{DestFolder}"`"		{abEcho} "> Create new subFolder : {DestFolder}"		NewFolder "{copyPath}{DestFolder}"	EndEnd{abEcho} "ImageDestPath : {copyPath}{destfolder}"### Copy file to DestFolderIf ("{theFilePath}" != "")	if {hack} == 0		Duplicate -y "{theFilePath}" "{copyPath}{DestFolder}"	else		Duplicate -y {theFilePath} "{copyPath}{DestFolder}"	endElse	{abEcho} "{FNF}{theFile}"EndIf !"`Exists -f "{copyPath}{DestFolder}{theFile}"`"	Set	ftcErr 1	{abEcho} "{FNF}{copyPath}{DestFolder}{theFile}"	Exit 1EndIf ( ({XPos} != "" || {YPos} != "") && {ftcErr} == 0 )		### Put file to X and Y position in the folder ...	Set res "`SendAE -t "{finderName}" -e "miscslct" ----- "obj ¶{form:name, want:type(file), seld:Ò{copyPath}{DestFolder}{theFile}Ó, from:'null'()¶}"`" ·· {reportPath}abFinalReport	Set res "`SendAE -t "{finderName}" -e "coresetd" ----- "obj ¶{form:prop, want:type(prop), seld:type(posn), from:obj ¶{form:prop, want:type(prop), seld:type(sele), from:'null'()¶}¶}" -data "[{XPos}, {YPos}]"`" ·· {reportPath}abFinalReport	{abEcho} "> Set (X,Y) Positions"Else	{abEcho} "> No (X,Y) Positions"EndExit 0