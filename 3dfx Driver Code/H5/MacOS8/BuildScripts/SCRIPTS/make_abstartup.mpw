######		MAKE_ABSTARTUP######	synopsis :###		make_abstartup.mpw###### InitializationSet		abfile		"{TempFolder}abtempfile"Set		abErr		"{TempFolder}abErr"Set		ErrNbr		0### Prepare the Error fileEcho ">>> Automated Build Setup Assistant Error LOG <<<" > "{abErr}"Echo "¶n> Started on `date`¶n" >> "{abErr}"Alert "AUTOMATED BUILD SETUP ASSISTANT¶n¶nCopyright 1996, 1997, 1998, 1999 by 3Dfx Interactive, Inc.  All rights reserved."Confirm "AUTOMATED BUILD SETUP ASSISTANT¶nThis setup will ask you some questions to setup your Automated Build"Set confRes {status}If ({confRes} > 0)	Echo "¶n### The SetUp did not create the ab¥startup file¶n"	Echo "> The Setup have been canceled by the user" >> "{abErr}"	Exit 42End### Copy the header of the startup fileEcho "#_______________________________________________________________ 						" > "{abfile}"Echo "#		ab¥startup							3dfx["`date -d -s4`"]						" >> "{abfile}"Echo "#																						" >> "{abfile}"Echo "#   This file was generated by the AB Setup Assistant ...								" >> "{abfile}"Echo "#																					  ¶n" >> "{abfile}"Echo "# Paths informations ...																" >> "{abfile}"Echo "#																					  ¶n" >> "{abfile}"Echo "###	been sourced Flag																" >> "{abfile}"Echo "Set -e	startupFlag		1														¶n¶n" >> "{abfile}"																		### Starting questions ...Echo "### Select path where the 3dfx_Built:devel folder will be on your HD (WORKDISK) 		" >> "{abfile}"Set	workdisk	"`GetFileName -q -b "Select" -d -m "Select the WorkDisk folder ..."`"If ("{status}" > 0)	Echo "### No WORKDISK folder path have been selected" >> "{abErr}"	Exit 42EndIf "{workdisk}" != ""	Echo "Set -e 	tdfx_builtPath 	¶"{Workdisk}¶"											" >> "{abfile}"Else	Echo "### No WORKDISK folder path have been selected" >> "{abErr}"	Evaluate ErrNbr +=1EndEcho "¶n### Select path folder for "Kit File Disk" (Kits)											" >> "{abfile}"Set	kPath	"`GetFileName -q -b "Select" -d -m "Select the Kits folder ..."`"If ("{status}" > 0)	Echo "### No Kits folder path have been selected" >> "{abErr}"	Exit 42EndIf "{kPath}" != ""	Echo "Set -e 	KitsPath 			¶"{kPath}¶"												" >> "{abfile}"Else	Echo "### No Kits folder path have been selected" >> "{abErr}"	Evaluate ErrNbr +=1EndEcho "¶n### Select path folder for Build Components	(Components)								" >> "{abfile}"Set	cPath	"`GetFileName -q -b "Select" -d -m 'Select the Components folder ...'`"If ("{status}" > 0)	Echo "### No Components folder path have been selected" >> "{abErr}"	Exit 42EndIf "{cPath}" != ""	Echo "Set -e 	CompPath 			¶"{cPath}¶"												" >> "{abfile}"Else	Echo "### No Components folder path have been selected" >> "{abErr}"	Evaluate ErrNbr +=1EndEcho "¶n### Number of attempt in pulldown scripts (default is 3)									" >> "{abfile}"Echo "Set -e	pdRetry			3														" >> "{abfile}"Echo "¶n###### APP PATH/NAME ######" 																>> "{abfile}"Echo "### CodeWarrior path" >> "{abfile}"Set	cwVar	"`GetFileName -q -b "Select" -m 'Select MetroWerks CodeWarrior application ...'`"If ("{status}" > 0)	Echo "### No MetroWerks CodeWarrior path have been selected" >> "{abErr}"	Exit 42EndIf "{cwVar}" != ""	### Get the directory name from the file's full path name.	(Evaluate "{cwVar}" =~ /¶'*(([Â:]*:)+)¨1([Â:]*)¨2/ ) · Dev:Null 	Echo "Set	-e	CWPath	¶"{¨1}¶"												" >> "{abfile}"	Echo "### CodeWarrior name" >> "{abfile}"	Echo "Set	-e	cwName ¶"{¨2}¶""												 >> "{abfile}"Else	Echo "### No CodeWarrior folder path have been selected" >> "{abErr}"	Evaluate ErrNbr +=1EndEcho "¶n### Stuffit Deluxe path" >> "{abfile}"Set	sitVar	"`GetFileName -q -b "Select" -m 'Select StuffIt Deluxe (upgraded v.5.1.5) application ...'`"If ("{status}" > 0)	Echo "### No StuffIt Deluxe path have been selected" >> "{abErr}"	Exit 42EndIf "{sitVar}" != ""	### Get the directory name from the file's full path name.	(Evaluate "{sitVar}" =~ /¶'*(([Â:]*:)+)¨1([Â:]*)¨2/ ) · Dev:Null 	Echo "Set	-e	sitPath	¶"{¨1}¶"												" >> "{abfile}"	Echo "### StuffIt Deluxe name" >> "{abfile}"	Echo "Set	-e	sitName ¶"{¨2}¶""												 >> "{abfile}"Else	Echo "### No StuffIt Deluxe folder path have been selected" >> "{abErr}"	Evaluate ErrNbr +=1EndEcho "¶n### Disk Copy path" >> "{abfile}"Set	dcpVar	"`GetFileName -q -b "Select" -m 'Select Disk Copy application ...'`"If ("{status}" > 0)	Echo "### No Disk Copy path have been selected" >> "{abErr}"	Exit 42EndIf "{dcpVar}" != ""	### Get the directory name from the file's full path name.	(Evaluate "{dcpVar}" =~ /¶'*(([Â:]*:)+)¨1([Â:]*)¨2/ ) · Dev:Null 	Echo "Set	-e	dcpyPath	¶"{¨1}¶"												" >> "{abfile}"	Echo "### Disk Copy name" >> "{abfile}"	Echo "Set	-e	dcpyName ¶"{¨2}¶""												 >> "{abfile}"Else	Echo "### No Disk Copy folder path have been selected" >> "{abErr}"	Evaluate ErrNbr +=1EndEcho "¶n### Outlook Express path" >> "{abfile}"Set	oleVar	"`GetFileName -q -b "Select" -m 'Select Outlook Express application ...'`"If ("{status}" > 0)	Echo "### No Outlook Express path have been selected" >> "{abErr}"	Exit 42EndIf "{oleVar}" != ""	### Get the directory name from the file's full path name.	(Evaluate "{oleVar}" =~ /¶'*(([Â:]*:)+)¨1([Â:]*)¨2/ ) · Dev:Null 	Echo "Set	-e	outlPath	¶"{¨1}¶"												" >> "{abfile}"	Echo "### Outlook Express name" >> "{abfile}"	Echo "Set	-e	outlName ¶"{¨2}¶""												 >> "{abfile}"Else	Echo "### No Outlook Express folder path have been selected" >> "{abErr}"	Evaluate ErrNbr +=1EndEcho "¶n###### User Information ######" >> "{abfile}"Echo "### StarTeam login									" >> "{abfile}"Set logVar "`Request -d "Your login" 'What is your StarTeam user login ?'`"If ("{status}" > 0)	Echo "### No StarTeam login have been recorded" >> "{abErr}"	Exit 42EndIf "{logVar}" != ""	Echo "Set -e	StarteamOwner			{logVar}												" >> "{abfile}"Else	Echo "### No StarTeam login have been recorded"  >> "{abErr}"	Evaluate ErrNbr +=1EndEcho "¶n### StarTeam password									" >> "{abfile}"Set pwdVar "`Request -d "¥¥¥¥¥¥¥¥" 'What is your StarTeam password ?'`"If ("{status}" > 0)	Echo "### No StarTeam password have been recorded" >> "{abErr}"	Exit 42EndIf "{pwdVar}" != ""	Echo "Set -e	StarteamPwd			{pwdVar}												" >> "{abfile}"Else	Echo "### No StarTeam password have been recorded"  >> "{abErr}"	Evaluate ErrNbr +=1EndEcho "¶n### email address (to mail the report)									" >> "{abfile}"Set emaVar "`Request -d "{logVar}@3dfx.com" 'What is your email address (to mail the report) ?'`"If ("{status}" > 0)	Echo "### No email address have been recorded" >> "{abErr}"	Exit 42EndIf "{emaVar}" != ""	Echo "Set -e	userEmail			{emaVar}												" >> "{abfile}"Else	Echo "### No email address have been recorded"  >> "{abErr}"	Evaluate ErrNbr +=1EndConfirm "AUTOMATED BUILD SETUP ASSISTANT¶nThe setup will now copy the new ab¶¥startup file in the '{MPW}Startup Items'"Set confRes {status}If ({confRes} > 0)	Echo "¶n### The SetUp did not copy the ab¥startup file¶n" >> "{abErr}"	Exit 42EndMove "{TempFolder}abtempfile" "{MPW}Startup Items:ab¶¥startup"set toto {status}echo "status : {toto}"If ({toto} != 0)	Echo "¶n### The SetUp did not copy the ab¥startup file¶n" >> "{abErr}"	Exit 42EndAlert "AUTOMATED BUILD SETUP ASSISTANT¶n¶nYou need to restart your MPW SHELL ...¶n¶nThank you"Exit {ErrNbr}