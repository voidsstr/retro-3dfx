######		GATHER ALL			######	synopsis :###		Gather_all.mpw ga_filename###### Gather binaries and ReadMeFiles ...{abEcho} "¶n!`date -t`{BNS}GATHER ALL"### Initialization ...{abEcho} "> Initialization¶n"Set		gafiles			"{1}"Set		current			1Set		sitCodec		BinHex4Set		creatorCodec	BNHQSet		rnFolder		"release_notes"Set		fileErr			0### Check for {CompPath} folderIf !"`Exists -d "{CompPath}"`"	echo {CompPath}	NewFolder "{CompPath}"	If {status} != 0		{abEcho} "{CCF}{CompPath}"		{abEcho} "> Current Dir `Directory`"	EndEnd### Check for {CompPath}Comp:{dayName}: folderSet -e 	CompDayPath		"{CompPath}{dayName}:"If !"`Exists -d "{CompDayPath}"`"	NewFolder "{CompDayPath}"	If {status} != 0		{abEcho} "{CCF}{CompDayPath}"		{abEcho} "> Current Dir `Directory`"	EndEnd### Make the construction directorySet	-e	ImagePath		"{abPath}c_{MAKEVERSION}:"If "`Exists -d {ImagePath}`"	Delete -y {ImagePath}	If "{status}" == 0		{abEcho} "> Old {ImagePath} have been deleted"	Else		{abEcho} "### Could not delete {ImagePath}"		{abEcho} "> Current Directory `Directory`"	EndEndNewFolder {ImagePath}If {status} == 0	{abEcho} "> Created new {ImagePath} Folder"Else	{abEcho} "{CCF}{ImagePath}"	{abEcho} "> Current Directory `Directory`"End### Lunch StuffIt Deluxe application{abEcho} "> Extract Release Notes Files"Execute "{sitPath}{sitName}"Set rnPath		"`whereis -d -s "{tdfx_builtPath}" -c {rnFolder}`"If "`Exists -d {rnPath}:temp:`"	{abEcho} "> Delete old {rnPath}:temp: folder"	Delete -y {rnPath}:temp:End	{abEcho} "> Create new {rnPath}:temp: folder¶n"	NewFolder {rnPath}:temp:	For fName in `Files -f -c "{creatorCodec}" {rnPath}:{MAKEVERSION}:Å`	### Translate some files	{abEcho} "> Translate file : {fName} / using {sitCodec}"	Set res `SendAE -t "{sitName}" -e "SIT!TRAN" -----alis "{fName}" -trnmTEXT "{sitCodec}" -destTEXT {rnPath}:temp:` ·· Dev:NullEnd# Quit StuffIt Deluxe{abEcho} "> Quit {sitName}"Set	res		`SendAE -t "{sitName}" -e aevtquit` ·· Dev:Null### Check if ga_filename existsIf "`Exists -f {gafiles}`"	Set fileNum 	`count -l {gafiles}`Else	{abEcho} "{FNF}{gafiles}"	Exit 42End### Exit if no files to gatherIf ({fileNum} == 0)	{abEcho} "{FIE}{gafiles}"	#ExitEnd### Open cwfilesOpen -r -t {gafiles}### Loop on each line of the cwfilesLoop	Find {current}		Set currProject "`Catenate ¤`"		### Call the FileToCopy script	({scriptsPath}FileToCopy.mpw {ImagePath} {currProject})    Evaluate fileErr += {status}		Evaluate current+=1    Break If {current} > {fileNum}End # >>Dev:StdErrClose {gafiles} -y### Look for some .rom filesIf "`Exists -f {reportPath}RomFiles`"	Set current 1	Set fileNum 	`count -l {reportPath}RomFiles`		### "Exit" if no files to gather	If ({fileNum} == 0)		{abEcho} "{FIE}{reportPath}RomFiles"		#Exit	End	### Open cwfiles	Open -r -t {reportPath}RomFiles		### Loop on each line of the cwfiles	Loop		Find {current}				Set currProject "`Catenate ¤`"		### Call the FileToCopy script		({scriptsPath}FileToCopy.mpw {ImagePath} {currProject})		Evaluate fileErr += {status}				Evaluate current+=1		Break If {current} > {fileNum}	End # >>Dev:StdErr		Close {reportPath}RomFiles -yElse	{abEcho} "¶n{FNF}{reportPath}RomFiles"	{abEcho} ">>> No .rom files have been created in this build"EndIf ({fileErr} > 0)	{abEcho} "¶n### {fileErr} file(s) have not been copied into the Components folder"	Exit 42Else	{abEcho} "> Gather completed successfully¶n"	{abEcho} "> Copy folder {ImagePath} in {CompDayPath} Folder"	### Look for an old .FAILED folder ...	If "`Exists -d "{CompDayPath}{MAKEVERSION}.FAILED"`"		Delete -y "{CompDayPath}{MAKEVERSION}.FAILED"	End		If (("`Exists -d {ImagePath}`") && ("`Exists -d "{CompDayPath}"`"))		Rename -y {ImagePath} {abPath}{MAKEVERSION}:		Move -y {abPath}{MAKEVERSION}: "{CompDayPath}"		If {status} != 0			{abEcho} "### An error occured while renaming/moving {ImagePath} - {CompDayPath}"		End	Else		{abEcho} "### Could not find {abPath}{MAKEVERSION}: and/or {CompDayPath}"	EndEnd{abEcho} "`Date -t`{ENS}GATHER ALL"