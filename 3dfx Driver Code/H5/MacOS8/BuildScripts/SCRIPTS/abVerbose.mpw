######		ABVERBOSE							###### synopsis :###		execute ABVERBOSE.mpw### ### set some variables used in ab### ERROR SECTIONSet -e		FNF			"### Could not find file : "Set	-e		DNF			"### Could not find folder : "Set	-e		CCF			"### Could not create : "Set	-e		FIE			"### Empty file : "Set	-e		NEP			"### Not enough parameters were specified for this script."Set	-e		IPN			"### Invalid PullDown attempt number "### MESSAGE SECTIONSet -e		BAB			"¶t! STARTING v0.9 "Set	-e		EAB			"¶t> ENDING "Set -e		BNS			"¶t STARTING "Set -e		ENS			"¶t> ENDING "