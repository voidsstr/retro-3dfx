######		CLEAN ALL				######	synopsis :###		Clean_All.mpw tdfx_builtPath###### Remove/Clean the 3dfx_Built folder{abEcho} "¶n!`date -t`{BNS}CLEAN ALL"### Remove the 3dfx_Built folderIf "`Exists -d "{tdfx_builtPath}"`"	Delete "{tdfx_builtPath}" -y -i	{abEcho} "> Old "WorkDisk" folder have been removed"Else	{abEcho} "> No "WorkDisk" folder found"End### Create a new 3dfx_Built folderNewFolder "{tdfx_builtPath}"If {status} == 0	NewFolder "{tdfx_builtPath}devel:"	If {status} == 0		{abEcho} ">>> New {tdfx_builtPath} created¶n"	Else		{abEcho} "{CCF}{tdfx_builtPath}devel:"		Exit 42	EndElse	{abEcho} "{CCF}{tdfx_builtPath}"	Exit 42End{abEcho} "`Date -t`{ENS}CLEAN ALL"