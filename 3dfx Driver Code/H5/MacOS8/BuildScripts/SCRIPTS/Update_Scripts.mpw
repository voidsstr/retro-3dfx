#_______________________________________________________________#		UPDATE_SCRIPTS								3dfx[021400]##### Set Exit to 0 (otherwise it quits when backups found nothing to update)set exit 0### Initialization#Set		tdfx_builtPath	"Goinfre:3dfx_built:"Set		backupPath		"/3dfx/devel/h5/macos8/BuildScripts/"Set		macBUPath		"{TempFolder}BackUp:h5:macos8:"#Set		abPath			"Goinfre:My3dfx:devel:h5:MacOS8:BuildScripts:"{abEcho} ">>> Check Update Scripts"Set SavedDirectory "`Directory`"### Set directory for the pulldownDirectory "{TempFolder}"#### Pulldown the Buildscripts folderrunjava stcmd co -p "{StarteamOwner}:{StarteamPwd}@starteam:49201{backupPath}" -o -is -cmp -rp "BackUp" -x > "{TempFolder}UpdateScript"If "`Exists -d "{TempFolder}BackUp:"`"		{abEcho} "> Fixing Types/Creator	Execute "{MPW}Tools:FixTypes.mpt" "{TempFolder}BackUp:"		### Make the busy folder	If not `Exists -d "{abPath}busyFolder"`		Newfolder "{abPath}busyFolder"		{abEcho} "> busyFolder created"	End		### Do a Backup to check the diff.	Directory "{macBUPath}"	{abEcho} "> Pulling down the BuildScripts files"	Backup -r -a -c -from ":BuildScripts:" -to "{abPath}" -busy "{abPath}busyFolder" > "{macBUPath}UpdateResult"		Set 	number		`Count -l "{macBUPath}UpdateResult"`	Evaluate number += 0		If ( {number} > 0 )		Catenate "{macBUPath}UpdateResult"		Catenate "{macBUPath}UpdateResult" >> "{reportPath}abFinalReport"		{abEcho} "¶n### AB needs to update some files¶n"		Execute "{macBUPath}UpdateResult" > "{macBUPath}Updating"		Catenate "{macBUPath}Updating"		Catenate "{macBUPath}Updating" >> "{reportPath}abFinalReport"		{abEcho} ">>> The files have been updated"		{abEcho} "###### >>> You need to RESTART your build <<< ######"		Set UpdateErr 42	Else		{abEcho} "¶n> No files will be be updated, you already have the last scripts on your HD"		Set UpdateErr 0	End		Directory "{SavedDirectory}"	If {status} == 0 		{abEcho} "Saved Directory : {SavedDirectory}"	Else		{abEcho} "### A problem occured while changing the Directory proccess"	End		### Delete the backup directory	If "`Exists -d "{TempFolder}BackUp:"`"		Delete -y "{TempFolder}BackUp:"	EndElse	Set UpdateErr 0	If "`Exists -f "{TempFolder}UpdateScript"`"		Catenate "{TempFolder}UpdateScript"		Catenate "{TempFolder}UpdateScript" >> "{reportPath}abFinalReport"	Else		{abEcho} ">>> Update_Scripts found no UpdateScript file"	EndEndExit {UpdateErr}