######		WIPE BINARY######	synopsis :###		WIPEBINARY.mpw 1 2 {file2wipe}###Set WipeType	"{1}"if ({WipeType} == 1)	Set FileName	"{4}"else	if ("{2}" == "#")		Set FileName	"{5}"	else		Set FileName	"{4}".rom.rsrc	endend### Find the built binarySet 	here		`Whereis -s "{tdfx_builtPath}" -c "{FileName}"` ·· Dev:NullIf !"`Exists -f "{here}"`"		Whereis -s "{tdfx_builtPath}" -c "{FileName}" > "{reportPath}CWBuildSearch"	set fileNum "`count -l "{reportPath}CWBuildSearch"`"	if {fileNum} > 0		### there is more than ONE file with this name ...		### look for the last one ... the newer !		{abEcho} "# The AB found more than one file with the filename {FileName}"		Catenate "{reportPath}CWBuildSearch"				### Open CWBuildSearch		Open -t "{reportPath}CWBuildSearch"		set current 1		Find ¥ ; Replace -c ° /¶n/ " " "{reportPath}CWBuildSearch"		Save "{reportPath}CWBuildSearch"		Find ¥ ; Replace -c ° /¶'/ "¶¶¶"" "{reportPath}CWBuildSearch"		Save "{reportPath}CWBuildSearch"		Find 1		### find the newer		set resultat "`Catenate ¤`"		Delete -y {resultat}		Close -y "{reportPath}CWBuildSearch"			### Clean all temporary files		If "`Exists -f "{reportPath}CWBuildSearch"`"			Delete "{reportPath}CWBuildSearch" -y -i		End		{abEcho} "> Delete files : {FileName}"		Exit 0	Else		Echo "> There is no file named : {FileName}"		Exit 42	EndEndDelete -y "{here}"{abEcho} "> Delete file : {FileName}"	