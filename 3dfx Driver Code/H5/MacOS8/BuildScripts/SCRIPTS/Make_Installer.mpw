######		MAKE INSTALLER				######	synopsis :###		Make_Installer.mpw mi_filename###### make installer for filename version{abEcho} "¶n!`date -t`{BNS}MAKE INSTALLER"### Initialization ...{abEcho} "> Initialization¶n"Set		mifile			"{1}"Set		copyPath		"{MAKEVERSION}:"Set		sitCodec		"BinHex4"Set		creatorCodec	BNHQSet		ImageName		"{MAKEVERSION}"Set		blockNbr		10240Set		fileSystem		"Fhfs"Set		Zeroing			"true"Set		finderName		"Finder"Set		inwPos			"[100, 150]"Set		inwSize			"[300, 150]"Set		parts			"parts"Set		FlashRom		"FlashROM"Set		partsWPos		"[128, 355]"Set		flashWPos		"[221, 85]"Set		current 		1Set		ErrInstallMe	"{reportPath}ErrInstallMe"Set		InstallMePrj	"InstallerScript.prj"Set		InstallMeTarget	"{MAKEVERSION}"Set		FileName		"Voodoo for Macintosh Installer"Set	-e	makeErr			0Set		fileErr			0Set		rnFolder		"release_notes"Set		IMeWPos			"[128, 300]"Set		InstallerWPos	"[128, 85]"### Check for {KitsPath} folderIf !"`Exists -d "{KitsPath}"`"	NewFolder "{KitsPath}"	If {status} != 0		{abEcho} "{CCF}{KitsPath}"		{abEcho} "> Current Dir `Directory`"	EndEnd### Look for mounted Image (JUST IN CASE)If "`Exists "{ImageName}:"`"	{abEcho} "### A disk named {ImageName} is mounted"	{abEcho} "### Unmount it and relaunch the AB"	Exit 42End### Check for {KitsPath}{dayName}: folderSet	-e	KitsDayPath		"{KitsPath}{dayName}:"If !"`Exists -d "{KitsDayPath}"`"	NewFolder "{KitsDayPath}"	If !"`Exists -d "{KitsDayPath}"`"		{abEcho} "{CCF}{KitsDayPath}"		Exit 42	Else		{abEcho} "> Created new {dayName} folder¶n"	EndEnd		### Make the construction directorySet -e InstallPath			"{abPath}i_{MAKEVERSION}:"If "`Exists -d {InstallPath}`"	Delete -y {InstallPath}	If "{status}" == 0		{abEcho} "> Old {InstallPath} have been deleted"	Else		{abEcho} "### Could not delete {InstallPath}"		{abEcho} "> Current Directory `Directory`"	EndEndNewFolder {InstallPath}If {status} == 0	{abEcho} "> Created new {InstallPath} Folder"Else	{abEcho} "{CCF}{InstallPath}"	{abEcho} "> Current Directory `Directory`"End### Prepare InstallPath for the AE (remove quote)Echo "{InstallPath}" > {reportPath}temptempOpen -t {reportPath}temptempFind ¥ ; Replace -c ° /¶'/ "" {reportPath}temptempSave {reportPath}temptempFind 1 ; Set aeInstallPath "`Catenate ¤`"Close {reportPath}temptemp -yDelete {reportPath}temptemp### Lunch StuffIt Deluxe application{abEcho} "> Execute {sitName}"Execute "{sitPath}{sitName}"### Translate the ReleaseNotes filesSet rnPath		"`whereis -d -s "{tdfx_builtPath}" -c {rnFolder}`"If "`Exists -d {rnPath}:temp:`"	{abEcho} "> Delete old {rnPath}:temp: folder"	Delete -y {rnPath}:temp:End	{abEcho} "> Create new {rnPath}:temp: folder¶n"	NewFolder {rnPath}:temp:	For fName in `Files -f -c "{creatorCodec}" {rnPath}:{MAKEVERSION}:Å`	### Translate some files	{abEcho} "> Translate file : {fName} / using {sitCodec}"	Set res `SendAE -t "{sitName}" -e "SIT!TRAN" -----alis "{fName}" -trnmTEXT "{sitCodec}" -destTEXT {rnPath}:temp:` ·· Dev:NullEnd### Translate file installer:Installer.hqx{abEcho} "> Look for 'installer.hqx' file"Set		installHQX		"`whereis -s "{tdfx_builtPath}" -c "Installer.hqx"`"If ({installHQX} != "")	### Prepare installHQX for the AE (remove quote)	Echo "{installHQX}" > {reportPath}temptemp	Open -t {reportPath}temptemp	Find ¥ ; Replace -c ° /¶'/ "" {reportPath}temptemp	Save {reportPath}temptemp	Find 1 ; Set aeinstallHQX "`Catenate ¤`"	Close {reportPath}temptemp -y	Delete {reportPath}temptemp		{abEcho} "> Translate file : Installer.hqx / using {sitCodec}"	Set res `SendAE -t "{sitName}" -e "SIT!TRAN" -----alis "{aeinstallHQX}" -trnmTEXT "{sitCodec}" -destTEXT {InstallPath}` ·· {reportPath}abFinalReport	{abEcho} "> Installer.hqx file : Decoded"Else	{abEcho} "{FNF}Installer.hqx"	{abEcho} "### So can't Translate it !"	#Exit 42End### Quit StuffIt Deluxe{abEcho} "> Quit {sitName}"SendAE -t "{sitName}" -e aevtquit -dot### Lunch DiskCopy application{abEcho} "¶n> Execute {dcpyName}"Execute "{dcpyPath}{dcpyName}"### Create an Image{abEcho} "> Create a new Image name : {ImageName}"Set res "`SendAE -t "{dcpyName}" -e "ddskCrea" -----TEXT "{ImageName}" -SvAs "obj ¶{form:name, want:type(file), seld:Ò{aeInstallPath}{ImageName}Ó, from:'null'()¶}" -Blks {blockNbr} -Fsys {fileSystem} -Zero {Zeroing}`" # ·· {reportPath}abFinalReport### Quit Disk Copy{abEcho} "¶n> Quit {dcpyName}¶n"Set res "`SendAE -t "{dcpyName}" -e "aevtquit"`" #·· Dev:Null### Select the Image{abEcho} "> Clean up the folder"Set res "`SendAE -t "{finderName}" -e "miscslct" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}"`" ·· {reportPath}abFinalReport### Open the ImageSet res "`SendAE -t "{finderName}" -e "aevtodoc" ----- "obj ¶{form:prop, want:type(prop), seld:type(sele), from:'null'()¶}"`" ·· {reportPath}abFinalReport### Set the position on the screen of the Image windowSet res "`SendAE -t "{finderName}" -e "coresetd" ----- "obj ¶{form:prop, want:type(prop), seld:type(posn), from:obj ¶{form:prop, want:type(prop), seld:type(cwnd), from:obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}¶}¶}" -data "{inWPos}"`" ·· {reportPath}abFinalReport### Set the size of the Image windowSet res "`SendAE -t "{finderName}" -e "coresetd" ----- "obj ¶{form:prop, want:type(prop), seld:type(ptsz), from:obj ¶{form:prop, want:type(prop), seld:type(cwnd), from:obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}¶}¶}" -data "{inWSize}"`" ·· {reportPath}abFinalReport### Create the storage folderIf !"Exists {ImageName}"	{abEcho} "### Could not find Image {MAKEVERSION} !!!"		Exit 42End#NewFolder "{ImageName}:{parts}:" "{ImageName}:{FlashRom}:"NewFolder "{ImageName}:{parts}:"If {status} != 0	{abEcho} "{CCF}"{ImageName}:{parts}:" and/or "{ImageName}:{FlashRom}:""Else	{abEcho} "> Created new folders : 'parts' and 'FlashROM'"End### Set position of storage folder (parts and flashrom){abEcho} "> Clean up the new folders"Set res "`SendAE -t "{finderName}" -e "miscslct" ----- "obj ¶{form:name, want:type(cfol), seld:Ò{ImageName}:{parts}Ó, from:'null'()¶}"`" Set res "`SendAE -t "{finderName}" -e "coresetd" ----- "obj ¶{form:prop, want:type(prop), seld:type(posn), from:obj ¶{form:prop, want:type(prop), seld:type(sele), from:'null'()¶}¶}" -data "{partsWPos}"`" #Set res "`SendAE -t "{finderName}" -e "miscslct" ----- "obj ¶{form:name, want:type(cfol), seld:Ò{ImageName}:{flashRom}Ó, from:'null'()¶}"`" #Set res "`SendAE -t "{finderName}" -e "coresetd" ----- "obj ¶{form:prop, want:type(prop), seld:type(posn), from:obj ¶{form:prop, want:type(prop), seld:type(sele), from:'null'()¶}¶}" -data "{flashWPos}"`" ### Copy all the necessary binaries{abEcho} "¶n> Copy all the necessary binaries"{abEcho} "> mifiles : {mifile}"### Check if mi_filename existsIf "`Exists -f {mifile}`"	Set fileNum 	`count -l {mifile}`Else	{abEcho} "{FNF}{mifile}"	### Unmount Image	{abEcho} "> Unmount volume : {ImageName}¶n"	SendAE -t "{finderName}" -e "coredelo" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}" ·· {reportPath}abFinalReport	Exit 42End### Exit if no files to gatherIf ({fileNum} == 0)	{abEcho} "{FIE}{mifile}"	#ExitEnd### Open cwfilesOpen -r -t {mifile}### Loop on each line of the mifilesLoop	Find {current}		Set currProject "`Catenate ¤`"		### Call the FileToCopy script	({scriptsPath}FileToCopy.mpw "{copyPath}" {currProject})    Evaluate fileErr += {status}		Evaluate current+=1    Break If {current} > {fileNum}End # >>Dev:StdErrClose {mifile} -y# ### Look for some .rom files#{abEcho} "¶n> Check for the ROMs"#If "`Exists -f {reportPath}RomFiles`"#	Set current 1#	Set fileNum 	`count -l {reportPath}RomFiles`#	#	### "Exit" if no files to gather#	If ({fileNum} == 0)#		{abEcho} "{FIE}{reportPath}RomFiles"#		#Exit#	End#	### Open cwfiles#	Open -r -t {reportPath}RomFiles#	#	### Loop on each line of the cwfiles#	Loop#		Find {current}#		#		Set currProject "`Catenate ¤`"#		### Call the FileToCopy script#		({scriptsPath}FileToCopy.mpw "{copyPath}" {currProject})#		Evaluate fileErr += {status}#		#		Evaluate current+=1#		Break If {current} > {fileNum}#	End # >>Dev:StdErr#	#	Close {reportPath}RomFiles -y#Else#	{abEcho} "¶n{FNF}{reportPath}RomFiles"#	{abEcho} ">>> No .rom files have been created in this build¶n"#End### Check if all the files have been copiedIf ( {fileErr} > 0)	{abEcho} "### {fileErr} file(s) have not been copied into the {ImageName} Image"	### Unmount Image	{abEcho} "> Unmount volume : {ImageName}¶n"	SendAE -t "{finderName}" -e "coredelo" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}" ·· {reportPath}abFinalReport		Exit {fileErr}Else	{abEcho} "> All files have been copied"End### Bind the installer script{abEcho} "¶n> Make the Install Me file"{abEcho} "> Find {InstallMePrj} file"Set		imPath			"`Whereis  -s "{tdfx_builtPath}" -c "{InstallMePrj}"`"### Get the directory name from the file's full path name.(Evaluate "{imPath}" =~ /¶'*(([Â:]*:)+)¨1[Â:]*/ ) ·· Dev:Null Set		imPath			"{¨1}"# Set the path to {MPW}Directory "{MPW}"# Run CodeWarrior{abEcho} "> Execute {cwName}¶n""{CWPath}{cwName}"# Close all opened projectsLoop	Set res "`SendAE -t "{cwName}" -e MMPRClsP  -dot`"	Break If "{res}" != ""End### Clean ErrWarnMsgEcho "" > {reportPath}ErrWarnMsg### Load CWBuild({scriptsPath}CWBuild.mpw "{imPath}{InstallMePrj}" "{InstallMeTarget}" "{FileName}")Set imErr	{status}### Quit CodeWarrior{abEcho} "> Quit {cwName}"SendAE -t "{cwName}" -e aevtquit -dot### Rename the compilation information fileRename {reportPath}ErrWarnMsg {ErrInstallMe} -yIf ( {imErr} != 0 )	{abEcho} "{FNF}{FileName}"	### Unmount Image	{abEcho} "> Unmount volume : {ImageName}¶n"	SendAE -t "{finderName}" -e "coredelo" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}" ·· {reportPath}abFinalReport		Exit {imErr}End### Look for 'Install Me' fileSet 	here		`Whereis -s "{tdfx_builtPath}" -c "{FileName}"` ·· {reportPath}abFinalReportIf ( "{here}" != "" )	{abEcho} "> File {FileName} has been located"Else	{abEcho} "{FNF}{FileName}"	### Unmount Image	{abEcho} "> Unmount volume : {ImageName}¶n"	SendAE -t "{finderName}" -e "coredelo" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}" ·· {reportPath}abFinalReport		Exit 42End{abEcho} "¶n> Move and Set position for the 'Install Me' file"Move -y "{here}" "{ImageName}:"If ({status} == 0)	### Put file to X and Y position in the folder ...	Set res "`SendAE -t "{finderName}" -e "miscslct" ----- "obj ¶{form:name, want:type(file), seld:Ò{ImageName}:{FileName}Ó, from:'null'()¶}"`" 	Set res "`SendAE -t "{finderName}" -e "coresetd" ----- "obj ¶{form:prop, want:type(prop), seld:type(posn), from:obj ¶{form:prop, want:type(prop), seld:type(sele), from:'null'()¶}¶}" -data "{IMeWPos}"`" ·· {reportPath}abFinalReportElse	{abEcho} "{CCF}{ImageName}:{FileName}"	### Unmount Image	{abEcho} "> Unmount volume : {ImageName}¶n"	SendAE -t "{finderName}" -e "coredelo" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}" ·· {reportPath}abFinalReport		Exit 42End{abEcho} "> Move and Set position for the 'Installer' file"If "`Exists -f {InstallPath}Installer`"		Move -y {InstallPath}Installer "{ImageName}:"	### Put file to X and Y position in the folder ...	Set res "`SendAE -t "{finderName}" -e "miscslct" ----- "obj ¶{form:name, want:type(file), seld:Ò{ImageName}:InstallerÓ, from:'null'()¶}"`" 	Set res "`SendAE -t "{finderName}" -e "coresetd" ----- "obj ¶{form:prop, want:type(prop), seld:type(posn), from:obj ¶{form:prop, want:type(prop), seld:type(sele), from:'null'()¶}¶}" -data "{InstallerWPos}"`" ·· {reportPath}abFinalReportElse	{abEcho} "{FNF}{InstallPath}Installer"	### Unmount Image	{abEcho} "> Unmount volume : {ImageName}¶n"	SendAE -t "{finderName}" -e "coredelo" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}" ·· {reportPath}abFinalReport		Exit 42End### Do a ScriptCheckIf !"`Exists -f "{ImageName}:{FileName}"`"	{abEcho} "{FNF}{ImageName}:{FileName}"	### Unmount Image	{abEcho} "> Unmount volume : {ImageName}¶n"	SendAE -t "{finderName}" -e "coredelo" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}" ·· {reportPath}abFinalReport		Exit 42End{abEcho} "¶n> ScriptCheck file : {ImageName}:{FileName}"("{MPW}"Tools:ScriptCheck.mpt "{ImageName}:{FileName}") ·· {reportPath}scheckCatenate {reportPath}scheckCatenate {reportPath}abFinalReport {reportPath}scheck > {reportPath}newabFRRename -y {reportPath}newabFR {reportPath}abFinalReportSearch -q -w /Error/ {reportPath}scheckSet response {status}Delete -y {reportPath}scheckIf {response} == 0	{abEcho} "### ScriptCheck report found Error(s)"	### Unmount Image	{abEcho} "> Unmount volume : {ImageName}¶n"	SendAE -t "{finderName}" -e "coredelo" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}" ·· {reportPath}abFinalReport		Exit 42Else	{abEcho} "> No "Error" found in the ScriptCheck report¶n"End### Lunch DiskCopy application{abEcho} "¶n> Execute {dcpyName}"Execute "{dcpyPath}{dcpyName}"### Check Image{abEcho} "> Make {dcpyName} Check Image on {ImageName}"SendAE -t "{dcpyName}" -e "ddskChek" -----alis "{aeInstallPath}{ImageName}" > {reportPath}chkimgCatenate {reportPath}chkimgCatenate {reportPath}abFinalReport {reportPath}chkimg > {reportPath}newabFRRename -y {reportPath}newabFR {reportPath}abFinalReportSearch -q -w /appears to be OK./ {reportPath}chkimgSet response {status}Delete -y {reportPath}chkimgIf {response} != 0	### Quit Disk Copy	{abEcho} "¶n> Quit {dcpyName}¶n"	Set res "`SendAE -t "{dcpyName}" -e "aevtquit"`" ·· Dev:Null	### Unmount Image	{abEcho} "> Unmount volume : {ImageName}¶n"	SendAE -t "{finderName}" -e "coredelo" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}" ·· {reportPath}abFinalReport		Exit 42End### Unmount Image{abEcho} "> Unmount volume : {ImageName}¶n"SendAE -t "{finderName}" -e "coredelo" ----- "obj ¶{form:name, want:type(cdis), seld:Ò{ImageName}Ó, from:'null'()¶}" ·· {reportPath}abFinalReport	### Create SMI file{abEcho} "> Create {ImageName}.SMI file"ECHO AEINSTALLPATH {aeInstallPath}ECHO install {InstallPath}ECHO SendAE -t "{dcpyName}" -e "ddskMSMI" ----- Ò{aeInstallPath}{ImageName}.smiÓ -SMI1alis {InstallPath}{ImageName} -VChk true > {reportPath}smiSendAE -t "{dcpyName}" -e "ddskMSMI" ----- Ò{aeInstallPath}{ImageName}.smiÓ -SMI1alis {InstallPath}{ImageName} -VChk true > {reportPath}smiCatenate {reportPath}smiCatenate {reportPath}abFinalReport {reportPath}smi > {reportPath}newabFRRename -y {reportPath}newabFR {reportPath}abFinalReportDelete -y {reportPath}smi### Quit Disk Copy{abEcho} "¶n> Quit {dcpyName}¶n"Set res "`SendAE -t "{dcpyName}" -e "aevtquit"`" ·· Dev:NullIf !"`Exists -f {InstallPath}{ImageName}.smi`"	{abEcho} "{FNF}{InstallPath}{ImageName}.smi"	Exit 42End### Lunch StuffIt Deluxe application{abEcho} "¶n> Execute {sitName}"Execute "{sitPath}{sitName}"### Create the Self Extract Archive file{abEcho} "> Create Archive"Set sitHdl "`SendAE -t "{sitName}" -e "corecrel" -kocl "type(Arc )" -prdt "¶{fPth:Ò{aeInstallPath}{ImageName}.seaÓ¶}"`"### Gather the handle for sending the mail{abEcho} "> Make archive ¶'self-extracting¶'"(Evaluate "{sitHdl}" =~ /Åseld:([0-9]+)¨1[¶}]/) ·· Dev:NullSet sitHdl "{¨1}"{abEcho} "> sitHandle ¶'{sitHdl}¶'"SendAE -t "{sitName}" -e "coresetd" ----- "obj ¶{form:prop, want:type(prop), seld:type(self), from:obj ¶{form:indx, want:type(Arc ), seld:{sitHdl}, from:'null'()¶}¶}" -data "true" ·· {reportPath}abFinalReport{abEcho} "> Stuff the {ImageName}.smi into the archive"SendAE -t "{sitName}" -e "SIT!STUF" -----alis "{aeInstallPath}{ImageName}.smi" -repl true #-into "obj ¶{want:type('Arc '), from:'null'(), form:'indx', seld:1¶}"### Quit StuffIt Deluxe{abEcho} "> Quit {sitName}"SendAE -t "{sitName}" -e aevtquit -dot### Check if SEA is present (ie make install SUCCEED !)If !"`Exists -f {InstallPath}{ImageName}.sea`"	{abEcho} "{FNF}{InstallPath}{ImageName}.sea"	Exit 42Else	### Check if there is an old i_{MAKEVERSION}.FAILED folder	If "`Exists -d "{KitsDayPath}{MAKEVERSION}.FAILED"`"		Delete -y "{KitsDayPath}{MAKEVERSION}.FAILED"	End		### Copy the sea file in the {KitsDayPath}	{abEcho} "> Copy archive {InstallPath}{ImageName}.sea to {KitsDayPath} folder"	Move -y {InstallPath}{ImageName}.sea "{KitsDayPath}{ImageName}.sea"	If "{status}" != 0 		{abEcho} "### Error occured while copying the file {ImageName}.sea"		Exit 42	End		### Clean up (delete the construct folder)	If "`Exists -d {InstallPath}`"		Delete -y {InstallPath}		If "{status}" != 0			{abEcho} "### Could not delete folder : {InstallPath}"			Exit 42		Else			{abEcho} "> Deleted {InstallPath} folder"		End	Else		{abEcho} "### Could not delete folder {InstallPath} because ... mmh ..."		{abEcho} "### ... we do not know where it is"		Exit	EndEnd### Clean the mess{abEcho} "`Date -t`{ENS}PULLDOWN ALL"