######		MAKE ARCHIVE			######	synopsis :###		Make_Archive###### create a new dir in BD:Archive folder and copy last build ...### create folder BD:Archives{abEcho} "¶n!`date -t`{BNS}MAKE ARCHIVE"If !"`Exists -d "{bdPath}Archives:"`"	NewFolder "{bdPath}Archives:"	If ({status} == 0)		{abEcho} "> Created new ¶'{bdPath}Archives¶' folder"			Else		{abEcho} "{CCF}{bdPath}Archives"		{abEcho} "> Current dir : `Directory`"	EndEnd### make the archive{abEcho} "> Archive target ¶'{MAKEVERSION}¶' /  ¶'{report}¶'"set result 0NewFolder "{bdPath}Archives:{MAKEVERSION}_{report}:"If ("{status}" != 0)	{abEcho} "{CCF}{bdPath}Archives:{MAKEVERSION}_{report}:"	{abEcho} "### No Archive Folder will be created"	Exit 42EndDuplicate -y "{bdPath}{reportDay}:I_{MAKEVERSION}" "{bdPath}Archives:{MAKEVERSION}_{report}:I_{MAKEVERSION}"Evaluate resultat += {status}Duplicate -y "{bdPath}{reportDay}:N_{MAKEVERSION}" "{bdPath}Archives:{MAKEVERSION}_{report}:N_{MAKEVERSION}"Evaluate resultat += {status}Duplicate -y "{reportPath}" "{bdPath}Archives:{MAKEVERSION}_{report}:reports"Evaluate resultat += {status}If ({resultat} > 0)	{abEcho} "### Error : Could not make the archive properly"	Exit 42End#"{sitPath}{sitName}"#SendAE -t "{sitName}" -e "SIT!TRAN" -----alis "{bdPath}:{reportDay}:" -trnmTEXT "{sitCodec}" -encd "true" -destTEXT "{bdPath}:Archives:{MAKEVERSION}_{reportDay}"#SendAE -t "{sitName}" -e aevtquit -dot{abEcho} "`Date -t`{ENS}MAKE ARCHIVE"