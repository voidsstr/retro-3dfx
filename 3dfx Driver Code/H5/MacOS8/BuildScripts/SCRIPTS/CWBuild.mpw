###### Build CW target###### synopsis :### 	CWBuild.mpw ProjectFile Target FileName###### Call CW to build ProjectFile w/ Target and compiled FileName### InitializationSet		ProjectFile 	"{1}"Set		TargetName		"{2}"Set		FileName		"{3}"Set		Timeout			108000 # 30 minutes in ticks	Set		ErrWarnFile		"{reportPath}ErrWarnMsg"Set		tempfile		"{reportPath}corefile"Set		headerfile		"{reportPath}headerfile"Set		makeErr			0### DEBUG VARIABLES#Set		CWPath			":::CodeWarrior Pro 5:Metrowerks CodeWarrior:CodeWarrior IDE 4.0"#Set		cwName			"CodeWarrior IDE 4.0"#Set		ProjectFile 	"Goinfre:3dfx_built:devel:h3:MacOS8:hardware_resource_manager:hrdw_res_mgr.prj"#Set		TargetName		"release"#Set 	tAEBuild	 	"obj ¶{want:type(PRJD)}"### Store informations in the header fileEcho "¶n¶n___________________________________________________________________________" >> {ErrWarnFile}Echo "> Building Project : {ProjectFile}" > {headerfile}Echo "> With target : {TargetName}" >> {headerfile}Echo "> FileName : {FileName}" >> {headerfile} ### Find ProjectFileSet 	pathProjectFile	"`Whereis -s "{tdfx_builtPath}" -c {ProjectFile}`"(Evaluate "{pathProjectFile}" =~ /¶'*(([Â:]*:)+)¨1[Â:]*/ ) · Dev:Null Set		pathProjectFile			"{¨1}"# Open the project to build{abEcho} "> Open project : {ProjectFile}"Set res 	`SendAE -t "{cwName}" -e aevtodoc -----alis "{pathProjectFile}{ProjectFile}"` ·· {ErrWarnFile} # Select the targetIf "{TargetName}" != ""	{abEcho} "> Select target : {TargetName}"	Set res	`SendAE -t "{cwName}" -e MMPRSTrg -----TEXT "{TargetName}"` ·· {ErrWarnFile}Else	{abEcho} "> Select target : ¶"DEFAULT¶""End ### Remove binary object code from project{abEcho} "> Remove all binary object code"Set res		`SendAE -t "{cwName}" -e MMPRRemB` ·· {ErrWarnFile}### Build the project{abEcho} "> Build the current project"Set res		`SendAE -timeout {Timeout} -t "{cwName}" -e MMPRMake` ·· {ErrWarnFile} ### Create tempfile to store errors & warningsEcho "" > {tempfile} ### Save the Errors and Warnings window in a file{abEcho} "> Log Errors & Warnings"Set res		`SendAE -t "{cwName}" -e MMPRSvMs -----alis {tempfile}` ·· {ErrWarnFile} ### Close the current project{abEcho} "> Close the current project"Set res		`SendAE -t "{cwName}" -e MMPRClsP` ·· {ErrWarnFile}### Catenate all filesCatenate {headerfile} {tempfile} >> {ErrWarnFile}Echo ">>> {ProjectFile} : FINISHED¶n" >> {ErrWarnFile}### Find the built binarySet 	here		`Whereis -s "{tdfx_builtPath}" -c "{FileName}"` ·· {ErrWarnFile}If !"`Exists -f "{here}"`"		Whereis -s "{tdfx_builtPath}" -c "{FileName}" > "{reportPath}CWBuildSearch"	set fileNum "`count -l "{reportPath}CWBuildSearch"`"	if {fileNum} > 0		### there is more than ONE file with this name ...		### look for the last one ... the newer !		{abEcho} "# The AB found more than one file with the filename {FileName}"		Catenate "{reportPath}CWBuildSearch"				### Open CWBuildSearch		Open -t "{reportPath}CWBuildSearch"		set current 1		Find ¥ ; Replace -c ° /¶n/ " " "{reportPath}CWBuildSearch"		Save "{reportPath}CWBuildSearch"		Find ¥ ; Replace -c ° /¶'/ "¶¶¶"" "{reportPath}CWBuildSearch"		Save "{reportPath}CWBuildSearch"		Find 1		### find the newer		set resultat "`Catenate ¤`"		set here "`Newer {resultat}`"		{abEcho} "> Here is the newest file : {here}"		Close -y "{reportPath}CWBuildSearch"		Echo " >>>> Binary file created : {FileName} <<<<" >> {ErrWarnFile}		{abEcho} " >>> Compilation succeed"		### Clean all temporary files		{abEcho} "> Clean\Purge temp files¶n"		If "`Exists -f {tempfile}`"			Delete {tempfile} -y -i		End		If "`Exists -f {headerfile}`"			Delete {headerfile} -y -i		End		If "`Exists -f "{reportPath}CWBuildSearch"`"			Delete "{reportPath}CWBuildSearch" -y -i		End		Exit {makeErr}	Else		Echo "> There is no file named : {FileName}"	EndEndecho If !"`Exists -f "{here}"`"	Echo " ###############################################################" >> {ErrWarnFile}	Echo " ### COULD NOT FIND BINARY FILE : {FileName}" >> {ErrWarnFile}	Echo " ###############################################################" >> {ErrWarnFile}	{abEcho} "{FNF}{FileName}"	{abEcho} "### Compilation failed"	Evaluate makeErr +=1Else	Echo " >>>> Binary file created : {FileName} <<<<" >> {ErrWarnFile}	{abEcho} " >>> Compilation succeed"End### Clean all temporary files{abEcho} "> Clean\Purge temp files¶n"If "`Exists -f {tempfile}`"	Delete {tempfile} -y -iEndIf "`Exists -f {headerfile}`"	Delete {headerfile} -y -iEndIf "`Exists -f "{reportPath}CWBuildSearch"`"	Delete "{reportPath}CWBuildSearch" -y -iEndExit {makeErr}