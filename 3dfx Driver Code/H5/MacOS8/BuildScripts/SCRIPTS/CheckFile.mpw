######		CHECKFILE							###### synopsis :###		CheckFile filenamePath### ### Check filename is installed on the computer (take relative path starting at {MPW})### Return true/false### InitSet		filename		"{1}"Set		saveddir		`directory`Directory {MPW}Echo "> CheckFile : {filename}"If !"`Exists -f {filename}`"	Directory {saveddir}	Echo "### File "{filename}" not found"	Exit {FALSE}Else	Directory {saveddir}	Exit {TRUE}End