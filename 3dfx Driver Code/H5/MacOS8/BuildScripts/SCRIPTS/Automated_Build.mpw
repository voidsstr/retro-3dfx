######		AUTOMATED BUILD######	synopsis :###		Automated_Build.mpw [-p] versionfilename###### Don't exit program on error.Set 	Exit 			0Export Exit### Provide error detection.Set 	TraceFailures 	1Export TraceFailures### Init abresSet -e ABRes 0Set ParamErr 0### Compilation name and Opt ParamIf "{1}" == "-p"	Set -e	MAKEVERSION	"{2}"	Set NoPD	1Else If "{2}" == ""	Set -e	MAKEVERSION	"{1}"	Set	NoPD	0Else	Set ParamErr	1	Set -e MAKEVERSION "{2}"End### Save AB:SCRIPTS directorySet 	OriginalDir 	`Directory`Set		sitCodec		"BinHex4"### Set abPath variableDirectory ::Set -e	abPath 			"`Directory`"Set	-e	delivPath		"{abPath}delivrable_specs:{MAKEVERSION}:"Set	-e	scriptsPath		"{abPath}scripts:"Set	-e	abtoolsPath		"{abPath}essential_tools:"### Make report folderSet -e ABFullDate		"`Date -n`"Set 	¨1				""Set 	¨2 				""Set 	¨3 				""### Prepare Date VariablesSet 	reportDay 		"`Date -c {ABFullDate} -d -s`"(Evaluate "{reportDay}" =~ /([0-9]+)¨1[¶/]([0-9]+)¨2[¶/]([0-9]+)¨3/) ·· Dev:NullIf ( {¨1} < 10 )	Set	DD "0{¨1}"Else	Set	DD "{¨1}"EndIf ( {¨2} < 10 )	Set	MM "0{¨2}"Else	Set	MM "{¨2}"EndIf "{¨1}" == ""	Set DD "00"EndIf "{¨2}" == ""	Set MM "00"EndIf "{¨3}" == ""	Set YYYY "0000"Else	Set YYYY "{¨3}"EndSet -e	reportDay		"{DD}-{MM}-{YYYY}"### Pick the name of the daySet -e 	dayName			"`Date -c {ABFullDate} -d`"(Evaluate "{dayName}" =~ /([a-z]+)¨1[Â' ']Å/) ·· Dev:NullSet		dayName			"{¨1}"If {dayName} == "{DD}"	set dayName 	"UnknowDay"End### Prepare Time VariablesSet 	reportTime "`Date -c {ABFullDate} -t -u`"(Evaluate "{reportTime}" =~ /([0-9]+)¨1[¶:]([0-9]+)¨2[¶:]Å/)  ·· Dev:NullIf ( "{¨1}" < 10 )	Set	HH "0{¨1}"Else	Set	HH "{¨1}"EndIf ( "{¨2}" < 10 )	Set	MM "0{¨2}"Else	Set	MM "{¨2}"EndSet 	reportTime		"{HH}{MM}"Set	-e	report				"{reportDay}.{reportTime}"Set	-e	reportPath			"{abPath}{MAKEVERSION}_{report}:"### Check for reportPathIf "`Exists -d {reportPath}`"	Delete -y {reportPath}Else	Echo "No old report folder to delete"EndNewFolder {reportPath}If ( {status} != 0 )	Echo "### Could not create report folder"	Echo "### Could not create report folder" >> {abPath}abFinalReport	Echo "> Current directory `Directory`"	Echo "> Current directory `Directory`" >> {abPath}abFinalReportEnd### Function VariableIf "`Exists -f {scriptsPath}abEcho.mpw`"	Set	-e	abEcho			"{scriptsPath}abEcho.mpw"Else	Echo "### Could not find file : scripts/abEcho.mpw"	Evaluate ABRes += 1 #Exit 42EndIf ({ParamErr} == 1)	{abEcho} "¶n### WARNING : ¶"{1}¶" Unknown Option - [Targetname : "{MAKEVERSION}"]¶n"End### source abVerbose fileIf "`Exists -f {scriptsPath}abVerbose.mpw`"	Execute {scriptsPath}abVerbose.mpwElse	{abEcho} "### Could not source abVerbose.mpw file"	{abEcho} "### Some errors/warnings/messages may not be display"End{abEcho} "#`Date -t`{BAB}AUTOMATED BUILT"{abEcho} "> Date : `date -D`"Echo "> Initialization"Echo "ABRes [{ABRes}]"### Files name initSet	-e	abExt		".ab"Set		vh_sfiles	"vh_sfiles.ab"Set		vh_cfiles	"vh_cfiles.ab"Set		pd_all		"pd_all"Set 	cw_all		"cw_all"Set		zero		0Set		returnValue	0Set -e	TRUE		0Set -e	FALSE		1### Validate_Host filesSet 	vhsfiles		"{abPath}{vh_sfiles}"Set		vhcfiles		"{abPath}{vh_cfiles}"### Path and Name of the final folderIf ( "{MAKEVERSION}" == "" )	{abEcho} "{NEP}"	{abEcho} "# Usage - Automated_Built Target"	Evaluate ABRes += 1 #Exit 42End### Pulldown/CWBuild fileIf "`Exists -f {delivPath}pd_{MAKEVERSION}{abExt}`"	Set		pdfile "{delivPath}pd_{MAKEVERSION}{abExt}"	{abEcho} "> Built Version : {MAKEVERSION}{abExt}"Else	{abEcho} "{FNF}{delivPath}pd_{MAKEVERSION}{abExt}"	{abEcho} "¶n### The file is missing or the target ¶'{MAKEVERSION}¶' does not exist !¶n"	Evaluate ABRes += 1 #Exit 42End### Compile_All fileIf "`Exists -f {delivPath}cw_{MAKEVERSION}{abExt}`"	Set cwfile "{delivPath}cw_{MAKEVERSION}{abExt}"Else	{abEcho} "{FNF}{delivPath}cw_{MAKEVERSION}{abExt}"	Evaluate ABRes += 1 #Exit 42End	###	Gather_all fileIf "`Exists -f {delivPath}ga_{MAKEVERSION}{abExt}`"	Set gafile "{delivPath}ga_{MAKEVERSION}{abExt}"Else	{abEcho} "{FNF}{delivPath}ga_{MAKEVERSION}{abExt}"	Evaluate ABRes += 1 #Exit 42End### Make_ROM fileIf "`Exists -f {delivPath}mr_{MAKEVERSION}{abExt}`"	Set mrfile "{delivPath}mr_{MAKEVERSION}{abExt}"Else	{abEcho} "{FNF}{delivPath}mr_{MAKEVERSION}{abExt}"	Evaluate ABRes += 1 #Exit 42End### Make_Installer fileIf "`Exists -f {delivPath}mi_{MAKEVERSION}{abExt}`"	Set mifile "{delivPath}mi_{MAKEVERSION}{abExt}"Else	{abEcho} "{FNF}{delivPath}mi_{MAKEVERSION}{abExt}"	Evaluate ABRes += 1 #Exit 42End### Set New Directory{abEcho} "> Set Directory to {MPW}"Directory "{MPW}"### Check for ab¥startup {abEcho} "> Checking ab¥startup file"If !"`Exists -f "{MPW}"Startup Items:ab¥startup`"	{abEcho} "{FNF}ab¥startup"	Evaluate ABRes += 1 #Exit 42Else	Evaluate startupFlag = {startupFlag} + 0	If {startupFlag} == 0		{abEcho} "### The file ab¥startup have not been sourced by the MPW Shell"		{abEcho} "### Please restart your MPW Shell"		Evaluate ABRes += 1 #Exit 42	EndEnd### Check if the retry number is coherentIf ({pdRetry} < 1)	Echo "{IPN}({pdRetry})"	Evaluate ABRes += 1 #Exit 42End######################################## Execute scripts ...If ({ABRes} == 0)   Execute 	({scriptsPath}Validate_Host.mpw "{vhsfiles}" "{vhcfiles}")   Set	vaRes	"{status}"   If ({vaRes} != 0)	   {abEcho} "###>>> script Validate_Host did not end properly <<<###"   Else # vaRes test	      	### Check if the "-p" Option selected	If ({NoPD} == 0 )	   Execute 	({scriptsPath}Clean_All.mpw "{tdfx_builtPath}")	   If ({status} != 0)		   {abEcho} "###>>> script Clean_All did not end properly <<<###"		   Evaluate ABRes += 1	   End	   	   Execute 	({scriptsPath}Pulldown.mpw "{pdfile}")	   If ({status} != 0)		   {abEcho} "###>>> script Pulldown did not end properly <<<###"		   Evaluate ABRes += 1	   End   	Else		{abEcho} "¶n#> No CleanAll/PullDown will be done in this build (-p)"		{abEcho} "#> However, all previous binaries will be wiped !"		({scriptsPath}Moins_P.mpw 1 "{cwfile}")		({scriptsPath}Moins_P.mpw 2 "{mrfile}")	End	   	Execute		({scriptsPath}Generated_Headers.mpw)   	If ({status} != 0)   		{abEcho} "###>>> script Generated_Headers did not end properly <<<###"   		Evaluate ABRes += 1   	End   	   	Execute		({scriptsPath}Compile_All.mpw "{cwfile}")    	If ( {status} > 0)   		{abEcho} "###>>> script Compile_All did not end properly <<<###"   		Evaluate ABRes += 1   	End   	Execute 	({scriptsPath}Make_ROM.mpw "{mrfile}")	If ( {status} > 0)		{abEcho} "###>>> script Make_ROM did not end properly <<<###"		Evaluate ABRes += 1	End	   	Execute		({scriptsPath}Gather_all.mpw "{gafile}")	If ( {status} > 0)		Evaluate ABRes += 1		{abEcho} "###>>> script Gather_all did not end properly <<<###"		### Need to move/rename the folder {abPath}c_{MAKEVERSION}: in the correct place		{abEcho} "> Move¶/Rename folder {abPath}c_{MAKEVERSION}: in {CompPath}{dayName}:{MAKEVERSION}.FAILED Folder"		If (("`Exists -d {abPath}c_{MAKEVERSION}:`") && ("`Exists -d "{CompPath}{dayName}:"`"))			Rename -y {abPath}c_{MAKEVERSION}: {abPath}{MAKEVERSION}.FAILED:			Move -y {abPath}{MAKEVERSION}.FAILED: "{CompPath}{dayName}:"			If {status} != 0				{abEcho} "### An error occured while moving¶/renaming {abPath}c_{MAKEVERSION}: - {CompPath}{dayName}:{MAKEVERSION}.FAILED"			Else				Set	failedFolder	"{CompPath}{dayName}:{MAKEVERSION}.FAILED:"			End		Else			{abEcho} "### Could not find {abPath}c_{MAKEVERSION}: and¶/or {CompPath}{dayName}:"		End	Else		Set failedFolder "{CompPath}{dayName}:{MAKEVERSION}:"	End   	Execute		({scriptsPath}Make_Installer.mpw "{mifile}")	If ( {status} > 0)		Evaluate ABRes += 1		{abEcho} "###>>> script Make_Installer did not end properly <<<###"		### Need to move/rename the folder {abPath}i_{MAKEVERSION}: in the correct place		{abEcho} "> Move¶/Rename folder {abPath}i_{MAKEVERSION}: in {KitsPath}{dayName}:{MAKEVERSION}.FAILED Folder"		If (("`Exists -d "{abPath}i_{MAKEVERSION}:"`") && ("`Exists -d "{KitsPath}{dayName}:"`"))			Rename -y "{abPath}i_{MAKEVERSION}:" "{abPath}{MAKEVERSION}.FAILED:"			Move -y "{abPath}{MAKEVERSION}.FAILED:" "{KitsPath}{dayName}:"			If {status} != 0				{abEcho} "### An error occured while moving¶/renaming {abPath}i_{MAKEVERSION}: - {KitsPath}{dayName}:{MAKEVERSION}.FAILED"			End		Else			{abEcho} "### Could not find {abPath}i_{MAKEVERSION}: and¶/or {KitsPath}{dayName}:"		End	End      	### Move the reports to the compenents:day:MAKEVERSION folder ...	{abEcho} "¶n> Move the report folder {MAKEVERSION}_{report}"	If (("`Exists -d "{reportPath}"`") && ("`Exists -d "{failedFolder}"`"))		Move -y "{reportPath}" "{failedFolder}"		If {status} != 0			{abEcho} "### An error occured while moving {MAKEVERSION}_{report} in {failedFolder}"			Evaluate ABRes += 1		Else			Set -e  reportPath	"{failedFolder}{MAKEVERSION}_{report}:"			{abEcho} "> Set the new '{reportPath}' path to {failedFolder}{MAKEVERSION}_{report}:"		End	Else		{abEcho} "### Could not find {reportPath} and/or {CompPath}{dayName}:"		Evaluate ABRes += 1	End   End #vaRes testEnd{abEcho} "¶n¶n>>> you can find all the reports in {reportPath} <<<"Evaluate ABRes += {vaRes} + 0If ({ABRes} == 0)	Set abPriority		"!nrm"Else	Set abPriority		"!hgh"EndExecute		("{scriptsPath}SendMail.mpw" "{abPriority}")######################################## Clean up diff things### Check for the RomFilesIf "`Exists -f "{reportPath}RomFiles"`"	Delete -y "{reportPath}RomFiles"EndIf "`Exists -f "{reportPath}ErrWarnMsg"`"	Delete -y "{reportPath}ErrWarnMsg"End### Check password.txt file has been deleted ...Set 	pwd		"`Whereis -s {tdfx_builtPath} -c "password.txt"`"If ({pwd} != "")	Delete -y -i "{pwd}"EndDirectory {OriginalDir}{abEcho} "> Date : `Date -d`"{abEcho} "#`Date -t`{EAB}AUTOMATED BUILT"