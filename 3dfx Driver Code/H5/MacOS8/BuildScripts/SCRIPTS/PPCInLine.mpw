######		PPCINLINE				######	synopsis :###		PPCInLine.mpw###### Compile/Run 3DFXGLIDELIB3X.PRJ with PPCInLine target{abEcho} "¶n> PPCInLine"### Initialization#Set		CWPath			":::CodeWarrior Pro 5:Metrowerks CodeWarrior:CodeWarrior IDE 4.0"#Set		cwName			"CodeWarrior IDE 4.0"Set		ErrPPCInLine	"{reportPath}ErrPPCInLine"Set		ppcProject		"3DFXGLIDELIB3X.PRJ"Set		ppcTarget		"PPCInLine"Set		FileName		"PPCInLine"Set	-e	makeErr			0### DEBUG VARIABLES### Find gendate.c file{abEcho} "> Find {ppcProject} file"Set		ppcPath			"`Whereis  -s "{tdfx_builtPath}" -c "{ppcProject}"`"### Get the directory name from the file's full path name.(Evaluate "{ppcPath}" =~ /¶'*(([Â:]*:)+)¨1[Â:]*/ ) · Dev:Null Set		ppcPath			"{¨1}"If "`Exists -d "{ppcPath}"`"	# Set the path to {MPW}	Directory "{MPW}"		# Run CodeWarrior	{abEcho} "> Execute {cwName}¶n"	"{CWPath}{cwName}"		# Close all opened projects	Loop		Set res "`SendAE -t "{cwName}" -e MMPRClsP  -dot`"		Break If "{res}" != ""	End		### Clean ErrWarnMsg	Echo "" > {reportPath}ErrWarnMsg		### Load CWBuild	({scriptsPath}CWBuild.mpw "{ppcPath}{ppcProject}" "{ppcTarget}" "{FileName}")	Set ppcILErr	{status}		# Quit CodeWarrior	{abEcho} "> Quit {cwName}"	SendAE -t "{cwName}" -e aevtquit -dot			Rename {reportPath}ErrWarnMsg {reportPath}ErrPPCInLine -y		If ( {ppcILErr} == 0 )		"{ppcPath}{FileName}"		{abEcho} ">>> PPCInline.inc : completed"		Exit 0	Else		{abEcho} "{FNF}{FileName}"		Exit {ppcILErr}	EndElse	{abEcho} "{DNF}{ppcPath}"	Exit 42End