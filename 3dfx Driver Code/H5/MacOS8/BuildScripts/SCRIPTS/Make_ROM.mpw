######		MAKE ROM######	synopsis :###		Make_ROM.mpw mr_versionfilename###{abEcho} "¶n!`date -t`{BNS}MAKE ROM"### InitializationSet		mrfiles		"{1}"Set		current		1Set 	ErrCounter	0### Check if {mrfiles} existsIf "`Exists -f {mrfiles}`"	Set	fileNum		`Count -l {mrfiles}`Else	{abEcho} "{FNF}{mrfiles}"	Exit 42End### Look if file is not emptyIf ({fileNum} == 0)	{abEcho} "{FIE}{mrfiles}"EndEcho "" > {reportPath}RomFiles### Open mrfilesOpen -r -t {mrfiles}### Loop on each line of the mrfilesLoop	Find {current}		Set currROM	"`Catenate ¤`"		### call function to make the .rom	({scriptsPath}mmRom.mpw {currROM} "{current}")	Set resultat {status}	If ({resultat} == 0)		Catenate {reportPath}RomFiles {reportPath}add > {reportPath}rftemp		Move -y {reportPath}rftemp {reportPath}RomFiles	Else if ({resultat} == 1)		Evaluate ErrCounter+=1	Else if ({resultat} == 4242)		### Compilation line (Control Panel)		({scriptsPath}Compile_AfterMROM.mpw {currROM})		if ({status} > 0)			Evaluate ErrCounter+=1		end	End	Evaluate current+=1	Break If {current} > {fileNum}EndClose {mrfiles} -ySet RomNum `Count -l {reportPath}RomFiles`### Cleanup the messIf "`Exists -f {reportPath}add`"	Delete -y -i {reportPath}addEndIf "`Exists -f {reportPath}rftemp`"	Delete -y -i {reportPath}rftempEndIf ({ErrCounter} > 0)	{abEcho} "### .rom files creation FAILED"	Exit 42Else		If "{fileNum}" == 0		If "`Exists -f {reportPath}RomFiles`"			Delete -y {reportPath}RomFiles		End	End	{abEcho} "`Date -t`{ENS}MAKE ROM"	Exit 0End