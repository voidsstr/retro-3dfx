######		GENDATE				######	synopsis :###		GenDate.mpw###### Compile/Run gendate.c Set		genFile			"gendate.h"Set		genFileC		"gendate.c"Set		filetype		"TEXT"Set		filecreator		"CWIE"{abEcho} "> GenDate.mpw is now a MPW SCRIPT (instead of incsrc/gendate.c)"{abEcho} "> make gendate.h"echo "#ifndef GENDATE_H" > {genFile}echo "#define GENDATE_H" >> {genFile}echo "#define BUILD_DATE ¶"`date -a` (from incsrc/gendate.h)¶"" >> {genFile}echo "#endif" >> {genFile}{abEcho} "> SetFile TYPE / CREATOR"SetFile -c {filecreator} -t {filetype} {genFile}#{abEcho} "> Find 'incsrc' folder"Set		genPath			"`Whereis  -s "{tdfx_builtPath}" -c "{genFileC}"`" ### Get the directory name from the file's full path name.(Evaluate "{genPath}" =~ /¶'*(([Â:]*:)+)¨1[Â:]*/ ) · Dev:Null Set		genPath			"{¨1}"If "`Exists -d "{genPath}"`"	Move -y {genFile} "{genPath}"Else	{abEcho} "{DNF}{genPath}"	Exit 42End