######		MMROM######	synopsis :###		mmRom.mpw GDXfile OFfile romName######	Wrn : romName should be WITHOUT ".rom" & OFfile path relative to GDX folder### InitializationSet 	GDXfile			"{1}"Set		OFfile			"{2}"Set		romName			"{3}"Set		resourceID		"{4}"Set		FlashRom		"FlashROM"###DEBUG VARIABLES#Set		abEcho	"goinfre:my3dfx:devel:h5:macos8:buildscripts:scripts:abEcho"	### Check if all args are hereIf ("{1}" == "" || "{2}" == "" || "{3}" == "")	{abEcho} "{NEP}"	{abEcho} "# Usage - mmRom GDXfile OFfile romName"	{abEcho} "# Wrn : romName should be WITHOUT ".rom""	Exit 1EndIf ({1} == "#")	### Here is a compilation line !	### Exit with ref 4242 	Exit 4242End{abEcho} "> Tokenize : {OFfile}"### Find where is GDXfileSet	-e	gdxPath			"`Whereis  -s "{tdfx_builtPath}" -c "{GDXfile}"`"### Get the directory name from the file's full path name.If ({gdxPath} != "")	(Evaluate "{gdxPath}" =~ /¶'*(([Â:]*:)+)¨1[Â:]*/ ) · Dev:Null 	Set		gdxPath			"{¨1}"Else	{abEcho} "{FNF}{GDXfile}"	Exit 1End### Find if OFfile existsSet		sdir		`Directory`Directory "{gdxPath}"If !"`Exists -f {OFfile}`"	{abEcho} "{FNF}{OFfile}"	{abEcho} "### WRN : the file path MUST be relative to the GDX folder !!"	Exit 1End### Prepare date for romName#Echo "`date -d -s4`" > {reportPath}romFile#Open -t {reportPath}romFile#Find ¥ ; Replace -c ° /¶// "-" {reportPath}romFile#Save {reportPath}romFile#Find 1 ; Set today "`Catenate ¤`"#Close {reportPath}romFile -ySet		mromName		"{romName}.rom"  {abEcho} "> Saved-Image : {mromName}"### Create tokinfo file{abEcho} "> Building the tokinfo file"Echo "" > "{gdxPath}tokinfo"Echo "tokenize {OFfile}" >> "{gdxPath}tokinfo"Echo "save-image {romName}" >> "{gdxPath}tokinfo"Echo "bye" >> "{gdxPath}tokinfo"### Let's Tokenize !{abEcho} "¶n> Tokenizing ...""{MPW}"Tools:Tokenizer.mpt < "{gdxPath}tokinfo" > "{gdxPath}resinfo"Catenate "{gdxPath}resinfo"Catenate "{gdxPath}resinfo" >> {reportPath}abFinalReportIf "`Exists -f "{gdxPath}{romName}"`"	### !!! MAKE IMAGE TOOL HERE !!!	{abEcho} "> Make rom image with resource ID #{resourceID}"	"{MPW}"Tools:makeROMrsrc.mpt "{gdxPath}{romName}" "{gdxPath}{mromName}" "{resourceID}"End### Clean up the messIf "`Exists -f "{gdxPath}tokinfo"`"	Delete "{gdxPath}tokinfo" -i -yEndIf "`Exists -f "{gdxPath}resinfo"`"	Delete "{gdxPath}resinfo" -i -yEndIf "`Exists -f {reportPath}romFile`"	Delete {reportPath}romFile -i -yEndIf "`Exists -f {reportPath}{romName}`"	Delete {reportPath}{romName} -i -yEnd### Check for .rom fileIf "`Exists -f "{gdxPath}{mromName}"`"	### add to the temp ga_file 	{abEcho} "> Add {mromName}.rsrc to the 'RomFiles' file"	Echo "¶¶¶"{mromName}.rsrc¶¶¶" ¶¶¶"{FlashRom}¶¶¶"" > {reportPath}add		{abEcho} ">>> Tokenize completed successfully¶n"	Exit 0	Else	{abEcho} "¶n{FNF}{mromName}"	{abEcho} "### A problem occured while tokenizing {mromName}"	Exit 1End	