######		COMPILE AFTER MROM######	synopsis :###		Complie_AfterMROM.mpw ###{abEcho} "¶n!`date -t`{BNS}COMPILE AFTER MAKE_ROM"### InitializationSet		Dieze			"{1}"Set		ProjectName		"{2}"Set		TargetName		"{3}"Set		FileName		"{4}"Set		ROMfile			"{reportPath}RomFiles"Set 	current			1### Find where is ProjectNameSet	-e	ProjectPath			"`Whereis  -s "{tdfx_builtPath}" -c "{ProjectName}"`"### Get the directory name from the file's full path name.If ({ProjectPath} != "")	(Evaluate "{ProjectPath}" =~ /¶'*(([Â:]*:)+)¨1[Â:]*/ ) · Dev:Null 	Set		ProjectPath			"{¨1}"Else	{abEcho} "{FNF}{ProjectPath}"	Exit 1End### Copy all the ROMs into this folder### Check if {ROMfile} exists{abEcho} "> Check if {ROMfile} exists"If "`Exists -f {ROMfile}`"	Set	fileNum		`Count -l {ROMfile}`Else	{abEcho} "{FNF}{ROMfile}"	Exit 1End### Look if file is not emptyIf ({fileNum} == 0)	{abEcho} "{FIE}{ROMfile}"End{abEcho} "> Open the ROMfile"### Open mrfilesOpen -r -t {ROMfile}{abECho} "> Looking for ROMs file to copy"### Loop on each line of the mrfilesLoop	Find {current}		Set currROM	"`Catenate ¤`"	### Get the name of the ROM to copy	({scriptsPath}GetFirstArg.mpw {currRom}) > "{reportPath}FirstArg"	Set currRom2 "`Catenate "{reportPath}FirstArg"`"		### Find the ROM to copy	if ("{currROM2}" != "")		Set	-e	toCopyROM			"`Whereis  -s "{tdfx_builtPath}" -c "{currROM2}"`"		If ("{toCopyROM}" != "")			{abEcho} "> Move file {toCopyROM} in {ProjectPath} folder"			Move -y {toCopyROM} {ProjectPath}		Else			{abEcho} "{FNF}{currROM}"		End	end		Evaluate current+=1	Break If {current} > {fileNum}EndClose {ROMfile} -y### Lunch the compilation ...# Set the path to {MPW}set currDir `Directory`Directory "{MPW}"# Run CodeWarrior{abEcho} "> Run {cwName}¶n""{CWPath}{cwName}"### Call the CWBuild project({scriptsPath}CWBuild.mpw "{ProjectName}" "{TargetName}" "{FileName}")Set makeErr {Status} # Quit CodeWarrior{abEcho} "> Quit {cwName}"Set	res		`SendAE -t "{cwName}" -e aevtquit` ·· {reportPath}ErrWarnMsgDirectory {currDir}If ( {makeErr} > 0)	{abEcho} "### the project {ProjectName} did not build successfully"	Exit {makeErr}End{abEcho} "`Date -t`{ENS}COMPILE AFTER MAKE_ROM"