RM_2D_AccelMode);	//if (!result)		return false;	result = SetPopupButtonContentFromHRM (perf2D_FontCaching, HRM_2D_FontCaching);	//if (!result)		return false;	result = SetPopupButtonContentFromHRM (perf2D_PictCaching, HRM_2D_PictCaching);	//if (!result)		return false;	result = SetPopupButtonContentFromHRM (perf2D_QTAccel, HRM_QT_AccelMode);	//if (!result)		return false;	result = SetPopupButtonContentFromHRM (perf2D_MPEGAccel, HRM_QT_MPEGMode);	//if (!result)		return false;				if (mVVersion == 3)	{		/*	Disable some popupmenu 	*/		LPopupButton * theFCacheButton = (LPopupButton*) this->FindPaneByID(perf2D_FontCaching);		theFCacheButton->SetCurrentMenuItem( kDisabled );		theFCacheButton->Disable();				LPopupButton * thePCacheButton = (LPopupButton*) this->FindPaneByID(perf2D_PictCaching);		thePCacheButton->SetCurrentMenuItem( kDisabled );		thePCacheButton->Disable();				LPopupButton * theQTButton = (LPopupButton*) this->FindPaneByID(perf2D_QTAccel);		theQTButton->SetCurrentMenuItem( kDisabled );		theQTButton->Disable();				LPopupButton * theMPEGButton = (LPopupButton*) this->FindPaneByID(perf2D_MPEGAccel);		theMPEGButton->SetCurrentMenuItem( kDisabled );		theMPEGButton->Disable();				/*	Disable some option in the PopupMenu	*/		LPopupButton * theQDButton = (LPopupButton*) this->FindPaneByID(perf2D_QDAccel);		theQDButton->SetCurrentMenuItem( kBasic );		MenuHandle menuH = theQDButton->GetMacMenuH();		::DisableItem(menuH, 3);	}			return result;}/*______________________________________________________________________________	FinisCreateSelf	*/voidC2DPerfView::FinishCreateSelf(){	LPopupButton * theQDButton = (LPopupButton*) this->FindPaneByID(perf2D_QDAccel);	if (theQDButton != nil)		theQDButton->AddListener(this);		LPopupButton * theFCacheButton = (LPopupButton*) this->FindPaneByID(perf2D_FontCaching);	if (theFCacheButton != nil)		theFCacheButton->AddListener(this);		LPopupButton * thePCacheButton = (LPopupButton*) this->FindPaneByID(perf2D_PictCaching);	if (thePCacheButton != nil)		thePCacheButton->AddListener(this);		LPopupButton * theQTButton = (LPopupButton*) this->FindPaneByID(perf2D_QTAccel);	if (theQTButton != nil)		theQTButton->AddListener(this);		LPopupButton * theMPEGButton = (LPopupButton*) this->FindPaneByID(perf2D_MPEGAccel);	if (theMPEGButton != nil)		theMPEGButton->AddListener(this);		}/*______________________________________________________________________________	ListenToMessage	*/void					C2DPerfView::ListenToMessage(	MessageT 			inMessage, 	void *				ioParam){	bool		res;	UInt32 		longParam = *(UInt32*)ioParam;		if ( mBoard )	{		switch(inMessage) {			case msg_2DPerf_QD:			{				res = mBoard->SetSettingUL(HRM_2D_AccelMode, *((UInt32*)ioParam));				break;			}						case msg_2DPerf_FontCach:			{				res = mBoard->SetSettingUL(HRM_2D_FontCaching, *((UInt32*)ioParam));				break;			}						case msg_2DPerf_PictCach:			{				res = mBoard->SetSettingUL(HRM_2D_PictCaching, *((UInt32*)ioParam));				break;			}						case msg_2DPerf_QT:			{				res = mBoard->SetSettingUL(HRM_QT_AccelMode, *((UInt32*)ioParam));				break;			}						case msg_2DPerf_MPEG:			{					res = mBoard->SetSettingUL(HRM_QT_MPEGMode, *((UInt32*)ioParam));				break;			}						default:				break;		}	}}/*______________________________________________________________________________	SetPopupButtonContentFromHRM*/BooleanC2DPerfView::SetPopupButtonContentFromHRM(	PaneIDT		inPane,	char *		inSettingName){	Boolean		res = true;	UInt32 		outputSetting;		LPopupButton * 	thePopupButton = (LPopupButton*) this->FindPaneByID(inPane);		if ( mBoard )	{		res = mBoard->GetSettingUL(inSettingName, &outputSetting);	}		if ( res ) thePopupButton->SetCurrentMenuItem( outputSetting );		return res;}/*______________________________________________________________________________	SetVoodooVersion*/voidC2DPerfView::SetVoodooVersion(	int	 		inValue){	mVVersion = inValue;}