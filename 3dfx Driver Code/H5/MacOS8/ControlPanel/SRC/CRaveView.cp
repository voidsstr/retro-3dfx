();}/*______________________________________________________________________________	ListenToMessage*/voidCRaveView::ListenToMessage(	MessageT 			inMessage, 	void *				ioParam){	UInt32 		longParam = *(UInt32*)ioParam;	Boolean 	res;		if ( mBoard )	{		switch(inMessage)		{			case msg_3DPerf_AAliasing:				res = mBoard->SetSettingUL(HRM_GlobalRaveAntiAliasing, *((UInt32*)ioParam));				break;			case perf3D_AAliasingKey:				res = mBoard->SetSettingUL(HRM_GlobalRaveAntiAliasingKey, *((UInt32*)ioParam));				break;			case msg_3DPerf_GammaTbl:			{				float theFloat = 1.0 + ( longParam * 0.1 );							res = mBoard->SetSettingF(HRM_GlobalGlideGamma, theFloat);				break;			}						case msg_3DPerf_VSync:				res = mBoard->SetSettingUL(HRM_GlobalGlideVSyncEnable, longParam);				break;						default:				break;		}	}}/*______________________________________________________________________________	SetPCIHardware*/voidCRaveView::SetPCIHardware(	CPCIHardware *		inBoard){	if ( inBoard != 0 ) {		mBoard = inBoard;		LoadRave_View();	}}/*______________________________________________________________________________	LoadGlide_View*/BooleanCRaveView::LoadRave_View(){	UInt32 		theValue;	float 		theFloat;	Boolean 	result = true;		mBoard->GetSettingUL(HRM_GlobalRaveAntiAliasing, &theValue);	mAASampling->SetCurrentMenuItem( theValue );		mBoard->GetSettingUL(HRM_GlobalRaveAntiAliasingKey, &theValue);	mAAKey->SetValue( theValue );		mBoard->GetSettingF(HRM_GlobalGlideGamma, &theFloat);	theValue = (theFloat - 1.0) * 10;	mGamma->SetValue( theValue );		mBoard->GetSettingUL(HRM_GlobalGlideVSyncEnable, &theValue);	mVSync->SetCurrentMenuItem( theValue );		return result;}