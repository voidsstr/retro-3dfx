LPushButton*) FindPaneByID(updatedrv_Cancel);	if (theButton != nil)		theButton->AddListener(this);		mProgress = (LCaption*) FindPaneByID(updatedrv_Status);		/*	Set the text inside the UpdateDrv Window */		CaptionText.Assign(UpdateDrv_STR, kChecking4Version);	LCaption*	theText = (LCaption*) FindPaneByID(updatedrv_Line1);	if (theText != nil)	theText->SetDescriptor(CaptionText);		CheckDriverVersion();	}/*______________________________________________________________________________	ListenToMessage*/void CUpdateDrv::ListenToMessage(	MessageT 	inMessage, 	void *		ioParam){	UInt32 		longParam = *(UInt32*)ioParam;	switch(inMessage) 	{		case updatedrv_Download:		{			DownloadDrvNow();			break;		}				case updatedrv_Cancel:		{			/* Need to kill the thread before closing the window, if needed */			if (IsHTTPThreadActive)				theHTTPThread->DeleteThread();			if (IsGETThreadActive)				theGETDrvThread->DeleteThread();							DoClose();			break;		}				default:			break;	}}#pragma mark -/*______________________________________________________________________________	CheckDriverVersion*/void CUpdateDrv::CheckDriverVersion(){	theHTTPThread = new CHTTPSendMsgThread(this);		theHTTPThread->Resume();}/*______________________________________________________________________________	SetLastVersion*/void CUpdateDrv::SetLastVersion(LStr255 & inLastVersion){	mLastVersion = inLastVersion;}/*______________________________________________________________________________	SetHqxName*/void CUpdateDrv::SetHqxName(LStr255 & inHqxName){	mHqxName = inHqxName;}/*______________________________________________________________________________	SetDriverName*/void CUpdateDrv::SetDriverName(LStr255 & inDriverName){	mDriverName = inDriverName;}/*______________________________________________________________________________	GetDriverName*/LStr255 & CUpdateDrv::GetDriverName(){	return mDriverName;}/*______________________________________________________________________________	GetHqxName*/LStr255 & CUpdateDrv::GetHqxName(){	return mHqxName;}/*______________________________________________________________________________	DownloadDrvNow*/void CUpdateDrv::DownloadDrvNow(){	theGETDrvThread = new CGETDrvThread(this);		theGETDrvThread->Resume();}