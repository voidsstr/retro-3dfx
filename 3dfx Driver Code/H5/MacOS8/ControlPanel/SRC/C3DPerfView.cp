ew);	if (perf3DMPV != nil)		perf3DMPV->CreateAllPanels();		LPushButton*		theTestButton = (LPushButton*) this->FindPaneByID(perf3D_TestButton);	if (theTestButton != nil) theTestButton->AddListener(this);}/*______________________________________________________________________________	SetPCIHardware*/voidC3DPerfView::SetPCIHardware(	CPCIHardware *		inBoard){	if ( inBoard != 0 ) 	{		mBoard = inBoard;				Load3DPerfView();	}}/*______________________________________________________________________________	Load3DPerfView*/BooleanC3DPerfView::Load3DPerfView(){	Boolean	result = true;		mMultiPanelView = dynamic_cast<LMultiPanelView*> (this->FindPaneByID(perf3D_MultiPanelView));	mMultiPanelView->SwitchToPanel(index_3DPerf_Glide);		COpenGLView* theOpenGLView = (COpenGLView*) this->FindPaneByID(perf3D_OpenGLView);	theOpenGLView->SetPCIHardware( mBoard );		CGlideView* theGlideView = (CGlideView*) this->FindPaneByID(perf3D_GlideView);	theGlideView->SetVoodooVersion( mVVersion );	theGlideView->SetPCIHardware( mBoard );		CRaveView* theRaveView = (CRaveView*) this->FindPaneByID(perf3D_RaveView);	theRaveView->SetPCIHardware( mBoard );		return result;}/*______________________________________________________________________________	ListenToMessage*/void					C3DPerfView::ListenToMessage(	MessageT 			inMessage, 	void *				ioParam){	UInt32 longParam = *(UInt32*)ioParam;		switch (inMessage) {		case msg_3DPerf_PGB:			mMultiPanelView->SwitchToPanel(longParam);			break;				case msg_3DPerf_TestButton:			int i =0;			break;				default:			break;	}}/*______________________________________________________________________________	SetVoodooVersion*/voidC3DPerfView::SetVoodooVersion(	int	 		inValue){	mVVersion = inValue;}