; 3dfxvsn.inf
;
; Installation inf file for the 3dfx Interactive, Inc. Voodoo graphics adapter.
;

[Version]
Signature="$Windows NT$"
Provider=%3dfx%
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display

[DestinationDirs]
DefaultDestDir    = 11  ; system32
3dfxvsn.Miniport   = 12  ; drivers
3dfxvsn.Display    = 11
Control.Panel     = 11

;
; Driver information
;

[Manufacturer]
%3dfx%   = 3dfx.Mfg

[3dfx.Mfg]
"3dfx Voodoo Series" = 3dfxvsn, PCI\VEN_121A&DEV_0009
"3dfx Voodoo Series" = 3dfxvsn, PCI\VEN_121A&DEV_000B


;
; General installation section
;

[3dfxvsn]
CopyFiles=3dfxvsn.Miniport, 3dfxvsn.Display
AddReg=OpenGL.Regs

;
; File sections
;

[3dfxvsn.Miniport]
3dfxvsnm.sys,,,%IN_USE%

[3dfxvsn.Display]
3dfxvsn.dll,,,%IN_USE%
glide2x.dll,,,%IN_USE%
glide3x.dll,,,%IN_USE%
3dfxSpl2.dll,,,%IN_USE%
3dfxSpl3.dll,,,%IN_USE%
3dfxOGL.dll,,,%IN_USE%

;
; Registry sections
;

[OpenGL.Regs]
HKLM,"Software\Microsoft\Windows NT\CurrentVersion\OpenGLdrivers","3dfx",,"3dfxogl.dll"

;
; Service Installation
;

[3dfxvsn.Services]
AddService = 3dfxvsn, 0x00000002, 3dfxvsn_Service_Inst, 3dfxvsn_EventLog_Inst

[3dfxvsn_Service_Inst]
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 1                  ; SERVICE_SYSTEM_START
ErrorControl   = 0                  ; SERVICE_ERROR_IGNORE
LoadOrderGroup = Video
ServiceBinary  = %12%\3dfxvsnm.sys

[3dfxvsn_EventLog_Inst]
AddReg = 3dfxvsn_EventLog_AddReg

[3dfxvsn_EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%SystemRoot%\System32\IoLogMsg.dll;%SystemRoot%\System32\drivers\3dfxvsnm.sys"
HKR,,TypesSupported,0x00010001,7

;
; General config information
;
[3dfxvsn.GeneralConfigData]
MaximumDeviceMemoryConfiguration=68

;
; Software Installation
;

[3dfxvsn.SoftwareSettings]
AddReg = 3dfxvsn_SoftwareDeviceSettings
DelReg = 3dfxvsn_DeleteSWSettings


[3dfxvsn_DeleteSWSettings]
HKR,TIMINGS
HKR,D3D
HKR,Glide
HKR,FEATURES
HKLM,System\CurrentControlSet\Services\3dfx

