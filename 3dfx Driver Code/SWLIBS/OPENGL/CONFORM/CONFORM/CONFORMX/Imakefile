OBJS = \
	appl.o \
	font.o \
	readpix.o \
	tests.o

INCLUDES = -I../conformshell \
	   -I../../ctk \
	   -I$(TOP)/include \
	   -I$(TOP)/include/GL

DEP_LIBS = ../conformshell/libconformshell.a \
	   ../../ctk/libctk.a \
	   $(TOP)/lib/GL/libGL.a

LOCAL_LIBS = $(DEP_LIBS) $(XLIB)

AllTarget(conformx)

NormalProgramTarget(conformx, $(OBJS), $(DEP_LIBS), $(LOCAL_LIBS), -lm)

DependTarget()
