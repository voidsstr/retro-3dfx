#!/bin/csh
setenv SEED $$

echo "**********************************************************************"
echo "     OpenGL Conformance Suite."
echo "**********************************************************************"
echo ""

echo "**********************************************************************"
echo "     covgl."
echo "**********************************************************************"
echo ""
covgl/covgl 

echo "**********************************************************************"
echo "     conform."
echo "**********************************************************************"
echo ""
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -1 mustpass.c -D 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 1
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -1 mustpass.c -D 2
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 2
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -1 mustpass.c -D 3
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 3
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -1 mustpass.c -D 4
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 4
echo "**********************************************************************"
echo ""
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 1 -p 1
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 2 -p 1
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 3 -p 1
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 4 -p 1
echo "**********************************************************************"
echo ""
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 1 -p 2
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 2 -p 2
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 3 -p 2
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 4 -p 2
echo "**********************************************************************"
echo ""
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 1 -p 3
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 2 -p 3
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 3 -p 3
@ SEED = $SEED + 1
conform/conform -v 0 -r $SEED -f conform/TESTLIST -D 4 -p 3

echo "**********************************************************************"
echo "     primtest."
echo "**********************************************************************"
echo ""
primtest/primtest 

echo "**********************************************************************"
echo "     covglu."
echo "**********************************************************************"
echo ""
covglu/covglu
