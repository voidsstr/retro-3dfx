 "__GL_COSMO_BUILD" /D "__GL_SUPPORT_MGL" /D "__WGL_USE_GLIDE" /FAcs\
 /Fa"$(INTDIR)/" /Fp"$(INTDIR)/opengl.pch" /YX /Fo"$(INTDIR)/" /Fd"$(INTDIR)/"\
 /c 
