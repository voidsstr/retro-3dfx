 /base:0x69000000 /subsystem:windows /dll /incremental:no\
 /pdb:"$(OUTDIR)/opengl.pdb" /map:"$(INTDIR)/opengl.map" /debug /machine:I386\
 /def:".\oglicd.def" /out:"$(OUTDIR)/opengl.dll" /implib:"$(OUTDIR)/opengl.lib" 
