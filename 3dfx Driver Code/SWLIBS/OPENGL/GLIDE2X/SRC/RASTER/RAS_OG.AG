@	    movq    'mmxtr.s.didx',mm2
@           psraw   mm2,2
@	    movq    'mmxtr.t.didx',mm3
@	    pmullw	mm2,[#'DISPOF(stagger_k) + ((dx == -1) ? 8 : 0)']
@           psraw   mm3,2
@	    pmullw	mm3,[#'DISPOF(stagger_k) + ((dx == -1) ? 8 : 0)']

@	    movq    mm7,mm6
@           pslld   mm6,'mmxtr.tex_s_kerrect'
@           pslld   mm7,'mmxtr.tex_t_kerrect'
@           punpcklwd mm6,mm6
@           punpckhwd mm7,mm7
@	    punpckhdq mm6,mm6
@	    punpckhdq mm7,mm7
@	    paddw   mm6,mm2
@	    paddw   mm7,mm3
@           jmp     central
	} else {
@   	    jne     central
        }
#else
@central:
@central2:
#endif
@tail:

@   	mov     ebx,ending
@   	and     ebx,3

	/* Don't do a thing if there's no span left */

@	je      next_line

        if (interpolate_z) {
	    static const GLuint mask_1[] = { 0xffffffff,
				       0x000000ff,
				       0x0000ffff,
				       0x00ffffff };
	    static const GLuint mask_M[] = { 0xffffffff,
				       0xff000000,
				       0xffff0000,
				       0xffffff00 };

@           genz(tr, '&mmxtr', [edi], [edi], [esi], NULL, dx, [#'(int)((dx == -1) ? &mask_M : &mask_1)' + ebx * 4], zwint, next_line, mixpix, texenv)
        }
@zwint:

@	genpix('&pixval', tr, '&mmxtr', c_stride, NULL, dx, [edi], texenv)
@   	jmpi    [#'DISPOF(tailgate)' + ebx * 4]

        {
	    struct celem
		*c0 = label(gc), 
		*c1 = label(gc), 
		*c2 = label(gc),
		*c3 = label(gc);
            unsigned char** targets = (unsigned char**)DISPOF(tailgate);

	    if (dx == -1) {
@c1:
		if (c_stride == 8) {
@	            psrlq	pixval,48
@   	    	    movd    eax,pixval
@   	    	    size16
@   	    	    mov     [edi + 6],eax
		} else {
@	            psrlq   pixval,48
@   	    	    movd    eax,pixval
@   	    	    mov     [edi + 3],al
		}
@   	    	jmp     next_line

@c2:	    
		if (c_stride == 8) {
@	            psrlq	pixval,32
@   	    	    movd     [edi + 4],pixval
		} else {
@	            psrlq	pixval,32
@		    packuswb pixval,pixval
@   	    	    movd    eax,pixval
@   	    	    size16
@   	    	    mov     [edi + 2],eax
		}
@   	    	jmp     next_line

@c3:	    
		if (c_stride == 8) {
@	            psrlq	pixval,16
@   	    	    movd    [edi + 2],pixval
@   	    	    punpckhdq pixval,pixval
@   	    	    movd    eax,pixval
@   	    	    size16
@   	    	    mov     [edi + 6],eax
		} else {
@	            psrlq	pixval,16
@                   packuswb pixval,pixval
@                   movd    eax,pixval
@   	    	    size16
@   	    	    mov     [edi + 1],eax
@   	    	    shr     eax,16
@   	    	    mov     [edi + 3],al
		}
@   	    	jmp     next_line

@c0:	    
	    } else {
@c1:
		if (c_stride == 8) {
@           	    movd    eax,pixval
@           	    size16
@           	    mov     [edi],eax
		} else {
@           	    movd    eax,pixval
@           	    mov     [edi],al
		}
@           	jmp     c0
    	
@c2:	    
		if (c_stride == 8) {
@           	    movd    [edi],pixval
@           	    jmp     c0
		} else {
@		    packuswb pixval,pixval
@           	    movd    eax,pixval
@		    size16
@		    mov     [edi],eax
@           	    jmp     c0
		}
    	
@c3:	    
		if (c_stride == 8) {
@           	    movd    [edi],pixval
@           	    punpckhdq pixval,pixval
@           	    movd    eax,pixval
@           	    size16
@           	    mov     [edi+4],eax
		} else {
@		    packuswb pixval,pixval
@		    movd    eax,pixval
@		    size16
@		    mov     [edi],eax
@		    shr     eax,16
@		    mov     [edi+2],al
		}

@c0:
	    }

            targets[0] = c0->spec.label.where;
            targets[1] = c1->spec.label.where;
            targets[2] = c2->spec.label.where;
            targets[3] = c3->spec.label.where;
        }

@next_line:
@   	mov     eax,'tr(x0Frac)'
@   	mov     ebx,'tr(dxdy0Frac)'

@   	add     eax,ebx
@   	mov     ebp,'tr(cp0)'

@   	mov     ebx,eax
@   	and     eax,~0x80000000UL

@   	shr     ebx,31
@   	mov     ecx,'tr(x0Int)'

@   	mov     edx,'trs(dcpdy0)'
@   	mov     edi,'trs(dxdy0Int)'

@   	add     ecx,edi
@   	add     ebp,edx

        if (interpolate_z) {
@	    movq    mm4,'tr(z0)'
@	    paddd   mm4,'trsq(dzdy0)'
@	    movq    'tr(z0)',mm4
        }

        if (interpolate_tex) {
@	    movq    mm6,'tr(s0)'
@	    paddd   mm6,'trsq(dsdy0)'
@	    movq    'tr(s0)',mm6

	    if (modeFlags & __GL_SHADE_TEXTURE_PERSP) {
@	    	movq    mm0,'tr(q0)'
@	    	paddd   mm0,'trsq(dqdy0)'
@	    	movq    'tr(q0)',mm0
            }
        }

	if (interpolate_color) {
@	    movq    mm5,'tr(r0)'
@	    movq    mm7,'tr(b0)'
@	    paddd   mm5,'trsq(drdy0)'
@	    paddd   mm7,'trsq(dbdy0)'

@	    movq    'tr(r0)',mm5
@	    movq    'tr(b0)',mm7
	}

@   	mov     'tr(x0Int)',ecx
@   	mov     'tr(cp0)',ebp
@   	mov     'tr(x0Frac)',eax

@   	mov     ecx,'tr(x1Frac)'
@   	mov     ebx,'tr(dxdy1Frac)'

@   	add     ecx,ebx
	if (modeFlags & __GL_SHADE_DITHER)
@	    mov     ebp,'tr(y)'

@   	mov     ebx,ecx
@   	and     ecx,~0x80000000UL

@   	shr     ebx,31
@   	mov     'tr(x1Frac)',ecx

@   	mov     eax,h
@   	mov     ecx,'tr(x1Int)'

	if (modeFlags & __GL_SHADE_DITHER)
@           inc     ebp
@   	mov     ebx,'trs(dxdy1Int)'

@   	add     ecx,ebx
	if (modeFlags & __GL_SHADE_DITHER)
@           mov     'tr(y)',ebp

@   	mov     'tr(x1Int)',ecx
@   	dec     eax

@   	jne     perline

@done_trap:
@   	mov     eax,'tr(y1Int)'
@   	mov     ebx,'tr(y2Int)'
@   	cmp     eax,ebx
@   	je      alldone
@   	mov     'tr(y0Int)',ebx
@   	mov     'tr(y2Int)',eax

@   	memov('tr(x1Int)','tr(x2Int)')
@   	memov('tr(dxdy1Int[0])', 'tr(dxdy2Int[0])')
@   	memov('tr(dxdy1Int[1])', 'tr(dxdy2Int[1])')
@   	memov('tr(x1Frac)','tr(x2Frac)')
@   	memov('tr(dxdy1Frac)','tr(dxdy2Frac)')

@   	jmp     trap

@short_span:
@   	mov     edi,'tr(cp0)'

        if (interpolate_z)
@	    mov     esi,'tr(zp0)'

	/* We have to be careful here... if edi is right at the start
	 * of the color buffer, then subtracting 6 or 3 might leave it pointing
	 * out of the area.  qword accesses (such as the color pointer read in
	 * blending) might give us GPFs.  So we copy as much as we need, and set
	 * 'readfrom' to point to the copy.
	 */
        readfrom = mem2(gc, NULL, edi);
        if (dx == -1) {
	    /* Decrease both pointers by 3/4 of stride */
@           sub     edi,#'(3 * c_stride) / 4'
            if (interpolate_z)
@               sub     esi,#'(3 * z_stride) / 4'

	    if (modeFlags & __GL_SHADE_BLEND) {
		struct celem *copy = near_label(gc);

@		mov     eax,3
@               mov     edx,ebx
@ copy:

		if (c_stride == 8) {
@	            size16
@	            mov     ecx,[edi + eax * 2]
@	            size16
@	            mov     [#'DISPOF(mmxtr.pixcopy)' + eax * 2],ecx
		} else {
@	            mov     cl,[edi + eax]
@	            mov     [#'DISPOF(mmxtr.pixcopy)' + eax],cl
		}

@               dec     eax
@		dec     edx
@               jne     copy

		readfrom = mmxtr.pixcopy;
	    } else {

	    }
        }

@   	and     ebx,3

	if (modeFlags & __GL_SHADE_DITHER) {
	    GLuint dt = (int)dithertab;

	    /* Oh dear.  We're about to do a misaligned write, so we need
	     * to rotate the dither pattern sync up with the screen.
	     * When looking at the rotates, keep in mind that 'left' in
	     * intelspeak is right on the screen.  Good luck.
	     */
@	    mov	eax,edi
@   	    and     eax,#'c_stride - 1'
            if (c_stride == 8)
@   		    shr     eax,1

@           mov     ecx,'tr(y)'
@           and     ecx,#DITHER_MASK

@	    movd    mm0,eax
@	    pslld   mm0,4
@	    movq    mm1,'mxk4(gc, 64,0,0,0)'
@	    psubd   mm1,mm0

	    if (!interpolate_color && !interpolate_tex) {
		/* We have 4 precalculated pixels sitting in mm7. */
@	    	movq    mm3,mm7
@	    	psllq   mm7,mm1
@	    	psrlq   mm3,mm0
@	    	por     mm7,mm3
	    } else {
@	    	movq    mm2,[#dt + ecx * 8]
@	    	movq    mm3,mm2
@	    	psllq   mm2,mm1
@	    	psrlq   mm3,mm0
@	    	por     mm2,mm3
@           	movq    'mmxtr.dithers[0]',mm2
    
@	    	movq    mm2,[#'dt + 32' + ecx * 8]
@	    	movq    mm3,mm2
@	    	psllq   mm2,mm1
@	    	psrlq   mm3,mm0
@	    	por     mm2,mm3
@           	movq    'mmxtr.dithers[1]',mm2
    
@	    	movq    mm2,[#'dt + 64' + ecx * 8]
@	    	movq    mm3,mm2
@	    	psllq   mm2,mm1
@	    	psrlq   mm3,mm0
@	    	por     mm2,mm3
@           	movq    'mmxtr.dithers[2]',mm2
	    }

            if (interpolate_color &&
		!(modeFlags & (__GL_SHADE_TEXTURE | __GL_SHADE_BLEND))) {
@	        paddw   mm5,'mmxtr.dithers[0]'
@	        paddw   mm6,'mmxtr.dithers[1]'
@	        paddw   mm7,'mmxtr.dithers[2]'
	    }
	}

        if (interpolate_z) {
	    static const GLuint mask_1[] = { 0xffffffff,
				       0x000000ff,
				       0x0000ffff,
				       0x00ffffff };
	    static const GLuint mask_M[] = { 0xffffffff,
				       0xff000000,
				       0xffff0000,
				       0xffffff00 };

@           genz(tr, '&mmxtr', [edi], readfrom, [esi], NULL, dx, [#'(int)((dx == -1) ? &mask_M : &mask_1)' + ebx * 4], zwins, next_line, mixpix, texenv)
        }
@zwins:
@	    genpix('&pixval', tr, '&mmxtr', c_stride, NULL, dx, readfrom, texenv)
@   	    jmpi    [#'DISPOF(minigate)' + ebx * 4]
    
    	    {
    		struct celem
    		    *c0 = label(gc), 
    		    *c1 = label(gc), 
    		    *c2 = label(gc),
    		    *c3 = label(gc);
    		unsigned char** targets = (unsigned char**)DISPOF(minigate);

		if (dx == -1) {
@c1:
@	        psrlq	pixval,48
@   	    	movd    eax,pixval
		if (c_stride == 8) {
@   	    	    size16
@   	    	    mov     [edi + 6],eax
		} else {
@   	    	    mov     [edi + 3],al
		}
@   	    	jmp     next_line

@c2:	    
@	        psrlq   pixval,32
		if (c_stride == 8) {
@   	    	    movd     [edi + 4],pixval
		} else {
@		    packuswb pixval,pixval
@   	    	    movd    eax,pixval
@   	    	    size16
@   	    	    mov     [edi + 2],eax
		}
@   	    	jmp     next_line

@c3:	    
@	        psrlq    pixval,16
		if (c_stride == 8) {
@   	    	    movd    [edi + 2],pixval
@   	    	    punpckhdq pixval,pixval
@   	    	    movd    eax,pixval
@   	    	    size16
@   	    	    mov     [edi + 6],eax
		} else {
@                   packuswb pixval,pixval
@                   movd    eax,pixval
@   	    	    size16
@   	    	    mov     [edi + 1],eax
@   	    	    shr     eax,16
@   	    	    mov     [edi + 3],al
		}
@   	    	jmp     next_line
    
@c0:		
		    if (c_stride == 8) {
@   		        movq    [edi],pixval
		    } else {
@			packuswb pixval,pixval
@			movd    [edi],pixval
		    }
@   		    jmp     next_line
		} else {
@c1:
		if (c_stride == 8) {
@           	    movd    eax,pixval
@           	    size16
@           	    mov     [edi],eax
		} else {
@           	    movd    eax,pixval
@           	    mov     [edi],al
		}
@           	jmp     next_line
    	
@c2:	    
		if (c_stride == 8) {
@           	    movd    [edi],pixval
		} else {
@		    packuswb pixval,pixval
@           	    movd    eax,pixval
@		    size16
@		    mov     [edi],eax
		}
@		jmp     next_line
    	
@c3:	    
		if (c_stride == 8) {
@           	    movd    [edi],pixval
@           	    punpckhdq pixval,pixval
@           	    movd    eax,pixval
@           	    size16
@           	    mov     [edi+4],eax
		} else {
@		    packuswb pixval,pixval
@		    movd    eax,pixval
@		    size16
@		    mov     [edi],eax
@		    shr     eax,16
@		    mov     [edi+2],al
		}
@		jmp     next_line
    
@c0:		
		    if (c_stride == 8) {
@   		        movq    [edi],pixval
		    } else {
@			packuswb pixval,pixval
@			movd    [edi],pixval
		    }
@   		    jmp     next_line
		}
    	
    		targets[0] = c0->spec.label.where;
    		targets[1] = c1->spec.label.where;
    		targets[2] = c2->spec.label.where;
    		targets[3] = c3->spec.label.where;
            }
    }

@alldone:

   if (gc->procs.unlockBuffers != NULL) {
	    struct celem* noneed = label(gc);

@       mov     edx,[#'(int)&(gc)->procs.unlockBuffers']
@       test    edx,edx
@       je      noneed

@       mov     edx,[#'(int)&(gc)->buffers.lock']
@       dec     edx
@       mov     [#'(int)&(gc)->buffers.lock'],edx
@       cmp     edx,0
@       jne     noneed
@       mov     edx,#'(int)gc'
@       push    edx
@       call    [#'(int)&(gc)->procs.unlockBuffers']
@       add     esp,4
@ noneed:
    }

@   emms

#if __GL_CODEGEN_DESCRIBERS
@   rdtsc
@   add     [#'(int)&last_describer->cyc[0]'],eax
@   adc     [#'(int)&last_describer->cyc[1]'],edx
#endif /* __GL_CODEGEN_DESCRIBERS */

#if __GL_CODEGEN_PMON
@   push    1
@   call	endKernelIteration
#endif /* __GL_CODEGEN_PMON */

/* Really a return, this is initialised at the start of setup. */
@   mov         eax,1
@   jmpi	[#'(int)&gc->ogState.rsave']

    if (interpolate_z) {
	struct celem* result;

/* Ptr to color destination in edi.  If blending, color source is 
 * in esi.
 */
@ mixpix:
@       movq    'mmxtr.zresult',mm1
@	genpix('&result', tr, '&mmxtr', c_stride, NULL, '(1)', [esi], texenv)

@       mov    ecx,'mmxtr.zresult'
        if (c_stride != 8) {
@	    packuswb mm0,mm0
	}

	/* Do a selective write, using the mask in ecx */
	{
	    struct celem
		*loop = near_label(gc),
		*lose = near_label(gc);

@	    mov     edx,0
@ loop:
@	    test    ecx,0xff
@	    je      lose
@	    movd    eax,mm0
            if (c_stride == 8) {
@           	size16
@           	mov     [edi + edx * 2],eax
	    } else {
@           	mov     [edi + edx],al
	    }
@ lose:
@	    psrlq   mm0,16
@           shr     ecx,8
@           inc     edx
@           cmp     edx,4
@           jne     loop
	}

@       ret
    }

@ do_recip:
@       reciprocal(ecx)
@       ret

    return cb;
}
#endif

/* e_to_str: Convert enum to printable string */

STATIC char*
e_to_str(GLenum e)
{

#define E2S(e) \
case e: return (#e)

    switch (e) {
	E2S(GL_ZERO);
	E2S(GL_ONE);
	E2S(GL_DST_COLOR);
	E2S(GL_SRC_COLOR);
	E2S(GL_ONE_MINUS_DST_COLOR);
	E2S(GL_ONE_MINUS_SRC_COLOR);
	E2S(GL_SRC_ALPHA);
	E2S(GL_ONE_MINUS_SRC_ALPHA);
	E2S(GL_DST_ALPHA);
	E2S(GL_ONE_MINUS_DST_ALPHA);
	E2S(GL_SRC_ALPHA_SATURATE);

    default: return "?";
    }

#undef E2S
}

STATIC GLuint
bf_to_index(GLenum x)
{
    switch (x) {
    case GL_ZERO:		return 0;
    case GL_ONE:		return 1;
    case GL_SRC_COLOR:		return 2;
    case GL_ONE_MINUS_SRC_COLOR:return 3;
    case GL_SRC_ALPHA:		return 4;
    case GL_ONE_MINUS_SRC_ALPHA:return 5;
    case GL_DST_ALPHA:		return 6;
    case GL_ONE_MINUS_DST_ALPHA:return 7;
    case GL_DST_COLOR:		return 8;
    case GL_ONE_MINUS_DST_COLOR:return 9;
    case GL_SRC_ALPHA_SATURATE: return 10;

    default:
	assert(0);
    }
}

rasterizer
GenerateRasterizer(__GLcontext *gc,
		   GLboolean spanlet)
{
  unsigned char *space;
  unsigned char *data;
  unsigned char *cb;
  struct __GLfptri fptr;
  struct celem
    *trap,
    *alldone,
    *canal,
    *nextline,
    *hzero;
  int locals = 0;
  struct celem *tr = NULL;
  struct celem *h = NULL;
  struct celem *w = NULL;
  struct celem *truew = NULL;
  struct celem *dither_index = NULL;
  struct celem *rptr = NULL, *gptr = NULL, *bptr = NULL;
  struct celem *dithertable = NULL;
  struct celem *dithervalue = NULL;
  struct celem
    *drdxH, *dgdxH, *dbdxH,	/* Used in smoothspan */
    *drdxP, *dgdxP, *dbdxP;
  GLuint modeFlags = gc->polygon.shader.modeFlags;
  __GLtexture *current;
  __GLmipMapLevel *lp;
  GLuint wl2, hl2;
  int fbsize;
  GLboolean useFlatspan;
  GLboolean useSmoothspan;
  unsigned int signature;
  int
    interpolate_color,
    interpolate_z;
  GLboolean texNeedRho;
  GLenum texenv;

  /* Create a unique cache signature that covers information not
   * included in modeFlags.
   */
  signature = 0;

  if (modeFlags & __GL_SHADE_TEXTURE) {
      __GLtexture *current = gc->texture.currentTexture;
      texNeedRho = current->params.minFilter != current->params.magFilter;
      texenv = gc->state.texture.env[0].mode;
      if (texenv == GL_DECAL &&
	  gc->texture.currentTexture->texelFormat == GL_RGB)
	  texenv = GL_REPLACE;
  } else {
      texNeedRho = GL_FALSE;
  }

  if (spanlet) {
      signature |= __OG_RASTER_SPANLETS;
  } else {

      if (modeFlags & __GL_SHADE_TEXTURE) {
	  __GLtexture *current = gc->texture.currentTexture;
	  int baseFormat;

	  /* Texture environment */
	  switch (texenv) {
	  case GL_MODULATE:
	      signature |= (0<<__OG_RASTER_TEX_ENV_SHIFT);
	      break;
	  case GL_DECAL:
	      signature |= (1<<__OG_RASTER_TEX_ENV_SHIFT);
	      break;
	  case GL_BLEND:
	      signature |= (2<<__OG_RASTER_TEX_ENV_SHIFT);
	      break;
	  case GL_REPLACE:
	      signature |= (3<<__OG_RASTER_TEX_ENV_SHIFT);
	      break;
	  case GL_ADD:
	      signature |= (4<<__OG_RASTER_TEX_ENV_SHIFT);
	      break;
	  }

	  /* Texture size */
	  assert(current->level->widthLog2 < 16);
	  assert(current->level->heightLog2 < 16);

	  /* MMX renderer doesn't care about texture width... */
	  /* ... but on MMX we use the bits for somethings else (see below) */
	  if (!MMX || !__glCanMmx(gc)) {
	      signature |=
		  (current->level->widthLog2 << __OG_RASTER_TEX_WIDTH_SHIFT) |
		  (current->level->heightLog2 << __OG_RASTER_TEX_HEIGHT_SHIFT);
	  }

	  /* Texture format */
	  baseFormat = current->texelFormat;
	  if (baseFormat == GL_COLOR_INDEX) {
	      signature |= __OG_RASTER_TEX_INDEX;
	      if (modeFlags & __GL_SHADE_RGB)
		  baseFormat = current->CT.baseFormat;
	  }

	  switch (baseFormat) {
	  case GL_LUMINANCE:
	      signature |= (0 << __OG_RASTER_TEX_FORMAT_SHIFT);
	      break;
	  case GL_LUMINANCE_ALPHA:
	      signature |= (1 << __OG_RASTER_TEX_FORMAT_SHIFT);
	      break;
	  case GL_RGB:
	      signature |= (2 << __OG_RASTER_TEX_FORMAT_SHIFT);
	      break;
	  case GL_RGBA:
	      signature |= (3 << __OG_RASTER_TEX_FORMAT_SHIFT);
	      break;
	  case GL_INTENSITY:
	      signature |= (4 << __OG_RASTER_TEX_FORMAT_SHIFT);
	      break;
	  case GL_ALPHA:
	      signature |= (5 << __OG_RASTER_TEX_FORMAT_SHIFT);
	      break;
	  }

#if 0 /* Currently this falls back to spanlet pipeline */
	  /* Texture wrap mode */
	  if (current->params.sWrapMode != GL_REPEAT)
	      signature |= __OG_RASTER_TEX_S_CLAMP;
	  if (current->params.tWrapMode != GL_REPEAT)
	      signature |= __OG_RASTER_TEX_S_CLAMP;

	  /* Texture border */
	  if (current->level->border)
	      signature |= __OG_RASTER_TEX_BORDER;
	
	  /* Texture filter */
	  if (current->params.minFilter != GL_NEAREST)
	      signature |= __OG_RASTER_TEX_MIN_LINEAR;

	  switch (current->params.magFilter) {
	  case GL_NEAREST:
	      signature |= (0<<__OG_RASTER_TEX_MAX_FILTER_SHIFT);
	      break;
	  case GL_LINEAR:
	      signature |= (1<<__OG_RASTER_TEX_MAX_FILTER_SHIFT);
	      break;
	  case GL_NEAREST_MIPMAP_NEAREST:	
	      signature |= (2<<__OG_RASTER_TEX_MAX_FILTER_SHIFT);
	      break;
	  case GL_LINEAR_MIPMAP_NEAREST:
	      signature |= (3<<__OG_RASTER_TEX_MAX_FILTER_SHIFT);
	      break;
	  case GL_NEAREST_MIPMAP_LINEAR:
	      signature |= (4<<__OG_RASTER_TEX_MAX_FILTER_SHIFT);
	      break;
	  case GL_LINEAR_MIPMAP_LINEAR:
	      signature |= (5<<__OG_RASTER_TEX_MAX_FILTER_SHIFT);
	      break;
	  }
#endif
      }
      if (MMX && __glCanMmx(gc)) {
	  /* Use these bits to represent the blend func.
	   */
	  if (modeFlags & __GL_SHADE_BLEND) {
	      signature |=
		  ((bf_to_index(gc->state.raster.blendSrc) << 
		    __OG_RASTER_TEX_WIDTH_SHIFT) |
		   (bf_to_index(gc->state.raster.blendDst) << 
		    __OG_RASTER_TEX_HEIGHT_SHIFT));
	  }
      }

#if 0  /* Currently this falls back to spanlet pipeline */
      /* Scissor or front-buffer clipmask */
      if (!gc->transform.reasonableViewport) {
	  signature |= __OG_RASTER_CLIP_SCISSOR;
      }
#endif

      if (modeFlags & __GL_SHADE_DEPTH_TEST) {

	  signature |= (gc->state.depth.testFunc & 7) <<
	      __OG_RASTER_DEPTH_FUNC_SHIFT;

	  if (gc->depthBuffer.buf.depth > 16) {
	      signature |= __OG_RASTER_DEPTH_SIZE32;
	  }
	  if (gc->state.depth.writeEnable) {
	      signature |= __OG_RASTER_DEPTH_WRITE;
	  }
      }
  }
  if (gc->buffers.doubleStore) {
      signature |= __OG_RASTER_DOUBLESTORE;
  }
  if (texNeedRho) {
      signature |= __OG_RASTER_RHO;
  }

  if (__glAllocCodeSpace(&gc->triRasterCache, 
			 modeFlags & MODEFLAGS_RASTERIZER_CARES_ABOUT, 
			 signature, 
			 &gc->tr,
			 &space)) {
      /* Found existing rasterizer which satisfies request! */
      return (rasterizer) (space + 2000);
