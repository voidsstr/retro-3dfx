@	  mov	eax, 'fptr->ist'
@	  mov	'fptr->st', eax
@  	  mov	eax, 'fptr->qit'
@  	  shl	eax, 16
@  	  size16
@	  mov	eax, 'fptr->qis'
@	  mov	'fptr->ist', eax

@         pcstepnext(tr, wl2, hl2, fptr);

@	  fdivr	'fpk(gc, 1.0)'
      } else {
@	  mov	eax,'fptr->st'
@	  mov	ebx,'fptr->dstdx2'
@	  add	eax,ebx
@	  mov	'fptr->st',eax
      }
@     jmp     perpixel_reload
    }

  if (interpolate_z) {
@   jmp	allover
@zfail:
    if (interpolate_color && (modeFlags & __GL_SHADE_SMOOTH)) {
      if (spill_rgb) {
@         mov	eax,'tr(r)'
@         mov	ebx,'tr(g)'
@         mov	ecx,'tr(b)'
      }

@     add	eax,'tr(drdx)'
@     add	ebx,'tr(dgdx)'
@     add	ecx,'tr(dbdx)'

      if (spill_rgb) {
@         mov	'tr(r)',eax
@         mov	'tr(g)',ebx
@         mov	'tr(b)',ecx
      }
    }

  if (modeFlags & __GL_SHADE_TEXTURE) {
@     mov	edx,'fptr->st'
@     mov	ebp,'fptr->dstdx'
@     add	edx,ebp
@     mov	'fptr->st',edx
  }

    if (modeFlags & __GL_SHADE_DITHER) {
@     mov	edi,dither_index
@     inc	edi
@     and	edi,3
@     mov	dither_index,edi
    }

@   mov edi,'tr(cp)'
@   add	edi,'tr(dcpdx)'
@   mov 'tr(cp)',edi

@   dec	w
@   jne	perpixel
    if (modeFlags & __GL_SHADE_TEXTURE)
@     jmp	adjuster

  }

@allover:

  if (modeFlags & __GL_SHADE_TEXTURE_PERSP) {
@	  	fstp	st0
@	  	fstp	st0
@	  	fstp	st0
@	  	fstp	st0
  }

  return cb;
}

STATIC unsigned char*
set_dither(__GLcontext* gc,
	   unsigned char* cb,
	   struct celem* tr,
	   struct celem* key,
	   int spanlet)
{
@   mov	eax,key
@   mov	ecx,'tr(y)'

@   and eax,#DITHER_MASK
@   and ecx,#DITHER_MASK

  /* ebx *= 35, or 0x23 */
@   mov	edx,ecx

@   add	edx,edx
@   add	edx,ecx
@   shl	ecx,5

@   add	ecx,edx
@   add	ecx,eax
  if (spanlet) {
@   mov	edx,'tr(ditherTable)'
@   lea	eax,[edx + ecx * 4]
  } else {
@   lea	eax,[#'(int)__glFRDitherTable' + ecx * 4]
  }
@   mov	'tr(dither)',eax

  return cb;
}

/********************************************
**  Rasterizer Cache
*********************************************/

/* mode bits for cache signature */
#define __OG_RASTER_SPANLETS			(1<<0)
#define __OG_RASTER_TEX_ENV_SHIFT		1	/* 3 bits */
#define __OG_RASTER_TEX_WIDTH_SHIFT		4	/* 4 bits */
#define __OG_RASTER_TEX_HEIGHT_SHIFT		8	/* 4 bits */
#define __OG_RASTER_TEX_INDEX			(1<<12)
#define __OG_RASTER_TEX_FORMAT_SHIFT		13	/* 3 bits */
#define __OG_RASTER_TEX_S_CLAMP			(1<<16)
#define __OG_RASTER_TEX_T_CLAMP			(1<<17)
#define __OG_RASTER_TEX_BORDER			(1<<18)
#define __OG_RASTER_TEX_MIN_LINEAR		(1<<19)
#define __OG_RASTER_TEX_MAX_FILTER_SHIFT	20	/* 3 bits */
#define __OG_RASTER_CLIP_SCISSOR		(1<<23)
#define __OG_RASTER_DEPTH_FUNC_SHIFT		24	/* 3 bits */
#define __OG_RASTER_DEPTH_SIZE32		(1<<27)
#define __OG_RASTER_DEPTH_WRITE			(1<<28)
#define __OG_RASTER_DOUBLESTORE			(1<<29)
#define __OG_RASTER_RHO				(1<<30)

#define MODEFLAGS_RASTERIZER_CARES_ABOUT \
    ~(__GL_SHADE_STIPPLE | __GL_SHADE_TWOSIDED | __GL_SHADE_CULL_FACE)

#define FORCE_DIRECT !MMX

/*
 * Input is a dword-aligned pointer [edi], and a count, in dwords.
 * Fill value is in eax.
 * 
 * edx, ebp, esi are unchanged.
 * 
 */
void __glGenerateMMXFill(__GLcontext *gc, unsigned char* cb)
{
    struct celem* even;
    struct celem* loop;
    struct celem* done;
    struct celem* done2;

    og_warmup(gc);

    even = near_label(gc);
    loop = near_label(gc);
    done = near_label(gc);
    done2 = near_label(gc);

@   test    edi,7
@   je      even
 
@   mov     [edi],eax
@   add     edi,4
@   dec     ecx
 
@ even:	
@   mov     ebx,ecx
@   shr     ecx,1
@   je      done
 
@   movd    mm0,eax
@   punpckldq mm0,mm0
@ loop:	
@   movq    [edi],mm0
@   add     edi,8
@   dec     ecx
@   jne     loop
 
@ done:	
@   test    ebx,1
@   je      done2
@   mov     [edi],eax
@   add     edi,4

@ done2:
@   ret
}

#if MMX

/* 
 * This needn't go into the gc because MMX is available
 * across all contexts.  This won't hold if
 * people build mixed MMX/non-MMX multi-processor machines
 * and run multi-thread/multi-context apps.
 */

int __glIsMmx(void)
{
    static int cold = 1;
    static int r;

    if (cold) {
	int d;
	char *force;

	cold = 0;

	force = getenv("__GL_FORCE_MMX");
	if (force) {
	    r = atoi(force);
	} else { 
	    __asm    push    eax
	    __asm    push    ebx
	    __asm    push    ecx
	    __asm    push    edx

	    __asm    mov eax,1
            __asm    __emit 0x0f
            __asm    __emit 0xa2
            __asm    mov d,edx

	    __asm    pop     edx
	    __asm    pop     ecx
	    __asm    pop     ebx
	    __asm    pop     eax

	    if (d & 0x00800000)
		r = 1;
	    else
		r = 0;
        }
    }
    return r;
}

/* Determines if this machine is capable of using MMX with the gc's
 * pixel format.  Uses only state that is available during early
 * context initialization.  This assumes that gc->drawBuffer and
 * gc->front are comparable formats.
 */
int __glCanMmx(__GLcontext* gc)
{
    GLuint modeFlags = gc->polygon.shader.modeFlags;

    return (__glIsMmx() &&
	    gc->modes.rgbMode &&
	    (gc->front->buf.depth <= 16));
}

STATIC
struct celem* mxk(__GLcontext *gc, GLint v)
{
    return mxk4(gc, v, v, v, v);
}

unsigned char* mmxgobit(__GLcontext *gc,
			unsigned char* cb,
			struct celem* r,
			int from, int to)
{
    if (from < to)
@       psllw	r, #'(to - from)'
    else if (from > to)
@       psrlw	r, #'(from - to)'

    return cb;
}

struct mmxinterp {
    struct celem *didx, *istagger;
};

struct mmxcolor {
    struct celem *r;
    struct celem *g;
    struct celem *b;
    struct celem *a;
};

struct __GLmmxtri {
    struct mmxinterp r, g, b, a, s, t, z;
    struct celem *zvalue, *zresult;
    struct celem *z_skew;
    struct celem* tex_s_shift;
    struct celem* tex_t_shift;
    struct celem* tex_s_kerrect;
    struct celem* tex_t_kerrect;
    struct celem* tex_t_mask;
    struct celem* spill_z;
    struct celem* spill_r;
    struct celem* spill_g;
    struct celem* spill_b;
    struct celem* spill_a;
    struct celem* spill_1;
    struct celem* dithers[4];
    struct celem* tex_a;
    struct celem* pixcopy; /* Sometimes blending needs a copy of
			    * destination pixels. */
    struct mmxcolor src, dst;
    struct mmxcolor sf, df;
    struct celem* prev_st;
    struct celem* next_pc;
    struct celem *indexTextureBase;
};

STATIC unsigned char* 
genread(__GLcontext *gc,
	unsigned char* cb,
	struct celem* target,
	GLenum baseFormat)
{
    switch (baseFormat) {
    case GL_RGB:
@       lea     eax,[eax + eax * 2]
@       lea     ecx,[ecx + ecx * 2]

@       movd    target,[ebp + eax]
@       punpckldq target,[ebp + ecx]

        break;
    case GL_RGBA:
@       movd    target,[ebp + eax * 4]
@       punpckldq target,[ebp + ecx * 4]
        break;
    default:
        assert(0);
    }

    return cb;
}

/* Given a blend function 'func', set 'factor' appropriately.
 * This may be just setting the variables in factor to the appropriate
 * terms, or it may involve generating a little code.
 */
STATIC unsigned char*
calc_blend_factor(__GLcontext *gc,
		  unsigned char* cb,
		  struct mmxcolor *factor,
		  struct __GLmmxtri *mmxtr,
		  GLenum func)
{
    GLboolean must_save = GL_FALSE;
    GLboolean copy_red = GL_FALSE;
    struct celem* alpha_one = mxk(gc, 0x4000);
    struct celem* alpha_oneX2 = mxk(gc, 0x8000);

    switch (func) {
    case GL_ZERO:
	factor->r = mxk(gc, 0);
	factor->g = mxk(gc, 0);
	factor->b = mxk(gc, 0);
	break;
    case GL_ONE:
	factor->r = alpha_one;
	factor->g = alpha_one;
	factor->b = alpha_one;
	break;
    case GL_DST_COLOR:
@	movq    mm0,'mmxtr->dst.r'
@	movq    mm1,'mmxtr->dst.g'
@	movq    mm2,'mmxtr->dst.b'

@	psrlw   mm0,1
@	psrlw   mm1,1
@	psrlw   mm2,1

	must_save = GL_TRUE;
	break;
    case GL_SRC_COLOR:
@	movq    mm0,'mmxtr->src.r'
@	movq    mm1,'mmxtr->src.g'
@	movq    mm2,'mmxtr->src.b'

@	psrlw   mm0,1
@	psrlw   mm1,1
@	psrlw   mm2,1

	must_save = GL_TRUE;
	break;
    case GL_ONE_MINUS_DST_COLOR:
@	movq    mm0,alpha_oneX2
@       movq    mm1,mm0
@       movq    mm2,mm0

@	psubw   mm0,'mmxtr->dst.r'
@	psubw   mm1,'mmxtr->dst.g'
@	psubw   mm2,'mmxtr->dst.b'

@	psrlw   mm0,1
@	psrlw   mm1,1
@	psrlw   mm2,1

	must_save = GL_TRUE;
	break;
    case GL_ONE_MINUS_SRC_COLOR:
@	movq    mm0,alpha_oneX2
@       movq    mm1,mm0
@       movq    mm2,mm0

@	psubw   mm0,'mmxtr->src.r'
@	psubw   mm1,'mmxtr->src.g'
@	psubw   mm2,'mmxtr->src.b'

@	psrlw   mm0,1
@	psrlw   mm1,1
@	psrlw   mm2,1

	must_save = GL_TRUE;
	break;
    case GL_SRC_ALPHA:
	factor->r = mmxtr->src.a;
	copy_red = GL_TRUE;
	break;
    case GL_ONE_MINUS_SRC_ALPHA:
@	movq    mm0,alpha_one
@       psubw   mm0,'mmxtr->src.a'
@	movq    'factor->r',mm0
	copy_red = GL_TRUE;
	break;
    case GL_DST_ALPHA:
	factor->r = mmxtr->dst.a;
	copy_red = GL_TRUE;
	break;
    case GL_ONE_MINUS_DST_ALPHA:
@	movq    mm0,alpha_one
@       psubw   mm0,'mmxtr->dst.a'
@	movq    'factor->r',mm0
	copy_red = GL_TRUE;
	break;
    case GL_SRC_ALPHA_SATURATE:

	/* load mm0 with 1-<dst alpha>
	 *      mm1 with <src alpha>
	 */

@	movq    mm0,alpha_one
@       psubw   mm0,'mmxtr->dst.a'
@	movq    mm1,'mmxtr->src.a'
@       movq    mm2,mm0
@       pcmpgtw mm0,mm1		; (mm2 > mm1) ? 0xffff : 0x0000
@       pand    mm1,mm0
@       pandn   mm0,mm2
@       por     mm0,mm1
@	movq    'factor->r',mm0
        copy_red = GL_TRUE;
    }

    if (copy_red) {
	factor->g = factor->b = factor->r;
    }
    if (must_save) {
	/* factor.[rgb] point to some memory by default.
	 * save mm[012] there.
	 */
@	movq    'factor->r',mm0
@	movq    'factor->g',mm1
@	movq    'factor->b',mm2
    }

    return cb;
}


/* 
 *  Predicate to identify common situations where
 *  we don't want to clamp.  This is true
 *  (1) when one term is GL_ZERO
 *  (2) when the 2 terms are complementary: ALPHA, 1-ALPHA.
 */
STATIC GLboolean
clamp_blend_factor(GLenum src, GLenum dst)
{
    if ((src == GL_ZERO) || (dst = GL_ZERO))
	return GL_FALSE;

    if ((src == GL_SRC_ALPHA) &&
	(dst == GL_ONE_MINUS_SRC_ALPHA))
	return GL_FALSE;

    if ((src == GL_ONE_MINUS_SRC_ALPHA) &&
	(dst == GL_SRC_ALPHA))
	return GL_FALSE;

    return GL_TRUE;
}

STATIC unsigned char*
genblend(__GLcontext* gc,
	 unsigned char* cb,
	 struct __GLmmxtri *mmxtr,
	 GLint c_stride,
	 struct celem* cp)
{
    GLuint modeFlags = gc->polygon.shader.modeFlags;
    __GLcolorBuffer* fb = &gc->frontBuffer;
    GLuint redSize = log2(fb->redMax);
    GLuint greenSize = log2(fb->greenMax);
    GLuint blueSize = log2(fb->blueMax);
    GLuint hibit;

#if DEBUG
    {
        struct celem *bad = near_label(gc);
        struct celem *good = near_label(gc);

@       mov     eax,[#'(int)&gc->state.raster.blendSrc']
@       cmp     eax,#'gc->state.raster.blendSrc'
@       jne     bad
@       mov     eax,[#'(int)&gc->state.raster.blendDst']
@       cmp     eax,#'gc->state.raster.blendDst'
@       je      good
@ bad:
@       int3
@ good:
    }
#endif /* DEBUG */

    /* Load up destination.  We don't currently support destination alpha,
     * so it's RGB only here.
     */
    if (c_stride == 8) {
@       movq    mm0,cp
    } else {
@       movd    mm0,cp
@       pxor    mm1,mm0
@	punpcklbw mm0,mm1
    }

@   movq    mm1,mm0
@   movq    mm2,mm0

@   mmxgobit(mm0, 'fb->redShift + redSize', '(14)')
@   mmxgobit(mm1, 'fb->greenShift + greenSize', '(14)')
@   mmxgobit(mm2, 'fb->blueShift + blueSize', '(14)')

@   pand    mm0,'mxk(gc, fb->redMax << (13 - (redSize - 1)))'
@   pand    mm1,'mxk(gc, fb->greenMax << (13 - (greenSize - 1)))'
@   pand    mm2,'mxk(gc, fb->blueMax << (13 - (blueSize - 1)))'

    if ((gc->state.raster.blendSrc == GL_ONE) &&
	(gc->state.raster.blendDst == GL_ONE)) {

@       paddsw  mm0,'mmxtr->src.r'
@       paddsw  mm1,'mmxtr->src.g'
@       paddsw  mm2,'mmxtr->src.b'

	hibit = 14;

    } else {
@   	movq    'mmxtr->dst.r',mm0
@   	movq    'mmxtr->dst.g',mm1
@   	movq    'mmxtr->dst.b',mm2
    
    	/* Now we have source and destination, calculate blend factors */
@   	calc_blend_factor('&mmxtr->sf', mmxtr, 'gc->state.raster.blendSrc');
@   	calc_blend_factor('&mmxtr->df', mmxtr, 'gc->state.raster.blendDst');
    
    	if (gc->state.raster.blendSrc == GL_ZERO) {
@   	    movq    mm0,'mmxtr->dst.r'
@   	    pmulhw  mm0,'mmxtr->df.r'
    	
@   	    movq    mm1,'mmxtr->dst.g'
@   	    pmulhw  mm1,'mmxtr->df.g'
    	
@   	    movq    mm2,'mmxtr->dst.b'
@   	    pmulhw  mm2,'mmxtr->df.b'
    
	    hibit = 12;
    	} else {
@   	    movq    mm0,'mmxtr->src.r'
@   	    pmulhw  mm0,'mmxtr->sf.r'
@   	    movq    mm1,'mmxtr->dst.r'
@   	    pmulhw  mm1,'mmxtr->df.r'
@   	    paddsw  mm0,mm1
    	
@   	    movq    mm1,'mmxtr->src.g'
@   	    pmulhw  mm1,'mmxtr->sf.g'
@   	    movq    mm2,'mmxtr->dst.g'
@   	    pmulhw  mm2,'mmxtr->df.g'
@   	    paddsw  mm1,mm2
    	
@   	    movq    mm2,'mmxtr->src.b'
@   	    pmulhw  mm2,'mmxtr->sf.b'
@   	    movq    mm3,'mmxtr->dst.b'
@   	    pmulhw  mm3,'mmxtr->df.b'
@   	    paddsw  mm2,mm3
    
	    hibit = 12;
    	}
    
    	/* Now we might have to clamp.
    	   This isn't free, so there are certain common situations where
    	   we don't want to clamp.
    	   (1) When one term is GL_ZERO
    	   (2) When the 2 terms are complementary: ALPHA, 1-ALPHA
    	   */
    
    	if (clamp_blend_factor(gc->state.raster.blendSrc, 
				gc->state.raster.blendDst)) {
    	    while (hibit < 14) {
@		paddsw  mm0,mm0
@		paddsw  mm1,mm1
@		paddsw  mm2,mm2
    
    		hibit++;
    	    }
    	}   
    }
	
    if (modeFlags & __GL_SHADE_DITHER) {
@	mmxgobit(mm0, hibit, '(14)');
    	
@   	paddsw  mm0,'mmxtr->dithers[0]'
@	mmxgobit(mm1, hibit, '(14)');
    	
@   	paddsw  mm1,'mmxtr->dithers[1]'
@	mmxgobit(mm2, hibit, '(14)');
    	
@   	paddsw  mm2,'mmxtr->dithers[2]'
    	
    	hibit = 14;
    }

@   mmxgobit(mm0, hibit, 'fb->redShift + redSize')
@   pand    mm0,'mxk(gc, fb->redMax << fb->redShift)'

@   mmxgobit(mm1, hibit, 'fb->greenShift + greenSize')
@   pand    mm1,'mxk(gc, fb->greenMax << fb->greenShift)'

@   mmxgobit(mm2, hibit, 'fb->blueShift + blueSize')

@   por	mm0,mm1
@   por	mm0,mm2

    return cb;
}

STATIC GLboolean
has_alpha(GLenum baseFormat)
{
    switch (baseFormat) {
    case GL_ALPHA:
    case GL_LUMINANCE_ALPHA:
    case GL_INTENSITY:
    case GL_RGBA:
	return GL_TRUE;
    case GL_LUMINANCE:
    case GL_RGB:
	return GL_FALSE;
    default:
	assert(0);
    }
}

STATIC unsigned char*
genpix(__GLcontext* gc,
       unsigned char* cb,
       struct celem** result,
       struct celem* tr,
       struct __GLmmxtri *mmxtr,
       GLint c_stride,
       struct celem* step,
       GLint dx,
       struct celem* cp,
       GLenum texenv)
{
    GLuint modeFlags = gc->polygon.shader.modeFlags;
    __GLcolorBuffer* fb = &gc->frontBuffer;
    struct celem
      *rstep,
      *gstep,
      *bstep,
      *astep;
    struct celem
      *sstep,
      *tstep;
    GLuint redSize = log2(fb->redMax);
    GLuint greenSize = log2(fb->greenMax);
    GLuint blueSize = log2(fb->blueMax);
    GLboolean do_blend;
    __GLtexture *current;
    GLenum baseFormat;
    GLboolean indexed = GL_FALSE;

    if (modeFlags & __GL_SHADE_TEXTURE) {
	current = gc->texture.currentTexture;
	baseFormat = current->texelFormat;
	if (baseFormat == GL_COLOR_INDEX) {
	    /* Index texture.  Set the flag, and find the real format.
	     */
	    indexed = GL_TRUE;
	    baseFormat = current->CT.baseFormat;
	}
    }

    do_blend = (modeFlags & __GL_SHADE_BLEND) ? GL_TRUE : GL_FALSE;

    if (modeFlags & __GL_SHADE_SMOOTH) {
	if (step) {
	    rstep = mmxtr->r.didx;
	    gstep = mmxtr->g.didx;
	    bstep = mmxtr->b.didx;
	    astep = mmxtr->a.didx;
	}
    }

    if (modeFlags & __GL_SHADE_TEXTURE) {
	GLboolean cookedTexture;

	if ((modeFlags & (__GL_SHADE_BLEND|__GL_SHADE_TEXTURE|__GL_SHADE_RGB|__GL_SHADE_DITHER)) ==
	    (__GL_SHADE_TEXTURE|__GL_SHADE_RGB)) {
	    cookedTexture =
		(texenv == GL_REPLACE) &&
		(current->texelFormat != GL_COLOR_INDEX);
	} else {
	    cookedTexture = GL_FALSE;
	}

	if (step) {
	    sstep = mmxtr->s.didx;
	    tstep = mmxtr->t.didx;
	}

	/* 
	 * Build 2 pairs of offsets in mm0,mm1.
	 */

@	movq    mm3,'mmxtr->tex_s_shift'
@	movq    mm1,mm7
	
@	psrlw   mm1,'mmxtr->tex_t_shift'
@	movq    mm0,mm6
	
@	movq    mm2,mm6
@       punpcklwd mm0,mm1
	
        if (step)
@       	paddw   mm6,sstep
@       punpckhwd mm2,mm1
	
        if (step)
@       	paddw   mm7,tstep
@	psrld   mm0,mm3
	
@	psrld   mm2,mm3

        if (indexed) {
@	    paddd  mm0,'mmxtr->indexTextureBase'
@	    paddd  mm2,'mmxtr->indexTextureBase'
	}

        if (step == eax)
@           push    eax

        if (cookedTexture) {
	    GLint texsize = c_stride / 4;

	    assert(!do_blend);

@	    movd    eax,mm0
@	    punpckhdq mm0,mm0
@	    movd    ecx,mm0
@	    movq    mm0,mm2

	    // stall

	    if (texsize == 2) {
@	    	mov     dl,[0 + ebp + ecx * 2]
    
@	    	mov     dh,[1 + ebp + ecx * 2]
@	    	mov     cl,[0 + ebp + eax * 2]
    
@	    	shl     edx,16
@	    	mov     ch,[1 + ebp + eax * 2]
    
@	    	movd    eax,mm0
@		punpckhdq mm0,mm0
    
@           	or      edx,ecx

@	    	movd    ecx,mm0
    
@           	movd    mm0,edx
    
@	    	mov     dl,[0 + ebp + ecx * 2]
    
@	    	mov     dh,[1 + ebp + ecx * 2]
@	    	mov     cl,[0 + ebp + eax * 2]
    
@	    	shl     edx,16
@	    	mov     ch,[1 + ebp + eax * 2]

@               or      edx,ecx

@	        movd    mm2,edx

@	        punpckldq mm0,mm2
	    } else {
@	    	mov     dl,[0 + ebp + eax]

@	    	mov     dh,[0 + ebp + ecx]

@	    	movd    eax,mm0
@		punpckhdq mm0,mm0

@	    	movd     ecx,mm0
@		pxor    mm1,mm1

@	    	mov     al,[0 + ebp + eax]
@		and	edx,0xffff

@	    	mov     ah,[0 + ebp + ecx]

@	    	shl     eax,16

@		or	edx,eax

@		movd    mm0,edx

@		punpcklbw mm0,mm1
	    }

            if (step == eax)
@               pop    eax
            else if (modeFlags & __GL_SHADE_TEXTURE_PERSP)
@               mov    eax,'mmxtr->next_pc'
        } else {
	    GLuint hibit;

	    /* Be warned, the rules for handling glTexEnv with the
	     * various texture formats are somewhat arcane...
	     */

	    if (modeFlags & __GL_SHADE_DEPTH_TEST)
@               movq    'mmxtr->spill_z',mm4

@	    movd    eax,mm0
@	    punpckhdq mm0,mm0
@	    movd    ecx,mm0
@	    movq    mm0,mm2

	    if (indexed) {
@		mov    al,[eax]
@		mov    cl,[ecx]
@		and    eax,255
@		and    ecx,255
	    }

            switch (baseFormat) {
	    case GL_LUMINANCE:
	    case GL_INTENSITY:
@		mov     dl,[ebp + eax]
@		mov     dh,[ebp + ecx]
@               shl     edx,16

@		movd    eax,mm0
@		punpckhdq mm0,mm0
@		movd    ecx,mm0

	    	if (indexed) {
@		    mov    al,[edx + eax]
@		    mov    cl,[edx + ecx]
@		    and    eax,255
@		    and    ecx,255
	    	}   

@		mov     dl,[ebp + eax]
@		mov     dh,[ebp + ecx]
@               rol     edx,16

@               movd    mm0,edx
@               punpcklbw mm0,mm0
 		if (step == eax)
@		    pop    eax
                else if (modeFlags & __GL_SHADE_TEXTURE_PERSP)
@                   mov    eax,'mmxtr->next_pc'
@               psrlw   mm0,1

@               movq    mm1,mm0
@               movq    mm2,mm0
		if (do_blend && has_alpha(baseFormat)) {
@		    movq    mm3,mm0
@	            psrlw   mm3,1
@		    movq    'mmxtr->tex_a',mm3
		}

		break;
	    case GL_LUMINANCE_ALPHA:
@		size16
@	        mov     edx,[ebp + ecx * 2]
@		shl     edx,16
@		size16
@	        mov     edx,[ebp + eax * 2]
@		movd    mm3,edx

@		movd    eax,mm0
@		punpckhdq mm0,mm0
@		movd    ecx,mm0

	    	if (indexed) {
@		    mov    al,[eax]
@		    mov    cl,[ecx]
@		    and    eax,255
@		    and    ecx,255
	    	}   

@		size16
@	        mov     edx,[ebp + ecx * 2]
@		shl     edx,16
@		size16
@	        mov     edx,[ebp + eax * 2]
@		movd    mm2,edx

		/* Now we have luminance-alpha values in the low
		 * halves of mm2,mm3.  Luminance is in the low byte of
		 * each word, alpha is in the high byte. */

@		punpckldq mm3,mm2	; Now 4 pixels are in a qword.
@		movq    mm0,mm3
@		psrlw   mm3,2		; Alpha
@		psllw   mm0,7		; Luminance
@		pand    mm3,'mxk(gc, 0x3fc0)'
@		pand    mm0,'mxk(gc, 0x7f80)'

 		if (step == eax)
@		    pop    eax
                else if (modeFlags & __GL_SHADE_TEXTURE_PERSP)
@                   mov    eax,'mmxtr->next_pc'

@               movq    mm1,mm0
@               movq    mm2,mm0
		if (do_blend) {
@		    movq    'mmxtr->tex_a',mm3
		}

		break;
            case GL_RGB:
            case GL_RGBA:
@		genread(mm3, baseFormat);

@		movd    eax,mm0
@		punpckhdq mm0,mm0
@		movd    ecx,mm0

	    	if (indexed) {
@		    mov    al,[eax]
@		    mov    cl,[ecx]
@		    and    eax,255
@		    and    ecx,255
	    	}   

@		genread(mm4, baseFormat);
    
 		if (step == eax)
@		    pop    eax
                else if (modeFlags & __GL_SHADE_TEXTURE_PERSP)
@                   mov    eax,'mmxtr->next_pc'
    
@		lea     ecx,'mxk4(gc, 0x7f80, 0x0, 0x7f80, 0x0)'

		/* Extract alpha from texture */
		if (do_blend && has_alpha(baseFormat)) {
@		    movq    mm0,mm3
@		    movq    mm1,mm4
@		    psrld   mm0,18
@		    psrld   mm1,18
@		    pand    mm0,'mxk4(gc, 0x3fc0, 0x0, 0x3fc0, 0x0)'
@		    pand    mm1,'mxk4(gc, 0x3fc0, 0x0, 0x3fc0, 0x0)'
@		    packssdw mm0,mm1
@		    movq    'mmxtr->tex_a',mm0
		}

@		movq    mm0,mm3
@		movq    mm1,mm4
@		pslld   mm0,7
@		pslld   mm1,7
@		pand    mm0,[ecx]
@		pand    mm1,[ecx]
@		packssdw mm0,mm1	; mm0 holds red

@		movq    mm1,mm3
@		movq    mm2,mm4
@		psrld   mm1,1
@		psrld   mm2,1
@		pand    mm1,[ecx]
@		pand    mm2,[ecx]
@		packssdw mm1,mm2	; mm1 holds green

@		psrld   mm3,9
@		psrld   mm4,9
@		pand    mm3,[ecx]
@		pand    mm4,[ecx]
@		movq    mm2,mm3
@		packssdw mm2,mm4	; mm2 holds blue
	        break;
	    default:
		assert(0);
            }

	    if (texenv == GL_MODULATE) {
		/* Texture with alpha component, modulate alpha with
                   fragment alpha */
		if (do_blend) {
		    if (has_alpha(baseFormat)) {
@		    	movq    mm3,'mmxtr->tex_a'
@		    	pmulhw  mm3,'mmxtr->spill_a'
@		    	psllw   mm3,2
@	            	movq    'mmxtr->tex_a',mm3
		    }
		}
                if (modeFlags & __GL_SHADE_SMOOTH) {
@		    movq      mm3,'mmxtr->spill_g'
@		    pmulhw    mm0,mm5
    
		    if (step)
@			paddw     mm5,rstep
@		    pmulhw    mm1,mm3
    
@		    movq      mm4,'mmxtr->spill_b'
@		    pmulhw    mm2,mm4

 		    if (step) {
@			paddw     mm3,gstep
@			paddw     mm4,bstep
@			movq      'mmxtr->spill_g',mm3
@			movq      'mmxtr->spill_b',mm4
                    }
                } else {
@                   pmulhw   mm0,'mmxtr->spill_r'
@                   pmulhw   mm1,'mmxtr->spill_g'
@                   pmulhw   mm2,'mmxtr->spill_b'
                }

                hibit = 13;
            } else {
		hibit = 14;
	    }

	    if (!do_blend) {
            	if (modeFlags & __GL_SHADE_DITHER) {
            	     if (hibit == 13) {
@           		 psllw   mm0,1
    
@			 paddsw  mm0,'mmxtr->dithers[0]'
@           		 psllw   mm1,1
    
@			 paddsw  mm1,'mmxtr->dithers[1]'
@           		 psllw   mm2,1
    
@			 paddsw  mm2,'mmxtr->dithers[2]'
    
			 hibit = 14;
		     } else {
@			 paddsw  mm0,'mmxtr->dithers[0]'
@			 paddsw  mm1,'mmxtr->dithers[1]'
@			 paddsw  mm2,'mmxtr->dithers[2]'
		     }
	    	}
    
@	    	pand	mm1,'mxk(gc, fb->greenMax << (hibit - greenSize))'
@	    	mmxgobit(mm0, hibit, 'fb->redShift + redSize')
    	
@	    	pand	mm0,'mxk(gc, fb->redMax << fb->redShift)'
@	    	mmxgobit(mm2, hibit, 'fb->blueShift + blueSize')
    
@	    	mmxgobit(mm1, hibit, 'fb->greenShift + greenSize')
@	    	por	mm0,mm2

@	    	por	mm0,mm1
	    } else {
@		mmxgobit(mm0, hibit, '(14)');
@		mmxgobit(mm1, hibit, '(14)');
@		mmxgobit(mm2, hibit, '(14)');

@		movq    'mmxtr->src.r',mm0
@		movq    'mmxtr->src.g',mm1
@		movq    'mmxtr->src.b',mm2

		/* If the texture format has alpha, use it; otherwise
		   take alpha from the fragment.  */

		if (has_alpha(baseFormat))
		    mmxtr->src.a = mmxtr->tex_a;     /* At */
		else
		    mmxtr->src.a = mmxtr->spill_a;   /* Af */

@	        genblend(mmxtr, c_stride, cp);
                if ((modeFlags & __GL_SHADE_SMOOTH) && step) {
@		        movq    mm3,'mmxtr->spill_a'
@			paddw   mm3,astep
@			movq    'mmxtr->spill_a',mm3
	        }
	    }

	    if (modeFlags & __GL_SHADE_DEPTH_TEST)
@               movq    mm4,'mmxtr->spill_z'
        }

	*result = mm0;
    } else {
	if ((modeFlags & __GL_SHADE_SMOOTH) == 0) {
	    if (!do_blend) {
@	        movq    mm0,mm7
	    } else {
		/* The colors are already present in spill_[rgb] */
		mmxtr->src.r = mmxtr->spill_r;
		mmxtr->src.g = mmxtr->spill_g;
		mmxtr->src.b = mmxtr->spill_b;

		mmxtr->src.a = mmxtr->spill_a;

@		genblend(mmxtr, c_stride, cp);
	    }

	    *result = mm0;
 	} else {
	    if (!do_blend) {
 	    	if (step)
@		    movq   mm3,gstep
@	    	movq	mm0,mm5
    
@	    	mmxgobit(mm0, '(14)', 'fb->redShift + redSize')
@	    	movq	mm1,mm6
    
@	    	pand	mm0,'mxk(gc, fb->redMax << fb->redShift)'
@	    	mmxgobit(mm1, '(14)', 'fb->greenShift + greenSize')
    
@	    	pand	mm1,'mxk(gc, fb->greenMax << fb->greenShift)'
@	    	movq	mm2,mm7
    
@	    	mmxgobit(mm2, '(14)', 'fb->blueShift + blueSize')
@	    	por	mm0,mm1
    
	    	if (step)
@		    paddw   mm5,rstep
@	    	por	mm0,mm2
    
 	    	if (step) {
@		    paddw   mm7,bstep
@		    paddw   mm6,mm3
 	    	}
	    } else {
		mmxtr->src.r = mm5;
		mmxtr->src.g = mm6;
		mmxtr->src.b = mm7;
		mmxtr->src.a = mmxtr->spill_a;

@		genblend(mmxtr, c_stride, cp);

	    	if (step) {
@		    movq    mm1,'mmxtr->spill_a'
@		    paddw   mm1,astep
@		    paddw   mm5,rstep
@		    paddw   mm6,gstep
@		    paddw   mm7,bstep
@		    movq    'mmxtr->spill_a',mm1
		}
	    }
    
	    *result = mm0;
 	}
    }

    return cb;
}

STATIC unsigned char* 
genstep(__GLcontext* gc,
	unsigned char* cb,
	struct celem* tr,
	struct __GLmmxtri *mmxtr,
	struct celem* step,
	GLint dx,
	GLenum texenv)
{
    GLuint modeFlags = gc->polygon.shader.modeFlags;
    __GLcolorBuffer* fb = &gc->frontBuffer;
    struct celem
	*rstep,
	*gstep,
	*bstep,
	*astep,
	*sstep,
	*tstep;

    if (step) {
	rstep = mmxtr->r.didx;
	gstep = mmxtr->g.didx;
	bstep = mmxtr->b.didx;
	astep = mmxtr->a.didx;
	sstep = mmxtr->s.didx;
	tstep = mmxtr->t.didx;

    	if ((modeFlags & __GL_SHADE_SMOOTH) &&
	    !((modeFlags & __GL_SHADE_TEXTURE) &&
	      (texenv == GL_REPLACE))) {
@	    paddw   mm5,rstep
	    if ((modeFlags & __GL_SHADE_TEXTURE) &&
		(texenv == GL_MODULATE)) {
@   		movq    mm0,'mmxtr->spill_g'
@   		movq    mm1,'mmxtr->spill_b'
@		paddw   mm0,gstep
@		paddw   mm1,bstep
@   		movq    'mmxtr->spill_g',mm0
@   		movq    'mmxtr->spill_b',mm1
    	    } else {
@		paddw   mm6,gstep
@		paddw   mm7,bstep
    	    }
    	}
	if ((modeFlags & __GL_SHADE_BLEND) &&
	    (modeFlags & __GL_SHADE_SMOOTH)) {
@	    movq    mm0,'mmxtr->spill_a'
@	    paddw   mm0,astep
@	    movq    'mmxtr->spill_a',mm0
	}

    	if (modeFlags & __GL_SHADE_TEXTURE) {
@	    paddw   mm6,sstep
@	    paddw   mm7,tstep
    	}
    }
    	    
    return cb;
}

/* 
 * Preshift is shift of inital Z value
 * alive is which results matter
 *
 * Writes Z value
 */

STATIC unsigned char*
genz(__GLcontext *gc,
     unsigned char* cb,
     struct celem* tr,
     struct __GLmmxtri *mmxtr,
     struct celem* cp,
     struct celem* cp_read,
     struct celem* zp,
     struct celem* step,
     GLint dx,
     struct celem* alive,
     struct celem* win,
     struct celem* lose,
     struct celem* mixpix,
     GLenum texenv)
{
    struct celem* dostep = near_label(gc);
    struct celem* zstep = NULL;

    if (step) {
	zstep = mmxtr->z.didx;
    }

    if (gc->depthBuffer.buf.depth == 16) {
@	movq    mm0,mm4
@	movq    mm2,mm4

	if (dx == 1)
@	    paddd   mm2,'mmxtr->z_skew'
	else
@	    paddd   mm0,'mmxtr->z_skew'

@	pand    mm2,'mxk4(gc, 0, ~0, 0, ~0)'
@	psrld   mm0,16

 	if (gc->state.depth.testFunc != GL_ALWAYS)
@	    movq    mm1,zp
@	por     mm0,mm2

 	/*
 	 * Input:
 	 *     mm0   Generated Z value
 	 *     mm1   Z-buffer value
 	 *     mm2   scratch
 	 *
 	 * Output:
 	 *     mm0   Generated Z value
 	 *     mm1   Success mask: 0x0000 means lose, 0xffff means win
 	 *     mm2   scratch
 	 */

 	switch (gc->state.depth.testFunc) {
 	case GL_NEVER:
@	    pxor    mm1,mm1
 	    break;
 	case GL_LESS:
@	    movq    mm2,mm0
@	    movq    mm3,mm0
@	    psubw   mm2,mm1
@	    psubusw mm3,mm1
@	    pcmpeqw mm2,mm3
@	    pcmpeqw mm1,mm1
@	    pxor    mm1,mm2
 	    break;
 	case GL_EQUAL:
@	    pcmpeqw mm1,mm0
	    break;
 	case GL_LEQUAL:
@	    movq    mm2,mm1
@	    psubw   mm1,mm0
@	    psubusw mm2,mm0
@	    pcmpeqw mm1,mm2
 	    break;
 	case GL_GREATER:
@	    movq    mm2,mm1
@	    psubw   mm1,mm0
@	    psubusw mm2,mm0
@	    pcmpeqw mm1,mm2
@	    pcmpeqw mm2,mm2
@	    pxor    mm1,mm2
 	    break;
 	case GL_NOTEQUAL:
@	    pcmpeqw mm1,mm0
@	    pcmpeqw mm2,mm2
@	    pxor    mm1,mm2
 	    break;
 	case GL_GEQUAL:
@	    movq    mm2,mm0
@	    movq    mm3,mm0
@	    psubw   mm2,mm1
@	    psubusw mm3,mm1
@	    pcmpeqw mm2,mm3
@	    movq    mm1,mm2
 	    break;
 	}

 	/* Now 
 	 * mm0 is new Z
 	 * mm1 is result of comparison
 	 * [esi] is original Z
 	 */

 	/* 0x00 means lose, 0xff means win */

 	/* Mask to stop us winning over the edges */
 	if (alive) {
@	    movd	mm2,alive
@	    punpcklbw mm2,mm2
 	    if (gc->state.depth.testFunc != GL_ALWAYS)
@		pand    mm1,mm2
	    else
@		movq    mm1,mm2
 	}

 	if ((gc->state.depth.testFunc != GL_ALWAYS) ||
	    alive) {
@	    movq    mm2,mm1
@	    packsswb mm1,mm1

            if (gc->state.depth.writeEnable) {
@	    	pand    mm0,mm2
    
@	    	pandn   mm2,zp
	    }
    
@	    movd    ecx,mm1
            if (gc->state.depth.writeEnable)
@	        por     mm0,mm2

 	    if (step)
@		paddd   mm4,zstep

            if (gc->state.depth.writeEnable)
@	        movq    zp,mm0

@	    test    ecx,ecx
@	    je      dostep
 	} else {
 	    if (step)
@		paddd   mm4,zstep

@	    movq    zp,mm0
@	    jmp     win
        }
    } else {
	struct celem* zp8;

	zp8 = mem(gc, value(gc, 8), zp->spec.mem.reg1, zp->spec.mem.reg2, zp->spec.mem.scale);

	/* Form a new quadruplet of Z-values in mm3,mm4 */

@       movq    mm3,mm4

	if (dx == -1)
@	    paddd   mm3,'mmxtr->z_skew'
	else
@	    paddd   mm4,'mmxtr->z_skew'

 	switch (gc->state.depth.testFunc) {
 	case GL_ALWAYS:
@           pcmpeqd mm0,mm0
@           pcmpeqd mm1,mm1
 	    break;

 	case GL_NEVER:
@           pxor    mm0,mm0
@           pxor    mm1,mm1
 	    break;

 	case GL_LESS:
@           movq    mm0,zp
@           pcmpgtd mm0,mm3
@           movq    mm1,zp8
@           pcmpgtd mm1,mm4
 	    break;

 	case GL_EQUAL:
@           movq    mm0,zp
@           pcmpeqd mm0,mm3
@           movq    mm1,zp8
@           pcmpeqd mm1,mm4
	    break;

 	case GL_LEQUAL:
@           movq    mm0,mm3
@           pcmpgtd mm0,zp
@           movq    mm1,mm4
@           pcmpgtd mm1,zp8

@           pcmpeqw mm2,mm2
@           pxor    mm0,mm2
@           pxor    mm1,mm2

 	    break;
 	case GL_GREATER:
@           movq    mm0,mm3
@           pcmpgtd mm0,zp
@           movq    mm1,mm4
@           pcmpgtd mm1,zp8
 	    break;

 	case GL_NOTEQUAL:
@           movq    mm0,zp
@           pcmpeqd mm0,mm3
@           movq    mm1,zp8
@           pcmpeqd mm1,mm4

@           pcmpeqw mm2,mm2
@           pxor    mm0,mm2
@           pxor    mm1,mm2
 	    break;

 	case GL_GEQUAL:
@           movq    mm0,zp
@           pcmpgtd mm0,mm3
@           movq    mm1,zp8
@           pcmpgtd mm1,mm4
@           pcmpeqw mm2,mm2
@           pxor    mm0,mm2
@           pxor    mm1,mm2
 	    break;
 	}

@       movq    mm2,mm0
@       packssdw mm2,mm1

 	/* Now 
 	 * mm3,4 is new Z
	 * mm0,mm1 are masks
 	 * mm2 is result of comparison
 	 * [esi] is original Z
 	 */

 	/* 0x00 means lose, 0xff means win */

 	/* Mask to stop us winning over the edges */
 	if (alive) {
@	    movd      mm1,alive
@	    punpcklbw mm1,mm1
@	    pand    mm2,mm1
 	}
@       movq    mm1,mm2
@	packsswb mm2,mm2
@       movd    ecx,mm2

        if (gc->state.depth.writeEnable) {
@           movq    mm0,mm1
@           punpckhwd mm1,mm1
@           punpcklwd mm0,mm0

@           pand    mm3,mm0
@           pandn   mm0,zp
@           por     mm0,mm3
@           movq    zp,mm0

@           movq    mm2,mm4
@           pand    mm2,mm1
@           pandn   mm1,zp8
@           por     mm1,mm2
@           movq    zp8,mm1
	}

 	if (step) {
	    if (dx == -1)
@	        paddd   mm4,'mmxtr->z.didx'
	    else
@	        paddd   mm4,'mmxtr->z_skew'
	}

@	test    ecx,ecx
@	je      dostep

@       movd    mm1,ecx
    }

    if (gc->polygon.shader.modeFlags & __GL_SHADE_MASK) {
	/* Do nothing, just fall through to dostep and the Z lose route. */
    } else {
    	 if (alive) {
@   	     mov     edx,alive
@   	     cmp     ecx,edx
@   	     je      win
    	 } else {
@   	     cmp     ecx,~0
@   	     je      win
    	 }
     
    	  /* We're mixed */
    	  if (step == eax)
@   	      mov    'mmxtr->spill_1',eax
     
	  /* 'mixpix' takes it color pointer in edi.  If we're
	   * blending, short spans have a different cp and cp_read: so
	   * mixpix takes a color source pointer in esi and
	   * destination in edi.
	   */

          if (gc->polygon.shader.modeFlags & __GL_SHADE_BLEND) {
@	      push    esi
@	      lea     esi,cp_read
@   	      push    edi
@   	      lea     edi,cp

@   	      call    mixpix

@   	      pop     edi
@	      pop     esi
	  } else {
@   	      push    edi
@   	      lea     edi,cp
@   	      call    mixpix
@   	      pop     edi
	  }

    	  if (step == eax)
@   	      mov    eax,'mmxtr->spill_1'
    }

@ dostep:
     if (step)
@        genstep(tr, mmxtr, step, dx, texenv)

    /* Need to load up eax if we're in the central section */
    if (!alive &&
	(gc->polygon.shader.modeFlags & __GL_SHADE_TEXTURE_PERSP)) {
@       mov    eax,'mmxtr->next_pc'
    }
@   jmp     lose

    return cb;
}

/* Round r towards zero, given that we intend to truncate 
 * afterwards and preserve 'keep' bits.
 */
STATIC unsigned char*
rtz(__GLcontext *gc,
    unsigned char* cb,
    struct celem* r,
    struct celem* keep)
{
@   movq	mm7,r
@   psrad	mm7,31
@   psrld	mm7,keep
@   paddd	r,mm7

    return cb;
}

/* Round r towards zero, given that we intend to truncate 
 * afterwards and preserve 'keep' bits.
 */
STATIC unsigned char*
rtzw(__GLcontext *gc,
     unsigned char* cb,
     struct celem* r,
     struct celem* keep)
{
@   movq	mm7,r
@   psraw	mm7,15
@   psrlw	mm7,keep
@   paddw	r,mm7

    return cb;
}

/*
 * Correct an interpolant.  Generally, we get interpolants in 16.16
 * precision.  We like to use small (16-bit) interpolators, so we have
 * so shift all values left by some amount ('shift').
 */
STATIC unsigned char*
kerrect(__GLcontext *gc,
	unsigned char* cb,
	struct celem* r0,
	struct celem* drdx,
	struct celem* drdy0,
	struct celem* drdy1,
	struct celem* shift)
{
@    movd	mm0,r0
@    pslld	mm0,shift
@    movd	r0,mm0

@    movd	mm0,drdx
@    pslld	mm0,shift
@    movd	drdx,mm0

@    movd	mm0,drdy0
@    pslld	mm0,shift
@    movd	drdy0,mm0

@    movd	mm0,drdy1
@    pslld	mm0,shift
@    movd	drdy1,mm0

     return cb;
}

STATIC unsigned char*
prepare(__GLcontext *gc,
	unsigned char* cb,
	struct celem* ending,
	struct celem* tail,
	int dx,
	GLint z_stride,
	GLint c_stride,
	GLboolean interpolate_z,
	struct __GLmmxtri* mmxtr,
	GLuint modeFlags)
{
    if (ending)
@       mov     ending,ebx

@   mov     eax,ebx

@   shr     eax,2
@   xor	    ebx,ebx

    if (dx == 1) {
@       cmp	eax,0
@       je      tail

@       lea	edi,[edi + eax * c_stride]
@       sub	ebx,eax

        if (interpolate_z) {
	    if (z_stride == 16)
@               add    eax,eax
@           lea     esi,[esi + eax * 8]
        }
        if ((modeFlags & __GL_SHADE_TEXTURE) && 
	    (modeFlags & __GL_SHADE_TEXTURE_PERSP)) {
@           mov    eax,ebx
@           add    eax,4
@           mov    'mmxtr->next_pc',eax
        }
    } else {
@	sub     ebx,eax
@       lea	edi,[edi + ebx * c_stride]
        if (interpolate_z) {
	    if (z_stride == 16)
@               add    ebx,ebx
@           lea     esi,[esi + ebx * 8]
        }
@       cmp	eax,0
@       je      tail
@       mov     ebx,eax
        if ((modeFlags & __GL_SHADE_TEXTURE) && 
	    (modeFlags & __GL_SHADE_TEXTURE_PERSP)) {
@           sub    eax,4
@           mov    'mmxtr->next_pc',eax
        }
    }

    return cb;
}

/*
 * Perspective-correct approximation in MMX.
 * 
 * Crucial to this process we need a reciprocal function: something
 * to give us 1/q, but without using floating-point.
 * 
 * First we normalize 'q'.  This is done in 'mknorm'; it builds
 * a normalization tree that binary chops through 'q' until it
 * finds the most-significant bit.  Then it shifts 'q' left and
 * records the exponent.
 *
 * Next, we look up 'q' by indexing via its high bits into a
 * reciprocal table.  Each entry contains not only (1/x), but the
 * slope of (1/x) at that point.  So we LERP between entries by
 * multiplying this slope by the fractional part of 'q'.
 * 
 * The function returns this value, which is basically a mantissa,
 * and the exponent, which is the normalization distance we found
 * in 'mknorm'.
 *
 * (If you don't know what LERP, mantissa, exponent, and normalization
 * mean, you should read up on floating-point and numerical
 * approximations.)
 */

#define MMX_TRUE_DIVIDE 0

#define L2_RECIP_SIZE 8
#define RECIP_SIZE (1 << L2_RECIP_SIZE) 

STATIC unsigned char*
mknorm(__GLcontext *gc,
       unsigned char * cb,
       GLint lo,
       GLint hi,
       struct celem* done)
{
    if (lo == hi) {
        if ((lo == 24) || (lo == 0)) {
@	    mov     ecx,#'MMX_TRUE_DIVIDE ? 0xffffff : 0xffffffff'
@           mov     edx,1
	} else {
@           gobit(ecx,'(24 - lo)','(MMX_TRUE_DIVIDE ? 23 : 32)')
@           mov     edx,#lo
        }
@       jmp     done
    } else {
	struct celem *less = label(gc);
	GLuint mid;

	mid = (hi + lo) / 2;
@       cmp     ecx,#'(0x1000000 >> mid)'
@       jl      less
@       mknorm(lo, mid, done)
@less:
@       mknorm('mid + 1', hi, done)
    }

    return cb;
}

STATIC unsigned char*
reciprocal(__GLcontext *gc,
	   unsigned char * cb,
	   struct celem* q)
{
    static GLboolean cold = GL_TRUE;
    static GLuint recips[RECIP_SIZE];
    struct celem
	*ok = near_label(gc),
	*done = label(gc);

    if (cold) {
	GLint i;

	cold = GL_FALSE;
	for (i = 0 ; i < RECIP_SIZE; i++) {

#define RENT(i) ((0x8000 << L2_RECIP_SIZE) / (RECIP_SIZE + (i)))

	    recips[i] = (RENT(i) | ((2 * (RENT(i + 1) - RENT(i))) << 16));

#undef RENT

	}
    }

    if (q != ecx)
@       mov     ecx,q

@   mknorm('(0)', '(24)', done)
@done:

#if MMX_TRUE_DIVIDE
@   push    eax
@   push    ebx

@   mov     eax,ecx
@   and     eax,0xff800000
@   cmp     eax,0x00800000
@   je      ok
@ int3
@ ok:

@   movd    mm2,edx

@   mov     edx,0x40
@   mov     eax,0x00000000
@   idiv    ecx
@   movd    mm0,eax
@   packssdw mm0,mm0
@   punpcklwd mm0,mm0
@   punpckldq mm0,mm0

@   pop     ebx
@   pop     eax

#else
@   movd    mm2,edx

@   mov     edx,ecx

@   shr     edx,#'((32 - L2_RECIP_SIZE) - 15)'

@   shr     ecx,#'(32 - L2_RECIP_SIZE)'
@   and     edx,0x7fff

@   movd    mm3,edx

@   movd    mm1,[#'(int)recips' + ecx * 4]

@   movq    mm0,mm1
@   psrld    mm1,16

@   pmulhw   mm1,mm3

@   paddw    mm0,mm1

@   punpcklwd mm0,mm0

@   punpckldq mm0,mm0

#endif

    return cb;
}

STATIC unsigned char*
mul32x16(__GLcontext *gc,
	 unsigned char * cb,
	 struct celem *dst32,
	 struct celem *src16,
	 struct celem *work1,
	 struct celem *work2)
{

@   movq    work1,dst32
@   psrlw   work1,1

@   movq    work2,src16
@   pand    work2,'mxk4(gc, ~0, 0, ~0, 0)'

@   pand    src16,'mxk4(gc, 0, ~0, 0, ~0)'

@   pmaddwd dst32,src16
@   pmaddwd work1,work2
@   pslld   dst32,1
@   psrld   work1,14
@   paddd   dst32,work1

    return cb;
}

STATIC unsigned char*
mul32x16i(__GLcontext *gc,
	  unsigned char * cb,
	  struct celem *dst32,
	  struct celem *src16,
	  struct celem *work1,
	  struct celem *work2)
{
@   movq    work1,dst32
@   psrlw   work1,1

@   movq    work2,src16
@   pand    work2,'mxk4(gc, ~0, 0, ~0, 0)'

@   pand    src16,'mxk4(gc, 0, ~0, 0, ~0)'

@   pmaddwd dst32,src16
@   pmaddwd work1,work2
@   pslld   work1,1
@   pslld   dst32,16
@   paddd   dst32,work1

    return cb;
}

STATIC unsigned char*
perspective(__GLcontext *gc,
	    unsigned char* cb,
	    struct celem *tc,
	    struct celem *q,
	    struct celem *work1,
	    struct celem *work2)
{
@   mul32x16(tc,mm0,work1,work2)
@   pslld   tc,mm2

    return cb;
}

/* Returns true if the blend function uses alpha */
STATIC GLboolean
uses_alpha(GLenum bm)
{
    switch (bm) {
    case GL_ZERO:
    case GL_ONE:
    case GL_DST_COLOR:
    case GL_SRC_COLOR:
    case GL_ONE_MINUS_DST_COLOR:
    case GL_ONE_MINUS_SRC_COLOR:
	return GL_FALSE;

    case GL_SRC_ALPHA:
    case GL_ONE_MINUS_SRC_ALPHA:
    case GL_DST_ALPHA:
    case GL_ONE_MINUS_DST_ALPHA:
    case GL_SRC_ALPHA_SATURATE:
	return GL_TRUE;

    default:
	assert(0);
    }
}

STATIC unsigned char*
BuildMMXRasterizer(__GLcontext *gc, unsigned char* cb)
{
    GLuint modeFlags = gc->polygon.shader.modeFlags;
    struct celem
	*forwards = label(gc),
	*alldone = label(gc);
    double *data;
    GLuint offset = 0;
    struct celem* tr;
    struct celem* h;
    struct celem* ending;
    struct celem* headgate;	/* 4-way jump table for handling start-of-span... */
    struct celem* tailgate;	/* ... end-of-span... */
    struct celem* minigate;	/* ... short (1-4 pixel) spans */
    struct celem* pixval;	/* Pixel value we're going to generate.  mm0 */
    struct celem* readfrom;	/* Place to get pixel from when blending with short spans */
    struct celem* stagger_k;
    struct celem* mixpix = label(gc);
    struct celem* do_recip = label(gc);
    struct __GLmmxtri mmxtr;
    GLint dx;
    GLboolean interpolate_tex;
    GLboolean interpolate_color;
    GLboolean interpolate_z;
    GLboolean need_alpha;
    GLenum texenv;
    struct celem *ditherspace;
    double *dithertab;
    __GLcolorBuffer* fb = &gc->frontBuffer;
    GLint
	z_stride,		/* Depth 4-pixel stride (either 8 or 16) */
	c_stride;		/* Color 4-pixel stride (either 4 or 8) */
#if __GL_CODEGEN_PMON
    struct celem* startKernelIteration;
    struct celem* endKernelIteration;
#endif /* __GL_CODEGEN_PMON */

#if __GL_CODEGEN_PMON
    startKernelIteration = label(gc);
    startKernelIteration->spec.label.where = (unsigned char*)&StartKernelIteration;
    endKernelIteration = label(gc);
    endKernelIteration->spec.label.where = (unsigned char*)&EndKernelIteration;
#endif /* __GL_CODEGEN_PMON */

    if (modeFlags & __GL_SHADE_TEXTURE) {
	interpolate_tex = GL_TRUE;
	texenv = gc->state.texture.env[0].mode;
	if (texenv == GL_DECAL &&
	    gc->texture.currentTexture->texelFormat == GL_RGB)
	    texenv = GL_REPLACE;
    } else {
	interpolate_tex = GL_FALSE;
	texenv = 0;
    }

    interpolate_color = !(interpolate_tex && (texenv == GL_REPLACE)) &&
	(modeFlags & __GL_SHADE_SMOOTH);

    if (modeFlags & __GL_SHADE_BLEND) {
	if (uses_alpha(gc->state.raster.blendSrc) ||
	    uses_alpha(gc->state.raster.blendDst))
	    need_alpha = GL_TRUE;
    } else {
	need_alpha = GL_FALSE;
    }
    
    /* However, if we're blending with a GL_REPLACE texture that has no alpha
     * channel, we need alpha from the fragment, so we set interpolate_color.
     */
    if (need_alpha &&
	(interpolate_tex && (texenv == GL_REPLACE)) &&
	 !has_alpha(gc->texture.currentTexture->texelFormat) &&
	(modeFlags & __GL_SHADE_SMOOTH))
	interpolate_color = GL_TRUE;

    switch (gc->drawBuffer->fbtype) {
    case 0:
    case CINDEX:
    case RGB332:
    case RGB666:
	c_stride = 4;
	break;
    case RGB5:
    case RGB565:
    case A1RGB5:
	c_stride = 8;
	break;
    case RGB8:
    case BGR8:
    case RGBX8:
    case XRGB8:
    case XBGR8:
    case RGBA8:
    case ARGB8:
    case ABGR8:
	assert(0);
	break;
    }

    interpolate_z = (modeFlags & __GL_SHADE_DEPTH_TEST &&
		     (gc->state.depth.writeEnable ||
		      gc->state.depth.testFunc != GL_ALWAYS));

    /* 
     * z_stride is the size of a gang of 4 depth values.
     * For a 16-bit Z it's 8, for 32-bit Z it's 16.
     */
    z_stride = 4 * (gc->depthBuffer.buf.depth / 8);

    tr = mem2(gc, value(gc, 0), esp);

    data = (double*)((((int)cb - 2000) + 7) & ~7UL);

#define ILOCAL(name)	(name = mem2(gc, value(gc, (int)&data[offset]), NULL), offset++)
#define DLOCAL(name)	(name = mem2(gc, value(gc, (int)&data[offset]), NULL), offset++)
#define XLOCAL(name, sz)(name = mem2(gc, value(gc, (int)&data[offset]), NULL), offset += (sz / sizeof(double)))

    DLOCAL(mmxtr.r.didx);
    DLOCAL(mmxtr.g.didx);
    DLOCAL(mmxtr.b.didx);
    DLOCAL(mmxtr.a.didx);
    DLOCAL(mmxtr.s.didx);
    DLOCAL(mmxtr.t.didx);
    DLOCAL(mmxtr.z.didx);

    XLOCAL(mmxtr.r.istagger, 32);
    XLOCAL(mmxtr.g.istagger, 32);
    XLOCAL(mmxtr.b.istagger, 32);
    XLOCAL(mmxtr.a.istagger, 32);
    XLOCAL(mmxtr.s.istagger, 32);
    XLOCAL(mmxtr.t.istagger, 32);
    XLOCAL(mmxtr.z.istagger, 32);

    /* Dither table for 3 colors, for 4 lines, for 4 horizontal pixels,
     * using 16-bit (2 byte) values.
     */
    XLOCAL(ditherspace, (3 * 4 * 4 * 2));
    dithertab = (double*)DISPOF(ditherspace);

    DLOCAL(mmxtr.zvalue);
    DLOCAL(mmxtr.zresult);
    DLOCAL(mmxtr.z_skew);

    DLOCAL(mmxtr.spill_z);
    DLOCAL(mmxtr.spill_r);
    DLOCAL(mmxtr.spill_g);
    DLOCAL(mmxtr.spill_a);
    DLOCAL(mmxtr.tex_a);
    DLOCAL(mmxtr.spill_b);
    DLOCAL(mmxtr.spill_1);

    DLOCAL(mmxtr.dithers[0]);
    DLOCAL(mmxtr.dithers[1]);
    DLOCAL(mmxtr.dithers[2]);
    DLOCAL(mmxtr.dithers[3]);

    DLOCAL(mmxtr.src.r);
    DLOCAL(mmxtr.src.g);
    DLOCAL(mmxtr.src.b);
    DLOCAL(mmxtr.src.a);

    DLOCAL(mmxtr.dst.r);
    DLOCAL(mmxtr.dst.g);
    DLOCAL(mmxtr.dst.b);
    DLOCAL(mmxtr.dst.a);

    DLOCAL(mmxtr.df.r);
    DLOCAL(mmxtr.df.g);
    DLOCAL(mmxtr.df.b);
    DLOCAL(mmxtr.df.a);

    DLOCAL(mmxtr.sf.r);
    DLOCAL(mmxtr.sf.g);
    DLOCAL(mmxtr.sf.b);
    DLOCAL(mmxtr.sf.a);

    DLOCAL(mmxtr.pixcopy);
    DLOCAL(mmxtr.indexTextureBase);

    ILOCAL(mmxtr.prev_st);
    ILOCAL(mmxtr.next_pc);

    ILOCAL(h);
    ILOCAL(ending);

    {
	__GLcolorBuffer *cfb = gc->drawBuffer;
	GLuint shifts[4];
	int c, i, j;

	shifts[0] = log2(cfb->redMax) + 1;
	shifts[1] = log2(cfb->greenMax) + 1;
	shifts[2] = log2(cfb->blueMax) + 1;

	for (c = 0; c <= 2; c++)
	    for (i = 0; i < 4; i++) {
		short* ps;

		ps = (short*)&dithertab[(4 * c) + i];
		for (j = 0; j < 4; j++) {
		    *ps++ = __glFRDitherTable[i][j] >> (shifts[c] + 1);
		}
	    }
    }

#define MENTION(i)								\
    __glNSWhereIs(gc->tr, offsetof(i, __GLtri), sizeof(GLint));

    MENTION(y0Int);
    MENTION(y1Int);
    MENTION(y2Int);

    MENTION(x0Int);
    MENTION(x1Int);
    MENTION(x2Int);

    MENTION(dxdy0Int[0]);
    MENTION(dxdy0Int[1]);
    MENTION(dxdy1Int[0]);
    MENTION(dxdy1Int[1]);
    MENTION(dxdy2Int[0]);
    MENTION(dxdy2Int[1]);

    MENTION(x0Frac);
    MENTION(x1Frac);
    MENTION(x2Frac);

    MENTION(dxdy0Frac);
    MENTION(dxdy1Frac);
    MENTION(dxdy2Frac);

    MENTION(dx);

#define IPAIR(a, b)				\
    __glNSAlign(gc->tr, 8);			\
    MENTION(a);					\
    MENTION(b);					\
    MENTION(a##0);				\
    MENTION(b##0);				\
    MENTION(d##a##dx);				\
    MENTION(d##b##dx);				\
    MENTION(d##a##dy0[0]);			\
    MENTION(d##b##dy0[0]);			\
    MENTION(d##a##dy0[1]);			\
    MENTION(d##b##dy0[1]);

#if __GL_CODEGEN_DESCRIBERS
@       inc	[#'(int)&last_describer->drawn_tris']
@       rdtsc
@       sub     [#'(int)&last_describer->cyc[0]'],eax
@       sbb     [#'(int)&last_describer->cyc[1]'],edx
#endif /* __GL_CODEGEN_DESCRIBERS */

    if (interpolate_color || interpolate_tex || interpolate_z) {
	stagger_k = mxk4(gc, 0, 1, 2, 3);

	mxk4(gc, 3, 2, 1, 0);

@	mov	ebp,'tr(dx)'	; 0x01	0xff
@	mov	ebx,ebp		; +1    -1
@	sar	ebp,31		; 0x00	0xff
@	and	ebp,3		; 0x00	0x03
    }

    if (interpolate_color) {
	struct celem* again = label(gc);

	IPAIR(r, g);
	IPAIR(b, a);

@	kerrect('tr(r0)', 'tr(drdx)', 'tr(drdy0[0])', 'tr(drdy0[1])', '14 - log2(fb->redMax)')
@	kerrect('tr(g0)', 'tr(dgdx)', 'tr(dgdy0[0])', 'tr(dgdy0[1])', '14 - log2(fb->greenMax)')
@	kerrect('tr(b0)', 'tr(dbdx)', 'tr(dbdy0[0])', 'tr(dbdy0[1])', '14 - log2(fb->blueMax)')
	if (need_alpha)
@	    kerrect('tr(a0)', 'tr(dadx)', 'tr(dady0[0])', 'tr(dady0[1])', '14 - log2(ALPHA_MAX)')

@	movq	mm0,'tr(drdx)'
@	movq	mm2,'tr(dbdx)'

@	paddd	mm0,mm0
@	paddd	mm2,mm2

@	paddd	mm0,mm0
@	paddd	mm2,mm2

@	rtz(mm0, 16)
@	rtz(mm2, 16)

@	movq	mm1,mm0
@	movq	mm3,mm2

@	punpcklwd mm0,mm0
@	punpcklwd mm2,mm2
@	punpckhwd mm1,mm1
@	punpckhwd mm3,mm3

@	punpckhdq mm0,mm0
@	punpckhdq mm1,mm1
@	punpckhdq mm2,mm2
@	punpckhdq mm3,mm3

@	movq	'mmxtr.r.didx',mm0
@	movq	'mmxtr.g.didx',mm1
@	movq	'mmxtr.b.didx',mm2
	if (need_alpha)
@	    movq    'mmxtr.a.didx',mm3

@	movq	mm0,'tr(drdx)'
@	movq	mm2,'tr(dbdx)'

@	rtz(mm0, 16)
@	rtz(mm2, 16)

@	movq	mm1,mm0
@	movq	mm3,mm2

@	punpcklwd mm0,mm0
@	punpcklwd mm2,mm2
@	punpckhwd mm1,mm1
@	punpckhwd mm3,mm3

@	punpckhdq mm0,mm0
@	punpckhdq mm1,mm1
@	punpckhdq mm2,mm2
@	punpckhdq mm3,mm3

@	movq	mm4,mm0
@	movq	mm5,mm1
@	movq	mm6,mm2
@	movq	mm7,mm3

@	mov	eax,'tr(dx)'
@	shr	eax,31

@	pmullw	mm0,[#'DISPOF(stagger_k)' + eax * 8]
@	pmullw	mm1,[#'DISPOF(stagger_k)' + eax * 8]
@	pmullw	mm2,[#'DISPOF(stagger_k)' + eax * 8]
	if (need_alpha)
@	    pmullw  mm3,[#'DISPOF(stagger_k)' + eax * 8]

@	mov	ecx,4
@       push    ebp

@again:
@	movq	[#'DISPOF(mmxtr.r.istagger)' + ebp * 8],mm0
@	movq	[#'DISPOF(mmxtr.g.istagger)' + ebp * 8],mm1
@	movq	[#'DISPOF(mmxtr.b.istagger)' + ebp * 8],mm2
	if (need_alpha)
@	    movq    [#'DISPOF(mmxtr.a.istagger)' + ebp * 8],mm3

@	psubw	mm0,mm4
@	psubw	mm1,mm5
@	psubw	mm2,mm6
@	psubw	mm3,mm7

@	add	ebp,ebx

@	dec	ecx
@	jne	again

@       pop     ebp
    }

    if (interpolate_z) {
	static const unsigned short masks[4] = { 
	    0x0000, 0xffff,
	    0xffff, 0x0000
	};
	struct celem* again = label(gc);
	IPAIR(z, zp);

@       movd    mm0,'tr(dzdx)'
@       punpckldq mm0,mm0

	if (gc->depthBuffer.buf.depth == 16) {
@	    movq	'mmxtr.z_skew',mm0
@	    paddd	mm0,mm0
	} else {
@	    paddd	mm0,mm0
@	    movq	'mmxtr.z_skew',mm0
	}

@	paddd	mm0,mm0

@	movq	'mmxtr.z.didx',mm0

@	mov	eax,'tr(dx)'

@	shr	eax,31

@	rtz(mm0,30)

@       push    ebp
@	psrad	mm0,2

@       movq    mm1,mm0

	if (gc->depthBuffer.buf.depth == 16)
@	    pslld   mm0,1		; Cheap stagger here

@	movq	mm2,[#'(int)&masks' + eax * 4]

@	punpcklwd mm2,mm2

@	pand	mm0,mm2

@	mov	ecx,4
@again:	
@	movq	[#'DISPOF(mmxtr.z.istagger)' + ebp * 8],mm0
    	
@	psubd	mm0,mm1
@	add	ebp,ebx
    	
@	dec	ecx
@	jne	again

@       pop     ebp

    }

    if (interpolate_tex) {
	struct celem* again = label(gc);

	IPAIR(s, t);
	if (modeFlags & __GL_SHADE_TEXTURE_PERSP) {
	    IPAIR(q, dummy);
	}

	DLOCAL(mmxtr.tex_s_shift);
	DLOCAL(mmxtr.tex_t_shift);
	DLOCAL(mmxtr.tex_s_kerrect);
	DLOCAL(mmxtr.tex_t_kerrect);
	DLOCAL(mmxtr.tex_t_mask);

@	mov     esi,[#'(int)&gc->texture.currentTexture']
@       mov     edx,16

@       pxor    mm0,mm0

@       mov     esi,[esi + __GLtexture.level]
@       mov     ecx,edx

@       movq     'mmxtr.tex_s_shift',mm0
@       movq     'mmxtr.tex_t_shift',mm0
@       movq     'mmxtr.tex_s_kerrect',mm0
@       movq     'mmxtr.tex_t_kerrect',mm0

@       movd    mm7,[esi + __GLmipMapLevel.widthLog2]
@       movd    mm0,[esi + __GLmipMapLevel.height2]
@       punpcklwd mm0,mm0
@       punpckldq mm0,mm0
@       psubw   mm0,'mxk(gc, 1)'
@       psllw   mm0,mm7
@       movq    'mmxtr.tex_t_mask',mm0

/*
 * s_shift = (16 - wl2)
 * t_shift = (16 - wl2) - hl2;
 */

@       sub     ecx,[esi + __GLmipMapLevel.heightLog2]
@       sub     edx,[esi + __GLmipMapLevel.widthLog2]

@       mov     'mmxtr.tex_t_kerrect',ecx
@       mov     'mmxtr.tex_s_kerrect',edx

@       mov     'mmxtr.tex_s_shift',edx
@       mov     'mmxtr.tex_t_shift',ecx

	if (!(modeFlags & __GL_SHADE_TEXTURE_PERSP)) {
@	    kerrect('tr(s0)', 'tr(dsdx)', 'tr(dsdy0[0])', 'tr(dsdy0[1])', 'mmxtr.tex_s_kerrect')
@	    kerrect('tr(t0)', 'tr(dtdx)', 'tr(dtdy0[0])', 'tr(dtdy0[1])', 'mmxtr.tex_t_kerrect')
        }
	if (!(modeFlags & __GL_SHADE_TEXTURE_PERSP)) {
@	    movq	mm0,'tr(dsdx)'

@	    paddd   mm0,mm0
@	    paddd   mm0,mm0
@	    rtz(mm0, 16)

@           movq     mm1,mm0
@           punpcklwd mm0,mm0

@           punpckhwd mm1,mm1

@           punpckhdq mm0,mm0
@           punpckhdq mm1,mm1

@	    movq     'mmxtr.s.didx',mm0
@	    movq     'mmxtr.t.didx',mm1

@	    rtzw(mm0,14)
@	    rtzw(mm1,14)
@	    psraw   mm0,2
@	    psraw   mm1,2

@           movq    mm2,mm0
@           movq    mm3,mm1

@	    mov     eax,'tr(dx)'
@	    shr	    eax,31

@	    pmullw  mm0,[#'DISPOF(stagger_k)' + eax * 8]
@	    pmullw  mm1,[#'DISPOF(stagger_k)' + eax * 8]

@	    mov	ecx,4
@again:	   
@	    movq	[#'DISPOF(mmxtr.s.istagger)' + ebp * 8],mm0
@	    movq	[#'DISPOF(mmxtr.t.istagger)' + ebp * 8],mm1

@	    psubw	mm0,mm2
@	    psubw	mm1,mm3
    
@	    add	ebp,ebx
    
@	    dec	ecx
@	    jne	again
        }
    }

    if (modeFlags & __GL_SHADE_BLEND) {
	/* If we're blending with a texenv GL_REPLACE, and the texture
	 * has no alpha channel, assume alpha of 1.0 */
@   	movq    mm0,'mxk(gc, 0x4000)'
@   	movq    'mmxtr.src.a',mm0

        /* Similarly, destination alpha is assumed to be 1.0 */
@   	movq    'mmxtr.dst.a',mm0
    }

    if (!(interpolate_tex && (texenv == GL_REPLACE)) &&
	!interpolate_color) {
@       movd    mm0,'tr(r)'
@       pslld   mm0,'14 - log2(fb->redMax)'
@       punpcklwd mm0,mm0
@       punpckhdq mm0,mm0
@       movq    'mmxtr.spill_r',mm0
 
@       movd    mm0,'tr(g)'
@       pslld   mm0,'14 - log2(fb->greenMax)'
@       punpcklwd mm0,mm0
@       punpckhdq mm0,mm0
@       movq    'mmxtr.spill_g',mm0
 
@       movd    mm0,'tr(b)'
@       pslld   mm0,'14 - log2(fb->blueMax)'
