          g =	mem(gc, NULL, esi, edx, 2);
          b =	mem(gc, NULL, esi, edx, 2);
	  break;
	case GL_RGB:
@	  lea	edx,[eax + eax * 2]
@	  mov	esi,ecx
          colorformat = lo8;
          r =	mem(gc, NULL, esi, edx, 1);
          g =	mem(gc, value(gc, 1), esi, edx, 1);
	  b =	mem(gc, value(gc, 2), esi, edx, 1);
