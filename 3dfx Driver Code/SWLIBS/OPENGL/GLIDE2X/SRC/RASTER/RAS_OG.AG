@ adjuster:

@     mov	ebx,truew
@     sub ebx,16
@     jle	allover
@     mov truew,ebx

      {
          struct celem* no = near_label(gc);
@	  cmp	ebx,16
@	  jle	no
@	  mov	ebx,16
@ no:	  
@	  mov	w,ebx
      }

