#define MENTION(i)								\
  __glNSWhereIs(gc->tr, offsetof(i, __GLtri), sizeof(GLint));

  MENTION(y0Int);
  MENTION(y1Int);
  MENTION(y2Int);

  MENTION(x0Int);
  MENTION(x1Int);
  MENTION(x2Int);

