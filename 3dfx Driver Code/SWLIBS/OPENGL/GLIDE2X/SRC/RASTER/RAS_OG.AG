	 so we don't need this stuff */

@ fxinterp:
@	fld	v0p			; 1	p0
@	fld	v1p			; 2		
@	fsub	st1			; 3	dp0	p0
@	fld	v2p			; 4	
@	fsub	st2			; 5	dp1	dp0	p0
@	fld	'QBASE(ebp,dy1)'	; 6	dy1	dp1	dp0	p0
@	fmul	st2			; 7	dy1*dp0	dp1	dp0	p0
@	fxch	st2			;	dp0	dp1	dy1*dp0	p0
@	fld	'QBASE(ebp,dy0)'	; 8	dy0	dp0	dp1	dy1*dp0	p0
@	fmul	st2			; 9	dy0*dp1	dp0	dp1	dy1*dp0	p0
@	fxch	st1			;	dp0	dy0*dp1	dp1	dy1*dp0	p0
@	fmul	'QBASE(ebp,dx1)'	; 10	dp0*dx1	dy0*dp1	dp1	dy1*dp0	p0
@	fxch	st3			; 	dy1*dp0	dy0*dp1	dp1	dp0*dx1	p0
		        		// 11	------------ STALL ------------
@	fsubp	st1,st0			; 12	dpdx	dp1	dp0*dx1	p0
@	fxch	st1			;	dp1	dpdx	dp0*dx1	p0
@	fmul	'QBASE(ebp,dx0)'	; 13	dp0*dx1	dpdx	dp0*dx1	p0
@	fxch	st1			;	dpdx	dp0*dx1	dp0*dx1	p0
@	fldq	dxbias			; 14	dxbias	dpdx	dp0*dx1	dp0*dx1	p0
@	fadd	st1			; 15	drdx	dpdx	dp0*dx1	dp0*dx1	p0
@	fxch	st2			; 	dp0*dx1	dpdx	drdx	dp0*dx1	p0
@	fsubp	st3,st0			; 16	dpdx	drdx	dpdy	p0
@	fld	st0			; 17	dpdx	dpdx	drdx	dpdy	p0
@	fmul	'QBASE(ebp,xsnap0)'	; 18	dpdx*xs	dpdx	drdx	dpdy	p0
@	fld	'QBASE(ebp,ysnap0)'	; 19	ys	dpdx*xs	dpdx	drdx	dpdy	p0
@	fmul	st4			; 20	dpdy*ys	dpdx*xs	dpdx	drdx	dpdy	p0
@	fxch	st3			;	drdx	dpdx*xs	dpdx	dpdy*ys	dpdy	p0
@	fstpq	'QBASE(ebp,qdx)'	; 21	dpdx*xs	dpdx	dpdy*ys	dpdy	p0
		        		// 22
@	faddp	st2,st0			; 23	dpdx	r0...	dpdy	p0
@	fxch	st3			;	p0	r0...	dpdy	dpdx
@	faddq	p0bias			; 24	p0...	r0...	dpdy	dpdx
@	fxch	st3			; 	dpdx	r0...	dpdy	p0...
@	fmul	'QBASE(ebp,dxdyInt0)'	; 25	dpdx*i	r0...	dpdy	p0...
@	fxch	st2			;	dpdy	r0...	dpdx*i	p0...
@	faddq	dybias			; 26	dpdy...	r0...	dpdx*i	p0...
@	fxch	st1			;	r0...	dpdy...	dpdx*i	p0...
@	faddp	st3,st0			; 27	dpdy...	dpdx*i	r0

@	mov	eax,'QBASE(ebp,qdx)'
@	mov	ebx,'QBASE(ebp,negdx)'

@	xor	eax,ebx

@	sub	eax,ebx

@	mov	[edi+#pos_didx],eax; drdx
	if (spanlet) {
@           mov     ecx,eax
@	    shl	    ecx,5
@	    mov	    [edi+#pos_didxSpan],ecx
        }
@	mov	ecx,'QBASE(ebp,negdxdy)'

@	faddp	st1,st0	; 30	dy	r0
@	fxch	st1
@	fstpq	'QBASE(ebp,q0)'		; 31
		       // 32
@	xor	eax,ecx
@	mov	ebx,'QBASE(ebp,q0)'

@	fstpq	'QBASE(ebp,qdy)'	; 34

@	sub	eax,ecx
@	mov	ecx,'QBASE(ebp,qdy)'

@	mov	[edi+#pos_didy0_0],ecx	; drdy0[0]
@	add	ecx,eax

@	mov	[edi+#pos_didy0_1],ecx	; drdy0[1]
@	mov	[edi],ebx	; r0

@	ret

        if ((modeFlags & __GL_SHADE_TEXTURE) &&
	    (modeFlags & __GL_SHADE_TEXTURE_PERSP)) {

@ fpinterp:
@	fld	v0p	; 1	p0
@	fld	v1p	; 2		
@	fsub	st1	; 3	dp0	p0
@	fld	v2p	; 4	
@	fsub	st2	; 5	dp1	dp0	p0
@	fld	dy1	; 6	dy1	dp1	dp0	p0
@	fmul	st2	; 7	dy1*dp0	dp1	dp0	p0
@	fxch	st2	;	dp0	dp1	dy1*dp0	p0
@	fld	dy0	; 8	dy0	dp0	dp1	dy1*dp0	p0
@	fmul	st2	; 9	dy0*dp1	dp0	dp1	dy1*dp0	p0
@	fxch	st1	;	dp0	dy0*dp1	dp1	dy1*dp0	p0
@	fmul	dx1	; 10	dp0*dx1	dy0*dp1	dp1	dy1*dp0	p0
@	fxch	st3	; 	dy1*dp0	dy0*dp1	dp1	dp0*dx1	p0
		       // 11	------------ STALL ------------
@	fsubp	st1,st0	; 12	dpdx	dp1	dp0*dx1	p0
@	fxch	st1	;	dp1	dpdx	dp0*dx1	p0
@	fmul	dx0	; 13	dp0*dx1	dpdx	dp0*dx1	p0
@	fxch	st1	;	dpdx	dp0*dx1	dp0*dx1	p0
@	fld	fnegdx	; 14	dxbias	dpdx	dp0*dx1	dp0*dx1	p0
@	fmul	st1	; 15	drdx	dpdx	dp0*dx1	dp0*dx1	p0
@	fxch	st2	; 	dp0*dx1	dpdx	drdx	dp0*dx1	p0
@	fsubp	st3,st0	; 16	dpdx	drdx	dpdy	p0
@	fld	st0	; 17	dpdx	dpdx	drdx	dpdy	p0
@	fmul	xsnap0	; 18	dpdx*xs	dpdx	drdx	dpdy	p0
@	fld	ysnap0	; 19	ys	dpdx*xs	dpdx	drdx	dpdy	p0
@	fmul	st4	; 20	dpdy*ys	dpdx*xs	dpdx	drdx	dpdy	p0
@	fxch	st3	;	drdx	dpdx*xs	dpdx	dpdy*ys	dpdy	p0
@	fstp	[edi+4]	; 21	dpdx*xs	dpdx	dpdy*ys	dpdy	p0
		       // 22
@	faddp	st2,st0	; 23	dpdx	r0...	dpdy	p0
@	fst	q0	; 24,25	
@	fmul	dxdyInt0; 25	dpdx*i	r0...	dpdy	p0...
@	fxch	st2	;	dpdy	r0...	dpdx*i	p0...

        if (texNeedRho) {
@	    fst    [edi + 24]
	}

@	fxch	st1	;	r0...	dpdy...	dpdx*i	p0...
@	faddp	st3,st0	; 27	dpdy...	dpdx*i	r0

@	faddp	st1,st0	; 30	dy	r0
@	fxch	st1	;	r0	dy
@	fstp	[edi]	; 31	dy
@	fld	q0	;	dpdx	dy
@	fmul	fnegdxdy; 32	+-dpdx	dy[0]
@	fxch	st1	;	dy[0]	+-dpdx
@	fst	[edi+#'(spanlet || FORCE_DIRECT) ? 16 : 12']; 33	dy[0]	+-dpdx
@	faddp	st1,st0	;	dy[1]

@	fstp	[edi+#'(spanlet || FORCE_DIRECT) ? 20 : 16']

@	ret
        }
    }

@cull3:
@    fstp	st0
@    fstp	st0
@    fstp	st0
@    fldcw	fpcw

@cull:
@ xor eax,eax
/* Really a return, this is initialised at the start of setup. */
@      jmpi	[#'(int)&gc->ogState.rsave']

    assert((unsigned)code + gc->constants.triSetupCacheSize > (unsigned)cb);
#if SOURCE_TRAIL
    og_stream(gc, NULL);
#endif

    return (setterupper)code;
}
#endif
