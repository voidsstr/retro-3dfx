     */
    if (modeFlags & __GL_SHADE_MASK) {
@       jmp     zfail
      }
  }

  if (modeFlags & __GL_SHADE_TEXTURE) {

	if (wl2 <= 8) {
@		mov	ecx,'fptr->st'
@		mov	ebx,'fptr->dstdx'

@	  	mov	eax, ecx
@		add	ebx,ecx

@	  	shr	eax, #'24 - hl2'

@	  	mov	al, ch

	    	if (wl2 < 8)
@			shr	eax, #'8 - wl2'
@		mov	ecx,'tr(tp)'

	} else {
	    	/* Got to do the more expensive 16-bit version */
@		mov	ecx,'fptr->st'
@		mov	ebx, 'fptr->dstdx'

@	  	mov	eax, ecx
@		add	ebx,ecx

	    	if (hl2 < 16)
@			shr	eax, #'16 - hl2'

@	  	size16
@	  	mov	eax, ecx
	    	if (wl2 < 16)
@			shr	eax, #'16 - wl2'
@		mov	ecx,'tr(tp)'
	}
	/* EAX now holds (unscaled) offset into texture */

        baseFormat = current->texelFormat;

	if ((modeFlags & __GL_SHADE_RGB) && baseFormat == GL_COLOR_INDEX) {
	  /* Indirect, turn it into offset in palette (which looks like
	   * a 256x1 texture).
	   */
@	  	mov	ecx, 'tr(tp)'
@	  	add	ecx, eax
@	  	xor	eax,eax
@	  	mov	al, [ecx]
	    	/* EAX now holds (unscaled) offset into palette */
	    	baseFormat = current->CT.baseFormat;
	}

	if (cooked) {
	    switch (fbsize) {
	    case 1:
@		mov	dl,[ecx + eax]
		break;
	    case 2:
@		size16
@		mov	edx,[ecx + eax * 2]
		break;
	    case 3:
@		lea	eax,[ecx + eax * 2]
@		mov	edx,[ecx + eax]
		break;
	    case 4:
@		mov	edx,[ecx + eax * 4]
		break;
	    }
	} else {
	  switch (baseFormat) {
	  case GL_COLOR_INDEX:
@	  mov	edx,eax
          r =	mem(gc, NULL, ecx, edx, 1);
	  break;
	case GL_LUMINANCE:
	case GL_INTENSITY:
@	  mov	edx,eax
@	  mov	esi,ecx
          colorformat = lo8;
          r =	mem(gc, NULL, esi, edx, 1);
          g =	mem(gc, NULL, esi, edx, 1);
	  b =	mem(gc, NULL, esi, edx, 1);
	  break;
	case GL_LUMINANCE_ALPHA:
          colorformat = lo8;
@	  mov	edx,eax
@	  mov	esi,ecx
