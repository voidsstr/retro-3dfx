@      xor	eax,eax
@      mov	'fptr->st',ebx

@      mov	al,r
@      xor	ebx,ebx

@      mov	bl,g
@      xor	ecx,ecx

@      mov	cl,b
@      mov	ebp,'tr(r)'

@      shr	ebp,#redshift
@      mov	edi,'tr(g)'

@      shr	edi,#greenshift
@      mov	esi,'tr(b)'

@      shr	esi,#blueshift
@      push	ecx

@      mov	cl,[sqtab + ebp]
@      sub	ebp,eax

@      mov	dl,[sqtab + edi]
@      sub	edi,ebx

@      add	cl,[sqtab + eax]
@      add	dl,[sqtab + ebx]

@      xor	ebx,ebx
@      pop	eax

@      sub	cl,[sqtab + ebp]	; red
@      sub	dl,[sqtab + edi]	; green

@      mov	bl,[sqtab + eax]	; blue
@      mov	bh,[sqtab + esi]

@      sub	esi,eax
@      xor	eax,eax

@      mov	al,cl			; red in place
@      add	bl,bh

@      mov	bh,[sqtab + esi]
@      mov	cl,bl			; blue in place

@      sub	cl,bh
@      xor	ebx,ebx

@      mov	bl,dl			; green in place
        } else {
		/* we must be flat */
@		xor	eax,eax
@		mov	'fptr->st',ebx

@		mov	al,r
@		mov	edi,rptr

@		xor	ebx,ebx
@		mov	ebp,gptr

@		xor	ecx,ecx
@		mov	bl,g

@		mov	cl,b
@		mov	edx,bptr

@		mov	al,[edi + eax]
@		mov	bl,[ebx + ebp + 0]

@		mov	cl,[edx + ecx]
	}

        r = eax;
        g = ebx;
        b = ecx;
	}
	break;
    case GL_ADD:
	if (!(modeFlags & __GL_SHADE_DITHER)) {
@	    mov	al,'tr2(r,2)'
@	    mov	cl,r

@	    add	al,cl
@           mov	'fptr->st',ebx
            colorformat = lo8;
	} else {
@	    xor	eax,eax
@	    mov	al,r
@	    mov	edx,'tr(r)'

@	    shl	eax,16
@	    add	eax,edx

@           mov	'fptr->st',ebx

            colorformat = hi16;
	}
	r = eax;
	break;
    default:
@       mov	'fptr->st',ebx
	break;

  }
}

/* At this point r, g, b are ready for dithering */
    if (modeFlags & __GL_SHADE_DITHER) {

      if (r && r->what == MEM) {
	/* The color triple is in memory: load into registers */
@	xor	eax,eax
@	mov	al,r
