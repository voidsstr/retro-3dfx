	   * min(truew - 16, 16)
	   */
	  {
	      struct celem *ok = near_label(gc);
	  
@	      mov     eax,truew
@	      sub     eax,16
@	      cmp     eax,16
@	      jle     ok
@	      mov     eax,16
@ ok:
@	      mov     'fptr->qit',eax
