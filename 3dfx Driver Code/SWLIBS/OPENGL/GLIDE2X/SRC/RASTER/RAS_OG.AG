	case GL_RGBA:
          colorformat = lo8;
@	  mov	edx,eax
@	  mov	esi,ecx
          r =	mem(gc, NULL, esi, edx, 4);
          g =	mem(gc, value(gc, 1), esi, edx, 4);
	  b =	mem(gc, value(gc, 2), esi, edx, 4);
