      r = eax;
      g = ebx;
      b = ecx;

@     mov	esi,'tr(dither)'
@     mov	ebp,dither_index

@     mov	edx,ebp
@     inc	ebp

@     and	ebp,3

@     mov	dither_index,ebp
@     mov	esi,[esi + edx * 4]

    }

  final_pixel = (fbsize == 1) ? dl : edx;
  if (cooked) {
	/* edx already hold pixel to write */
  } else if ((modeFlags & (__GL_SHADE_SMOOTH | __GL_SHADE_DITHER | __GL_SHADE_TEXTURE)) == 0) {
@   mov	edx,'tr(r0)'
  } else {
