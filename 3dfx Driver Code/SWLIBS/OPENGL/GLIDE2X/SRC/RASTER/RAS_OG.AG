@ 	      mov	[edi],final_pixel
  	      break;
  	    case 2:
@ 	      size16
@ 	      mov	[edi],edx
  	      break;
  	    case 3:
@ 	      size16
@ 	      mov	[edi],edx
@ 	      shr	edx,16
@ 	      mov [edi+2],dl
  	      break;
  	    case 4:
@ 	      mov	[edi],edx
