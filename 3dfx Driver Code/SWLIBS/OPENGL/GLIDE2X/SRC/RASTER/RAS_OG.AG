@     shr	ebp,#'16 - cfb->blueShift'
@     and	edx,#'(cfb->redMax << cfb->redShift)'

@     shr	esi,#'16 - cfb->greenShift'
@     and	ebp,#'(cfb->blueMax << cfb->blueShift)'

@     and	esi,#'(cfb->greenMax << cfb->greenShift)'
@     or	edx,ebp

@     or	edx,esi
      break;

    case lo8:
    {
@   mov al,r
@   mov bl,g
@   mov cl,b

@   and	eax,#'(cfb->redMax << (7 - redSize))'

@   gobit(eax, '(7 - redSize)', 'cfb->redShift')
@   and	ebx,#'(cfb->greenMax << (7 - greenSize))'

@   gobit(ebx, '(7 - greenSize)', 'cfb->greenShift')
@   mov	edx,eax

@   or	edx,ebx
@   and	ecx,#'(cfb->blueMax << (7 - blueSize))'

@   gobit(ecx, '(7 - blueSize)', 'cfb->blueShift')

@   or	edx,ecx
    }
      break;
    case loN:
      if (cfb->blueShift != 0)
@       shl	ecx,#'cfb->blueShift'

@     shl	eax,#'cfb->redShift'
@     mov	edx,ecx

@     shl	ebx,#'cfb->greenShift'
@     or	edx,eax

@     or	edx,ebx
      break;
    }
  } else {
      switch (colorformat) {
      case hi16:
@	mov	edx,eax
