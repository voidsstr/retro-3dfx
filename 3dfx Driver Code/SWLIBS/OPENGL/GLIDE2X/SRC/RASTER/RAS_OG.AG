@         shr esi,16
@         size16
        }
@       cmp	esi,[edi]
@       mov	'tr(zp)',ebp
@       mov 'tr(z)',edx
        switch (gc->state.depth.testFunc) {
        case GL_NEVER:
@         jmp	zfail
          break;
        case GL_LESS:
@         jae	zfail
          break;
        case GL_EQUAL:
@         jne	zfail
          break;
        case GL_LEQUAL:
@	  ja	zfail
          break;
        case GL_GREATER:
@         jbe	zfail
          break;
        case GL_NOTEQUAL:
@         je	zfail
          break;
        case GL_GEQUAL:
@         jb	zfail
          break;
        case GL_ALWAYS:
