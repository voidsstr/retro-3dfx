        if (gc->depthBuffer.buf.depth == 16)
@         size16
@       mov	[edi],esi
      }
    } else {
	/* We're running ALWAYS.  Just write out that Z */
        if (gc->depthBuffer.buf.depth == 16) {
@         shr esi,16
        }
@       mov	'tr(zp)',ebp
@       mov     'tr(z)',edx
      if (gc->state.depth.writeEnable) {
        if (gc->depthBuffer.buf.depth == 16)
@         size16
@       mov	[edi],esi
