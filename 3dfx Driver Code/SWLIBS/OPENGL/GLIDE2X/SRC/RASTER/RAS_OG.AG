	if (spill_rgb) {
@     mov	eax,'tr(r)'
@     mov	ebx,'tr(g)'
@     mov	ecx,'tr(b)'
	}

@     mov	esi,'tr(drdx)'

@     add	ebx,'tr(dgdx)'
@     add	ecx,'tr(dbdx)'

@     add	eax,esi

	if (spill_rgb) {
@     mov	'tr(r)',eax
@     mov	'tr(g)',ebx
@     mov	'tr(b)',ecx
	}
    } else {
	if (final_pixel == al) {
@	    mov	dl,al
	    final_pixel = dl;
	}
	if (spill_rgb) {
@           mov	eax,'tr(r)'
	}
@	mov	ebx,'tr(drdx)'
@       add	eax,ebx
	if (spill_rgb) {
@           mov	'tr(r)',eax
	}
    }
  }

