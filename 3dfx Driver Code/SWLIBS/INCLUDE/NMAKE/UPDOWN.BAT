if not exist %1\NUL goto no_dir_exit
echo ====recursing into %1 (make %3) =======================================
cd %1
%2 /nologo %3 %4 %5 %6 %7 %8 %9
if ERRORLEVEL 1 goto bad_makefile_exit
cd ..
goto good_exit


:bad_makefile_exit
cd ..
echo ////Make returned bad exit status in %1 (make %3) /////////////////////
REM Kill recursion at this point
SUBDIRS=
exit 1


:no_dir_exit
echo ////no such directory %1 (make %3) ////////////////////////////////////
:bad_exit
REM Kill recursion at this point
SUBDIRS=
exit 1


rem ** we're done!
:good_exit
