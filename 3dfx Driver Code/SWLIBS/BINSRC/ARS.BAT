@echo off

REM ars ar-library ar-sub-library
REM inserts all the files in ar-sub-library into ar-library

REM creates a subdirectory, extracts sub-library into it
REM appends all the files to library, then deletes subdirectory

REM gross, but it works.

md slibtmp
cd slibtmp

echo %2 > libnameo.txt
sed -e 's,\\,/,g' libnameo.txt > libnamef.txt
ar t @libnamef.txt > objlist.txt
ar x @libnamef.txt
ar qv ../%1 @objlist.txt

cd ..
deltree /y slibtmp