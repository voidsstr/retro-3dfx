/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_ATB                 ICON    DISCARDABLE     "ATB.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_DEMOMENU MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Screen &Print\t<BREAK>",      ID_SCREENPRINT
        MENUITEM SEPARATOR
        MENUITEM "E&xit\t<ESC>",                ID_APP_EXIT
    END
    POPUP "&Render"
    BEGIN
        MENUITEM "&Fog\tCtrl+F",                ID_RENDER_FOG
        MENUITEM "&Bilinear\tCtrl+B",           ID_RENDER_BILINEAR
        MENUITEM "&Mipmapping\tCtrl+M",         ID_RENDER_MIPMAPPING
        MENUITEM "&Wireframe\tCtrl+W",          ID_RENDER_WIREFRAME
        MENUITEM "&Texturing\tCtrl+T",          ID_RENDER_TEXTURING
    END
    POPUP "&Event"
    BEGIN
        MENUITEM "&Reset\tCtrl+D",              ID_EVENT_RESET
        MENUITEM "&Playback\t<ENTER>",          ID_EVENT_PLAYBACK
        MENUITEM "&Record\tCtrl+R",             ID_EVENT_RECORD
    END
    POPUP "&Misc"
    BEGIN
        MENUITEM "&Calibrate Joystick\tCtrl+J", ID_JOYCAL
        MENUITEM "Performance",                 ID_MISC_PERFORMANCE
        MENUITEM "Performance Fulll",           ID_MISC_PERFORMANCEFULL
        MENUITEM "Vsync",                       ID_MISC_VSYNC
        MENUITEM "Sound",                       ID_MISC_SOUND
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help Topics\tF1",            ID_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About demo...",              ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS PRELOAD MOVEABLE PURE 
BEGIN
    "B",            ID_RENDER_BILINEAR,     VIRTKEY, CONTROL, NOINVERT
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    "F",            ID_RENDER_FOG,          VIRTKEY, CONTROL, NOINVERT
    "J",            ID_JOYCAL,              VIRTKEY, CONTROL, NOINVERT
    "M",            ID_RENDER_MIPMAPPING,   VIRTKEY, CONTROL, NOINVERT
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    "S",            ID_FILE_SAVE,           VIRTKEY, CONTROL, NOINVERT
    "T",            ID_RENDER_TEXTURING,    VIRTKEY, CONTROL, NOINVERT
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL, NOINVERT
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT, NOINVERT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT, NOINVERT
    VK_F1,          ID_HELP,                VIRTKEY, NOINVERT
    VK_F1,          ID_CONTEXT_HELP,        VIRTKEY, SHIFT, NOINVERT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY, NOINVERT
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT, NOINVERT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT, NOINVERT
    "W",            ID_RENDER_WIREFRAME,    VIRTKEY, CONTROL, NOINVERT
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL, NOINVERT
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 309, 154
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About demo"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_ATB,IDC_STATIC,18,14,21,20
    LTEXT           "demo Version 0.5",IDC_STATIC,150,24,119,8,SS_NOPREFIX
    LTEXT           "Copyright © 1997",IDC_STATIC,149,50,119,8
    DEFPUSHBUTTON   "OK",IDOK,138,123,32,14,WS_GROUP
    LTEXT           "3DFX Interactive Inc",IDC_STATIC,149,37,60,9
    LTEXT           "Driver",IDC_STATIC,18,70,24,11
    EDITTEXT        IDC_DRIVER_NAME,60,70,25,13,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "FB (MB):",IDC_STATIC,18,94,32,11
    EDITTEXT        IDC_FB_MEM,60,94,28,13,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "TMU 0 (MB):",IDC_STATIC,96,94,43,8
    EDITTEXT        IDC_TFX0_MEM,140,94,29,13,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "TMU 1 (MB):",IDC_LABEL_TMU1,179,94,46,8
    EDITTEXT        IDC_TFX1_MEM,229,94,28,13,ES_AUTOHSCROLL | ES_READONLY
END

IDD_ERROR DIALOGEX 0, 0, 218, 100
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "&End Task",ID_END_TASK,153,73,50,14,NOT WS_TABSTOP,
                    WS_EX_DLGMODALFRAME
    DEFPUSHBUTTON   "OK",IDOK,99,73,50,14,0,WS_EX_DLGMODALFRAME
    ICON            "",IDC_ERROR_ICON,17,32,18,20
    EDITTEXT        IDC_ERROR_MESSAGE,52,23,151,39,ES_MULTILINE | 
                    ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT 
                    WS_TABSTOP,WS_EX_LEFTSCROLLBAR
END


