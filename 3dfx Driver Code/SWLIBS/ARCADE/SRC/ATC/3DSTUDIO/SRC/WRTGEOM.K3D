; WRITE GEOMETRY



DefXForm xform



@Main

	Gosub OpenOutputFile	

	NumFrames

	number_of_frames = Time

	print number_of_frames; " frames"

	frame = 0

;	For frame = 0 to number_of_frames - 1

		gosub WriteFrame		

;	Next frame

	print "Done."

End



@OpenOutputFile

	; Use standard file box to get filename and open file in Write mode

	;

	Selectfile "Select file to write geometry info to", "", ""   :'Selecting and opening ASC file to output to

	If RC < 1 Then End

;	FileName$ = "d:\gary3ds\test.obj"

	Open FileName$, OUTPUT, #1

Return



@WriteFrame

;	print "frame: "; frame	

;	print #1, "frame: "; frame

	GetNodeCount

	if RC < 1 Then End



	number_of_objects = 0

	For i = 0 to NodeCount - 1

		GetNodeName i

		if NodeType = 1 Then number_of_objects = number_of_objects + 1

	Next i		

	print #1, "objects: "; number_of_objects

	

	For i = 0 to NodeCount - 1

  		GetNodeName i     

		Obj$ = NodeName$



		If NodeType != 1 Then Next i : Return



		print #1, "object: <"; Obj$; ">"	



;		print #1, "transform:"

;		GetXForm Obj$, frame, xform

;		Gosub PrintXForm		



		GetFVCount Obj$

		number_of_faces = Faces

		number_of_verts = Verts



		print #1, "verts: "; number_of_verts

	 	DefVertex the_verts

		absolute = 0

		GetVerts Obj$, 0, number_of_verts, frame, absolute, the_verts

		For j = 0 to number_of_verts - 1

			print #1, the_verts.x(j); " "; the_verts.y(j); " "; the_verts.z(j)

		Next j



		print #1, "faces: "; number_of_faces

	  	DefFace the_faces

		GetFaces Obj$, 0, number_of_faces, the_faces

		For j = 0 to number_of_faces - 1

			print #1, the_faces.a(j); " "; the_faces.b(j); " "; the_faces.c(j)

		Next j

	Next i

Return





@PrintXForm

	print #1, xform.tm(0,0); " "; xform.tm(0,1); " "; xform.tm(0,2)

	print #1, xform.tm(1,0); " "; xform.tm(1,1); " "; xform.tm(1,2)

	print #1, xform.tm(2,0); " "; xform.tm(2,1); " "; xform.tm(2,2)

	print #1, xform.tm(3,0); " "; xform.tm(3,1); " "; xform.tm(3,2)

Return



