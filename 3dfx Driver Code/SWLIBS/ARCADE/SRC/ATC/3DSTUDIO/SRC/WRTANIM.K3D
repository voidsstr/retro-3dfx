; WRITE ANIMATION

DefXForm xform

@Main
	Gosub OpenOutputFile	
	GetSegment
	print #1, "segment: "; SegStart; " "; SegEnd
	print "segment: "; SegStart; " "; SegEnd
	GetNodeCount
	if RC < 1 Then End
	for i = 0 to NodeCount - 1
		GetNodeName i
		if NodeType != 1 Then Next i : print #1, "End" : print "Done" : End
		print "object: <"; NodeName$ ; ">"
		print #1, "object: <"; NodeName$ ; ">"
		Gosub WriteNode
	Next i
	print "Done."
End

@OpenOutputFile
	; Use standard file box to get filename and open file in Write mode
	;
	Selectfile "Select animation file to output to", "", ""   :'Selecting and opening ASC file to output to
	If RC < 1 Then End
;	FileName$ = "d:\gary3ds\test.obj"
	Open FileName$, OUTPUT, #1
Return

@WriteNode
	for frame = SegStart to SegEnd
		GetXForm NodeName$, frame, xform
		gosub PrintXForm
	Next frame
Return

@PrintXForm
	print #1, xform.tm(0,0); " "; xform.tm(0,1); " "; xform.tm(0,2)
	print #1, xform.tm(1,0); " "; xform.tm(1,1); " "; xform.tm(1,2)
	print #1, xform.tm(2,0); " "; xform.tm(2,1); " "; xform.tm(2,2)
	print #1, xform.tm(3,0); " "; xform.tm(3,1); " "; xform.tm(3,2)
Return

