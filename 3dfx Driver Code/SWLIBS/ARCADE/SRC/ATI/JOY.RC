#include <winuser.h>
#include "resource.h"

#if (WINVER < 0x1000)
#define DS_3DLOOK           0x0004L
#define DS_FIXEDSYS         0x0008L
#define DS_NOFAILCREATE     0x0010L
#define DS_CONTROL          0x0400L
#define DS_CENTER           0x0800L
#define DS_CENTERMOUSE      0x1000L
#define DS_CONTEXTHELP      0x2000L
#endif
/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

JOY_NOT_CENTERED DIALOG DISCARDABLE  0, 0, 239, 119
STYLE DS_MODALFRAME | DS_SETFOREGROUND | DS_3DLOOK | DS_CENTER | WS_POPUP | 
    WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,37,83,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,143,83,50,14
    LTEXT           "The joystick does not appear to be centered.",
                    IDC_STATIC,44,38,142,8
    LTEXT           "Do you wish to center it?",IDC_STATIC,71,51,79,8
END

CONFIGURE_JOY DIALOG DISCARDABLE  0, 0, 231, 149
STYLE DS_MODALFRAME | DS_SETFOREGROUND | DS_3DLOOK | DS_CENTER | WS_POPUP | 
    WS_CAPTION | WS_SYSMENU
CAPTION "Configure Joystick"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,45,115,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,138,115,50,14
    CONTROL         "Custom1",IDC_PICTURE_JOY,"3dfxJoystickDisplayWin",
                    WS_TABSTOP,141,22,62,59
    PUSHBUTTON      "Center Joystick",IDC_CENTER_JOY,32,33,61,14
    PUSHBUTTON      "Joystick Range",IDC_RANGE_JOY,32,55,61,14
    CTEXT           "Move joystick about full range and pull trigger",
                    IDC_CONFIG_TEXT,38,94,162,8
END


