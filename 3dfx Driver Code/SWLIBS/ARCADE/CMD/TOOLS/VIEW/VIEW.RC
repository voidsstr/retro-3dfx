/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU1 MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...",                    ID_FILE_OPEN
        MENUITEM "&Load Path...",               ID_FILE_LOADPATH
        MENUITEM SEPARATOR
        MENUITEM "Send...",                     ID_FILE_SEND
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "Render"
    BEGIN
        MENUITEM "Fog",                         ID_RENDER_FOG
        MENUITEM "Bilinear",                    ID_RENDER_BILINEAR
        MENUITEM "Mipmapping",                  ID_RENDER_MIPMAPPING
        MENUITEM "Wireframe",                   ID_RENDER_WIREFRAME
        MENUITEM "Texturing",                   ID_RENDER_TEXTURING
        MENUITEM "Culling",                     ID_RENDER_CULLING
    END
    POPUP "Misc"
    BEGIN
        MENUITEM "Show 3DFX Plug",              ID_MISC_PLUG
        MENUITEM "Calibrate Joystick",          ID_MISC_JOYCAL
        MENUITEM "View Mode",                   ID_MISC_VIEWMODE
    END
    POPUP "Help"
    BEGIN
        MENUITEM "About",                       ID_HELP_ABOUT
    END
END

IDR_MENU3 MENU DISCARDABLE 
