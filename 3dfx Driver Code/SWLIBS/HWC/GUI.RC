IDR_APPMENU1 MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Save\t       Ctrl+W",        ID_FILE_SAVE
        MENUITEM "Save &As\t       F12",        ID_FILE_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "E&xit\t       Alt+F4",        ID_FILE_EXIT
    END
    POPUP "&View"
    BEGIN
        POPUP "&Filter"
        BEGIN
            MENUITEM "&None",                       ID_VIEW_FILTER_NONE
            MENUITEM "&Expand",                     ID_VIEW_FILTER_EXPAND
