    EDITTEXT        IDC_PIXELS_IN,148,185,39,13,ES_RIGHT | ES_MULTILINE | 
                    ES_AUTOHSCROLL | WS_DISABLED,WS_EX_RIGHT
    CONTROL         "Pause after next &Triangle",
                    IDC_PAUSE_AFTER_NEXT_TRIANGLE,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,11,214,105,10
    CONTROL         "Pause before triangle #",IDC_PAUSE_BEFORE_TRIANGLE,
                    "Button",BS_AUTORADIOBUTTON,11,236,86,10
    EDITTEXT        IDC_PAUSE_BEFORE_TRIANGLE_NUM,99,236,33,13,
                    ES_AUTOHSCROLL | ES_NUMBER | WS_GROUP
    GROUPBOX        "Settings",IDC_STATIC,6,257,205,91
    COMBOBOX        IDC_COMBO_GDBG_LEVEL,9,272,109,90,CBS_DROPDOWN | 
                    WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "GDBG_LEVEL",IDC_BUTTON_GDBG,135,272,53,14
    EDITTEXT        IDC_FLUSH_COUNT,9,292,35,13,ES_AUTOHSCROLL
    EDITTEXT        IDC_POLL_LIMIT,9,311,35,13,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT3,9,326,35,13,ES_AUTOHSCROLL
    LTEXT           "Pixel Flush Count",IDC_STATIC,51,292,54,10
    LTEXT           "Input Poll Freq.",IDC_STATIC,51,311,48,10
    LTEXT           "unused",IDC_STATIC,51,326,34,10
    LTEXT           "in this frame",IDC_STATIC,135,236,40,11
    LTEXT           "pixels in (no clears)",IDC_STATIC,138,172,59,9
    EDITTEXT        IDC_TEX_DOWNLOADS,151,292,37,13,ES_RIGHT | ES_MULTILINE | 
                    ES_AUTOHSCROLL | ES_NUMBER | WS_DISABLED | NOT 
                    WS_TABSTOP
    EDITTEXT        IDC_TEX_BYTES,151,311,37,13,ES_RIGHT | ES_MULTILINE | 
                    ES_AUTOHSCROLL | ES_NUMBER | WS_DISABLED | NOT 
                    WS_TABSTOP
    EDITTEXT        IDC_NCC_DOWNLOADS,151,326,37,13,ES_RIGHT | ES_MULTILINE | 
                    ES_AUTOHSCROLL | ES_NUMBER | WS_DISABLED | NOT 
                    WS_TABSTOP
    LTEXT           "Tex Dlds",IDC_STATIC,111,292,36,11
    LTEXT           "Ncc Dlds",IDC_STATIC,112,326,38,11
    LTEXT           "Tex Bytes",IDC_STATIC,111,311,40,11
    CONTROL         "Analytical Raster",IDC_ANALYTICAL_RASTER,"Button",
