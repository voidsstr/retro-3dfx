                    BS_AUTORADIOBUTTON,114,86,86,10
    EDITTEXT        IDC_PAUSE_BEFORE_FRAME_NUM,114,100,33,13,ES_RIGHT | 
                    ES_MULTILINE | ES_AUTOHSCROLL | ES_NUMBER | WS_GROUP
