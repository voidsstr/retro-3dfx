IDD_CSIM_MAIN DIALOGEX 0, 0, 229, 356
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Csim Controls"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "&Quit",IDCANCEL,131,18,55,14
    GROUPBOX        "Options",IDC_STATIC,5,7,94,149
    CONTROL         "&Flush after cmds",IDC_FLUSH_AFTER_COMMANDS,"Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,15,20,66,10
    CONTROL         "&Pause",IDC_PAUSE,"Button",BS_AUTOCHECKBOX,15,35,63,10
    CONTROL         "&Save after swap",IDC_SAVE_AFTER_SWAP,"Button",
                    BS_AUTOCHECKBOX,15,50,64,10
    CONTROL         "&IEEE Math",IDC_IEEE_MATH,"Button",BS_AUTOCHECKBOX,15,
                    65,60,10
    CONTROL         "&Bit Accurate",IDC_BIT_ACCURATE,"Button",
                    BS_AUTOCHECKBOX,15,80,65,10
    CONTROL         "&Reset pixels in",IDC_RESET_PIXELS_IN,"Button",
                    BS_AUTOCHECKBOX,15,96,60,10
    CONTROL         "S&kip rendering",IDC_SKIP_RENDERING,"Button",
                    BS_AUTOCHECKBOX,15,110,61,10
    GROUPBOX        "Buffer Swaps",IDC_STATIC,105,43,104,113
    EDITTEXT        IDC_CURRENT_FRAME_NUM,114,54,33,13,ES_RIGHT | 
                    ES_MULTILINE | ES_AUTOHSCROLL | ES_NUMBER | WS_DISABLED
    LTEXT           "current frame #",IDC_STATIC,149,57,50,12
    CONTROL         "Pause after &Next swap",IDC_PAUSE_AFTER_NEXT_SWAP,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,114,
                    74,84,10
